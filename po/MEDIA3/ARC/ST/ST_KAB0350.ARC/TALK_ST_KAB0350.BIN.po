msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:288_0_1"
msgid "Neon at the top of Tsutenkaku Tower changes||to show tomorrow's weather,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:288_0_2"
msgid "So now it's red,{PA:10} yeah?{PA:20}||{MS:0}Red means.{PA:20}.{PA:20}.{PA:20} Wait,{PA:10} what's red mean again?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:289_0_1"
msgid "Winter or not,{PA:10}||it's way too flippin' cold.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_2"
msgid "Sachi,{PA:10} hold up!{PA:20}||H-Hold up,{PA:10} baby.{PA:20} Sachiko,{PA:10} this.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_3"
msgid "Damn barefoot punk's been glarin' at me!{PA:20}||Gotta give him a piece of my mind!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_4"
msgid "Ya daft,{PA:10} honey?{PA:20} That's a Billiken statue!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_5"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_6"
msgid "Apologize to the poor thing!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_7"
msgid "I-I'm sorry,{PA:10} buddy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_8"
msgid "Wrong way,{PA:10} ya drippy dipso!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_9"
msgid "Sorry,{PA:10} buddy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_10"
msgid "Ugh.{PA:20}.{PA:20}.{PA:20} This is so embarrassin'.{PA:20}||The hell were ya thinkin',{PA:10} man?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_11"
msgid "Ya went off and left all of a sudden!{PA:20}||I thought.{PA:20}.{PA:20}.{PA:20} I thought ya left me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_12"
msgid "Got fed up with me bein' such a failure and||left me for.{PA:20}.{PA:20}.{PA:20} For good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_13"
msgid "What?!{PA:20}||Done told ya I was goin' out shoppin'!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_14"
msgid "C'mon,{PA:10} we're goin' home!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_15"
msgid "Y-Yes,{PA:10} ma'am.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_16"
msgid "No idea at all how worried I was.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_17"
msgid "S-Sorry,{PA:10} ma'am.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_18"
msgid "Sorry to make ya watch all this,{PA:10} honey.{PA:20}||Thanks for yer help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_19"
msgid "I'll be sure to rake him over the coals good||this time so's he won't do it again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_20"
msgid "Honey!{PA:20} Apologize to the nice man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:291_0_21"
msgid "S-Sorry,{PA:10} man.{PA:20}.{PA:20}.{PA:20}"
msgstr "P-perdón po{PA:10}r todo{PA:20}..{PA:20}.{PA:20}"

