msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_3"
msgid "Hello.{PA:20} Imitation Renovating here.{PA:20}||What can I do you for?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_4"
msgid "It's Kiryu.{PA:20}"
msgstr "Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_5"
msgid "M-Mr.{PA:20} Kiryu!{PA:20} Boss!{PA:20} Yes,{PA:10} sir!{PA:20}||H-How can we help you today?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_6"
msgid "The folks at Sunflower want to build a kids'||park,{PA:10} but they're low on money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_7"
msgid "Can you do something for them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_8"
msgid "Yes,{PA:10} sir!{PA:20} Of course!{PA:20} Leave it to us,{PA:10} and||we'll whip something up for cheap!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_1_9"
msgid "Thanks.{PA:20}||That sounds great.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_4"
msgid "Hello?{PA:20}"
msgstr "¿Hola?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_6"
msgid "I'd like to ask about Keima.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_7"
msgid "How many stairs are in Tsutenkaku Tower?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_8"
msgid "The number of stairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_12"
msgid ".{PA:20}.{PA:20}.{PA:20}||Black bear,{PA:10} grilled guts,{PA:10} three times.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_13"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_15"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:20_2_16"
msgid "He hung up on me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_0_0"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr "¿Cómo van las cosas por ahí?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_2_5"
msgid "Yeah,{PA:10} I'll make it.{PA:20} I might not be a rock||like you,{PA:10} but I can still take a beating.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0350.ARC/TALK_ST_KAB0350.BIN::line:28_2_7"
msgid "I've got it covered.{PA:20}||Later.{PA:20}"
msgstr ""

