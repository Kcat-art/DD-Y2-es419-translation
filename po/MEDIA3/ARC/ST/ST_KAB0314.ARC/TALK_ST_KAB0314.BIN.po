msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_1"
msgid "\"Let's see yer invitation then!{PA:20}\"||Heh.{PA:20}.{PA:20}.{PA:20} Buncha big-headed twits.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_2"
msgid "What,{PA:10} do ya gotta be as good as \"{CC:ffc8c8}Jongka{CR:00}\" just||to get into a place now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_3"
msgid "Who's \"{CC:ffc8c8}Jongka{CR:00}\"?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_4"
msgid "What,{PA:10} ya don't know Jongka?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_5"
msgid "Any player around here would piss himself||just from hearin' the man's name!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_6"
msgid "So the three top dogs in underground mahjong||were Jongka,{PA:10} Jongko and Jongen,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_7"
msgid "But now Jongka says he's givin' up the game.{PA:20}||Spends all his time at the arcade now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_0_8"
msgid "Just plays those UFO catcher games like some||kinda zombie.{PA:20} It's pathetic.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_1_0"
msgid "\"{CC:ffc8c8}Jongka{CR:00}\" says he's quit mahjong.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_1_1"
msgid "Spends all his time at the arcade now.{PA:20}||Just plays those UFO catcher games.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:292_1_2"
msgid "Guy's like a zombie.{PA:20} It's pathetic.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_0"
msgid "Huh?!{PA:20} Who the fuck are you?{PA:20}"
msgstr "¡¿Eh?{PA:20}! ¡¿Quién carajos eres?!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_1"
msgid "I'm here in Jongka's place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_2"
msgid "What the fuck happened to Jongka?{PA:20}||And you got the money?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_4"
msgid "Wait,{PA:10} what?{PA:20} You're payin'?!{PA:20}||Near gave me a heart attack.{PA:20} Well,{PA:10} okay.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_5"
msgid "\"{CC:ffc8c8}Yukiko{CR:00}\"'s by the river,{PA:10} near the umbrella.{PA:20}||\"{CC:ffc8c8}Guy in a red coat{CR:00}\"'s got her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_6"
msgid "Later!{PA:20}"
msgstr "¡Adiós!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_8"
msgid "Gaah ha ha!{PA:20}||What a joke.{PA:20}"
msgstr "¡Jua, ja, ja! Tienes{PA:20}|| que estar bromeando.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_9"
msgid "Ya ain't got 5 million!{PA:20}||Think ya can just feed me a line like that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_10"
msgid "I've got no money to give to you people.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_11"
msgid "Gaah ha ha!{PA:20}||What a joke.{PA:20}"
msgstr "¡Jua, ja, ja! Tienes{PA:20}|| que estar bromeando.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_0_12"
msgid "Here's what I do to guys that fuck with me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_1_0"
msgid "Th-Thorry,{PA:10} buddy!{PA:20} Look,{PA:10} I'm thorry!{PA:20}||Y-\"{CC:ffc8c8}Yukiko{CR:00}\"'th.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_1_1"
msgid "She'th by the river.{PA:20}.{PA:20}.{PA:20} Under the umbrella.{PA:20}||\"{CC:ffc8c8}Guy in a red coat{CR:00}\"'th got her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_1_2"
msgid "Really!{PA:20} Don't hurt me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_2_0"
msgid "\"{CC:ffc8c8}Yukiko{CR:00}\"'s by the river,{PA:10} near the umbrella!{PA:20}||A \"{CC:ffc8c8}guy in a red coat{CR:00}\"'s got her,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_2_1"
msgid "W-We're done,{PA:10} right?{PA:20} Can I please go now?{PA:20}"
msgstr "¿Y-ya terminamos{PA:10}, verdad{PA:20}? ¿Me puedo ir, por favor?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_3_0"
msgid "\"{CC:ffc8c8}Yukiko{CR:00}\"'s by the river,{PA:10} near the umbrella.{PA:20}||\"{CC:ffc8c8}Guy in a red coat{CR:00}\"'s got her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:293_3_1"
msgid "Later!{PA:20}"
msgstr "¡Adiós!{PA:20}"

