msgid "Who are you?{PA:20}||How did you get this number?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_1_3"
msgid "Where is she?!{PA:20} Is she all right?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_1_5"
msgid "Who the hell is this?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_1_7"
msgid "(He hung up.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_2_0"
msgid "You Kiryu?{PA:20}"
msgstr "¿Hablo con Kiryu?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_2_2"
msgid "That don't matter one lick,{PA:10} buddy.{PA:20}||Ya want Haruka back?{PA:20} Then listen up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_2_4"
msgid "No questions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_2_5"
msgid "Ya wanna meet her?{PA:20} Then come to the||\"{CC:ffc8c8}Yokobori Golf Center{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_2_6"
msgid "Alone.{PA:20}"
msgstr "¡¿Usted solo?!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:294_2_8"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:295_0_0"
msgid "(The \"{CC:ffc8c8}Yokobori Golf Center{CR:00}\".{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:295_0_1"
msgid "(And that voice.{PA:20}.{PA:20}.{PA:20}||I feel like I've heard it before.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_0_0"
msgid "Wonder what it'd take to get an invite.{PA:20}.{PA:20}.{PA:20}"
msgstr "Me pregunto qué se necesitará para conseguir una invitaci{PA:20}ón{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_0"
msgid "Reach Towers is a famous mahjong parlor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_1"
msgid "Gets the top players from all over Kansai.{PA:20}||No kiddin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_2"
msgid "Word is,{PA:10} the four gods of the mahjong||underground play there pretty often.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_3"
msgid "There are four gods in underground mahjong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_4"
msgid "Yeah.{PA:20} Dunno too many specifics,{PA:10} but they're||supposed to be unstoppable.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_5"
msgid "Can't even count how many idiots gone up||against them and ruined their damn lives.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_6"
msgid "Anyhow,{PA:10} that's the sorta place it is.{PA:20}"
msgstr "Pero {PA:10}bueno, así es ese lugar.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_7"
msgid "They got it set up by invitation only to||keep the newbies out,{PA:10} follow?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_8"
msgid "Least that's what they say.{PA:20} Word is,{PA:10} there's||some shady business going down inside.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_9"
msgid "Still,{PA:10} as a serious player,{PA:10} I wish I could||play a round there.{PA:20} Even just once.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:296_1_10"
msgid "Wonder what it'd take to get an invite.{PA:20}.{PA:20}.{PA:20}"
msgstr "Me pregunto qué se necesitará para conseguir una invitaci{PA:20}ón{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:297_0_1"
msgid "I saw it,{PA:10} I swear!{PA:20}"
msgstr "¡Es real, ju{PA:10}ro que lo vi!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:297_0_2"
msgid "Osakan Castle split right in two!{PA:20}||Whole damn thing,{PA:10} no lie!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:297_0_3"
msgid "No,{PA:10} I'm serious!{PA:20} Ya gotta believe me!{PA:20}"
msgstr "¡Lo {PA:10}digo en serio, l{PA:20}o vi con mis propios ojos!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_0_1"
msgid "(Looks like an argument.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_0_2"
msgid "Piss me off and you'll regret it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_0_3"
msgid "Fuck if I care if he's a Diet member!{PA:20}||I'll knock yer ass down a peg or two!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_0_4"
msgid "Hey!{PA:20} Knock it off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_0_5"
msgid "Who the fuck are you?!{PA:20}||I'm gonna pound the lot o' ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_1_0"
msgid "Piss me off and you're really gonna||regret it,{PA:10} bub!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_1_1"
msgid "Excuse me?!{PA:20}"
msgstr "¡Mesero!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_1_2"
msgid "You'd better watch your mouth||around the Councilor!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_1"
msgid "Thank you so very much for your help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_2"
msgid "This is Councilor Saeki,{PA:10} a Diet member.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_3"
msgid "Hello,{PA:10} sir!{PA:20} So very nice to meet you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_4"
msgid "I'm his aide,{PA:10} Mita.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_5"
msgid "We'd have been in a real spot without you.{PA:20}||I'm down here in Osaka for some meetings.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_6"
msgid "It's a shame to see our cities are so very||much alike.{PA:20} It's as rough here as in Tokyo!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_7"
msgid "That is so true,{PA:10} Councilor.{PA:20}||It's precisely as you say.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_8"
msgid "Still,{PA:10} we managed!{PA:20} Thanks to your very||welcome assistance,{PA:10} of course.{PA:20} Ha ha!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_9"
msgid "Mita,{PA:10} please.{PA:20} Give the kind man one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_10"
msgid "Hm?{PA:20} Ah,{PA:10} yes,{PA:10} of course,{PA:10} Councilor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_11"
msgid "           You received a book.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_12"
msgid "Councilor Saeki authored this book,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_13"
msgid "             \"{CC:ffc8c8}You're Wonderful!{CR:00}{PA:20}\"||     -Happiness Isn't All About Money-"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_14"
msgid "A part of his \"Wonderful\" series!{PA:20}||Currently topping the bestseller charts!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_15"
msgid "Oh,{PA:10} stop.{PA:20} That's so embarrassing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_16"
msgid "The cover price is a fair 5,{PA:10}200 yen.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_17"
msgid "But you're being given a copy signed by the||Councilor himself,{PA:10} absolutely free!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_18"
msgid "I'm just so very sorry I have nothing else||with me to give you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_19"
msgid "You're a truly lucky man.{PA:20}||This is a rare blessing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_20"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_21"
msgid "Let's not take any more of his time.{PA:20}||Perhaps we'll see you again,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_2_22"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_3_0"
msgid "          Will you read the book?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_3_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_3_2"
msgid "(It's a cliché self-help book.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:301_3_3"
msgid "(It's just a long train of trite lines||strung one after another.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:305_0_0"
msgid "Rrgh!{PA:20} I ain't gonna forget this,{PA:10} assholes!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_3"
msgid "(Sounds like trouble.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_4"
msgid "Ooh,{PA:10} you're cute when ya struggle!{PA:20}||Cute when ya do anythin' at all,{PA:10} Mika!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_5"
msgid "Stop it!{PA:20}||This is sexual harassment!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_6"
msgid "What,{PA:10} you want money?{PA:20}||I'll give ya all ya like,{PA:10} baby.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_7"
msgid "Hmm?{PA:20} Hmmm?{PA:20}||So how much ya want?{PA:20} Just say it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_8"
msgid "This ain't about money!{PA:20}||Get yer damn smelly breath outta my face!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_9"
msgid "Excuse me?!{PA:20} Do you know who he is?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_0_10"
msgid "Yeah,{PA:10} a two-bit ass-starved sex bandit!{PA:20}||The hell do ya think YOU are?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_1_0"
msgid "Hey!{PA:20} Get yer hands off me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_2"
msgid "M-Mika.{PA:20}.{PA:20}.{PA:20}?{PA:20} Ahh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_3"
msgid "Huh?{PA:20} Honey?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_4"
msgid "Hm?{PA:20} Who the devil are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_5"
msgid "That's my wife,{PA:10} dammit!{PA:20}||Get yer filthy hands off her!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_6"
msgid "Honey.{PA:20}.{PA:20}.{PA:20}?{PA:20}||Y-You okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_7"
msgid "Sit tight,{PA:10} Mika!{PA:20} I'll save ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_8"
msgid ".{PA:20}.{PA:20}.{PA:20}That really you,{PA:10} honey?{PA:20}||What the hell happened to ya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_9"
msgid "When'd you suddenly grow a pair?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_10"
msgid "Hm?{PA:20} Mika here is my escort for the evening.{PA:20}||It seems you're looking for pain,{PA:10} hm?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_11"
msgid "Mita!{PA:20} Get to work!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_12"
msgid "Of course,{PA:10} Councilor!{PA:20} Leave this riff raff||to me,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_14"
msgid "D-Dammit!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_15"
msgid "            Will you help him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_2_17"
msgid "(I should just stay out of this.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_3_1"
msgid "Hey!{PA:20} Leave her alone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_3_2"
msgid "Y-You're that guy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_3_3"
msgid "Hm?{PA:20} Another rat's scurried onto the scene?{PA:20}||Wait.{PA:20}.{PA:20}.{PA:20} I feel as though we've met.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_3_4"
msgid "Regardless,{PA:10} it's time for you all to leave!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_1"
msgid "C-Councilor.{PA:20}.{PA:20}.{PA:20} Forgive me.{PA:20}.{PA:20}.{PA:20}||I wasn't able to.{PA:20}.{PA:20}.{PA:20} protect.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_2"
msgid "Honey!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_3"
msgid "Mika!{PA:20} I did it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_4"
msgid "Did you hit yer head or somethin'?{PA:20}||Guy over there did all the work for ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_5"
msgid "I'll give ya credit for tryin',{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_6"
msgid "M-Mika.{PA:20}.{PA:20}.{PA:20}||Now to learn this pervert a few things.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_7"
msgid "Ha ha.{PA:20}.{PA:20}.{PA:20} ha.{PA:20}.{PA:20}.{PA:20}"
msgstr "¡Ja, {PA:20}j{PA:20}a{PA:20}, j{PA:20}a{PA:20}!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_8"
msgid "N-No,{PA:10} this is wonderful.{PA:20} So very touching!{PA:20}||All's well that ends well,{PA:10} eh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_9"
msgid "H-Here,{PA:10} take this with my compliments!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_10"
msgid "    Saeki handed Yoshida a pile of cash.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_11"
msgid "After all,{PA:10} there's more to happiness than||money,{PA:10} right?{PA:20} Ha!{PA:20} Ha ha ha!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_12"
msgid "So long!{PA:20}||Mita!{PA:20} Let's get the hell outta here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_4_13"
msgid "Y-Yes,{PA:10} sir!{PA:20}"
msgstr "¡S-sí, {PA:10}señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_1"
msgid "So what happened,{PA:10} honey?{PA:20} When'd ya get to be||so brave?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_2"
msgid "Always knew there was a good man in ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_3"
msgid "Dirty ol' skirt-chaser came on to me in the||bar 'n' just wouldn't leave me alone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_4"
msgid "It's all thanks to this guy,{PA:10} actually.{PA:20}||Helped me out when I'd hit rock bottom.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_5"
msgid "Gave me a book by that Saeki guy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_6"
msgid "\"You're Wonderful\",{PA:10} think it's called.{PA:20}||Big hit right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_7"
msgid "So I read it,{PA:10} right?{PA:20} It's a piece o' trash!{PA:20}||Be worth more as toilet paper!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_8"
msgid "Just a giant train o' trite lines strung one||after another!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_9"
msgid "Seein' a book like that make bestseller made||me realize the whole world's crazy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_10"
msgid "Damn near laughed my ass off by the end.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_11"
msgid "Made me get to thinkin' my own worries were||all pretty dumb,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_12"
msgid "So I just kicked 'em all aside!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_13"
msgid "Saeki,{PA:10} ya said?{PA:20} \"You're Wonderful\"?!{PA:20}||Honey,{PA:10} that was the pervert from just now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_14"
msgid "No shit?{PA:20} Ah ha ha!{PA:20}||Ain't that a hoot!{PA:20} What a world!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_15"
msgid "Thank you,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_16"
msgid "Can't give ya much,{PA:10} but here.{PA:20}||At least take this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_17"
msgid "     You received an \"{CC:ffffc8}Italian necklace{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_19"
msgid "Really,{PA:10} I can't thank ya enough,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:306_5_20"
msgid "Received 2❟500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:311_0_0"
msgid "(So this is the Midoriyama Building.{PA:20}||Kajiwara said Kojima would be inside.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0314.ARC/TALK_ST_KAB0314.BIN::line:312_0_0"
