msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:284_0_0"
msgid "(This isn't the way to the theater.{PA:20}||I've got to track down Daigo.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:287_0_1"
msgid "All right,{PA:10} I'll be right there.{PA:20}"
msgstr "Allí e{PA:10}staré, Sayama.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:287_1_0"
msgid "I'm all ready here.{PA:20}||I'll be waiting for you at Serena.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:288_0_0"
msgid "It's me.{PA:20} Yuya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:288_1_0"
msgid "No,{PA:10} sir.{PA:20} I work with him here at the club.{PA:20}||He's not in at the moment,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:288_1_1"
msgid "But we're in serious trouble here!{PA:20}||Those men from before are back!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_3"
msgid "Mizuki.{PA:20}.{PA:20}.{PA:10}{PA:20} Let's end it all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_4"
msgid "Snap out of it,{PA:10} Aki!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_5"
msgid "Hey,{PA:10} don't do anything stupid,{PA:10} kid!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_6"
msgid "Wh-Who the hell are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_7"
msgid "Just a guy passing by.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_8"
msgid "Now the yakuza's after me?!{PA:20} Look,{PA:10} we're in||the middle of something!{PA:20} Stay out of this!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_9"
msgid "Just tell me what happened,{PA:10} kid.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_11"
msgid "You've got to have a reason for doing this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_12"
msgid ".{PA:20}.{PA:20}.{PA:20}I gave her everything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_13"
msgid "Okay.{PA:20}.{PA:20}.{PA:20}"
msgstr "Bueno.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_14"
msgid "But.{PA:20}.{PA:20}.{PA:10}{PA:20} It's all a lie!{PA:20} She'll never love me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_15"
msgid "No,{PA:10} Aki!{PA:20} That's not true!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_16"
msgid "Look,{PA:10} first put down that knife.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_17"
msgid "Don't you tell me what to do!{PA:20}||I ain't afraid of you,{PA:10} yakuza!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_18"
msgid "All right,{PA:10} then where's the bag I gave you?{PA:20}||I paid five million yen for that thing!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_19"
msgid "Oh,{PA:10} that.{PA:20} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_20"
msgid "I saw one just like it in the friggin' pawn||shop the other day!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_21"
msgid "Now tell me what you did with it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_22"
msgid "My mother really,{PA:10} really liked it,{PA:10} so I.{PA:20}.{PA:20}.{PA:20}||I let her have it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_23"
msgid "It's just a bag,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_24"
msgid "Fuck you!{PA:20}||.{PA:20}.{PA:20}.{PA:20}That was five million yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_25"
msgid "Could you buy something like that?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_26"
msgid "Nope.{PA:20}"
msgstr "No.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_27"
msgid "So the one in the pawn shop really was.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_28"
msgid "Aki,{PA:10} why won't you believe me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_29"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_30"
msgid "See?{PA:20} She's a good person.{PA:20} Her mom's lucky.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_31"
msgid "How many girls her age would do that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_32"
msgid "W-Well,{PA:10} I guess.{PA:20}.{PA:20}.{PA:20}||If it's for your mom,{PA:10} that's not too bad.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_33"
msgid "See,{PA:10} Aki?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_34"
msgid "Yeah,{PA:10} but that's not all!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_35"
msgid "Screw one little bag!{PA:20} I've given you so much||more than that,{PA:10} Mizuki!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_36"
msgid "Like that six million yen ring!{PA:20}||Where did that disappear to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_37"
msgid "Why aren't you wearing it tonight?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_38"
msgid "Well,{PA:10} it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_39"
msgid "It what?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_40"
msgid "I'm allergic to platinum,{PA:10} honey.{PA:20} It just||itched too much to keep wearing it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_41"
msgid "Allergic to platinum?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_42"
msgid "Yeah.{PA:20}||Of course I WANT to wear it always,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_43"
msgid "Well,{PA:10} I asked the doctor if there was any||way,{PA:10} but he told me to stop wearing it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_44"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_45"
msgid "See,{PA:10} she's allergic.{PA:20} It's not her fault.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_46"
msgid "Would you still expect her to wear it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_47"
msgid "W-Well,{PA:10} I guess not.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_48"
msgid "I never knew you could be allergic.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_49"
msgid "I really do love that ring,{PA:10} though.{PA:20}||I'm sorry,{PA:10} Aki.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_50"
msgid "Now,{PA:10} come on,{PA:10} let's go home.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_51"
msgid "N-No way!{PA:20} I'm not through yet!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_52"
msgid "You've got more explaining to do!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_53"
msgid "Who'd wear some huge ring every day?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_54"
msgid "Some huge ring.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_55"
msgid "It was a six million yen DIAMOND,{PA:10} asshole!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_56"
msgid "You ever seen a six million yen diamond?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_57"
msgid "Nope.{PA:20}"
msgstr "No.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_58"
msgid "A commoner would never understand.{PA:20}||This is all above you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_59"
msgid "Now shut up and butt out!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_60"
msgid ".{PA:20}.{PA:20}.{PA:20}But you were wearing a different ring the||other day,{PA:10} Mizuki.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_61"
msgid "For some reason,{PA:10} I don't react to that one.{PA:20}||That one isn't platinum!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_62"
msgid ".{PA:20}.{PA:20}.{PA:20}Really?{PA:20}"
msgstr ".{PA:20}..{PA:20} {PA:20}¿En serio?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_63"
msgid "You don't believe me,{PA:10} Aki?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_64"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_65"
msgid "Okay,{PA:10} Mizuki.{PA:20} Fine.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_66"
msgid "What about the car I bought you?{PA:20}||It hasn't been four months,{PA:10} and it's gone!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_67"
msgid "Well,{PA:10} I.{PA:20}.{PA:20}.{PA:20}"
msgstr "Bueno,{PA:10} yo.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_68"
msgid "There are only a couple of them in Japan,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_69"
msgid "but I saw one just like it zoom past me||the other day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_70"
msgid "I'm so sorry,{PA:10} Aki.{PA:20} I should have told you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_71"
msgid "I got in an accident and totaled it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_72"
msgid "T-Totaled it?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_73"
msgid "We'd just gone on a date.{PA:20}||I was so happy and distracted,{PA:10} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_74"
msgid "I sped a little,{PA:10} and kinda smashed it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_75"
msgid "You WHAT?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_76"
msgid "Th-That car cost 10 million!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_77"
msgid "See,{PA:10} it's partly your fault,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_78"
msgid "What?!{PA:20} How is it MY fault?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_79"
msgid "You should have seen her home safely.{PA:20}||She wouldn't have smashed the car.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_80"
msgid "W-Well,{PA:10} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_81"
msgid "Don't worry about it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_82"
msgid "I wasn't hurt.{PA:20} We're both still okay!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_83"
msgid "W-Well,{PA:10} yeah,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_84"
msgid "Now have you calmed down a little?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_85"
msgid "N-No.{PA:20}.{PA:20}.{PA:20}||Not yet!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_86"
msgid "You should be glad she's okay.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_87"
msgid "F-Fuck that noise,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_88"
msgid "Do you have ANY idea what I went through to||get her that car?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_89"
msgid "And she totals it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_90"
msgid "It's thanks to that car that I'm still here.{PA:20}||A different car and I might be dead!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_91"
msgid "It's like you saved my life,{PA:10} Aki.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_92"
msgid "Mizuki.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mizuk{PA:20}{PA:20}i{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_93"
msgid "All right then,{PA:10} Mizuki.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_94"
msgid "When is your new club going to open?{PA:20}||I'm still waiting to hear word!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_95"
msgid "I gave you 30 million yen over three months||ago to open that place!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_96"
msgid "You still haven't even told me where it is!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_97"
msgid "Well,{PA:10} I.{PA:20}.{PA:20}.{PA:20}"
msgstr "Bueno,{PA:10} yo.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_98"
msgid "What?{PA:20} You what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_99"
msgid "I got asked to stay at my old place,{PA:10} Aki.{PA:20}||The owner was begging me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_100"
msgid "What?{PA:20}||The guy at Max Bomber begged you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_101"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_102"
msgid "He said if his number one girl leaves,{PA:10} his||club will go out of business.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_103"
msgid "I.{PA:20}.{PA:20}.{PA:20}||I owe him a lot,{PA:10} honey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_104"
msgid "But wasn't it you saying you wanted to go||off on your own,{PA:10} Mizuki?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_105"
msgid "She's a grown woman,{PA:10} let her decide.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_106"
msgid "Shut the hell up!{PA:20}||I know that much!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_107"
msgid "The owner took me in off the street,{PA:10} Aki.{PA:20}||I owe him everything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_108"
msgid "I can't just betray him like that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_109"
msgid "So,{PA:10} please.{PA:20}||Just wait a little bit longer,{PA:10} Aki.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_110"
msgid "You'll be the first guy in when it opens!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_111"
msgid "F-Fine.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_112"
msgid "Now please,{PA:10} honey,{PA:10} let's just go home.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_113"
msgid "We can talk more there,{PA:10} if you like.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_114"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_115"
msgid "Maybe it's not that easy for her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_116"
msgid "Look,{PA:10} I know that much,{PA:10} okay?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_117"
msgid "Stop butting in!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_118"
msgid "The owner's done so much for me,{PA:10} honey.{PA:20}||I can't just betray him like that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_119"
msgid "So,{PA:10} please.{PA:20}||Just wait a little bit longer,{PA:10} Aki.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_120"
msgid "I'm sure I can convince him someday.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_121"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20}"
msgstr "A {PA:20}su{PA:20}s {PA:20}órdenes...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_122"
msgid "Mizuki.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mizuk{PA:20}{PA:20}i{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_123"
msgid "There's one last thing I want to ask.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_124"
msgid ".{PA:20}.{PA:20}.{PA:20}The condo I bought you a year ago.{PA:20}||The luxury suite.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_125"
msgid "Why won't you live there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_126"
msgid "Well,{PA:10} it's just.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_127"
msgid "I've still got 100 million to pay off on the||mortgage,{PA:10} Mizuki.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_128"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_129"
msgid "Tell me!{PA:20}"
msgstr "cuéntame!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_130"
msgid "She probably feels embarrassed by it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_131"
msgid "Why the hell would she be embarrassed?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_132"
msgid "It's a huge gift.{PA:20} Who wouldn't be a little||shy?{PA:20} Just give her some time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_133"
msgid "That's bullshit!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_134"
msgid "You're the one who picked the listing!{PA:20} You||wanted to tour the property,{PA:10} Mizuki!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_135"
msgid "She did?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_136"
msgid "There's an explanation,{PA:10} Aki.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_137"
msgid "To hell with your lies.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_138"
msgid "I saw it with my own two eyes,{PA:10} Mizuki!{PA:20}||Okay?{PA:20} I know!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_139"
msgid "It's been put back on the market!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_140"
msgid "Maybe there's a problem with the place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_141"
msgid "A problem?{PA:20}||Are you KIDDING?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_142"
msgid "It's a super high-tech mansion,{PA:10} built with||the latest cutting-edge technologies!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_143"
msgid "You could weather earthquakes,{PA:10} floods,{PA:10} the||fires of HELL in that place!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_144"
msgid "There's an explanation,{PA:10} Aki.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_145"
msgid "To hell with your lies.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_146"
msgid "I saw it with my own two eyes,{PA:10} Mizuki!{PA:20}||Okay?{PA:20} I know!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_147"
msgid "It's been put back on the market!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_148"
msgid "No,{PA:10} you misunderstand,{PA:10} Aki!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_149"
msgid "Enough!{PA:20}"
msgstr "¡Ya tuve suficiente!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0229.ARC/TALK_ST_KAB0229.BIN::line:289_0_150"
msgid "I'm ending it all,{PA:10} and you're coming,{PA:10} too!{PA:20}||Maybe.{PA:20}.{PA:20}.{PA:10}{PA:20} we'll be happier in the next life.{PA:20}"
msgstr ""

