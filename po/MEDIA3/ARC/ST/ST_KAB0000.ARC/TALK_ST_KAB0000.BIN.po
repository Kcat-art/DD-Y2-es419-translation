msgid "Kaoru"
msgstr "Kaoru"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_0"
msgid "Oh,{PA:10} Sayama.{PA:20} What's up?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_2"
msgid "You were unconscious.{PA:20}||Did you want me to carry you around?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_4"
msgid "In Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_6"
msgid "What do you want?{PA:20}"
msgstr "¿Qué quieres?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_8"
msgid "What do you need?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_10"
msgid "Women's underwear?{PA:20}||Are you serious?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_12"
msgid "That makes two of us.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_14"
msgid "What?!{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_1_16"
msgid "Hold it,{PA:10} why should I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_0"
msgid "What's up?!{PA:20} Oh,{PA:10} I'll tell you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_1"
msgid "You don't seem to understand the position||you're in is what's up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_2"
msgid "Run off like that again,{PA:10} and I'll.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_4"
msgid "Fine.{PA:20} I'll make an exception this time.{PA:20}||Where are you now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_6"
msgid "That's perfect.{PA:20}||Do me a favor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_8"
msgid "Would you pick up a few things for me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_10"
msgid ".{PA:20}.{PA:20}.{PA:20}\"{CC:ffffc8}Underwear{CR:00}\".{PA:20} Think you can manage that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_12"
msgid "Look,{PA:10} I didn't know I'd be staying with you||in Tokyo!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_14"
msgid "Oh,{PA:10} and while you're at it,{PA:10}||grab me a \"{CC:ffffc8}beer{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_16"
msgid "\"{CC:ffffc8}Underwear{CR:00}\" and \"{CC:ffffc8}beer{CR:00}\",{PA:10} got it?{PA:20}||Thanks!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:289_2_18"
msgid "Anyway,{PA:10} gotta go.{PA:20}||See ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:290_0_0"
msgid "You're coming to Kansai too,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:290_0_1"
msgid "Yeah.{PA:20} I'm worried about Chairman Goda.{PA:20}"
msgstr "Sí. M{PA:20}e preocupa el presidente Goda.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:290_0_2"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:290_0_3"
msgid "Well,{PA:10} I need to get ready.{PA:20}||Meet me back at Serena later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:290_0_4"
msgid "Get ready.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr "¡Prepára{PA:20}t{PA:20}e{PA:20}!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:290_0_5"
msgid "I'll call you when I'm done.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_0_0"
msgid "Aww man,{PA:10} maybe I SHOULD quit my job and go||work as a host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_0"
msgid "Hey,{PA:10} did you know the head host just changed||at that club,{PA:10} the Stardust?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_1"
msgid "No.{PA:20}.{PA:20}.{PA:20} Who's the head host now?{PA:20}"
msgstr "No.{PA:20}..{PA:20} {PA:20}¿Y quién está a cargo ahora?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_2"
msgid "Some guy named Yuya.{PA:20}||That's gotta be a pretty sweet gig!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_3"
msgid "I mean,{PA:10} he's head of the number one club||in town,{PA:10} you know?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_4"
msgid "I'll bet he's up to his knees in moolah.{PA:20}||Those hosts get paid like crazy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_5"
msgid "It makes me feel like an idiot for||working a boring 9-to-5.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_6"
msgid "What happened to Kazuki?{PA:20}"
msgstr "¿Qué le pasó a Kazuki?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_7"
msgid "Kazuki?{PA:20}||Oh,{PA:10} what,{PA:10} the owner?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_8"
msgid "Haven't heard much about him recently.{PA:20}||Doesn't show up at the club much,{PA:10} either.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_9"
msgid "He just leaves everything to that Yuya guy.{PA:20}||Maybe he's focusing on management stuff.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_10"
msgid "Well,{PA:10} either way,{PA:10}||I bet he's making a shitload of money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_1_11"
msgid "Aww man,{PA:10} maybe I SHOULD quit my job and go||work as a host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:291_2_0"
msgid "Seriously!{PA:20} Guy can't get a break.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:292_0_0"
msgid "Huh?{PA:20} The Amano Building?{PA:20}||Sorry,{PA:10} don't know the place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:292_1_0"
msgid "Rrgh,{PA:10} I can't get through!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_0_1"
msgid "Don't tell me.{PA:20}.{PA:20}.{PA:20}||You're going to see Katsumi?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_0_3"
msgid "Where are you now?{PA:20}"
msgstr "¿Dónde estás ahora?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_1_0"
msgid "Um,{PA:10} this is Yuki?{PA:20} From Vidal?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_1_1"
msgid "There's somebody I have to go meet now,{PA:10} but||after that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_1_2"
msgid "I was hoping you'd let me repay you for your||help earlier.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_1_4"
msgid "Huh?{PA:20} How did you know that.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_1_6"
msgid "In front of the drugstore.{PA:20} Oh,{PA:10} but I have to||go soon,{PA:10} or I'll be late.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:293_1_7"
msgid "I'll talk with you later.{PA:20}"
msgstr ""

