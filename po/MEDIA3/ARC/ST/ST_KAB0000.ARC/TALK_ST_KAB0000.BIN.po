msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_9_0"
msgid "Good to see you,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_10_0"
msgid "You there!{PA:20} You're pissing me off||by hanging out around here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_10_1"
msgid "I guess I'm gonna have to ||pound some sense into you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_11_0"
msgid "Huh!?{PA:20}"
msgstr "¡¿Eh?!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_12_0"
msgid "Sorry!{PA:20} I won't do it again!{PA:20}||Just take this!{PA:20} I won't do it again!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_12_1"
msgid "Received \"5❟000 yen\""
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_13_0"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr "Lo siento{PA:20}.{PA:20}..{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_14_0"
msgid "Hello!{PA:20}"
msgstr "¿Hola?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_15_0"
msgid "You don't look like you know who||we are!{PA:20} What's your business here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_15_1"
msgid "Sorry,{PA:10} but we're gonna have to fuck you up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_16_0"
msgid "Hey!{PA:20}"
msgstr "¡Oye!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_17_0"
msgid "S-Sorry!{PA:20} Th-This is for you.{PA:20}||Please,{PA:10} just take it.{PA:20}.{PA:20}.{PA:20}"
