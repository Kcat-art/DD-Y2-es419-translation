msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_26_0"
msgid "Hold up!{PA:20}"
msgstr "¡Espera!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_27_0"
msgid "Ow ow ow!{PA:20} I.{PA:20}.{PA:20}.{PA:20} I'm sorry!{PA:20}||This is all I got,{PA:10} take it.{PA:20}.{PA:20}.{PA:20}"
