msgid "Hi,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_20_0"
msgid "You're that Kiryu guy,{PA:10} right?{PA:20}||I'll show you why folks are afraid of me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_21_0"
msgid "Hey,{PA:10} buddy!{PA:20}"
msgstr "¡Ey!, ¿{PA:10}cómo andas?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_22_0"
msgid "M-My fault!{PA:20}||Here.{PA:20}.{PA:20}.{PA:20} From me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_22_1"
msgid "Received \"10❟000 yen\""
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_23_0"
msgid "I'm sorry.{PA:20}.{PA:20}.{PA:20} Leave me alone.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_24_0"
msgid "Hey,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0000.ARC/TALK_ST_KAB0000.BIN::line:285_25_0"
msgid "Hey,{PA:10} old man!{PA:20} Just because you're yakuza||doesn't mean you own the place!{PA:20}"
