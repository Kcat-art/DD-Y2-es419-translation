msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_9"
msgid "N-No!{PA:20} Nothing like that.{PA:20}.{PA:20}.{PA:20}||Well,{PA:10} I.{PA:20}.{PA:20}.{PA:20} I guess it's a little.{PA:20}.{PA:20}.{PA:20} weird.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_10"
msgid "I knew it!{PA:20} All right,{PA:10} boys,{PA:10} trash everything||in his bag!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_11"
