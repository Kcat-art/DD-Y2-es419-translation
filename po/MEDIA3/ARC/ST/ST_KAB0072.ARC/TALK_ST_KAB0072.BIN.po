msgid ".{PA:20}.{PA:20}.{PA:20}Take it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_28"
msgid "280.{PA:20}.{PA:20}.{PA:20} 290.{PA:20}.{PA:20}.{PA:20} 300,{PA:10}000 yen.{PA:20} Thank you kindly.{PA:20}||We'll be seeing you.{PA:20}"
