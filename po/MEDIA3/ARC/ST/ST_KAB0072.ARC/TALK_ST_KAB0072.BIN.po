msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_7"
msgid "Fine,{PA:10} if it's not skin flicks,{PA:10} then what?{PA:20}"
