msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_19"
msgid "That's life.{PA:20} Now get lost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0072.ARC/TALK_ST_KAB0072.BIN::line:290_1_20"
msgid "Yeah,{PA:10} you're right.{PA:20}"
