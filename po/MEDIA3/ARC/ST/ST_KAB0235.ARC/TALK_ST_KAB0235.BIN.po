msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_16"
msgid "Y-Ya don't mince yer words,{PA:10} do ya,{PA:10} bro?{PA:20}||Anyhow,{PA:10} sorry to get in yer face.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_21"
msgid "Name's Minamizawa.{PA:20}||You?{PA:20}"
