msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_31"
msgid "Ooh,{PA:10} or maybe aliens came 'n' messed with||his brain,{PA:10} beamed him up,{PA:10} and flew off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_32"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_33"
msgid "*Sigh*||Comedy's my life,{PA:10} ya know?{PA:20} What I wanna do.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_34"
msgid "Always dreamed of bein' a big act here.{PA:20}||We were serious.{PA:20} Really gave it all we had.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_35"
msgid "But now,{PA:10} with no partner.{PA:20}.{PA:20}.{PA:20}||Plus apparently my setups ain't funny.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_36"
msgid "I'm losin' my confidence,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_37"
msgid "Hey,{PA:10} tell me straight up,{PA:10} buddy.{PA:20}||Am I just not cut out for comedy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_38"
msgid "You can't just give up.{PA:20}||You've come this far.{PA:20} Try a little harder.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_39"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_40"
msgid "Yeah.{PA:20} I never been as serious as this about||anythin' else.{PA:20} I wanna keep going with it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_41"
msgid "Still,{PA:10} without a partner.{PA:20}.{PA:20}.{PA:20}||Hey,{PA:10} how 'bout it,{PA:10} pal?{PA:20} Pair up with me?{PA:20}"
msgstr ""

