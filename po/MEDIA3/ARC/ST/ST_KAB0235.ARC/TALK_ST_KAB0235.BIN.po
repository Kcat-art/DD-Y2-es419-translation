msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:0"
msgid "Kiryu"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:1"
msgid "Man"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:2"
msgid "Unknown Man"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:3"
msgid "Date"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:4"
msgid "Daigo"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:5"
msgid "Kaoru"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:6"
msgid "Haruka"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:7"
msgid "Il Yu-Jin"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:8"
msgid "Male Customer"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:9"
msgid "Female Staffer"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:10"
msgid "Minamizawa"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::name:11"
msgid "Bartender"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_0_0"
msgid "Man"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_1_1"
msgid "What?{PA:20} I haven't taken out any loans.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_1_3"
msgid "And just what do they plan to do?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_1_5"
msgid ".{PA:20}.{PA:20}.{PA:20}What the hell was that all about?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_0"
msgid "Hello?{PA:20}||Is this Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_1"
msgid "When do you plan on returning that 200K?{PA:20}||With interest,{PA:10} you're up to 401,{PA:10}000 now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_2"
msgid "Either you pay it back STAT,{PA:10} or you'll||start getting houseguests"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_3"
msgid "that start with a \"Y\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_4"
msgid "Don't say we didn't warn you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_6"
msgid "You think you're funny?{PA:20} Think you can||just walk off with our money?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_7"
msgid "Okay,{PA:10} buddy.{PA:20} I just put a yakuza dispatch||out on your ass.{PA:20} They'll be there soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_9"
msgid "Uh huh,{PA:10} no,{PA:10} just keep it up.{PA:20} It's all just a||big joke.{PA:20} You're history,{PA:10} pal.{PA:20} Game over!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_10"
msgid "You get us that money,{PA:10} NOW,{PA:10} or the yakuza"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:0_2_11"
msgid "are gonna eat you alive!{PA:20} *Click!{PA:20}*"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_0_0"
msgid "Yuya"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_1_1"
msgid "What's up?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_1_3"
msgid "401,{PA:10}000 yen?{PA:20}||Sounds like he and I are in the same boat.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_1_5"
msgid "Yeah.{PA:20} I didn't realize it was this bad.{PA:20}||Apparently they're running quite a racket.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_1_7"
msgid "I'll take care of this one.{PA:20}||You tell Takuma not to worry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_1_9"
msgid "Will do.{PA:20} Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_1_10"
msgid "(Morita the info dealer might know something||about these people.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_0"
msgid "Hello?{PA:20} Mr.{PA:20} Kiryu?{PA:20}||This is Yuya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_1"
msgid "There's something I wanted to ask you about.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_3"
msgid "One of the guys working here.{PA:20}.{PA:20}.{PA:20}||His name's Takuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_4"
msgid "He got scammed by a fake loan shark con and||lost 401,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_5"
msgid "I figured if anyone would know something||about it,{PA:10} you would.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_6"
msgid "Any guesses as to who's behind it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_8"
msgid "Wait,{PA:10} they're threatening you,{PA:10} too?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_10"
msgid "Seriously!{PA:20} I mean,{PA:10} it's partly||Takuma's own fault for"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_11"
msgid "falling for something like this.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_12"
msgid "But he worked hard for that money.{PA:20}||It kills me to see them just take it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_14"
msgid "You will?!{PA:20}||Oh,{PA:10} thank you,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:1_2_15"
msgid "If there's anything at all we can help with,{PA:10}||just give me a call.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:2_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:2_1_1"
msgid "Understood,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:2_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20}||You're on duty tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:2_2_1"
msgid "Come by the club,{PA:10} ASAP.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:3_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:3_1_1"
msgid "Understood,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:3_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20}||It's about time for your shift tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:3_2_1"
msgid "Head on in to the club.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:4_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:4_1_1"
msgid "Understood,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:4_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20}||It's almost time for your shift.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:4_2_1"
msgid "Come on down to the club.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:5_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:5_1_1"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:5_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20}||A customer's here who wants to see you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:5_2_1"
msgid "Get down here,{PA:10} ASAP.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:6_0_0"
msgid "Takaya"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:6_1_1"
msgid "(.{PA:20}.{PA:20}.{PA:20}Guess I should head to Adam.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:6_2_0"
msgid "It's me,{PA:10} Takaya from Adam.{PA:20}||I want a word with you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:6_2_1"
msgid "Get your ass over to Adam,{PA:10} pronto.{PA:20}||I'll be waiting.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:7_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:7_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20}||Everything's set for the big host-off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:7_2_1"
msgid "Get down to the club.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:8_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:8_1_1"
msgid "I'm sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:8_1_3"
msgid "I'll be right there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:8_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20} How long were you planning||on taking with that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:8_2_2"
msgid "Just come back inside,{PA:10} okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:9_0_0"
msgid "Masashi"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:9_2_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} sir!{PA:20}||It's me,{PA:10} Masashi!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:9_2_1"
msgid "Big trouble here at the club,{PA:10} sir!{PA:20}||Please,{PA:10} you've got to come by Marietta!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:10_0_0"
msgid "Masashi"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:10_2_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} sir!{PA:20}||It's me,{PA:10} Masashi!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:10_2_1"
msgid "Major crisis at the club,{PA:10} sir!{PA:20}||Please,{PA:10} you've got to come by Marietta!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:11_0_0"
msgid "Masashi"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:11_2_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} sir!{PA:20}||It's me,{PA:10} Masashi!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:11_2_1"
msgid "Big trouble here at the club,{PA:10} sir!{PA:20}||Please,{PA:10} you've got to come by Marietta!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:12_0_0"
msgid "Date"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:12_1_0"
msgid "Kiryu here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:12_1_2"
msgid "All right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:12_2_0"
msgid "It's me.{PA:20}||I just finished up preparations here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:12_2_1"
msgid "As soon as you're done there,{PA:10} come see me||back at \"{CC:ffc8c8}Serena{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:12_2_2"
msgid "There's something I need to tell you before||Sayama gets back into town.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:13_0_0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:13_2_0"
msgid "It's me,{PA:10} Kagami.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:13_2_1"
msgid "Things are ready for the big rematch.{PA:20}||We're ready for you here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:13_2_2"
msgid "Come down to the club,{PA:10} ASAP.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_1"
msgid "Is something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_3"
msgid "I see.{PA:20} So it hasn't been renovated since||I was there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_5"
msgid "How much will it cost?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_8"
msgid "Sorry,{PA:10} money has been a little tight for me||lately,{PA:10} too.{PA:20} I'm a little short.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_9"
msgid "I'll try to scrape it together.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_13"
msgid "All right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_14"
msgid ".{PA:20}.{PA:20}.{PA:20}All right.{PA:20}||I'll try to scrape it together.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_0_16"
msgid "All right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_0"
msgid "Mr.{PA:20} Kiryu?{PA:20}||This is Ms.{PA:20} Suenaga,{PA:10} from Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_2"
msgid "Oh,{PA:10} Mr.{PA:20} Kiryu.{PA:20} Our roof is leaking!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_3"
msgid "It's over 30 years old,{PA:10} so I suppose||it's little wonder,{PA:10} but still.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_5"
msgid "No,{PA:10} I'm afraid not.{PA:20}||We've been trying to get it fixed,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_6"
msgid "but the money just isn't there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_7"
msgid "Mr.{PA:20} Kiryu,{PA:10} it kills me to ask after||you've done so much,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_8"
msgid "but can you fund the repairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_10"
msgid ".{PA:20}.{PA:20}.{PA:20}250,{PA:10}000 yen.{PA:20} There's just no way||I can scrounge up"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_11"
msgid "such a large sum,{PA:10} sir.{PA:20} Please!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_14"
msgid "Oh,{PA:10} thank you,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_15"
msgid "I can accept it here,{PA:10} or via ATM transfer.{PA:20}||Whichever is easier for you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_16"
msgid "Oh,{PA:10} I understand.{PA:20} But think of the kids!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_17"
msgid "I'm afraid the poor dears will all catch||colds at this rate.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_20"
msgid "Oh,{PA:10} thank you,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:14_1_21"
msgid "I can accept it here,{PA:10} or via ATM transfer.{PA:20}||Whichever is easier for you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_0_1"
msgid "⋯⋯どうした？{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_0_3"
msgid "Five million yen!?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_0_5"
msgid "Wait,{PA:10} he made repairs on things you didn't||ask him to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_0_7"
msgid "You just tell him to give me a call.{PA:20}||I'll straighten him out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_0"
msgid "Hello,{PA:10} Mr.{PA:20} Kiryu?{PA:20}||Terrible news,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_2"
msgid "Well,{PA:10} sir,{PA:10} we just got the bill for those||roof repairs from before.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_3"
msgid "Mr.{PA:20} Kiryu,{PA:10} it's for 5,{PA:10}000,{PA:10}000 yen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_5"
msgid "His quote before was only 250,{PA:10}000 yen!{PA:20}||I asked about the difference,{PA:10} of course.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_6"
msgid "But he said it was for repairs on all the||other spots that were falling apart.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_8"
msgid "Apparently so,{PA:10} yes.{PA:20} The foundation,{PA:10} for one.{PA:20}||At least,{PA:10} so he says.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_9"
msgid "It took a miracle to get that first 250,{PA:10}000.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:15_1_11"
msgid "S-Sir?{PA:20} .{PA:20}.{PA:20}.{PA:20}I will.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_0_1"
msgid "She'll pay for the work she contracted.{PA:20}||Your quote was for 250,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_0_3"
msgid "Without their knowledge or permission.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_0"
msgid "Hello?{PA:20} I'm with Imitation Renovating.{PA:20}||The Suenaga lady told me to call you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_1"
msgid "You the guy who's gonna pay that 5 mil||she owes for all those repairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_3"
msgid "Ha ha!{PA:20} We been gettin' a lot of||you people lately.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_4"
msgid "Think you can weasel out of a bill.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_5"
msgid "We made those repairs so's those orphans||would be safe,{PA:10} you hear me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_7"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_8"
msgid "Perhaps you'd understand the situation more||clearly if we spoke in person.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:16_1_9"
msgid "Let's meet up and talk,{PA:10} you and I.{PA:20}||I think you'll get the picture then.{PA:20}"
