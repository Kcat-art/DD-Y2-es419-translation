msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_11"
msgid "What?{PA:20} .{PA:20}.{PA:20}.{PA:20}I don't think so.{PA:20}"
