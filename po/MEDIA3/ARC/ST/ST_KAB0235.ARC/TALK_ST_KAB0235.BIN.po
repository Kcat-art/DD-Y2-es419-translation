msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_43"
msgid "Just kiddin',{PA:10} bro.{PA:20} Don't worry about it.{PA:20}"
msgstr ""

