msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_24"
msgid "Me 'n' a buddy o' mine,{PA:10} Kitagawa.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_25"
msgid "We used to be a comedy duo,{PA:10} performin'||as the \"Mars Fighters\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_26"
msgid "I was the funny man to his straight guy.{PA:20}||Never went anywhere,{PA:10} so I doubt ya know us.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_27"
msgid "Anyhow,{PA:10} the Grand Prix o' Gags is comin' up.{PA:20}||I was set to enter.{PA:20} Gotta prove ourselves.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_28"
msgid "But Kitagawa said we was over.{PA:20}||Now he's disappeared.{PA:20} No clue where he's at.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_29"
msgid "Boy had more porn at his place 'n' you could||imagine.{PA:20} Maybe the CIA carted him off.{PA:20}"
