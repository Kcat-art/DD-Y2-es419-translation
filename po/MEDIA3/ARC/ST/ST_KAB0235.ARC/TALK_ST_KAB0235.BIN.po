msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_10"
msgid "Hey,{PA:10} c'mon,{PA:10} don't leave me hangin'!{PA:20} Ain't||comedy if ya don't play the straight man!{PA:20}"
