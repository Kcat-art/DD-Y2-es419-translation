msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_46"
msgid "There's more to life than comedy,{PA:10} you know.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_47"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}||Yeah,{PA:10} you're right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_48"
msgid "Maybe it's fate.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_1_0"
msgid "Nnnngh!{PA:20}||My head!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:294_0_0"
msgid "Maybe I should quit.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:295_0_0"
msgid "Bartender!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:296_0_0"
msgid "This cocktail ROCKS!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:297_0_0"
msgid "Sir,{PA:10} behind the bar||is off limits.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_1"
msgid "Welcome to Stijl.{PA:20}||What can I get for you,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_4"
msgid "Sir,{PA:10} I think you've had enough.{PA:20}||I recommend you stop there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_5"
msgid "Freshen up your drink,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_6"
msgid "I see.{PA:20}||We look forward to your next visit,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_9"
msgid "The finest product to come out of the||Hakushu refinery may be this 18-year.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_10"
msgid "You're simply not going to find a deeper||flavor than this long-matured malt offers.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_11"
msgid "It's also famous for using spring water from||the Japanese alps,{PA:10} rich in minerals.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_12"
msgid "I'd say it rivals Yamazaki as the||representative single malt from Japan.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_16"
msgid "They make that with mountain spring water at||Suntory's Hakushu distillery in the heart of"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_17"
msgid "the Japanese alps,{PA:10} so the taste is divine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_18"
msgid "Its distinctly creamy yet fruity feel sets||it apart from other Japanese whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_19"
msgid "I recommend taking the first drink straight||up,{PA:10} for a pleasantly robust kick.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_20"
msgid "It also complements Japanese food well.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_24"
msgid "I can wholeheartedly recommend that bottle.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_25"
msgid "It often takes the gold at competitions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_26"
msgid "Famously finicky critics the world over all||agree that it means business,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_27"
msgid "The rich,{PA:10} elegant taste has been likened to||the grandest sports cars.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_28"
msgid "It's even been called queen among single-||malt whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_29"
msgid "Whiskey doesn't get much finer,{PA:10} sir.{PA:20}||It's well worth the price.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_33"
msgid "That's the standard model Macallan,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_34"
msgid "It's perfect for those patrons looking to||try the luxury line on a more casual basis.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_35"
msgid "Even as \"just\" the standard model,{PA:10} this is||an exceptionally fine liquor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_36"
msgid "I urge you to try its sweet,{PA:10} full flavor and||bouquet for yourself.{PA:20} Taste the quality.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_40"
msgid "This 30-year is probably the finest specimen||of the Laphroaig line on the market.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_41"
msgid "Despite its long maturation time,{PA:10} it offers||a fresh,{PA:10} well-balanced flavor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_42"
msgid "I'd recommend it,{PA:10} even to those who find the||Laphroaig's usual kick a bit overpowering.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_43"
msgid "Its exceptional character has won it many||an award for best malt whiskey in the past.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_47"
msgid "It's safe to call this 10-year Laphroaig the||standard of the line.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_48"
msgid "It's characterized by a potent,{PA:10} smoky flavor||and a smooth,{PA:10} dry body.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_49"
msgid "It has more than its share of quirks,{PA:10} so||most people either love it or hate it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_50"
msgid "If you're on the love side of that,{PA:10} though,{PA:10}||it'll be a drink you never forget.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_54"
msgid "Sherry wood barrels lend that whiskey its||uniquely ripe,{PA:10} floral overtones.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_55"
msgid "The special blend of sea plants unique to||Islay give it a perfectly balanced salinity.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_56"
msgid "It's known as the queen of Islay.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_57"
msgid "That's the standard model Bowmore.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_58"
msgid "It stands a cut above the rest of the||single-malt 12-years,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_62"
msgid "The 30-year bottle stands at the pinnacle of||the Glenfiddich line.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_63"
msgid "It retains the family's fruity sweetness||while adding a fullness only time can bring.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_64"
msgid "It is a truly special bottle of whiskey.{PA:20}||The day you open it IS the special occasion.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_65"
msgid "Only so many are bottled each year,{PA:10} so their||market value is considerable.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_66"
msgid "It's pricey,{PA:10} but never disappoints.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_70"
msgid "This rectangular bottle's probably the most||popular whiskey in Japan,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_71"
msgid "Some call it the father of Japanese whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_72"
msgid "Its popularity shows no signs of dropping,{PA:10}||even 70 years after it first debuted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_73"
msgid "Its flavor is perfectly balanced.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_74"
msgid "The container's shape is so characteristic,{PA:10}||some people refer to the drink by it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_78"
msgid "That's the face of American whiskey,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_79"
msgid "A simple,{PA:10} clear taste and mellow,{PA:10} warm aroma||are its defining features.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_80"
msgid "It's made in Tennessee,{PA:10} in the States.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_81"
msgid "Between that,{PA:10} and the charcoal mellowing||process it undergoes.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_82"
msgid "It qualifies as Tennessee whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_83"
msgid "Still,{PA:10} most people seem to consider it a||bourbon,{PA:10} for whatever reason.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_87"
msgid "People have been loving that one since the||day it first came out in 1860.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_88"
msgid "It's practically synonymous with bourbon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_89"
msgid "The flavor is very American--silky to the||tongue but with a sharp,{PA:10} clean finish.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_90"
msgid "The modest price also makes it a wonderful||choice for a casual evening drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_94"
msgid "That's a mature,{PA:10} full-grape brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_95"
msgid "It's got that rich,{PA:10} dense brandy flavor and||bouquet you can really sink your teeth into.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_96"
msgid "The finish is wonderful,{PA:10} too.{PA:20} I drink this||stuff at home all the time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_97"
msgid "You can drink it straight or on the rocks,{PA:10}||cut it with water,{PA:10} cut it with tonic.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_98"
msgid "It's the only brandy you'd ever need.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_102"
msgid "That's one of Japan's top brandies.{PA:20} Many||people agree it offers a sublime taste.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_103"
msgid "It's a best-selling liquor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_104"
msgid "If you're curious about the V.S.O.P.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_105"
msgid "It stands for Very Superior Old Pale.{PA:20}||There are several classifications for"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_106"
msgid "brandies,{PA:10} as you may know.{PA:20}||V.S.O.P is the finest of those.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_107"
msgid "It also works well cut with fruit juice.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_111"
msgid "That's a nice,{PA:10} affordable brandy.{PA:20} Perfect||for a casual night's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_112"
msgid "The bouquet is clean and sharp,{PA:10} and the||fruity flavor of fresh grapes comes through.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_113"
msgid "It's got a nice,{PA:10} crisp finish,{PA:10} too,{PA:10} making||it very easy to drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_114"
msgid "You can drink it as brandy,{PA:10} or use it as the||base for a cocktail.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_115"
msgid "It's a good,{PA:10} strong specimen I'd recommend||to anyone looking to try out brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_119"
msgid "That one won Japan's first world title,{PA:10} then||held that title the following year.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_120"
msgid "It's a top-class beer by Japanese.{PA:20}.{PA:20}.{PA:20} no,{PA:10} by||world standards.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_121"
msgid "Unbending commitment to quality ingredients||and Suntory's impressive know-how combine to"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_122"
msgid "yield this delicious,{PA:10} almost magical flavor.{PA:20}||It's a thing of beauty,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_123"
msgid "A glass of this,{PA:10} while nibbling sashimi.{PA:20}.{PA:20}.{PA:20}||That right there is the life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_127"
msgid "That's Suntory's major draft beer.{PA:20} I really||don't know what more needs to be said.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_128"
msgid "Suntory is picky about everything they put||into their drinks,{PA:10} but especially the water.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_129"
msgid "Their careful use of natural spring water||really lets the other ingredients sing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_130"
msgid "That keeps the flavor clean,{PA:10} so it's easy to||drink,{PA:10} and the finish is crisp and tasty.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_131"
msgid "You could go all night on these.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_135"
msgid "That's a prime example of Korean soju.{PA:20}||A spring-water base gives it a clean taste,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_136"
msgid "while premium Korean barley gives it a||mellow and rounded feel.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_137"
msgid "The price is also quite reasonable.{PA:20} I'd say||it offers excellent value for the price.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_138"
msgid "There was a time this was all I'd drink.{PA:20}||These days,{PA:10} its taste is like an old friend.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_139"
msgid "The history only makes it all the sweeter.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_143"
msgid "That's a premium Russian vodka; a winner of||several awards at international expositions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_144"
msgid "It boasts a mild flavor and delicate aroma||that hold fans worldwide enthralled.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_145"
msgid "In case you were curious,{PA:10} Stolichnaya means||\"capital\" in Russian.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_146"
msgid "It's a winner,{PA:10} no matter how you drink it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_150"
msgid "That's another extremely popular Japanese||whiskey,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_151"
msgid "The unique influence of Yamazaki sherry wood||barrel aging has won it a lot of fans.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_152"
msgid "It just might be the line that best defines||Suntory's whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_0_153"
msgid "A lot of people call it \"Dharma\",{PA:10} because||the round shape looks like a daruma doll.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_1_0"
msgid "Welcome!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_2_0"
msgid "Good evening,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_2_1"
msgid "Do you have any almonds?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_2_2"
msgid "Hmm?{PA:20} Yes,{PA:10} we do,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_2_3"
msgid "How much for one?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:298_2_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

