msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_12"
msgid "*Sigh*||No good.{PA:20}.{PA:20}.{PA:20} It's no good!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_13"
msgid "Naw,{PA:10} I ain't sayin' you're no good,{PA:10} buddy.{PA:20}||It's me.{PA:20}.{PA:20}.{PA:20} Just ain't cut out for humor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0235.ARC/TALK_ST_KAB0235.BIN::line:291_0_14"
msgid "I can't get sharp comebacks outta folks 'cause||my setups are lame.{PA:20} That must be it.{PA:20}"
