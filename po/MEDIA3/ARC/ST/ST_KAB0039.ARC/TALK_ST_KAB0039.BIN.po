msgid "I'd say on the order of 30,{PA:10}000 yen.{PA:20}.{PA:20}.{PA:20}||Are you sure?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_1_26"
msgid "Well,{PA:10} hop in!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_1_28"
msgid "Sure,{PA:10} you say that,{PA:10} but look at you!{PA:20}||You don't have the money,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_3"
msgid "{PA:24}Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_4"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20} {PA:32}It's me,{PA:10} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_5"
msgid "Daigo!{PA:20} {PA:8}Are you all right?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_6"
msgid "Yeah,{PA:10} I'm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_7"
msgid "Mr.{PA:20} Kazuma Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_8"
msgid "Who is this?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_9"
msgid "You'll find out soon enough.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_10"
msgid "If you wish to keep Daigo Dojima alive.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_11"
msgid "You'll meet me at one a.{PA:20}m.{PA:20} tomorrow night.{PA:24}{PA:20}||Come to the {MS:0}\"{CC:ffc8c8}Amano Building{CR:00}\" here in town.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_12"
msgid "The \"{CC:ffc8c8}Amano Building{CR:00}\"?{PA:20}||{PA:75}And what about Chairman Goda?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_13"
msgid "You'll understand when you arrive.{PA:60}{PA:20}||Of course,{PA:10} you're to come alone.{PA:20} {PA:27}Am I clear?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_14"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_2_15"
msgid "Very good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_3_0"
msgid "(Tomorrow at one a.{PA:20}m.{PA:20},{PA:10} the Amano Building.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_3_1"
msgid "(Well,{PA:10} I should head to Tojo Clan||Headquarters now.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_6_0"
msgid "No,{PA:10} Mr.{PA:20} Kiryu,{PA:10} let's walk.{PA:20}||I want to see the city as we go,{PA:10} okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_0"
msgid "(The guy who beat Komaki is supposed to be||waiting for me at the pier.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_4"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_5"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_6"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_7"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_8"
msgid "South end of Nakamichi Street,{PA:10} sir?{MS:0}{PA:20}||I'm ready when you are.{PA:20} Just hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_10"
msgid "East end of Park Boulevard,{PA:10} sir?{MS:0}{PA:20}||I'm ready when you are.{PA:20} Just hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_12"
msgid "I hope to serve you at another time,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_13"
msgid "Tojo Headquarters.{PA:20}.{PA:20}.{PA:20}?{MS:0}{PA:20}||I won't ask any questions,{PA:10} sir.{PA:20} Hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_22"
msgid "Police Headquarters?{PA:20} Everything all right,{PA:10}{MS:0}{PA:10}||sir?{PA:20} In any case,{PA:10} hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_24"
msgid "Sotenbori?{PA:20} That'll be a bit pricey,{PA:10} sir!{PA:10}{MS:0}{PA:20}||If you're sure,{PA:10} hop on in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_8_26"
msgid "To the pier,{PA:10} sir?{PA:10}{MS:0}{PA:20}||I'm ready when you are.{PA:20} Just hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_0"
msgid "(The guy who beat Komaki is supposed to be||waiting for me at the pier.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_1"
msgid "(If he took down the old guy,{PA:10} he's strong.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_2"
msgid "(I shouldn't drag anyone else into this.{PA:20}||They might get hurt.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_3"
msgid "(I'll go to the pier when I'm alone.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_7"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_8"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_9"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_10"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_11"
msgid "South end of Nakamichi Street,{PA:10} sir?{MS:0}{PA:10}{PA:20}||I'm ready when you are.{PA:20} Just hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_13"
msgid "East end of Park Boulevard,{PA:10} sir?{MS:0}{PA:10}{PA:20}||I'm ready when you are.{PA:20} Just hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_15"
msgid "I hope to serve you at another time,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_16"
msgid "Tojo Headquarters.{PA:20}.{PA:20}.{PA:20}?{PA:10}{MS:0}{PA:20}||I won't ask any questions,{PA:10} sir.{PA:20} Hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_25"
msgid "Police Headquarters?{PA:20} Everything all right,{PA:10}{MS:0}{PA:10}||sir?{PA:20} In any case,{PA:10} hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_27"
msgid "Sorry,{PA:10} it sounded like you said \"Sotenbori\".{PA:20}||.{PA:20}.{PA:20}.{PA:20}You're serious?!{PA:20} It'll cost you,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_28"
msgid "I'd say on the order of 30,{PA:10}000 yen.{PA:20}.{PA:20}.{PA:20}||Are you sure?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_30"
msgid "Well,{PA:10} hop in!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:287_9_32"
msgid "Sure,{PA:10} you say that,{PA:10} but look at you!{PA:20}||You don't have the money,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_0_0"
msgid "The door is locked.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_0_1"
msgid "We'd better go find this boss kid and try||to get the key from him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_1_0"
msgid "This should be the Amano Building.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_1_1"
msgid "?!{PA:20}||It's locked.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_2_0"
msgid "The door is unlocked.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_2_1"
msgid "I'll go alone from here.{PA:20}||You wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:288_2_2"
msgid "Fine.{PA:20}||If something comes up,{PA:10} call me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:289_0_1"
msgid "Hey!{PA:20} You're with those assholes inside,{PA:10}||aren't you?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:289_0_2"
msgid "What are you talking about?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:289_0_3"
msgid "Don't play dumb!{PA:20}||Get him,{PA:10} boys!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:289_0_4"
msgid "Yarr!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_1"
msgid "Huff.{PA:20}.{PA:20}.{PA:20} huff.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_2"
msgid "What the hell is going on?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_3"
msgid "This place.{PA:20}.{PA:20}.{PA:20} The Amano Building is.{PA:20}.{PA:20}.{PA:20}||WAS our hideout.{PA:20}.{PA:20}.{PA:20}.{PA:20} Huff.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_4"
msgid "Then these crazy quacking foreigners||showed up.{PA:20}.{PA:20}.{PA:20} Y-You're not with them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_5"
msgid "No.{PA:20} So you kids had your secret fort taken||over by some bullies,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_6"
msgid "Where's the key to this place?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_7"
msgid "I don't have one.{PA:20}||The boss has a spare,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_8"
msgid "Where is he?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_9"
msgid "In the alley behind the drugstore,{PA:10} usually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_10"
msgid "I doubt he'll just hand over his key to you,{PA:10}||though,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_11"
msgid "Judging from the looks of you kids,{PA:10} he just||might.{PA:20} Either way,{PA:10} I'm going to get it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_12"
msgid "We'll see what the boss has to say,{PA:10} asshole.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_13"
msgid "Let's go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_0_14"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_1_0"
msgid "If you're looking for the boss,{PA:10} he's prolly||back in the alley behind the drugstore.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:290_1_1"
msgid "I doubt he'll just hand over his key to you,{PA:10}||though,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_0"
msgid "He needs medical attention,{PA:10} fast.{PA:20}||Where's the nearest hospital?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_1"
msgid "A friend of mine is a doctor.{PA:20}||Let's carry him there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_2"
msgid "The police are all over the city.{PA:20}||You can't just march out there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_3"
msgid "We don't have much choice here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_4"
msgid "If we wait for them to pack it in,{PA:10} we could||lose Kazuki!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_5"
msgid "Look,{PA:10} I realize that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_6"
msgid ".{PA:20}.{PA:20}.{PA:20}But if the police spot you,{PA:10} you're going||to have a hell of a time explaining this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_7"
msgid "You're right.{PA:20}.{PA:20}.{PA:20}||It's true that we stick out like this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_8"
msgid "So,{PA:10} what do we do?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_9"
msgid ".{PA:20}.{PA:20}.{PA:20}I've got an idea.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_10"
msgid "What's that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_11"
msgid "For starters,{PA:10} I'll get the attention of the||officers just outside.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_12"
msgid "I'll be fine even if they question me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_13"
msgid "I'll keep them occupied as long as I can.{PA:20}||You guys head out the other way.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_14"
msgid "Think you can pull it off?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_15"
msgid "We'll find out.{PA:20}||I'll meet you at the clinic.{PA:20} Where is it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_16"
msgid "At the {MS:0}\"{CC:ffc8c8}west end of Taihei Boulevard{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:295_0_17"
msgid "Okay.{PA:20} I'll see you there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:299_0_0"
msgid "(Sayama's distracting the police for us.{PA:20}||Let's head in the other direction.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:300_0_0"
msgid "(Sayama's distracting the police for us.{PA:20}||Let's head in the other direction.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:301_0_0"
msgid "(Sayama's distracting the police for us.{PA:20}||Let's head in the other direction.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:308_0_0"
msgid "[Shouting in Korean]"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:308_0_1"
msgid "Not again!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:308_1_0"
msgid ".{PA:20}.{PA:20}.{PA:20}!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:309_0_0"
msgid "N-Nngh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:309_0_1"
msgid "I'm surprised to see they've called in this||many Jingweon members.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:309_0_2"
msgid "I guess they mean business.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:309_1_0"
msgid "N-Nngh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:310_0_1"
msgid "So there was a shooting at that building||yesterday,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:310_0_2"
msgid "Just after that,{PA:10} I spotted four blood-soaked||people running down the street.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:310_0_3"
msgid "Do you think they were behind it all?{PA:20}||I should have gotten a better look at them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_0_0"
msgid "Now,{PA:10} how about that fee?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_0_1"
msgid "Hmph!{PA:20} How about I just finish the job now?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_0"
msgid "I-I'm sorry!{PA:20} I'll pay,{PA:10} I'll pay!{PA:20}||Just don't kill me,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_1"
msgid "         You received 200,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_3"
msgid "So what was in the box?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_4"
msgid "I-It was a hidden camera setup I made.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_5"
msgid "I couldn't get it done before the deadline.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_6"
msgid "My client would have killed me,{PA:10} so I had||you deliver it for me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_7"
msgid "I'm sorry,{PA:10} man!{PA:20} No harm done,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:311_1_8"
msgid "Received 1❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_0"
msgid "Tonight was the best night ever.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_1"
msgid "If you ever come to my country,{PA:10} Mr.{PA:20} Kiryu,{PA:10}||I would be happy to show you around,{PA:10} too!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_2"
msgid "Thanks,{PA:10} I'll look forward to that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_3"
msgid "This is my thank you for everything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_4"
msgid "        You received 300,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_5"
msgid "Here,{PA:10} take this too!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_6"
msgid "         You received an Il Yu-Jin||          \"{CC:ffffc8}signed publicity photo{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_8"
msgid "Please be well,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Let's meet again some day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_9"
msgid "Sure.{PA:20} I'll see you around.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:312_0_11"
msgid "Received 3❟500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:313_0_3"
msgid "What is it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:313_0_4"
msgid "I'm presently pursuing plans to pen a piece||of poignant prose set here in Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:313_0_5"
msgid "I've searched long and hard for some sign,{PA:10}||a spark to suggest a salient subject.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:313_0_6"
msgid "I'm considering the cries of our children.{PA:20}||I want something that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0039.ARC/TALK_ST_KAB0039.BIN::line:313_0_7"
msgid "That addresses the ails of our age.{PA:20}||The yelling of our youth,{PA:10} \"This is me!{PA:20}\""
