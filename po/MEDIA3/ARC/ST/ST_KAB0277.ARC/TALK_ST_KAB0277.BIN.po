msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_2_5"
msgid "Yeah,{PA:10} I'll make it.{PA:20} I might not be a rock||like you,{PA:10} but I can still take a beating.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:28_2_7"
msgid "I've got it covered.{PA:20}||Later.{PA:20}"
msgstr ""

