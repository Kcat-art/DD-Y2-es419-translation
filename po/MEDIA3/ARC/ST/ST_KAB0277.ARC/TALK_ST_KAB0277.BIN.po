msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_0"
msgid "What's going on here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_1"
msgid "Huff.{PA:20}.{PA:20}.{PA:20} haa.{PA:20}.{PA:20}.{PA:20} Some weird guy.{PA:20}.{PA:20}.{PA:20}||Said.{PA:20}.{PA:20}.{PA:20} Said he'd email me with a job.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_2"
msgid "The email said to bury the guy who comes up||and asks me how many bells I need.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_3"
msgid "He said my fee was the cash that guy would||have on him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_4"
msgid "So he fooled you,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_5"
msgid "What?!{PA:20}||What does that mean?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_6"
msgid "The same guy sent me a job by email.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_7"
msgid "Saying that I should go up to the man with a||beard and ask how many bells he needed.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_8"
msgid "That he would pay me my fee.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_9"
msgid "What?{PA:20} But that's.{PA:20}.{PA:20}.{PA:20} I don't.{PA:20}.{PA:20}.{PA:20}||I don't have any money!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_10"
msgid "I don't have any money for you,{PA:10} either.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_11"
msgid "He never planned on paying either of us.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_12"
msgid "He was probably just stringing you along to||try to shut me up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:290_2_13"
msgid "Wh-What?!{PA:20} That bastard tricked me!{PA:20}||Well,{PA:10} shit!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:291_0_0"
msgid "(I'd better look for the email guy.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_0"
msgid "Gimme your best,{PA:10} guy!{PA:20} C'mon!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_1"
msgid "Uh.{PA:20}.{PA:20}.{PA:20} Sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_2"
msgid "I challenge you!{PA:20} If you lose,{PA:10} you close up||shop here.{PA:20} You got the balls?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_3"
msgid "Wh-What?!{PA:20} Sir,{PA:10} I'm afraid I don't follow.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_4"
msgid "It's a duel,{PA:10} man!{PA:20} A duel!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_5"
msgid "Now tell me who I'm up against!{PA:20}||{MS:0}If you've got nobody,{PA:10} I win by default!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_0_6"
msgid "Y-You can't be serious.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_1_0"
msgid "Bring it on!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_0"
msgid "What's the problem here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_1"
msgid "Huh?{PA:20}||{MS:3}{MS:2}{MS:1}{MS:0}You the top dog around here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_2"
msgid "What are you going on about?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_3"
msgid "They're from Sparkling Alleys,{PA:10} the new||bowling place that opened up in town.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_4"
msgid "We're not the first place they've tried to||close down with this nonsense.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_5"
msgid "Please,{PA:10} sir!{PA:20} Our top league player's out now||with a sprained wrist.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_6"
msgid "We've got nobody who can take them down.{PA:20}||Will you do it?{PA:20} Please?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_8"
msgid "Sure,{PA:10} I'm game.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_9"
msgid "Then let's get our bowl on!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_11"
msgid "Sorry,{PA:10} but I'm not a big bowler.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0277.ARC/TALK_ST_KAB0277.BIN::line:292_2_12"
