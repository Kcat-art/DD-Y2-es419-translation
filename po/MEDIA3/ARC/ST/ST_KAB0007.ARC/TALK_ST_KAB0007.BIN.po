msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_1"
msgid "Fine.{PA:20}"
msgstr "Bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_2"
msgid "Sorry,{PA:10} but you should go on ahead.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_3"
msgid "I can't just walk around looking like this.{PA:20}||I'll go find some other pants.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_4"
msgid "Will you be okay on your own?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_5"
msgid "I'll be fine.{PA:20}||I'll see you guys at Bantam.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_6"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_1"
msgid "I never thought we'd run into TWO Kazukis||up there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_2"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} What's going on?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_3"
msgid "We shouldn't mention any of this to Yuya||and the Stardust crew just yet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_4"
msgid "Yeah,{PA:10} it's too soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_5"
msgid "As it stands,{PA:10} we still don't know a damn||thing about Kazuki's double.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_6"
msgid "We'd only make them worry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_7"
msgid "Right.{PA:20} Or worse,{PA:10} we might drag Yuya into||this mess.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_8"
msgid "He's been promoted to manager there.{PA:20} I'm||sure he can hold down the fort on his own.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_9"
msgid "I feel bad,{PA:10} but let's keep him out of this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_10"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_11"
msgid "Mr.{PA:20} Kiryu!{PA:20} Mr.{PA:20} Date!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_15"
msgid "Yuya?!{PA:20}"
msgstr "¡Yuya!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_16"
msgid "How did you know we were here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_17"
msgid "One of our regulars just told me she saw a||man who looked like Kazuki.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_18"
msgid "She said she saw him get carried in here!{PA:20}||I came running.{PA:20}.{PA:20}.{PA:20} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_19"
msgid "What happened?{PA:20}||Is Kazuki going to be all right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_20"
msgid "Kazuki's in surgery now.{PA:20}||He was shot.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_21"
msgid "Shot?{PA:20} Why would anyone shoot Kazuki?{PA:20}||Has he gotten mixed up in something?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_22"
msgid "He.{PA:20}.{PA:20}.{PA:20}"
msgstr "H{PA:20}e{PA:20}{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_23"
msgid "Some yakuza were going at it in the||street,{PA:10} being idiots.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_24"
msgid "Kazuki was unlucky.{PA:20} He got hit by a stray||bullet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_25"
msgid "Wh-What?!{PA:20}||Where the hell are those yakuza now?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_26"
msgid "I'll beat the shit out of them for what||they did!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_27"
msgid "Calm down,{PA:10} Yuya!{PA:20}"
msgstr "¡Cálmate,{PA:10} Yuya!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_28"
msgid "But.{PA:20}.{PA:20}.{PA:20}!{PA:20}"
msgstr "¡Pero{PA:20}.{PA:20}..{PA:20}!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_29"
msgid "Date was just telling me you've been named||manager of the Stardust,{PA:10} Yuya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_30"
msgid "Y-Yes.{PA:20}.{PA:20}.{PA:20}"
msgstr "S-sí, seño{PA:20}r.{PA:20}..{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_31"
msgid "You're responsible for the other boys,{PA:10} and||for your customers.{PA:20}.{PA:20}.{PA:20} Now calm down.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_32"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_33"
msgid "Kazuki's in bad shape.{PA:20} We don't know how||long it'll take for him to recover.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_34"
msgid "Exactly.{PA:20} Kazuki needs you to be strong now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_35"
msgid "You'll have to keep the boys at the club||together in his stead for a while.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_36"
msgid "Mr.{PA:20} Date.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_37"
msgid "Kazuki will pull through.{PA:20} You just||worry about the Stardust for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_38"
msgid ".{PA:20}.{PA:20}.{PA:20}You're right.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} Tienes razón.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_39"
msgid "I think even after my promotion,{PA:10} I was||relying on Kazuki for everything.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_40"
msgid "But I guess that needs to end.{PA:20}||I've got to pull it together.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_41"
msgid "Thank you both.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_42"
msgid "I'll do my best to keep the Stardust||running while he's recovering.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_46"
msgid "Phew.{PA:20}.{PA:20}.{PA:20}||I guess that's good for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_47"
msgid "We can fill him in on everything once we've||figured it out ourselves.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_48"
msgid "Right.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:287_0_49"
msgid "All right,{PA:10} let's head to Bantam before there||are any other interruptions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:291_0_4"
msgid "Huh?!{PA:20}||What's wrong with them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:291_0_5"
msgid "Oh,{PA:10} you know how it is.{PA:20}||They just drank a little too much.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:291_0_6"
msgid "Uh huh.{PA:20}.{PA:20}.{PA:20} Have you seen anyone suspicious||around here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:291_0_7"
