msgctxt "MEDIA3/ARC/ST/ST_KAB0007.ARC/TALK_ST_KAB0007.BIN::line:286_0_0"
msgid "Let's head to {MS:0}\"{CC:ffc8c8}Bantam{CR:00}\".{PA:20}"
