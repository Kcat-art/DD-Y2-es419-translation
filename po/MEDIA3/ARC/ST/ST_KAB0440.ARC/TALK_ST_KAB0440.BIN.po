msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_73"
msgid "I do impressions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_74"
msgid "Impressions?{PA:20}||That's kinda cliché,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_75"
msgid "A host is judged by his individuality.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_76"
msgid "If you can't get them to fall in love with||you as an individual,{PA:10} they won't shell out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_77"
msgid "Work on standing out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_78"
msgid "I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_79"
msgid "I do spot gags.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_80"
msgid "Where do they get virgin wool?{PA:20} Ugly sheep.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_81"
msgid "You just crossed about three lines.{PA:20}.{PA:20}.{PA:20}||Don't say \"virgin\",{PA:10} don't EVER say \"ugly\",{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_82"
msgid "and sheep sex.{PA:20}.{PA:20}.{PA:20} I won't even get into.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_83"
msgid ".{PA:20}.{PA:20}.{PA:20}Understood.{PA:20}"
msgstr "E{PA:20}{PA:20}n{PA:20}tendido.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_84"
msgid "I can make a woman hot.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_85"
msgid "I think you've got the wrong idea there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_86"
msgid "The idea isn't to land the woman.{PA:20} It's to||keep her strung along,{PA:10} always wanting more.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_87"
msgid "Push her too hard and she'll peak early.{PA:20}||You need to keep her having fun,{PA:10} not hot.{PA:20}"
