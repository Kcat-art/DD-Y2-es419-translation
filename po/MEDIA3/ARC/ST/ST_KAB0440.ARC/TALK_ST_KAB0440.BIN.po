msgid "That settles everything,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_2_4"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_2_5"
msgid "Then let's get back to work.{PA:20} It's going||{MS:0}to take teamwork to save this club.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_2_6"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_2_7"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_0"
msgid "Good morning,{PA:10} Mr.{PA:20} Kiryu,{PA:10} sir!{PA:20}||Ready for another good day's work?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_1"
msgid "Now that we have another girl on staff,{PA:10} we||can open up for business again tonight!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_2"
msgid "I'd like to ask you to plan the club setup||here with me now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_3"
msgid "Let me walk you through it,{PA:10} sir.{PA:20} It's really||pretty straightforward.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_4"
