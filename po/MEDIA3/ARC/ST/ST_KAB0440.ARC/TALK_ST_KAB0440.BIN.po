msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_2"
msgid "Mr.{PA:20} Kiryu!{PA:20} You have GOT to fire this bitch.{PA:20}||I can't work with her!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_3"
msgid "Tell me what happened.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_4"
msgid "She stole my favorite scarf.{PA:20}||It's really important to me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_5"
msgid "And I'm telling you,{PA:10} I didn't do it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_6"
msgid "Your scarf?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_7"
msgid "It was Italian.{PA:20}.{PA:20}.{PA:20} Hand-made!{PA:20}||It took me forever to save up for it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_8"
msgid "Miho is just getting angry because more guys||are coming in asking for me,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_9"
msgid "Excuse me?{PA:20}||Are you crazy,{PA:10} or just stupid?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_10"
msgid ".{PA:20}.{PA:20}.{PA:20}So if this scarf turns up,{PA:10} you'll simmer||down and get back to work?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_11"
msgid ".{PA:20}.{PA:20}.{PA:20}Yeah.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} Sí.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_12"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:289_0_13"
msgid "All right,{PA:10} calm down and wait here.{PA:20}"
