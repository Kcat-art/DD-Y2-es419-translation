msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_88"
msgid ".{PA:20}.{PA:20}.{PA:20}Understood.{PA:20}"
msgstr "E{PA:20}{PA:20}n{PA:20}tendido.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_89"
msgid "Are you usually popular with the ladies?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_90"
msgid "(What should I say?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_91"
msgid "Yeah,{PA:10} actually,{PA:10} I am.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_92"
msgid "Heh,{PA:10} I see.{PA:20}||Still,{PA:10} that's getting hit on in life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_93"
msgid "The ladies that come in here aren't your||average women.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_94"
msgid "There are ladies who come in here and drop||a million yen in a single night.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_95"
msgid "You're responsible for giving them that much||pleasure and attention in return.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_96"
msgid "Never forget this is a service industry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_97"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_98"
msgid "I'm actually more popular with the guys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_99"
msgid "That's a good sign.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_100"
msgid "There's no bullshitting that.{PA:20} It takes more||than smooth talk to make guy friends.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_101"
msgid "It shows you're a decent,{PA:10} considerate guy.{PA:20}||Somebody who can get a job done.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_102"
msgid "Make sure you're that kind of guy around the||customers,{PA:10} too.{PA:20} They can see through a lie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_103"
msgid "I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_104"
msgid "If you got rich,{PA:10} how would you spend it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_105"
msgid "On food,{PA:10} wine and cars,{PA:10} probably.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_106"
msgid "Heh,{PA:10} nice.{PA:20} You've got to keep investing what||you earn back into yourself in this world.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_107"
msgid "It'll broaden your experience,{PA:10} and that||means more topics of conversation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_108"
msgid "The single most important thing is to never||go on the defensive.{PA:20} Stay aggressive.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_109"
msgid "I'll remember that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_110"
msgid "I'd try to tuck it away for a rainy day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_111"
msgid "You think you can cut it in this line with||that kind of defensive thinking?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_112"
msgid "There are no guarantees in this industry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_113"
msgid "Yesterday's top host can be dead in the||water tonight.{PA:20} I've seen it before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_114"
msgid "Everybody's desperate to survive here.{PA:20}||They'll do what it takes to sell.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_115"
msgid "They'll spend a fortune on themselves.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_116"
msgid "I suggest you do the same.{PA:20} Call it an||investment in yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_117"
msgid "The single most important thing is to never||go on the defensive.{PA:20} Stay aggressive.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_118"
msgid "I'll remember that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_119"
msgid "Well,{PA:10} that concludes the interview.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_120"
msgid "I'd say.{PA:20}.{PA:20}.{PA:20} {PA:45}You pass.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_121"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_122"
msgid "But you're starting from the bottom.{PA:20}||It's minimum wage until you start selling.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_123"
msgid "I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_124"
msgid "Hosting's a dog-eat-dog world.{PA:20}||The top-selling host is king.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_125"
msgid "Remember that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_126"
msgid "There's no seniority and no holding back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_127"
msgid "It doesn't matter how long you've been here:||if you outsell the others,{PA:10} you're top dog.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_128"
msgid "If you're not top dog,{PA:10} you're trying to get||there.{PA:20} Understand?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_129"
msgid ".{PA:20}.{PA:20}.{PA:20}I do.{PA:20}"
msgstr "A{PA:20}s{PA:20}í{PA:20} es.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_130"
msgid "I can't hear you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_131"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr "¡Sí, {PA:10}señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_0"
msgid "First things first,{PA:10} the basics.{PA:20}||Go outside and start pulling in business.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_2"
msgid "Can't get asked for by name by a customer||if there are no customers.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_3"
msgid "But be smart about it.{PA:20} It's not about just||grabbing people and bringing them in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_4"
msgid "If they're cheap or broke,{PA:10} they'll only take||up time.{PA:20} Find someone who'll spend.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_5"
msgid "Never forget: one high roller is better for||business than ten small fries.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_6"
msgid "Okay,{PA:10} got it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_7"
msgid "And don't judge a book by its cover.{PA:20}||Remember that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_8"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_9"
msgid "Then you're all set.{PA:20}||Now go grab us three customers.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_10"
msgid "If we need you in here,{PA:10} I'll let you know.{PA:20}||Try to get three folks before then,{PA:10} okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_11"
msgid "Any questions?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_1_12"
msgid "No,{PA:10} sir.{PA:20}"
msgstr "... ¡N{PA:10}o, señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_1"
msgid "Hey,{PA:10} Kazuma.{PA:20} Were you planning on spending||all night out here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_2"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr "Lo siento{PA:20}.{PA:20}..{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_3"
msgid "Hm?{PA:20} What are you doing back?{PA:20}||I haven't seen those three customers yet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_4"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr "Lo siento{PA:20}.{PA:20}..{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_5"
msgid "That all you've got?{PA:20}"
msgstr "¿Eso es todo lo que tienes?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_6"
msgid "No,{PA:10} sir.{PA:20}"
msgstr "... ¡N{PA:10}o, señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_7"
msgid "Then get out there and get those ladies.{PA:20}||Am I clear?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_8"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_2_9"
msgid "(Looks like I'm stuck calling in clients.{PA:20}||May as well get it over with.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_0"
msgid "Great!{PA:20} Very nice.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Well?{PA:20}||Learn a thing or two out there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_3"
msgid "You're free to go for tonight.{PA:20} I'll call you||with your next shift.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_4"
msgid "Here's your cut for today.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_5"
msgid "          You were paid 3,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_6"
msgid "Received 200 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_7"
msgid "Good work tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_3_8"
msgid "Thank you,{PA:10} sir.{PA:20}"
msgstr "Gracias, s{PA:10}eñor.{PA:20}"

