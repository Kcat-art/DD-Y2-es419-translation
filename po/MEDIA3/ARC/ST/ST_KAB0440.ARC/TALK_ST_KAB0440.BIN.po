msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:20_2_15"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:20_2_16"
msgid "He hung up on me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_0_0"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr "¿Cómo van las cosas por ahí?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_2_5"
msgid "Yeah,{PA:10} I'll make it.{PA:20} I might not be a rock||like you,{PA:10} but I can still take a beating.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:28_2_7"
msgid "I've got it covered.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:30_0_0"
msgid "Tamiyo"
msgstr "Tamiyo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:30_1_0"
msgid "This is Kiryu.{PA:20}"
msgstr "Habla Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:30_1_2"
msgid "Oh,{PA:10} hello.{PA:20}||How is she doing?{PA:20}"
