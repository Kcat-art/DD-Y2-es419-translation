msgid "The menu has a number of options:"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_8"
msgid "pricing and the menu lineup,{PA:10} and interior||decoration,{PA:10} purchasing and installation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_9"
msgid "You can also ask any of the girls working||here for a face-to-face meeting.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_10"
msgid "If you could tweak the club's setup here to||maximize our earnings,{PA:10} we'll be in good"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_11"
msgid "shape,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_12"
msgid "Once we pick up some steam,{PA:10} we can think||about remodeling the place,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_13"
msgid "Oh,{PA:10} and don't worry--the club will cover the||cost of any interior or construction work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_0_14"
msgid "You won't be expected to front the cash.{PA:20}||So,{PA:10} ready to make some setup decisions?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_1_0"
msgid "Thank you,{PA:10} sir.{PA:20}"
msgstr "Gracias, s{PA:10}eñor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:290_1_1"
msgid "Well,{PA:10} we're all set to open.{PA:20} I'm excited!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_0"
msgid "There,{PA:10} now.{PA:20} Let's chat a bit and see if you||have what it takes to be a host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_1"
msgid "Any previous experience as a host?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_2"
msgid "No.{PA:20}"
msgstr "No{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_3"
msgid "May I have your name?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Kazuma Kiryu.{PA:20}"
msgstr "S{PA:20}o{PA:20}y{PA:20} Kazuma Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_5"
msgid "Did you say Kiryu?{PA:20} Wasn't that the name of||the head of the Tojo Clan.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_6"
msgid "(Uh oh.{PA:20}.{PA:20}.)"
msgstr "(Oh, oh.{PA:20}..{PA:20})."

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_7"
msgid "I get asked that a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_8"
msgid "Ha ha,{PA:10} I'm sure you do.{PA:20} You gave me a start!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_9"
msgid "There are tons of folks walking around with||identical names,{PA:10} I guess.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_10"
msgid "Hope I didn't offend you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_11"
msgid "Not at all.{PA:20}"
msgstr "No se preocupe.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_12"
msgid "I was once the Tojo Chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_13"
msgid ".{PA:20}.{PA:20}.{PA:20}You're joking.{PA:20}||Of course!{PA:20} Ha ha!{PA:20} Very good,{PA:10} very good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_14"
msgid "But I'd avoid jokes of that nature here.{PA:20}||You never know how they'll be taken.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_16"
msgid "How old are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_17"
msgid "(Am I supposed to lie here?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_18"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm 25.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_19"
msgid "Heh,{PA:10} with that face?{PA:20}||If so,{PA:10} I feel sorry for you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_20"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_21"
msgid "A host's only as good as his looks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_22"
msgid "You go out there and expose yourself to the||customers.{PA:20} That's what makes or breaks you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_23"
msgid "But with a bit of effort,{PA:10} you can make up||for being older.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_24"
msgid "Just don't let your appearance go.{PA:20}||That's the end of a host's career.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_25"
msgid "I'm 38.{PA:20}"
msgstr "Tengo 38.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_26"
msgid ".{PA:20}.{PA:20}.{PA:20}38 years old.{PA:20}||That's a bit tough.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_27"
msgid "Still,{PA:10} age isn't everything in this job.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_28"
msgid "If you've got the passion and the skill,{PA:10} you||can succeed at any age.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_29"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_30"
msgid "Still,{PA:10} a host's only as good as he looks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_31"
msgid "You go out there and expose yourself to the||customers.{PA:20} That's what makes or breaks you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_32"
msgid "Let your appearance go,{PA:10} and you're done for.{PA:20}||Consider it the product you're selling.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_33"
msgid "I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_34"
msgid "What got you interested in being a host?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_35"
msgid "(Hm.{PA:20}.{PA:20}.)"
msgstr "Mm.{PA:20}.{PA:20}."

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_36"
msgid "I need the money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_37"
msgid "Money,{PA:10} hm?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_38"
msgid "With enough money,{PA:10} you can do anything.{PA:20}.{PA:20}.{PA:20}||Is that what you're thinking?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_39"
msgid "Well,{PA:10} yes.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_40"
msgid "You may be right.{PA:20} Money solves an awful lot.{PA:20}||It can even buy affection,{PA:10} or trust.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_41"
msgid "But the people who come here are here for||a connection.{PA:20} It's about the people.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_42"
msgid "Customers are quick to see through a host||who's only in it for the money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_43"
msgid "Still,{PA:10} hosts who are so sentimental they||can't pull in the money never succeed.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_44"
msgid "Do you follow me?{PA:20}||What's really important is that balance.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_45"
msgid "The top hosts have a natural sense for the||right mix of business and emotion.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_46"
msgid "I want the ladies.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_47"
msgid "Oh,{PA:10} really?{PA:20}||Why not just go hit on random girls then?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_48"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_49"
msgid "Don't get the wrong idea about this job.{PA:20}||Host work is part of the service industry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_50"
msgid "The look,{PA:10} the banter,{PA:10} it's all business.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_51"
msgid "You'll have to get that into your head if||you hope to make it in this industry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_52"
msgid ".{PA:20}.{PA:20}.{PA:20}I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_53"
msgid "Can you drink?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_54"
msgid "(What should I say?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_55"
msgid "Like a fish.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_56"
msgid "Oh,{PA:10} yes?{PA:20} Well,{PA:10} that's good.{PA:20}||It's a skill you'll need here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_57"
msgid "Part of the job is drinking enough booze to||kill an average man,{PA:10} I'm afraid.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_58"
msgid "If the customer says drink,{PA:10} you drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_59"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_60"
msgid "A little bit.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_61"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} I see.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_62"
msgid "Well,{PA:10} don't worry.{PA:20} There are hosts who can't||handle a drop,{PA:10} and they still do fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_63"
msgid "That's a relief.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_64"
msgid "You'll just have to make up the difference||with smooth talking.{PA:20} It's doable.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_65"
msgid "Just be ready for a sudden drop in the mood||when they find out you don't drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_66"
msgid "It'll be a challenge to see how you get||things back on track from there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_67"
msgid "Think you're up to it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_68"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_69"
msgid "Are you good with banter?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_70"
msgid "(.{PA:20}.{PA:20}.{PA:20}No.)"
msgstr "Nada que{PA:20} la{PA:20} hay{PA:20}a puesto así..."

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_71"
msgid "I can make a lady laugh.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0440.ARC/TALK_ST_KAB0440.BIN::line:292_0_72"
msgid "All right.{PA:20}.{PA:20}.{PA:20}||What sort of material have you got?{PA:20}"
