msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:286_0_0"
msgid "Stop?!{PA:20} Whaddya talking about?{PA:20}||{MS:0}I'm paying good money to be in here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:286_0_1"
msgid "Now pour me another drink,{PA:10} goddammit!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:286_0_2"
msgid "I can't take this.{PA:20}.{PA:20}.{PA:20}||I quit!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:286_1_3"
msgid "Heyyy,{PA:10} you're that guy from before!{PA:20}||All right,{PA:10} that does it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:286_1_4"
msgid "Time for some payback,{PA:10} buddy.{PA:20}||It's all over,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:286_1_5"
msgid "You're damn right.{PA:20} It's time to put an end||to this.{PA:20} Step outside.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_0"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}||{MS:0}I'm afraid Rika left us.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_2"
msgid "That leaves a hole in our shift table.{PA:20}.{PA:20}.{PA:20}||We'll need to hire another girl,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_3"
msgid "Could I ask you to play scout again?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_4"
msgid "Now that we're a bigger space,{PA:10} I'd say we||have room for two more girls.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_5"
msgid "Perhaps this time it'd make sense to look||around the Champion District.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_0_6"
msgid "All right.{PA:20}||I'll see who I can find there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_1_0"
msgid "Good luck finding a couple of new girls to||fill in here,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_0"
msgid "Excellent work,{PA:10} Mr.{PA:20} Kiryu!{PA:20}||You've brought us two beauties,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_1"
msgid "Yeah,{PA:10} they should do nicely.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_2"
msgid "Now that we're staffed,{PA:10} I can put together||a new shift table!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_3"
msgid "I'll leave the club setup decisions to you.{PA:20}||At your convenience,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_4"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_5"
msgid "Oh,{PA:10} and one other thing.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_6"
msgid "If you're ever out and about and see another||girl,{PA:10} we could certainly use more.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_7"
msgid "Anyone you can scout out there will help||keep business stable here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_2_8"
msgid "The more girls we have,{PA:10} the more business||we'll do,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||Oh,{PA:10} this is terrible,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_1"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_2"
msgid "One of our part-time staff,{PA:10} Akihiko,{PA:10} just||{MS:0}ran off with 5 million yen from the till!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_3"
msgid "What?!{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_4"
msgid "I can't believe he'd do this.{PA:20}.{PA:20}.{PA:20}||He didn't seem the type,{PA:10} honestly.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_5"
msgid "He may have had his reasons.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_6"
msgid "Mr.{PA:20} Kiryu,{PA:10} sir,{PA:10} you HAVE to find him!{PA:20}||{MS:0}Without that money,{PA:10} we're.{PA:20}.{PA:20}.{PA:20} We're.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_3_7"
msgid "I'll find him.{PA:20} Don't worry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_4_0"
msgid "Please,{PA:10} Mr.{PA:20} Kiryu,{PA:10} you have to find Akihiko!{PA:20}||Oh,{PA:10} I hope the money is still safe.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||Well,{PA:10} sir.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_1"
msgid "I found him.{PA:20}||He was being threatened.{PA:20} He had no choice.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_2"
msgid ".{PA:20}.{PA:20}.{PA:20}I had no idea.{PA:20}"
msgstr "N{PA:20}o{PA:20} {PA:20}tenía ni idea.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_3"
msgid "Would you mind if we turned a blind eye just||this once?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_4"
msgid "I got the money back,{PA:10} safe and sound.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_5"
msgid "Certainly.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_6"
msgid "You've got to watch out for those punks||these days.{PA:20} Never know what they'll do.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:287_5_7"
msgid "Yes,{PA:10} sir.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:288_0_0"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:288_0_1"
msgid "The place is deserted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:288_0_2"
msgid "Please,{PA:10} you have to do something.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:288_1_0"
