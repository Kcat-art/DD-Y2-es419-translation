msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:288_4_1"
msgid "Will you take a look at that!{PA:20}||Every seat in the house is full!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0442.ARC/TALK_ST_KAB0442.BIN::line:288_4_2"
msgid "I never imagined business would take off||like this,{PA:10} sir.{PA:20}"
