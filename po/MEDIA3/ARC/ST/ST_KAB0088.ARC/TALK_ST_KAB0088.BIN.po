msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_1"
msgid "I worked as hard as I could!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_2"
msgid "Gas stations,{PA:10} restaurants,{PA:10} construction.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_3"
msgid "I did my best at each and every job.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_4"
msgid "But.{PA:20}.{PA:20}.{PA:20} They all just made fun of me,{PA:10} no||matter where I worked.{PA:20} I never lasted long.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_5"
msgid "Then money got tight,{PA:10} and I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_6"
msgid "What happened to doing whatever it takes to||make Kyoka happy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_7"
msgid "Those were your words,{PA:10} Takashi.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_8"
msgid "Was that just lip service?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_9"
msgid "But.{PA:20}.{PA:20}.{PA:20} Kyoka is.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_10"
msgid "What about her?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_11"
msgid "She's seeing some guy on the side!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_12"
msgid "What?{PA:20}||Are you sure?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_13"
msgid "When I ask her,{PA:10} she just says she's out||with friends.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_14"
msgid "But I swear,{PA:10} there's something going on.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_15"
msgid "Plus I heard from one of my coworkers at my||last job.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_16"
msgid "He said he saw Kyoka go into a hotel||with another man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_18"
msgid "Kyoka's the one who abandoned me!{PA:20}||I'm dying here,{PA:10} and she's off.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_19"
msgid "Pathetic.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_20"
msgid "You don't even bother finding out if it's||true or not!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_21"
msgid "Finding out?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_22"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_23"
msgid "Mr.{PA:20} Kiryu,{PA:10} I heard rumors a ways back.{PA:20}.{PA:20}.{PA:20}||About an info dealer here in Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_24"
msgid "They say he knows everything that happens||here.{PA:20} Does he really exist?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_25"
msgid "If anyone would know,{PA:10} it's you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Please,{PA:10} you have to tell me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_26"
msgid "Fine,{PA:10} I'll tell you.{PA:20}||You're talking about Kage.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_27"
msgid "Please.{PA:20}||Please take me to see him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_28"
msgid "I want to know the truth.{PA:20}||I want to know what Kyoka's really up to.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_29"
msgid "I'll ask Kage if he'll meet with you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_30"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_31"
msgid "Sorry,{PA:10} don't know him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_0_32"
msgid "Please,{PA:10} you've got to tell me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_1_1"
msgid "I'll be waiting right here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_1_2"
msgid "Thank you so much for asking Kage to help||me out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_2_1"
msgid "Oh,{PA:10} Mr.{PA:20} Kiryu!{PA:20} .{PA:20}.{PA:20}.{PA:20}Well?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_2_2"
msgid "He says he can spare a minute for you.{PA:20}||Let's go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:288_2_3"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_0"
msgid "What is it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_1"
msgid "My boss,{PA:10} Tagami,{PA:10} just ran off with||the company money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_2"
msgid "The company's just the two of us.{PA:20}||We're a tiny import agency,{PA:10} but anyway.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_3"
msgid "He's gotten hooked on gambling again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_4"
msgid "If it weren't for that,{PA:10} he'd be a||helluva boss.{PA:20} He's a genius salesman.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_5"
msgid "I wish I could hunt him down and get him to||give up gambling once and for all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_6"
msgid "Do you think I could ask you to help me?{PA:20}||I just need to find him first.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_7"
msgid "That sounds like it's your problem.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_8"
msgid "Yes,{PA:10} I suppose it is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_9"
msgid "Sure,{PA:10} I'll help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_10"
msgid "Really?{PA:20}||Oh,{PA:10} thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_11"
msgid "I don't expect you'll have any trouble||spotting him.{PA:20} He wears this loud blue tie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_12"
msgid "As far as the casino goes,{PA:10} I'm pretty sure||it's at.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_0_13"
msgid "Don't worry,{PA:10} I know where it is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:289_1_0"
msgid "Oh,{PA:10} man.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_0"
msgid "Ah,{PA:10} Mr.{PA:20} Kiryu!{PA:20} It's me,{PA:10} Igarashi!{PA:20}||You helped break my boss's gambling habit.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_1"
msgid "Oh,{PA:10} right.{PA:20} How's it been going?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_2"
msgid "He's like a new man!{PA:20}||Business is booming,{PA:10} it's incredible!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_3"
msgid "I wanted to give you this to say thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_4"
msgid "        You received 100,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_5"
msgid "It's your share of the profits,{PA:10} sir!{PA:20}||We never could have made it without you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_6"
msgid "Thanks.{PA:20} I'm glad it worked out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_7"
msgid "Thank you so much!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:290_0_8"
msgid "Received 2❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:291_0_2"
msgid "Thanks again for before.{PA:20}||You really saved my buns.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:291_0_3"
msgid "My name is Chikamatsu.{PA:20} I'm an Enka singer.{PA:20}||I guess I'm what the kids call \"old-school\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:291_0_4"
msgid "As you saw back there,{PA:10} though,{PA:10} I've got the||yakuza hot on my heels.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:291_0_5"
msgid "A man approached me a while back saying he||wanted to sell my records,{PA:10} but it was a con.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:291_0_6"
msgid "Apparently,{PA:10} he was neck-deep in debt from a||lot of unsavory sources.{PA:20} Now he's gone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:291_0_7"
msgid "He up and disappeared,{PA:10} and somehow all of||his debts have now fallen on my shoulders.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_2"
msgid "Where the fuck are ya,{PA:10} Chikamatsu?!{PA:20}||Git yer ass out here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_3"
msgid "Found ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_4"
msgid "H-Help me!{PA:20} Please!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_6"
msgid "I'm afraid you're on your own.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_7"
msgid "Y-You can't.{PA:20}.{PA:20}.{PA:20} They're gonna.{PA:20}.{PA:20}.{PA:20}!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_8"
msgid "Sorry,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_9"
msgid "Heh.{PA:20}.{PA:20}.{PA:20} Let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_12"
msgid "Hey,{PA:10} leave the guy alone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_13"
msgid "Who the fuck are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_14"
msgid "A guy who doesn't want to see anyone hurt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_15"
msgid "P-Please,{PA:10} you've got to listen!{PA:20}||I'm an Enka singer.{PA:20} A professional,{PA:10} I mean.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_16"
msgid "I haven't sold many records yet,{PA:10} but.{PA:20}.{PA:20}.{PA:20}||But,{PA:10} with time,{PA:10} I could.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_17"
msgid "Enka?{PA:20} Enka?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_18"
msgid "Who still listens to that old shit?{PA:20}||Won't earn half a goddamn yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_19"
msgid "I'm serious!{PA:20}||This is my career!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_20"
msgid "Enka is my life!{PA:20}||I swear I'll turn a profit and pay you back!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_21"
msgid "Would you at least listen to it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_22"
msgid "Shut yer hole!{PA:20} I ain't listenin' to shit!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_23"
msgid "You're behind the times,{PA:10} ya sorry bastard!{PA:20}||Give it up!{PA:20} Get a clue,{PA:10} buddy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_24"
msgid "Hey,{PA:10} hold up just a minute.{PA:20}||Give him a chance.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_25"
msgid "Who the fuck are you,{PA:10} anyway?{PA:20}||How's any of this your business,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_26"
msgid "Hey.{PA:20}||{MS:0}Change this guy's face around,{PA:10} boys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_0_27"
msgid "Yessir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_0"
msgid "Gnngh!{PA:20} Guy's a monster.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_1"
msgid "At least wait until you've heard the||guy's music before you rag on it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_2"
msgid "P-Please!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_3"
msgid "Hmph.{PA:20} Fine.{PA:20}.{PA:20}.{PA:20}||{MS:0}If it'll make ya shut up,{PA:10} I'll listen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_4"
msgid "Make it count,{PA:10} Chikamatsu.{PA:20}||You're singing yer own dirge here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_5"
msgid "Y-Yes,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_6"
msgid "Bartender,{PA:10} could you put this CD on?{PA:20}||It's the accompaniment.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_7"
msgid "C-Certainly.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_11"
msgid "       The Moonlit Snows of Kamurocho"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_13"
msgid "Th-This's.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_14"
msgid "It's like I can see the town I grew up in.{PA:20}||I see my old friends.{PA:20}.{PA:20}.{PA:20} My mom.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_15"
msgid "Goddamn,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_16"
msgid "One song,{PA:10} and ya wrecked me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_17"
msgid "The salt o' my own tears.{PA:20}.{PA:20}.{PA:20} This trembling!{PA:20}||When'd I get to be this old?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_18"
msgid "You owe 3 million,{PA:10} right?{PA:20}||Give or take a few.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_19"
msgid "That's right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_20"
msgid "How 'bout we forget the 3 million and ya||gimme 10 copies o' that album instead?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_21"
msgid "A-Are you serious?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_22"
msgid "I'm quittin' this money-grubbin' game.{PA:20}||Go back to the sticks,{PA:10} find my old girl.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_23"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_24"
msgid "This settles it.{PA:20} Done made up my mind.{PA:20}||I'm headin' back home to get a real job.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_25"
msgid "What?!{PA:20} B-But,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_26"
msgid "Ya serious,{PA:10} boss?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_27"
msgid "We're stayin' with ya,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_28"
msgid "Take me with ya!{PA:20} Please,{PA:10} I'm beggin' ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_29"
msgid "I'm headin' to the boonies.{PA:20}||Blizzards.{PA:20} No convenience stores.{PA:20} Ya follow?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_30"
msgid "Sea gets choppy at the drop of a hat.{PA:20} Ain't||a goddamn thing to do for fun but drink!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_31"
msgid "That don't matter to us!{PA:20} Seein' ya like this||just reminds me of why I joined up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_32"
msgid "Heh.{PA:20} It's yer life to waste.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_33"
msgid "Thank you,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_37"
msgid "Later,{PA:10} pal.{PA:20} You keep that singin' up.{PA:20}||Put out a real album and I'll pick one up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_38"
msgid "Th-Thank you!{PA:20} I will!{PA:20}||{MS:0}You take care,{PA:10} too,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_39"
msgid "Thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:292_1_40"
msgid "Sorry about before,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:294_2_2"
msgid "Well,{PA:10} that was sure an ego boost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:294_2_3"
msgid "Maybe I'll keep trying at the whole music||thing here a while longer.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:294_2_4"
msgid "Thank you for all your help.{PA:20}||This is just a token of my appreciation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:294_2_5"
msgid "        You received a \"{CC:ffffc8}silver plate{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:294_2_7"
msgid "Thank you,{PA:10} thank you,{PA:10} thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:294_2_8"
msgid "Received 1❟500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:297_0_0"
msgid "It's me.{PA:20} Yuya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:297_1_0"
msgid "No,{PA:10} sir.{PA:20} I work with him here at the club.{PA:20}||He's not in at the moment,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:297_1_1"
msgid "But we're in serious trouble here!{PA:20}||Those men from before are back!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_1"
msgid "Welcome,{PA:10} sir.{PA:20}||What can I get for you today?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_4"
msgid "Sir,{PA:10}{PA:10} you appear to have had enough.{PA:20}||I must suggest you call it a day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_5"
msgid "May I prepare you another drink,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_6"
msgid "Very well,{PA:10} sir.{PA:20}||I look forward to serving you again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_9"
msgid "That's one of Japan's top single malt||whiskeys,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_10"
msgid "It's become such a status symbol,{PA:10} and it's not||likely to lose that position any time soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_11"
msgid "It's a household name.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_12"
msgid "They use carefully tested,{PA:10} perfectly matured||malts to get that great,{PA:10} smooth flavor.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_13"
msgid "It's popular overseas,{PA:10} too.{PA:20} Not just here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_17"
msgid "They make that with mountain spring water at||Suntory's Hakushu distillery in the heart of"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_18"
msgid "the Japanese alps,{PA:10} so the taste is divine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_19"
msgid "Its distinctly creamy yet fruity feel sets||it apart from other Japanese whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_20"
msgid "I recommend taking the first drink straight||up,{PA:10} for a pleasantly robust kick.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_21"
msgid "It also complements Japanese food well.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_25"
msgid "I can wholeheartedly recommend that bottle.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_26"
msgid "It often takes the gold at competitions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_27"
msgid "Famously finicky critics the world over all||agree that it means business,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_28"
msgid "The rich,{PA:10} elegant taste has been likened to||the grandest sports cars.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_29"
msgid "It's even been called queen of the single-||malt whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_30"
msgid "Whiskey doesn't get much finer,{PA:10} sir.{PA:20}||It's well worth the price.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_34"
msgid "That's the standard model MacAllan,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_35"
msgid "For those patrons looking to try the luxury||line on a more casual basis.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_36"
msgid "Even as \"just\" the standard model,{PA:10} this is||an exceptionally fine liquor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_37"
msgid "I urge you to try its sweet,{PA:10} full flavor and||bouquet for yourself.{PA:20} Taste the quality.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_41"
msgid "Sherry wood barrels lend that whiskey its||uniquely ripe,{PA:10} floral overtones.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_42"
msgid "The special blend of sea plants unique to||Islay give it a perfectly balanced salinity.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_43"
msgid "It's known as the queen of Islay.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_44"
msgid "That's the standard model Bowmore.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_45"
msgid "It stands a cut above the rest of the single||malt 12-years,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_49"
msgid "The Glenfiddich 12-year is the best-selling||single-malt whiskey in the world,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_50"
msgid "This bottle set the industry standard for||a single malt.{PA:20} Light and fresh.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_51"
msgid "The bouquet is fruity and the finish clean,{PA:10}||making it exceptionally easy to drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_52"
msgid "My wife prefers it.{PA:20} In general,{PA:10} it's a||popular drink among the ladies.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_53"
msgid ".{PA:20}.{PA:20}.{PA:20}Not that it makes you less manly,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_57"
msgid "That's Japan's premium whiskey,{PA:10} and it's won||over whiskey snobs the world over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_58"
msgid "Over 30 types of hand-selected malts mix||with spirits aged in white oak barrels to"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_59"
msgid "produce a mellow flavor that's won a load of||titles at international taste tests.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_60"
msgid "The finish is particularly excellent.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_61"
msgid "A bottle also makes an exquisite gift.{PA:20}||The type I won't get for Christmas.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_65"
msgid "This malt whiskey is the result of extensive||research into developing the mildest flavor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_66"
msgid "It goes a long way towards reining in whiskey's||astringent taste,{PA:10} making it an easy first.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_67"
msgid "It's quite enjoyable,{PA:10} even to those more||accustomed to drinking soju and the like.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_68"
msgid "The bamboo charcoal filtration it undergoes||ensures a clean,{PA:10} pure taste.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_69"
msgid "It's particularly nice when served up half||on the rocks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_73"
msgid "This rectangular bottle's probably the most||popular whiskey in Japan,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_74"
msgid "Some call it the father of Japanese whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_75"
msgid "Its popularity shows no signs of dropping,{PA:10}||even 70 years after it first debuted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_76"
msgid "Its flavor is perfectly balanced.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_77"
msgid "The container's shape is so characteristic,{PA:10}||some people refer to the drink by it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_81"
msgid "Ah,{PA:10} the ultimate blended whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_82"
msgid "It boasts a flavor and aroma only possible||through the interweaving of over 40 malts.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_83"
msgid "It's the result of the best of Ballantine's||whiskey-blending technology.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_84"
msgid "It's well-loved the world over,{PA:10} to the point||of some calling it \"THE scotch\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_88"
msgid "That's a standard scotch,{PA:10} made from a blend||of over 40 types of single malts.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_89"
msgid "Not too heavy,{PA:10} not too light.{PA:20} It's got a||great balance to it,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_90"
msgid "And the price isn't too heavy,{PA:10} either.{PA:20} I'd||recommend it to a first-timer trying scotch.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_91"
msgid "Give it a try and see what you think.{PA:20} You||can always go up from there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_95"
msgid "That's the face of American whiskey,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_96"
msgid "A simple,{PA:10} clear taste and mellow,{PA:10} warm aroma||are its defining features.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_97"
msgid "It's made in Tennessee,{PA:10} in the States.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_98"
msgid "Between that,{PA:10} and the charcoal mellowing||process it undergoes.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_99"
msgid "It qualifies as Tennessee whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_100"
msgid "Still,{PA:10} most people seem to consider it a||bourbon,{PA:10} for whatever reason.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_104"
msgid "People have been loving that one since the||day it first came out in 1860.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_105"
msgid "It's practically synonymous with bourbon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_106"
msgid "The flavor is very American--silky to the||tongue but with a sharp,{PA:10} clean finish.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_107"
msgid "The modest price also makes it a wonderful||choice for a casual evening drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_111"
msgid "That's a mature,{PA:10} full-grape brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_112"
msgid "It's got that rich,{PA:10} dense brandy flavor and||bouquet you can really sink your teeth into.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_113"
msgid "The finish is wonderful,{PA:10} too.{PA:20} I often drink||this at home myself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_114"
msgid "You can drink it straight or on the rocks,{PA:10}||cut it with water,{PA:10} cut it with tonic.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_115"
msgid "It's the only brandy you'd ever need.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_119"
msgid "A remarkable specimen from France.{PA:20} This one||won top prize in the worldwide cognac tests.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_120"
msgid "The pairing of finest grapes with Borderies||spirits; a full but smooth palate.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_121"
msgid "You haven't drunk cognac until you've tried||this bottle,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_125"
msgid "That's one of the world's favorite beers.{PA:20} At||least,{PA:10} the folks of 140 countries think so.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_126"
msgid "Carlsberg customarily brews a lager beer,{PA:10}||but they've expanded from that base.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_127"
msgid "Their Japanese licensed brewer,{PA:10} Suntory,{PA:10} has||put their own know-how to work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_128"
msgid "Together,{PA:10} they've created Carlsberg's first||draft beer.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_129"
msgid "You'll only see this here in Japan,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_130"
msgid "It's an impressively clean taste that goes||marvelously with Western food.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_134"
msgid "That's a nicely balanced medium-grade golden||rum,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_135"
msgid "It's fermented and distilled by Guyana's||Demerara River,{PA:10} then aged in England.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_136"
msgid "It packs a powerful yet elegant flavor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_137"
msgid "People favor its faint,{PA:10} refined sweetness.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_138"
msgid "Behind the sweetness,{PA:10} though,{PA:10} it packs an||impressive 75.{PA:20}5 percent alcohol content.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_142"
msgid "This bottle practically defines premium||tequila,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_143"
msgid "It uses naturally fermented 100% blue agave||to create its winningly all-natural taste.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_144"
msgid "It boasts excellent aroma and a mouth-feel||that places it at the very top of tequilas.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_145"
msgid "It doesn't get much better,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_146"
msgid "As a shot,{PA:10} or in a cocktail,{PA:10} it's your call.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_150"
msgid "That's another extremely popular Japanese||whiskey,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_151"
msgid "The unique influence of Yamazaki sherry wood||barrel aging has won it a lot of fans.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_152"
msgid "It just might be the line that best defines||Suntory's whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:298_0_153"
msgid "A lot of people call it \"Dharma\",{PA:10} because||the round shape looks like a daruma doll.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0088.ARC/TALK_ST_KAB0088.BIN::line:299_0_0"
