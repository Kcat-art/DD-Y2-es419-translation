msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_0_2"
msgid "Picked up \"{CC:ffffc8}Shofukucho locker key #41{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_0_4"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_1_0"
msgid "(There's something here.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_1_1"
msgid "Take the locker key?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_1_2"
msgid "Picked up \"{CC:ffffc8}Shofukucho locker key #41{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_1_3"
msgid "(It says Shofukucho lockers.{PA:20}||That must be where this key goes.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:284_1_5"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_0"
msgid "Ahh,{PA:10} Mr.{PA:20} Kiryu!{PA:20} Good to see ya again,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_1"
msgid "Yeah.{PA:20} You said you got some info?{PA:20}||Something about bad news?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_2"
msgid "Yeah,{PA:10} about that.{PA:20}||{MS:0}I'm afraid I can't tell ya,{PA:10} pal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_3"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_4"
msgid "I hear ya took down the big guy at the golf||driving range.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_5"
msgid "I called him all the way from Hiroshima for||this job.{PA:20} You're a tough one,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_6"
msgid "I guess I didn't know HOW tough.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_7"
msgid "What are you saying?{PA:20}"
msgstr "Pero ¡¿qué estás diciendo?!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_8"
msgid "I got the feelin' I should stick around ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_9"
msgid "Figured one day I'd catch word of a way to||turn you into a whole mountain of cash.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_10"
msgid "Well,{PA:10} today's the day,{PA:10} boss.{PA:20}||No hard feelings,{PA:10} I hope.{PA:20}"
msgstr "Y ya{PA:10} llegó el momen{PA:10}to de{PA:20}|| cobrar mi reco{PA:10}mpensa.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_11"
msgid "You.{PA:20}.{PA:20}.{PA:20}||So you knew everything from the start?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_0_12"
msgid "That's enough chattin'.{PA:20} I already let my||mouth run off too much.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_1_1"
msgid "Sorry,{PA:10} Mr.{PA:20} K.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_1_2"
msgid "Ya been good to me so far,{PA:10} pal.{PA:20}||Still,{PA:10} I'm a guy who lives for money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_1_3"
msgid "Anyhow,{PA:10} I'm thinkin' now's as good a time||as any to get started.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:289_1_4"
msgid "I'm afraid these guys won't go down quite as||easy as yer golf buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_0"
msgid "Where is Haruka?!{PA:20} Talk.{PA:20} NOW!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_1"
msgid "Choose your next words carefully,{PA:10} Kurokawa.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_2"
msgid "I-It was Esaki.{PA:20} He hired me.{PA:20}"
msgstr "Fue Esaki... Él {PA:20}me contrató...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_3"
msgid "Said if I sunk you in the river,{PA:10} he'd give||me 10 million.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_4"
msgid "I-I've always been a sucker for cash.{PA:20}"
msgstr "E-el dinero siempre ha sido mi punto débil...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_5"
msgid "And besides,{PA:10} doin' business in this town||means stayin' on Sengoku's good side.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_6"
msgid "Where is he?{PA:20}"
msgstr "¿Y adónde fue?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:290_0_7"
msgid "Shinseicho.{PA:20}.{PA:20}.{PA:20} He's been hiding out inside||the \"{CC:ffc8c8}acupuncture{CR:00}\" place there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:294_0_0"
msgid "Osakan women are fine,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:295_0_1"
msgid "Hey,{PA:10} buddy!{PA:20} Did ya know this here river's||the one mentioned in the Momotaro legends?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:295_0_2"
msgid "Kid came floatin' down right here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:295_0_3"
msgid "No,{PA:10} I didn't.{PA:20}"
msgstr "No..{PA:10}., no lo sabía.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:295_0_4"
msgid "That's 'cause it ain't!{PA:20}||Dang,{PA:10} you Kanto folk are gullible!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:295_0_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:295_1_0"
msgid "Hey,{PA:10} buddy.{PA:20}.{PA:20}.{PA:20}"
msgstr "Oy{PA:10}e..{PA:20}.{PA:20}{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:296_0_0"
msgid "You know it!{PA:20}||They're not all stuck up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:296_0_1"
msgid "I'd hit that,{PA:10} for sure.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:297_0_0"
msgid "I-It's no good!{PA:20} He's too tough.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:297_0_1"
msgid "Hey,{PA:10} what the hell're ya doin'?!{PA:20}||Go beat him down already!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:297_0_2"
msgid "Augh!{PA:20} Hey!{PA:20} Quit movin' around,{PA:10} or.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_0"
msgid "What's wrong,{PA:10} lady?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_1"
msgid "Hey,{PA:10} listen to this!{PA:20}||Damn fool here hits me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_2"
msgid "He kicks me,{PA:10} beats me down!{PA:20} ME!{PA:20}||Poor,{PA:10} defenseless,{PA:10} pregnant little me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_3"
msgid "What?!{PA:20}||{MS:0}What the hell are you thinkin',{PA:10} pal?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_4"
msgid "How's about I kick YOU around?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_5"
msgid "She's full of it.{PA:20}||I've never seen this woman before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_6"
msgid "Aww,{PA:10} shut it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:298_0_7"
msgid "Y'all cold,{PA:10} emotionless types're always the||bad ones!{PA:20} It's a fact!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_3"
msgid "I been waitin',{PA:10} daddy!{PA:20}||Ya brought the cash,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_6"
msgid "Wha-?!{PA:20} Ya big liar!{PA:20} This ain't funny,{PA:10} honey.{PA:20}||Now bring me that money!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_7"
msgid "Aww,{PA:10} there's a good daddy.{PA:20}||Now fork over that 200 grand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_8"
msgid "Will you hand over 200,{PA:10}000 yen?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_12"
msgid "Do I look stupid?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_13"
msgid "Yeah,{PA:10} maybe!{PA:20} Stupid enough to ruin a fine||young lady and her baby's life!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_14"
msgid "Everybody,{PA:10} listen!{PA:20} This here limp dick||had his way with me,{PA:10} then up and left me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:299_0_15"
msgid "Says he's gonna let me and our poor little||baby starve out on the streets!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:300_0_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Take it.{PA:20}"
msgstr "n{PA:20}{PA:20}o{PA:20} puedo{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:300_0_3"
msgid "Ya hear that,{PA:10} baby?{PA:20}||Thank goodness yer daddy's so rich!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:300_0_4"
msgid "        You handed over 200,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:300_0_5"
msgid "A-Ahh,{PA:10} labor pains!{PA:20} Hospital time!{PA:20} Gotta go!{PA:20}||Thanks,{PA:10} man!{PA:20} See ya later!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Shit.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Shit.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_4"
msgid "What're ya doin',{PA:10} dumbass?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_5"
msgid "Aww,{PA:10} can it!{PA:20} Never woulda happened if you'd||done yer goddamn job!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_6"
msgid "I see you two know each other.{PA:20}||For such an elaborate con,{PA:10} I'm unimpressed.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_7"
msgid "Y-Ya gotta let me slide on this one!{PA:20}||I was against it the whole time!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_8"
msgid "This brute of a man forced me,{PA:10} and.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_9"
msgid "H-Hey!{PA:20} That's a damn lie!{PA:20}||This bitch is the one who came up with it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_10"
msgid "Some man you are,{PA:10} throwin' all the blame on||a frail young woman like me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_11"
msgid "Which part o' you is frail?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_12"
msgid "I-I'm real sorry,{PA:10} bro.{PA:20} Here,{PA:10} this's all I||got.{PA:20} You'll let us go,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_13"
msgid "            You got 30,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_14"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_16"
msgid "S-See ya later!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:302_0_17"
msgid "Hey,{PA:10} wait!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_0"
msgid "What's wrong,{PA:10} lady?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_1"
msgid "Hey,{PA:10} listen to this!{PA:20}||Damn fool here hits me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_2"
msgid "He kicks me,{PA:10} beats me down!{PA:20} ME!{PA:20}||Poor,{PA:10} defenseless,{PA:10} pregnant little me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_3"
msgid "What?!{PA:20}||{MS:0}What the hell are you thinkin',{PA:10} pal?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_4"
msgid "How's about I kick YOU around?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_5"
msgid "She's full of it.{PA:20}||I've never seen this woman before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_6"
msgid "Aww,{PA:10} shut it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:304_0_7"
msgid "Y'all cold,{PA:10} emotionless types're always the||bad ones!{PA:20} It's a fact!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_3"
msgid "Huff.{PA:20}.{PA:20}.{PA:20} huff.{PA:20}.{PA:20}.{PA:20}"
msgstr "Au{PA:20}{PA:20}{PA:20}..{PA:20}.{PA:20}{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_4"
msgid "Just whaddya plan on doin' about this baby||o' yours I'm carryin',{PA:10} stud?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_5"
msgid "Do I know you?{PA:20}"
msgstr "... ¿Te conozco?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_6"
msgid "What?!{PA:20} Done forgot about all the years we||spent stupid in love with each other?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_7"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20} Look,{PA:10} fine!{PA:20}||Don't want me anymore,{PA:10} that's just fine!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_8"
msgid "But think o' the baby,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_9"
msgid "You can throw me out,{PA:10} but you'd better||be payin' me child support!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_10"
msgid "200 grand!{PA:20} You owe your baby at least that!{PA:20}||Be a man and take some responsibility!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_11"
msgid "       Will you pay her 200,{PA:10}000 yen?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_16"
msgid "What,{PA:10} ya don't even got 200,{PA:10}000?!{PA:20}||Broke-ass deadbeat!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_17"
msgid "Hear that,{PA:10} baby?{PA:20} Yer daddy here's a broke-||ass deadbeat.{PA:20} Yes he is!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_18"
msgid "Now bring me that money!{PA:20}||I'm not movin' from here until ya do!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_19"
msgid "Do I look stupid?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_20"
msgid "Yeah,{PA:10} maybe!{PA:20} Stupid enough to ruin a fine||young lady and her baby's life!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_21"
msgid "Everybody,{PA:10} listen!{PA:20} This here limp dick||had his way with me,{PA:10} then up and left me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_0_22"
msgid "Says he's gonna let me and our poor little||baby starve out on the streets!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_1_0"
msgid "Hey,{PA:10} honey!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_1_1"
msgid "Honeeey!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:305_1_2"
msgid "YO!{PA:20} HONEY!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:308_0_0"
msgid "(Hm?{PA:20} There's a stuffed toy on the ground.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:308_0_1"
msgid "(Is this the \"{CC:ffc8c8}Robot Manager{CR:00}\" doll I caught?!)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:308_0_2"
msgid "   You picked up the Robot Manager doll.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_0"
msgid "Heh.{PA:20} {PA:10}Strong as they said ya were.{PA:20}.{PA:20}.{PA:10}{PA:20}||My loss,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_1"
msgid "I'll tell ya about Tatsu,{PA:10} as promised.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_2"
msgid "There's a guy sleepin' down by the river.{PA:20}||Name's Murata,{PA:10} yeah?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_3"
msgid "Tell him Kinoshita sent ya.{PA:20}||He'll call Tatsu for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_4"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_5"
msgid "Any time ya want Tatsu,{PA:10} just talk to Murata.{PA:20}||He'll put ya through,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_0_6"
msgid "You're good to go,{PA:10} pal.{PA:20} See ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_1_0"
msgid "Ah,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_1_1"
msgid "Not that I doubt ya,{PA:10} of course.{PA:20}||Just can't waste Tatsu's time,{PA:10} ya know?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_1_2"
msgid "Gotta see if you're the real deal.{PA:20}||No handicaps,{PA:10} no rules.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:309_1_3"
msgid "Just us.{PA:20} Let's see what ya got!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_0"
msgid "*Sigh*||Can't sing for shit with a stuffy nose.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_3"
msgid "     Will you offer him pocket tissues?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_4"
msgid "        You gave him pocket tissues.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_5"
msgid "Hey,{PA:10} hey!{PA:20}||Pretty thoughtful guy,{PA:10} ain't ya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_6"
msgid "Guys like you get rewarded in life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_7"
msgid "             You befriended the||            wandering guitarist!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_8"
msgid "Received 200 experience points.{PA:20}"
msgstr ""

