msgid " Will you offer him tissues with a flier?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_11"
msgid "     You gave him tissues with a flier.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_12"
msgid "Hey,{PA:10} hey!{PA:20}||Pretty thoughtful guy,{PA:10} ain't ya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_13"
msgid "Guys like you get rewarded in life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_14"
msgid "             You befriended the||            wandering guitarist!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_15"
msgid "Received 200 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_0_17"
msgid "Selfish prick.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_1_0"
msgid "Bluaa-CHOO!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_1_1"
msgid "B-B-Brrrr!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_2_0"
msgid "Mi.{PA:20}.{PA:20}.{PA:20} Mi mi miii.{PA:20} La la la laaa.{PA:20}||Shit,{PA:10} I sound great.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:311_3_0"
msgid "||||||{IC:00_06}➿"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_1"
msgid "You live up to your reputation.{PA:20}.{PA:20}.{PA:20}||Kazuma Kiryu,{PA:10} heir to the Komaki School.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_2"
msgid "And just who are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_3"
msgid "My name is Soei Kawachi.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_4"
msgid "Kawachi.{PA:20}.{PA:20}.{PA:20}||The guy that sent me those high-school kids?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_5"
msgid "The same.{PA:20} I apologize for that,{PA:10} but I needed||to test your abilities.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_6"
msgid "I was impressed to see you throw those na-||tionally ranked fighters around like dolls.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_7"
msgid "What's your angle,{PA:10} kid?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_8"
msgid "I was born into the direct lineage of the||Kawachi School of martial arts.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_9"
msgid "Regarded as the most powerful art in the||west,{PA:10} as the Komaki School is to the east.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_10"
msgid "Our two styles have long stood as the twin||pillars of Japanese martial arts.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_11"
msgid "I am the second son of the Kawachi house.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_12"
msgid "And what's your business with me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_13"
msgid "We here in Kansai caught wind of a rumor||that Komaki passed on his school.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_14"
msgid "and every technique he had to a certain man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_15"
msgid "One \"Kazuma Kiryu\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_16"
msgid "We've been following your activities since.{PA:20}||I hope you'll forgive our intrusion.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_17"
msgid "Hold on a minute.{PA:20} I'm Kiryu,{PA:10} but I don't||remember Komaki passing his school on.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_18"
msgid "View it how you will,{PA:10} the rest of the world||believes you to be his successor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_19"
msgid "You're his only pupil to ever be taught all||of his Ultimate Three.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_20"
msgid "Okay.{PA:20}.{PA:20}.{PA:20} I'm starting to get the picture.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_21"
msgid "So you're after me now to show that your||school's the stronger one?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_22"
msgid "No,{PA:10} sir.{PA:20}"
msgstr "... ¡N{PA:10}o, señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_23"
msgid "Then what are you after?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_24"
msgid "There's a man I'd like you to defeat.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_25"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_26"
msgid "My brother.{PA:20} Eldest son of the Kawachi family||and third master of the Kawachi School.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_27"
msgid "You want me to beat up your brother?{PA:20}"
msgstr "Entonces, ¿quieres que me enfrente a tu hermano?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_28"
msgid "Yes.{PA:20}.{PA:20}.{PA:20} He's like a man possessed.{PA:20}||His obsession with jujutsu is.{PA:20}.{PA:20}.{PA:20} unhealthy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_29"
msgid "Ours has always been a throwing art.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_30"
msgid "He spends his days tracking down fighters||and throwing them to the ground.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_31"
msgid "Always after the perfect art.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_32"
msgid "He's roamed the country,{PA:10} crushing dojo after||dojo,{PA:10} never satisfied.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_33"
msgid "Then,{PA:10} last month.{PA:20}.{PA:20}.{PA:20}||He set his sights on Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_34"
msgid "Don't tell me.{PA:20}.{PA:20}.{PA:20}"
msgstr "No me digas que persona er{PA:20}a.{PA:20}..{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_35"
msgid "Yes.{PA:20}||He went there looking for you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_36"
msgid "As his brother,{PA:10} it pains me to see him live||this way.{PA:20} He'll never find peace like this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_37"
msgid "Please,{PA:10} I beg of you to stop him.{PA:20}||Snap him out of this obsession,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_38"
msgid "(He seems pretty sincere.{PA:20}||Do I help the kid out?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_39"
msgid "Sorry,{PA:10} kid,{PA:10} but I've got my own worries now.{PA:20}||Find someone else to stop your brother.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_40"
msgid "I see.{PA:20}.{PA:20}.{PA:20} Sorry to have imposed on you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_41"
msgid "All right.{PA:20}||How do I find him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_42"
msgid "In a recent letter,{PA:10} he said he'd found a way||to face you one-on-one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_43"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mm.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_44"
msgid "Something about being \"secret\".{PA:20}.{PA:20}.{PA:20}?{PA:20}||No,{PA:10} it was \"underground\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_45"
msgid "I don't know any details past that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_46"
msgid "(Underground.{PA:20}.{PA:20}.{PA:20} The tournaments?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_47"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_48"
msgid "I'll go see him when I get back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_49"
msgid "Thank you.{PA:20}.{PA:20}.{PA:20} And here,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Please,{PA:10} take this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_50"
msgid "  You received the \"{CC:ffffc8}Kawachi Family History{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_52"
msgid "I'd advise you to learn what's written in||there before facing him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_53"
msgid ".{PA:20}.{PA:20}.{PA:20}All right.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} De acuerdo.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_54"
msgid "Please.{PA:20}.{PA:20}.{PA:20} Set him free.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_55"
msgid "(.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_56"
msgid "     You glanced through the contents.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_0_57"
msgid "  You learned the \"{CC:ffc8c8}Kawachi Reversal{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_0"
msgid "Can I ask you to shake my brother out of his||obsession,{PA:10} Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_1"
msgid "Sorry,{PA:10} kid,{PA:10} but I've got my own worries now.{PA:20}||Find someone else to stop your brother.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_2"
msgid "I see.{PA:20}.{PA:20}.{PA:20} Sorry to have imposed on you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_3"
msgid "All right.{PA:20}||How do I find him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_4"
msgid "In a recent letter,{PA:10} he said he'd found a way||to face you one-on-one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_5"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mm.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_6"
msgid "Something about being \"secret\".{PA:20}.{PA:20}.{PA:20}?{PA:20}||No,{PA:10} it was \"underground\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_7"
msgid "I don't know any details past that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_8"
msgid "(Underground.{PA:20}.{PA:20}.{PA:20} The tournaments?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_9"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_10"
msgid "I'll go see him when I get back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_11"
msgid "Thank you.{PA:20}.{PA:20}.{PA:20} And here,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Please,{PA:10} take this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_12"
msgid "  You received the \"{CC:ffffc8}Kawachi Family History{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_14"
msgid "I'd advise you to learn what's written in||there before facing him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_15"
msgid ".{PA:20}.{PA:20}.{PA:20}All right.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} De acuerdo.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_16"
msgid "Please.{PA:20}.{PA:20}.{PA:20} Set him free.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_17"
msgid "(.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_18"
msgid "     You glanced through the contents.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_1_19"
msgid "  You learned the \"{CC:ffc8c8}Kawachi Throw Reversal{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_2_1"
msgid "Ah!{PA:20} Mr.{PA:20} Kiryu!{PA:20}||Thank you so much,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_2_2"
msgid "Has your brother come back home?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_2_3"
msgid "Yes,{PA:10} sir!{PA:20} He said his fight with you really||opened his eyes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_2_4"
msgid "That's good to hear.{PA:20}||Take care of yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_2_5"
msgid "Oh!{PA:20} Please,{PA:10} wait!{PA:20}||Here.{PA:20}.{PA:20}.{PA:20} A gift,{PA:10} from the Kawachi School.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:312_2_6"
msgid "        You received a \"{CC:ffffc8}black belt{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_2"
msgid "Hm?{PA:20} What?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_3"
msgid "You Kazuma Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_4"
msgid "Yes.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr "Sí.{PA:20}.{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_5"
msgid "Gotta ask ya a favor,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_6"
msgid "I'm listening.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_7"
msgid "I know it's outta the blue 'n' all,{PA:10} but||would ya do some judo with us?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_8"
msgid ".{PA:20}.{PA:20}.{PA:20}Judo?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_9"
msgid "Yeah.{PA:20} Well,{PA:10} not yer normal judo,{PA:10} of course.{PA:20}||Ain't got the setup for that here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_10"
msgid "Just throwin' each other around a little.{PA:20}||Here on the street,{PA:10} I mean.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_11"
msgid "Why would you want me to throw you around on||the street?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_12"
msgid "Well,{PA:10} believe it or not,{PA:10} pal,{PA:10} I'm the guy||they call the Kansai Bear.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_13"
msgid "I'm pretty famous in the amateur judo world.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_14"
msgid "The other boys here're all up 'n' comin'||talents here in the west,{PA:10} too.{PA:20} Heh heh.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_15"
msgid ".{PA:20}.{PA:20}.{PA:20}And?{PA:20}"
msgstr "..{PA:20}. {PA:20}¿Y{PA:20} luego?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_16"
msgid "The Kansai Bear,{PA:10} man!{PA:20} Tough as a damn BEAR!{PA:20}||Ya ever fought a BEAR before?!{PA:20} C'mon!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_17"
msgid "Just get to the point.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_18"
msgid "*Sigh*"
msgstr "Ay..."

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_19"
msgid "Well,{PA:10} we got a request here.{PA:20}||Like a mission,{PA:10} ya might call it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_20"
msgid "Throw down against Kazuma Kiryu,{PA:10} it said.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_21"
msgid "A request from who?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_22"
msgid "Another kid at our high school.{PA:20}||Totally loaded.{PA:20} Kid's richer'n God,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_23"
msgid "Name's Kawachi.{PA:20} Maybe ya heard o' the guy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_24"
msgid "Kawachi?{PA:20} .{PA:20}.{PA:20}.{PA:20}Doesn't sound familiar.{PA:20}||And wait,{PA:10} you kids are high schoolers?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_25"
msgid "Yeah,{PA:10} ya know.{PA:20}||Anyhow,{PA:10} that's why we're here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_26"
msgid "Kid says if we take ya on,{PA:10} he'll give us||100K apiece.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_27"
msgid "So why throwing?{PA:20} And why should I help?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_28"
msgid "I've got no reason to fight you kids.{PA:20}||You haven't done anything to me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_29"
msgid "C'mon,{PA:10} buddy,{PA:10} please?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_30"
msgid "We don't go at it with Kazuma Kiryu,{PA:10} we||don't get paid 100K!{PA:20} What a waste!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_31"
msgid "Oh,{PA:10} and uh,{PA:10} Kawachi said it was personal.{PA:20}||His revenge against the Komaki School.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_32"
msgid "He mentioned Komaki?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_33"
msgid "S-So c'mon!{PA:20} Please?{PA:20}||Let's do this!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_34"
msgid "Please,{PA:10} buddy?{PA:20}||Just a quick round!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_35"
msgid "Sorry,{PA:10} but I'm in the middle of something||right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_36"
msgid "Yeah?{PA:20} Well,{PA:10} we'll wait for ya here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_0_37"
msgid "Any time ya want,{PA:10} c'mon down 'n' fight!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_1_0"
msgid "Sir?{PA:20} Hey,{PA:10} pal.{PA:20}||Excuse me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_2_1"
msgid "*Huff* *Haw*||N-No good.{PA:20} Guy's too strong.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_2_2"
msgid "You done?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_2_3"
msgid "Yes,{PA:10} sir!{PA:20} Ya got us beat.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_2_4"
msgid "Plus that's all we needed to get our money.{PA:20}||We can go home happy now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_2_5"
msgid "Heh,{PA:10} congratulations.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_2_6"
msgid "Well,{PA:10} thanks for yer help,{PA:10} sir.{PA:20}||Have a good one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_3_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20} I've got to warn you,{PA:10} though,{PA:10} I'm||not throwing a fight for you kids.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_3_2"
msgid "No problem,{PA:10} pal!{PA:20} C'mon at us full bore!{PA:20}||We're all set here.{PA:20} Let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_4_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20} I'll play along.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_4_2"
msgid "Thanks,{PA:10} pal!{PA:20} .{PA:20}.{PA:20}.{PA:20}Oh,{PA:10} but it looks like ya||got some equipment on,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:313_4_3"
msgid "Sorry,{PA:10} but we gotta ask ya to take it off.{PA:20}||Wouldn't be fair otherwise,{PA:10} follow?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_3"
msgid "Kazuma!{PA:20}"
msgstr "¡Kazuma!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_4"
msgid "Who are you?!{PA:20}"
msgstr "¿Quién es usted?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_5"
msgid "Stay away from her.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_6"
msgid "I'm just talking to Aya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_7"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_8"
msgid "Aya baby.{PA:20}.{PA:20}.{PA:20}||Why are you looking at me like that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_9"
msgid "You always said my presents made you happy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_10"
msgid "You love me,{PA:10} don't you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_11"
msgid "No!{PA:20} I'm.{PA:20}.{PA:20}.{PA:20} I'm in love with someone else.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_12"
msgid "You're such a joker,{PA:10} Aya.{PA:20}||Always kidding around.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_13"
msgid "You're a brave man,{PA:10} hitting on my woman.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_14"
msgid "Kazuma!{PA:20}"
msgstr "¡Kazuma!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_15"
msgid "I-I'm not afraid of you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_0_16"
msgid "I.{PA:20}.{PA:20}.{PA:20}||I'll protect Aya from you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_1_0"
msgid "Aya baby.{PA:20}.{PA:20}.{PA:20} Aya baby.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_2_0"
msgid "Ngaah!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_2_1"
msgid "You stay away from her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_2_2"
msgid "Understand?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_2_3"
msgid "Uwaaah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_3_3"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}||I thought you'd be alone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_3_4"
msgid "Is something wrong?{PA:20}||Is that guy threatening you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:315_3_5"
msgid "N-No,{PA:10} it's fine.{PA:20}||I'm fine.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_2"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_3"
msgid "That guy was a fan of mine from back when||I first started out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_4"
msgid "Yeah?{PA:20}"
msgstr "¿Sí?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_5"
msgid "The letters he used to write me used to make||me happy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_6"
msgid "I'd go to him for advice.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_7"
msgid "But as soon as I quit,{PA:10} he changed.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_8"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_9"
msgid "He's been stalking me ever since.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_10"
msgid "It must have been tough.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_11"
msgid "But you saved me.{PA:20}||I can finally sleep soundly tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_12"
msgid "Heh,{PA:10} glad to hear it.{PA:20}"
msgstr "Je.{PA:10} Qué bueno.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_13"
msgid "Brr.{PA:20}.{PA:20}.{PA:20}||It's getting kinda chilly,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_14"
msgid "Yeah,{PA:10} it is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_15"
msgid "Mmm.{PA:20}.{PA:20}.{PA:20} You're so warm.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_16"
msgid "Let's go get warm together.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_18"
msgid "Nobody would have to know.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_19"
msgid "Just you and me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:316_0_20"
msgid "Would that be okay.{PA:20}.{PA:20}.{PA:30}{PA:20}||{MS:0}Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:317_0_0"
msgid "Stay away from me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:320_0_0"
msgid "Whaddya want||this year,{PA:10} babe?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:321_0_0"
msgid "It's almost Christmas,{PA:10}||ain't it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:323_0_0"
msgid "You're still there?!{PA:20}||Hurry over here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0307.ARC/TALK_ST_KAB0307.BIN::line:323_1_0"
msgid "I don't think I can||make it home tonight.{PA:20}"
