msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:296_1_0"
msgid "That's you,{PA:10} right,{PA:10} Anna?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:296_1_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Do I know you?{PA:20}||Mister,{PA:10} are you drunk?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:296_1_2"
msgid "S-Sorry.{PA:20}.{PA:20}.{PA:20}||I thought you were someone else.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:296_1_3"
msgid "(Guess that wasn't Anna.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:299_0_0"
msgid "I don't get the rules.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:301_0_0"
msgid "You'd better not be||cheating here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:302_0_0"
msgid "Prize Redemption"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:302_1_0"
msgid "Welcome,{PA:10} sir.{PA:20} You can trade in chips for||prizes here,{PA:10} if you care to.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:302_1_2"
msgid "Thank you very much.{PA:20}||Please come again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:302_1_3"
msgid "Understood,{PA:10} sir.{PA:20}||Please come again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_0"
msgid "Hello,{PA:10} sir.{PA:20} Any questions about how to play||any of the games here at the casino?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_1"
msgid "Which game would you like||to hear about?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_2"
msgid "I'm fine,{PA:10} thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_3"
msgid "Oh,{PA:10} I see.{PA:20} Well,{PA:10} if you have any questions,{PA:10}||please don't hesitate to ask.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_4"
msgid "How do you play||blackjack?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_5"
msgid "The point of the game is to get the sum of||your cards as close to 21 as possible.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_6"
msgid "Go over 21,{PA:10} though,{PA:10} and you lose.{PA:20}||That's called going bust.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_7"
msgid "The game begins with you choosing how many||chips to bet on that hand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_8"
msgid "You're basically playing against the dealer.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_9"
msgid "If you're closer than them to 21,{PA:10} you win.{PA:20}||You'll get twice your original bet back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_10"
msgid "If you have the same total,{PA:10} you tie,{PA:10} and||you'll get your original bet back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_11"
msgid "An ace plus a 10 or higher is the strongest||hand,{PA:10} called blackjack.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_12"
msgid "Unless the dealer also has blackjack,{PA:10} you'll||win 2.{PA:20}5 times your original bet back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_13"
msgid "But if you choose to split,{PA:10} even a two-card||hand totaling 21 won't count as blackjack.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_14"
msgid "Would you like to hear more details,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_15"
msgid "Yeah,{PA:10} what more can you tell me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_16"
msgid "I'll explain splits,{PA:10} double down and||surrenders.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_17"
msgid "I should also briefly mention \"insurance\",{PA:10}||as well.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_18"
msgid "You can choose to split your hand if the two||cards you're dealt are two of a kind.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_19"
msgid "You can play them as two separate hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_20"
msgid "Double down is the option to double your bet||after seeing the two cards you're dealt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_21"
msgid "If you double down,{PA:10} though,{PA:10} you're required||to hit,{PA:10} which is to draw a card.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_22"
msgid "Surrendering lets you bow out of the game.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_23"
msgid "You'll collect half of your bet back,{PA:10} so use||it if you know you're unable to win.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_24"
msgid "Insurance is just as the term suggests.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_25"
msgid "You can use it if the dealer's exposed card||is an ace.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_26"
msgid "If you choose to use it,{PA:10} you'll need to bet||an additional 50% of your original bet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_27"
msgid "If the dealer does have blackjack,{PA:10} you'll||get twice your bet back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_28"
msgid "If the dealer doesn't,{PA:10} however,{PA:10} you'll lose||your bet,{PA:10} so choose wisely.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_29"
msgid "That's all you need to know!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_30"
msgid "Tell me how to play||roulette.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_31"
msgid "It's a game where players bet on which slot||on the roulette wheel the ball will stop on.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_32"
msgid "It's quite famous,{PA:10} sir.{PA:20} Enough so that it's||earned the title \"queen of the casino\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_33"
msgid "Depending on where you place your bet,{PA:10} you||can win 2 to 36 times your bet back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_34"
msgid "Bets are placed as the wheel is spinning,{PA:10}||and can continue up until the ball stops.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_35"
msgid "If you like,{PA:10} you can wait until the last||minute and try to predict the ball's path.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_36"
msgid "House rules state that bets may be placed||on up to 32 different locations.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_37"
msgid "Betting will end automatically once you||place your 32nd bet,{PA:10} so bet carefully.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_38"
msgid "That's all you need to know!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_39"
msgid "What are gambler's charms?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_40"
msgid "Supposedly,{PA:10} special talismans exist that||raise a person's luck a thousandfold.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_41"
msgid "If you believe in that sort of thing,{PA:10} it'd||be awfully handy in a casino!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_42"
msgid "They say they vanish after one use,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_43"
msgid "And you can't use more than one at a time.{PA:20}||Only the last one used will take effect.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_44"
msgid "Rumors suggest there are five kinds in all,{PA:10}||and that you can tell them by their names.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_45"
msgid "I doubt they exist,{PA:10} but if you do find one,{PA:10}||why not give it a try on the down-low?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_46"
msgid "How do you play baccarat?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_47"
msgid "Players try to guess which of two groups of||cards total closer to 9.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_48"
msgid "All players need to do is bet on which hand||they think will win.{PA:20} It's quite simple.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_49"
msgid "The dealer begins by dealing two cards each.{PA:20}||The hands are called \"Player\" and \"Banker\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_50"
msgid "The cards in the Player and Banker hands are||revealed one by one in that order.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_51"
msgid "In some cases,{PA:10} a third card can be dealt.{PA:20}||Once revealed,{PA:10} the hand closer to 9 wins.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_52"
msgid "Tens and face cards count as 0,{PA:10} aces as 1.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_53"
msgid "If the total exceeds 10,{PA:10} only the last digit||of the total is counted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_54"
msgid "Once the winning hand is decided,{PA:10} players||who chose correctly collect their winnings.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_55"
msgid "A correct guess will earn twice your bet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_56"
msgid "You can also bet that the two hands will||have an equal total by betting on \"tie\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_57"
msgid "Should the Player and Banker hands tie,{PA:10} you||collect back eight times your bet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_58"
msgid "Those who bet on Player or Banker get back||their original bet in the case of a tie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_59"
msgid "The probability of a tie is quite low,{PA:10} but||the potential winnings are considerable.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_60"
msgid "Those are the basic rules,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_61"
msgid "That said,{PA:10} it's an unfamiliar game for many||people.{PA:20} Shall I explain it in more detail?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_62"
msgid "Yeah,{PA:10} what more can you tell me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_63"
msgid "The rules regarding that third card are the||trickiest part of baccarat.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_64"
msgid "If neither the Player nor Banker hands total||8 or 9,{PA:10} the game continues.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_65"
msgid "Let's begin with the rules for when the||Player hand totals 6 or 7.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_66"
msgid "In that case,{PA:10} the Player is not allowed to||draw a third card.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_67"
msgid "At the same time,{PA:10} the Banker would only be||allowed to draw with a total of 5 or below.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_68"
msgid "If neither can draw,{PA:10} the game ends there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_69"
msgid "Now,{PA:10} if the Player hand totals 5 or less,{PA:10}||the rules get interesting.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_70"
msgid "In that case,{PA:10} the Player draws a third card,{PA:10}||adding to their total.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_71"
msgid "Whether the Banker draws a third card or not||depends on the standing Banker hand total"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_72"
msgid "and what the Player drew as a third card.{PA:20}||Each combination has a specific rule.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_73"
msgid "I'll list them for you in order:"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_74"
msgid "If the Banker total is 7,{PA:10} the Banker does||not draw a third card.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_75"
msgid "If the Banker total is 6,{PA:10} and the third card||drawn by the Player is a 6 or 7.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_76"
msgid "The Banker draws a third card.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_77"
msgid "If the Banker total is 5,{PA:10} and the third card||drawn by the Player is a 4,{PA:10} 5,{PA:10} 6 or 7.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_78"
msgid "The Banker draws a third card.{PA:20}||If the Banker total is 4,{PA:10} and the third card"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_79"
msgid "drawn by the Player is a 2 through 7.{PA:20}.{PA:20}.{PA:20}||The Banker draws a third card.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_80"
msgid "If the Banker total is 3,{PA:10} and the Player's||third card is anything other than an 8.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_81"
msgid "The Banker draws a third card.{PA:20}||If the Banker total is 2 or below,{PA:10} the"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_82"
msgid "Banker draws a third card.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_83"
msgid "Once the third card is drawn,{PA:10} the game ends||and the hand closer to 9 at the end wins.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_84"
msgid "Honestly,{PA:10} it makes more sense to see it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_85"
msgid "I'd recommend playing for a while,{PA:10} then||coming back if you still have questions.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_86"
msgid "That big list of numbers will make a lot||more sense once you've seen it in action.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_0_87"
msgid "That should be enough info to start!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:303_1_0"
