msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_2"
msgid "Igarashi!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_3"
msgid "There you are!{PA:20} I've been looking for you.{PA:20}||Come on,{PA:10} let's get back to work!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_4"
msgid "Igarashi,{PA:10} I.{PA:20}.{PA:20}.{PA:20} I just gave our company to||this man here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_5"
msgid "You WHAT?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_6"
msgid "After all those times you said the company||was worth more than your life?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_7"
msgid "I'm sorry,{PA:10} it's because I'm so weak.{PA:20}.{PA:20}.{PA:20} I.{PA:20}.{PA:20}.{PA:20}||I'll never gamble again!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_8"
msgid "How many times have I heard THAT before?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_9"
msgid "Plus you saying that now doesn't mean much,{PA:10}||considering we don't have jobs anymore!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_10"
msgid "Um.{PA:20}.{PA:20}.{PA:20} Sir.{PA:20} I'm begging you.{PA:20}||Can I have that deed back?{PA:20} Please?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_11"
msgid "I'll leave this with you for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_12"
msgid "If I ever hear that you're gambling again,{PA:10}||I'll be back for it.{PA:20} Am I understood?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_13"
msgid "You'd really let me have it back?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_14"
msgid "Your business is mine to do with as I like.{PA:20}||For now,{PA:10} I'll bet on you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_15"
msgid "Thank you so much!{PA:20}||We'll make it work,{PA:10} I swear!{PA:20} Right,{PA:10} boss?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_16"
msgid "Thank you.{PA:20}.{PA:20}.{PA:20} Thank you,{PA:10} thank you!{PA:20}||I promise I'll make it work this time!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_17"
msgid "I'm afraid I can't give it back to you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_18"
msgid "I see.{PA:20}.{PA:20}.{PA:20} I guess if he already gave it to||you,{PA:10} then that's that.{PA:20}"
