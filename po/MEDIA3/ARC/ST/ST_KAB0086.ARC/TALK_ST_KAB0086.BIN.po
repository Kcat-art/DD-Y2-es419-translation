msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_19"
msgid "We'll have to rebuild it all from scratch.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:288_0_20"
msgid "I.{PA:20}.{PA:20}.{PA:20} I'm so sorry,{PA:10} Igarashi.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0086.ARC/TALK_ST_KAB0086.BIN::line:289_0_0"
