msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:293_0_0"
msgid "It's me.{PA:20} Yuya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:293_1_0"
msgid "No,{PA:10} sir.{PA:20} I work with him here at the club.{PA:20}||He's not in at the moment,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:293_1_1"
msgid "But we're in serious trouble here!{PA:20}||Those men from before are back!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_3"
msgid "Hm?{PA:20} I know you.{PA:20}.{PA:20}.{PA:20}||You're Kazuma Kiryu,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Have we met?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_5"
msgid "Word gets around here in homeless central.{PA:20}||Besides,{PA:10} you're the champ!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_6"
msgid "Oh,{PA:10} you're with the underground tournament?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_7"
msgid "Some of the time,{PA:10} anyway.{PA:20}||Name's Cyclops Oba.{PA:20} Good to meet you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_8"
msgid "A pro wrestler,{PA:10} huh?{PA:20}||So what got you out here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_9"
msgid "Eh,{PA:10} I busted a rib in the ring a while back.{PA:20}||I'm taking it easy here while I heal up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_10"
msgid "I see.{PA:20} Sorry to bother you,{PA:10} then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_11"
msgid "Whoa,{PA:10} hold up,{PA:10} champ!{PA:20} This injury's got me||wondering about something.{PA:20} Got a minute?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_12"
msgid "Well,{PA:10} champ?{PA:20} Got a minute?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_13"
msgid "Sorry,{PA:10} but I'm pretty busy right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_14"
msgid "Yeah,{PA:10} I'll bet.{PA:20} Anyway,{PA:10} that's fine,{PA:10} forget||I asked.{PA:20} See you around or whatever.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_16"
msgid "Sure.{PA:20} What's up?{PA:20}"
msgstr "Claro{PA:20}. ¿Qué pasa?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_17"
msgid "Aw,{PA:10} thanks,{PA:10} man!{PA:20}||You're a good guy,{PA:10} champ.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_18"
msgid ".{PA:20}.{PA:20}.{PA:20}So what's your question?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_19"
msgid "Well,{PA:10} I've been doing some heavy physical||therapy,{PA:10} but I don't know how healed I am.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_20"
msgid "Sooo,{PA:10} any chance I could get in a quick bit||of sparring with you,{PA:10} champ?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_21"
msgid "I figure if I can last a couple rounds with||the strongest man in Japan,{PA:10} I'm all set.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_22"
msgid "I'll make it worth your while.{PA:20}||So,{PA:10} what do you say?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_23"
msgid "Hm?{PA:20} You decide to do some sparring?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_24"
msgid "Hm?{PA:20} You back for another round?{PA:20}||I'm always up for some sparring!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_26"
msgid "Sorry,{PA:10} I'm in the middle of something now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_0_27"
msgid "Yeah,{PA:10} I'll bet.{PA:20} Anyway,{PA:10} that's fine,{PA:10} forget||I asked.{PA:20} See you around or whatever.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_1_0"
msgid "Sure,{PA:10} I'm up for a quick round.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_1_1"
msgid "Really?{PA:20} Great!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_1_2"
msgid "Damn,{PA:10} today's my lucky day.{PA:20} I get to train||with the king of the ring!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_1_3"
msgid "Well,{PA:10} if you're ready to do it,{PA:10} let's get||to it,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_1"
msgid "*Huff* *Haah*||You trashed me,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_2"
msgid "Part of that's you being a beast,{PA:10} but I can||tell my stupid rib's still busted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_3"
msgid "It'll be a while before I'm back in the ring.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_4"
msgid "I'll cool my heels here for a while longer.{PA:20}||Thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_5"
msgid "Sure.{PA:20} Take care of yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_6"
msgid "Will do.{PA:20} Oh,{PA:10} and here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_7"
msgid "                You received||    \"{CC:ffffc8}Goriki Terayama's \"All About Tag Team\"{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_9"
msgid "It was written by my wrestling mentor.{PA:20}||It's out of print these days.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_10"
msgid "Even a pile of bricks like me could follow||it,{PA:10} so you should get it in a snap.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_11"
msgid "Anyway,{PA:10} take a look sometime.{PA:20} I look forward||to sparring again when I'm back in shape.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_12"
msgid "(.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:294_2_13"
msgid "     You glanced through the contents.{PA:20}"
