msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_1"
msgid "Um.{PA:20}.{PA:20}.{PA:20} Is something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_3"
msgid "Yeah,{PA:10} I remember.{PA:20}||Has something happened to him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_5"
msgid "Well,{PA:10} that's good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_7"
msgid "Ah.{PA:20}"
msgstr "Ah...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_9"
msgid "A what?!{PA:20}"
msgstr "¿Una qué?...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_12"
msgid "I think building a park on one person's||savings is an awfully big dream.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_13"
msgid "I'll see what I can find.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_17"
msgid "Okay,{PA:10} I'll see what I can find.{PA:20}"
msgstr "Entie{PA:10}ndo. Veré qué puedo averiguar{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_18"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_0_21"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_0"
msgid "Hello,{PA:10} Mr.{PA:20} Kiryu?{PA:20}||This is Ms.{PA:20} Suenaga,{PA:10} from Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_1"
msgid "Mr.{PA:20} Kiryu,{PA:10} I'll never forget all your help.{PA:20}||No matter what happens.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_3"
msgid "Wrong?{PA:20} Oh,{PA:10} no.{PA:20}.{PA:20}.{PA:20} I mentioned the headmaster||was resting up at home before,{PA:10} didn't I?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_5"
msgid "No,{PA:10} no!{PA:20} He's feeling worlds better!{PA:20}||Well enough to come back to work,{PA:10} actually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_7"
msgid "Yes,{PA:10} it's wonderful.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_8"
msgid "But it does mean my time with the children||is coming to an end.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_10"
msgid "It was only six months,{PA:10} but saying goodbye||to them is so hard.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_11"
msgid "So I've decided to make a gift to them.{PA:20}||I'd like to give them a park!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_13"
msgid "A park!{PA:20}||Something that will last.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_14"
msgid "Still,{PA:10} it takes more than pocket change and||good intentions to get a park built.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_15"
msgid "Mr.{PA:20} Kiryu,{PA:10} could I ask you to help me find||an affordable contractor?{PA:20} For the kids!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_18"
msgid "I realize it's a stretch,{PA:10} I really do!{PA:20}||But still,{PA:10} I want to do this for them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_19"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_20"
msgid "I'll keep trying on my end as well!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_23"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:19_1_24"
msgid "私も、{PA:10}もう少し色々あたってみます！{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_0_6"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_0_7"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_0_8"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_0_9"
msgid "(I've got nobody to call.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_0_11"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_0_13"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_3"
msgid "Hello.{PA:20} Imitation Renovating here.{PA:20}||What can I do you for?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_4"
msgid "It's Kiryu.{PA:20}"
msgstr "Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_5"
msgid "M-Mr.{PA:20} Kiryu!{PA:20} Boss!{PA:20} Yes,{PA:10} sir!{PA:20}||H-How can we help you today?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_6"
msgid "The folks at Sunflower want to build a kids'||park,{PA:10} but they're low on money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_7"
msgid "Can you do something for them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_8"
msgid "Yes,{PA:10} sir!{PA:20} Of course!{PA:20} Leave it to us,{PA:10} and||we'll whip something up for cheap!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_1_9"
msgid "Thanks.{PA:20}||That sounds great.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_4"
msgid "Hello?{PA:20}"
msgstr "¿Hola?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_6"
msgid "I'd like to ask about Keima.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_7"
msgid "How many stairs are in Tsutenkaku Tower?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_8"
msgid "The number of stairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_12"
msgid ".{PA:20}.{PA:20}.{PA:20}||Black bear,{PA:10} grilled guts,{PA:10} three times.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_13"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_15"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:20_2_16"
msgid "He hung up on me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_0_0"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr "¿Cómo van las cosas por ahí?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_2_5"
msgid "Yeah,{PA:10} I'll make it.{PA:20} I might not be a rock||like you,{PA:10} but I can still take a beating.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:28_2_7"
msgid "I've got it covered.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:30_0_0"
msgid "Tamiyo"
msgstr "Tamiyo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:30_1_0"
msgid "This is Kiryu.{PA:20}"
msgstr "Habla Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:30_1_2"
msgid "Oh,{PA:10} hello.{PA:20}||How is she doing?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:30_1_4"
msgid "That's good.{PA:20}"
msgstr "Qué bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0224.ARC/TALK_ST_KAB0224.BIN::line:30_1_6"
