msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::name:5"
msgid "Il Yu-Jin"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_1"
msgid "Wait,{PA:10} you're going in here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_2"
msgid "(I've got Sayama with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_3"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_4"
msgid "Doesn't look like I have much of a choice.{PA:20}||Fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_5"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_6"
msgid "You sure?{PA:20} I don't really care.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_7"
msgid "Are you going in here,{PA:10} Uncle Kaz?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_8"
msgid "(I've got Haruka with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_9"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Okay.{PA:20} I'll stay right here.{PA:20}||Have fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_11"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_12"
msgid "Really?{PA:20} If it's because of me,{PA:10} you don't||have to,{PA:10} Uncle Kaz.{PA:20} I'll be fine here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_13"
msgid "Whoa,{PA:10} whoa.{PA:20} Kazuma,{PA:10} you're going in HERE?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_14"
msgid "(I've got Date with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_15"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_16"
msgid "Well,{PA:10} I guess I'll wait out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_17"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_18"
msgid "You sure?{PA:20} Won't bother me.{PA:20}||I can keep myself busy for an hour.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_19"
msgid "You're not thinking of going in,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_20"
msgid "(I've got Daigo with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_21"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_22"
msgid "Hey,{PA:10} you're the boss,{PA:10} man.{PA:20}||I'll just wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_23"
msgid "Thanks,{PA:10} Daigo.{PA:20} I'll catch up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_24"
msgid "No,{PA:10} not right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_2_25"
msgid "Yeah?{PA:20} Well,{PA:10} a'ight then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_3_1"
msgid "*Sigh* Finally.{PA:20}||Now c'mon,{PA:10} let's get out of here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_3_2"
msgid "You took foreeever!{PA:20}||I'm bored,{PA:10} let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_3_3"
msgid "All done with your fun?{PA:20}||Let's get back to work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_3_4"
msgid "Fucking finally.{PA:20}||Let's go already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0052.ARC/TALK_ST_KAB0052_BTL.BIN::line:138_5_0"
msgid "No,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||This not where I wanted to go.{PA:20}"
msgstr ""

