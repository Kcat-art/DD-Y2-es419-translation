msgid "This is Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:30_1_2"
msgid "Oh,{PA:10} hello.{PA:20}||How is she doing?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:30_1_4"
msgid "That's good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:30_1_6"
msgid "Just the bandages?{PA:20}||I'll pick some up on my way there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:30_2_0"
