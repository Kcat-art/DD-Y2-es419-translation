msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_3_2"
msgid "Never in my wildest dreams did I see this||club rising to such success.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_3_3"
msgid "You've done amazingly,{PA:10} sir.{PA:20}"
