msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_13"
msgid "I wouldn't get my hopes up.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_14"
msgid "I see.{PA:20}.{PA:20}.{PA:20} You're probably right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_15"
msgid "But I'll go pay a little visit to Lilith.{PA:20}||I'll see what I can find out.{PA:20}"
msgstr ""

