msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_1_1"
msgid "We need another top-grade cabaret girl.{PA:20}||Someone who can fill Chinatsu's place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_1_2"
msgid ".{PA:20}.{PA:20}.{PA:20}I'll see who I can scout out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_1_3"
msgid "Thank you,{PA:10} sir.{PA:20} And remember,{PA:10} Lilith is||located on Suppon Street.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||You did it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_1"
msgid "And Lilith's top girl,{PA:10} at that!{PA:20}||Yuri is a gem,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_2"
msgid "I'll get right on the new schedule.{PA:20}||Oh,{PA:10} and more big news!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_3"
msgid "We got word from Mr.{PA:20} Kanamoto,{PA:10} the original||owner.{PA:20} His mother has recovered!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_4"
msgid "He says he's returning to Kamurocho!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_5"
msgid "Well,{PA:10} that's a relief.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_2_6"
msgid "He's going to flip when he sees the shape||the club is in now,{PA:10} sir!{PA:20}"
