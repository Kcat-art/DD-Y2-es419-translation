msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_3_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_3_1"
msgid "Amazing work,{PA:10} sir.{PA:20}||We're filling up!{PA:20} With just a little more,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_3_2"
msgid "we'll have this place filled to capacity,{PA:10}||I know it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_4_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_4_1"
msgid "Will you take a look at that!{PA:20}||Every seat in the house is full!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_4_2"
msgid "I never imagined business would take off||like this,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_4_3"
msgid "You're a miracle worker!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_9_0"
msgid "It'll be interesting to hear the sales||report for tonight,{PA:10} won't it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_9_1"
msgid "Masashi will call you with the totals once||he finishes crunching the numbers.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_9_2"
msgid "We'll just have to wait until then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_0"
msgid "Well,{PA:10} Mr.{PA:20} Kiryu,{PA:10} what do you think?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_1"
msgid "I think this may have just made ours the||largest club in Kamurocho!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_2"
msgid "And it's all thanks to your leadership.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_3"
msgid "I've always taken pride in working here,{PA:10}||but I've never felt prouder than I do now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_4"
msgid "I hope you'll continue to guide us to||greater heights as Marietta's owner.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_5"
msgid "Here,{PA:10} this isn't much,{PA:10} sir,{PA:10} but all of us||employees chipped in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_6"
msgid "       You received a \"{CC:ffffc8}lucky bracelet{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_8"
msgid "Now then,{PA:10} if you'd set the club up,{PA:10} sir.{PA:20}||Masashi is waiting in the back room.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_10_9"
msgid "Received 1❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_12_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||Thank you for everything,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_12_1"
msgid "No problem.{PA:20} How's business?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:288_12_2"
msgid "Booming,{PA:10} sir!{PA:20} Boominger than ever!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_1"
msgid "What's wrong now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_2"
msgid "It's Chinatsu,{PA:10} our top girl.{PA:20}.{PA:20}.{PA:20}||{MS:0}The guys from Lilith stole her away!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_3"
msgid "Lilith?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_4"
msgid "Another club here in town.{PA:20} They've got a||reputation for doing this sort of thing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_5"
msgid "The club is on Suppon Street,{PA:10} sir.{PA:20}||You've probably passed it before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_6"
msgid "The owner is infamous for stealing away top||girls from other clubs,{PA:10} by hook or by crook.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_7"
msgid "Then he sets them up to work for him.{PA:20}||He's a real skunk,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_8"
msgid "I knew about him,{PA:10} but I never thought I'd||be one of his victims.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_9"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_10"
msgid "I'll be honest,{PA:10} sir,{PA:10} losing our top girl||means bad news for business.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_11"
msgid "All of the regulars coming in for Chinatsu||could easily follow her off to Lilith now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0443.ARC/TALK_ST_KAB0443.BIN::line:289_0_12"
