msgid "Yeah,{PA:10} I'm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_7"
msgid "Mr.{PA:20} Kazuma Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_8"
msgid "Who is this?!{PA:20}"
msgstr "¿Con quién hablo?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_9"
msgid "You'll find out soon enough.{PA:20}"
msgstr "Pronto lo sabrás.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_10"
msgid "If you wish to keep Daigo Dojima alive.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_11"
msgid "You'll meet me at one a.{PA:20}m.{PA:20} tomorrow night.{PA:24}{PA:20}||Come to the {MS:0}\"{CC:ffc8c8}Amano Building{CR:00}\" here in town.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_12"
msgid "The \"{CC:ffc8c8}Amano Building{CR:00}\"?{PA:20}||{PA:75}And what about Chairman Goda?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_13"
msgid "You'll understand when you arrive.{PA:60}{PA:20}||Of course,{PA:10} you're to come alone.{PA:20} {PA:27}Am I clear?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_14"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:285_0_15"
msgid "Very good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:286_2_0"
msgid "(There's no time for that now.{PA:20} I need to||find a hospital.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:286_3_0"
msgid "No,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||This not where I wanted to go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:287_0_0"
msgid "I'm sorry,{PA:10} sir.{PA:20} We're performing sewer||maintenance here.{PA:20} The road's closed off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:290_0_0"
msgid "Nngh.{PA:20}.{PA:20}.{PA:20}||Damn it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:291_0_0"
msgid "Chilly one today!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:292_0_0"
msgid "It's warm and humid out today.{PA:20}||Isn't it gross?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:293_0_0"
msgid "I sure wish you'd come over here and||sit on my lap.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_0_0"
msgid "You can feel it in the air.{PA:20}||Feels a lot like it did last year.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_1_0"
msgid "This place is going to the dogs again.{PA:20}||It feels like it did last year.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_1_1"
msgid "Things got real bad then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_1_2"
msgid "The yakuza running this town had it out||and the whole city went to hell.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_1_3"
msgid "Not to mention those stupid gangs.{PA:20}||Those kids were all over the place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_1_4"
msgid "Where'd they wind up,{PA:10} anyway?{PA:20}||You don't see 'em around these days.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:294_1_5"
msgid "Maybe it's not \"cool\" anymore.{PA:20}||I always thought they were idiots.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:295_0_0"
msgid "I-I'm sorry,{PA:10} sir!{PA:20}||Here,{PA:10} take this,{PA:10} please!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:295_0_1"
msgid "          You got 10,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:296_0_0"
msgid "Keep dreaming,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:297_0_0"
msgid "Yeah,{PA:10} I guess.{PA:20}"
msgstr "S-su{PA:10}pongo...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_0"
msgid "Tonight was the best night ever.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_1"
msgid "If you ever come to my country,{PA:10} Mr.{PA:20} Kiryu,{PA:10}||I would be happy to show you around,{PA:10} too!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_2"
msgid "Thanks,{PA:10} I'll look forward to that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_3"
msgid "This is my thank you for everything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_4"
msgid "        You received 300,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_5"
msgid "Here,{PA:10} take this too!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_6"
msgid "         You received an Il Yu-Jin||          \"{CC:ffffc8}signed publicity photo{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_8"
msgid "Please be well,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Let's meet again some day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_9"
msgid "Sure.{PA:20} I'll see you around.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:299_0_11"
msgid "Received 3❟500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:301_0_0"
msgid "(Damn,{PA:10} I lost track of the peeping Tom.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_0"
msgid "Um,{PA:10} forgive me if I'm mistaken,{PA:10} but.{PA:20}.{PA:20}.{PA:20}||Are you Kazuma Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_1"
msgid "That's me.{PA:20}"
msgstr "Así es.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_2"
msgid "Good evening,{PA:10} sir!{PA:20} My name is Suenaga.{PA:20}||I'm headmistress at the Sunflower Orphanage.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_3"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} Thanks for keeping an eye on Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_4"
msgid "Oh,{PA:10} she's a pleasure.{PA:20}||Think nothing of it,{PA:10} really.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_5"
msgid "She's a little ray of sunshine,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Having her there brightens up the place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_6"
msgid "So,{PA:10} if you don't mind my asking.{PA:20}.{PA:20}.{PA:20}||What happened to the last headmaster?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_7"
msgid "Oh,{PA:10} he's been having health troubles.{PA:20}.{PA:20}.{PA:20}||He's resting now,{PA:10} with family.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_8"
msgid "I'm picking up where he left off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_9"
msgid "I see.{PA:20}.{PA:20}.{PA:20} And what's got you out in a place||{MS:1}{MS:0}like this tonight?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_10"
msgid "Oh,{PA:10} I'm ashamed to say it,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_11"
msgid "Well,{PA:10} our finances have gotten awfully||tight lately.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_12"
msgid "Ever since Mr.{PA:20} Fuma's death,{PA:10} the orphanage||has been.{PA:20}.{PA:20}.{PA:20} less important to the clan.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_13"
msgid "I know the Tojo have a lot on their plate,{PA:10}||but the poor children are.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_14"
msgid "Mr.{PA:20} Kashiwagi does his best to do right by||them all,{PA:10} of course.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_15"
msgid "But he's a busy man,{PA:10} and we sometimes slip||between the cracks.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_16"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_17"
msgid "Um,{PA:10} if you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_18"
msgid "If you found yourself with change to spare,{PA:10}||might you consider making a donation,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_19"
msgid "Sure.{PA:20}||I owe a lot to that orphanage.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_20"
msgid "I'll do what I can,{PA:10} but that's not a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_21"
msgid "Oh,{PA:10} thank you!{PA:20}||Anything at all would be wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_22"
msgid "I come out here a lot.{PA:20} Just let me know||any time you're able to make a donation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_23"
msgid "Or you can transfer funds directly into our||account via any convenience store ATM.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_24"
msgid "All right,{PA:10} I will.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_0_25"
msgid "Thank you again,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_1_0"
msgid "E-Excuse me!{PA:20} Sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_1"
msgid "I've got some money here.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_2"
msgid "Oh!{PA:20} Yes,{PA:10} of course!{PA:20} Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_6"
msgid "Thank you so much,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||You're a blessing to those children.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_7"
msgid "I'll be here any time you can help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_8"
msgid "Sorry,{PA:10} I'm actually shorter than I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_9"
msgid "Oh,{PA:10} I see.{PA:20} You're a good man to think of us.{PA:20}||Any time you're ready,{PA:10} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_10"
msgid "*Sigh*"
msgstr "Ay..."

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_11"
msgid "Is something wrong?{PA:20}"
msgstr "¿Qué ocurre?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_12"
msgid "Oh,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_13"
msgid "It's Hayato,{PA:10} one of our boys at Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_14"
msgid "He's just about Haruka's age.{PA:20} We've had him||with us for a little while now,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_15"
msgid "He hasn't really made any friends yet.{PA:20}||Hasn't opened up to the other kids at all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_16"
msgid "The other kids are doing their best to||include him,{PA:10} but he's shut them all out.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_17"
msgid "What do you think,{PA:10} Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_19"
msgid "Maybe you should talk it out with the kid.{PA:20}||Really get to the root of the problem.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_20"
msgid "If you show him you're on his side,{PA:10} he might||open up to you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_21"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} Maybe so.{PA:20} Still,{PA:10} he just ignores us||when we try to talk to him.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_22"
msgid "Do you know of anything he enjoys doing?{PA:20}||Maybe something he's good at?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_23"
msgid "Well.{PA:20}.{PA:20}.{PA:20}"
msgstr "Es que{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_24"
msgid "You could be right.{PA:20} That could be a way to||get him to open up some.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_25"
msgid "I remember reading in his file that he took||care of the class pets at his old school.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_26"
msgid "He may like animals.{PA:20}||.{PA:20}.{PA:20}.{PA:20}But we don't have any pets at Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_27"
msgid "If you leave him be,{PA:10} the kid will probably||come around on his own.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_28"
msgid "A lot of boys go through phases like that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_2_29"
msgid "I wonder.{PA:20}.{PA:20}.{PA:20} I can't imagine ignoring||the problem will help it go away.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_3_0"
msgid "Animals?{PA:20} Hm.{PA:20}.{PA:20}.{PA:20}||What could we do about that.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_4_0"
msgid "Goodness,{PA:10} who is this little guy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_4_1"
msgid "Think you and the kids could take care of||him at the orphanage?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_4_2"
msgid "You don't mind?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_4_3"
msgid "Of course not.{PA:20}"
msgstr "En absoluto.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_4_4"
msgid "Well,{PA:10} thank you!{PA:20}||Oh,{PA:10} this is going to make the kids so happy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_5_0"
msgid "Having that puppy there has brightened up||Sunflower,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_5_1"
msgid "And slowly but surely,{PA:10} Hayato is coming out||of his shell and making friends!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:303_5_2"
msgid "Received 300 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_2"
msgid "Hi,{PA:10} Ms.{PA:20} Suenaga!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_3"
msgid "Haruka?{PA:20} Goodness!{PA:20}||You look well,{PA:10} dear.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_4"
msgid "I'd like to make a donation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_5"
msgid "Oh!{PA:20} Yes,{PA:10} of course!{PA:20} Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_9"
msgid "Thank you so much,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||You're a blessing to those children.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_10"
msgid "I'll be here any time you can help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_11"
msgid "Sorry,{PA:10} I'm actually shorter than I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_12"
msgid "Oh,{PA:10} I see.{PA:20} You're a good man to think of us.{PA:20}||Any time you're ready,{PA:10} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_13"
msgid "What to do.{PA:20}.{PA:20}.{PA:20}"
msgstr "(¿Qué podría hacer?.{PA:20}..{PA:20}).{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_14"
msgid "Is something wrong?{PA:20}"
msgstr "¿Qué ocurre?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_15"
msgid "Oh,{PA:10} Mr.{PA:20} Kiryu.{PA:20} Our roof is leaking!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_16"
msgid "It's over 30 years old,{PA:10} so I suppose||it's little wonder,{PA:10} but still.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_17"
msgid "I see.{PA:20} So it hasn't been renovated since||I was there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_18"
msgid "No,{PA:10} I'm afraid not.{PA:20}||We've been trying to get it fixed,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_19"
msgid "but the money just isn't there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_20"
msgid "Mr.{PA:20} Kiryu,{PA:10} it kills me to ask after||you've done so much,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_21"
msgid "but can you fund the repairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_22"
msgid "How much will it cost?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_23"
msgid ".{PA:20}.{PA:20}.{PA:20}250,{PA:10}000 yen.{PA:20} There's just no way||I can scrounge up"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_24"
msgid "such a large sum,{PA:10} sir.{PA:20} Please!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_26"
msgid "Sorry,{PA:10} money has been a little tight for me||lately,{PA:10} too.{PA:20} I'm a little short.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_27"
msgid "Oh,{PA:10} I understand.{PA:20} But think of the kids!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_28"
msgid "I'm afraid the poor dears will all catch||colds at this rate.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_29"
msgid "I'll try to scrape it together.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_30"
msgid "Oh,{PA:10} thank you,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_31"
msgid "I can accept it here,{PA:10} or via ATM transfer.{PA:20}||Whichever is easier for you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_0_32"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_1_0"
msgid "Oh,{PA:10} what to do.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_2"
msgid "Hi,{PA:10} Ms.{PA:20} Suenaga!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_3"
msgid "Haruka?{PA:20} Goodness!{PA:20}||You look chipper as always.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_4"
msgid "I'd like to make a donation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_5"
msgid "Oh!{PA:20} Yes,{PA:10} of course!{PA:20} Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_15"
msgid "Thank you so much,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||You're a blessing to those children.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_16"
msgid "I'll be here any time you can help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_17"
msgid "Oh,{PA:10} Mr.{PA:20} Kiryu,{PA:10} I just don't know how I can||pull together 250,{PA:10}000 yen.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_18"
msgid "Any little bit you can spare,{PA:10} those kids||do desperately need your help,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_19"
msgid "I'll do what I can to pull together money as||well,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_20"
msgid "Between the two of us,{PA:10} we'll get those kids||covered up.{PA:20} Thank you so much,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_21"
msgid "The winter gets a little warmer for those||kids with every donation,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_22"
msgid "They owe you so much!{PA:20} I hope you'll continue||to be as generous to them in the future.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_23"
msgid "Mr.{PA:20} Kiryu!{PA:20} I can't believe it,{PA:10} but we're||almost there!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_24"
msgid "Just a bit more,{PA:10} and we'll be able to||complete the repairs.{PA:20} It's a miracle!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_25"
msgid "Mr.{PA:20} Kiryu!{PA:20} You should have seen the kids'||faces when I told them about the repairs!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_26"
msgid "They were glowing,{PA:10} sir!{PA:20} Just glowing!{PA:20}||Oh,{PA:10} the joy and relief and appreciation.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_27"
msgid "We'll have that roof all fixed up soon,{PA:10}||and it's all thanks to you,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_28"
msgid "Sorry,{PA:10} I'm actually shorter than I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_29"
msgid "Oh,{PA:10} I see.{PA:20} You're a good man to think of us.{PA:20}||Any time you're ready,{PA:10} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_30"
msgid "Thank you so much!{PA:20}||We finally have enough to cover the repairs!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_31"
msgid "That's great.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_2_32"
msgid "It's a miracle,{PA:10} sir!{PA:20} Well,{PA:10} I'm off to speak||to the contractors now.{PA:20} Take care,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_0"
msgid "Oh,{PA:10} Mr.{PA:20} Kiryu!{PA:20}||The roof is all fixed!{PA:20} It's wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_1"
msgid "Now I don't have to worry about the poor||children freezing to death.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_2"
msgid "That's great news.{PA:20}"
msgstr "Esas son buenas noticias.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_3"
msgid "Oh,{PA:10} here!{PA:20} The little angels wrote you a||letter and asked me to pass it along.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_4"
msgid "    You received the \"{CC:ffffc8}children's letter{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_6"
msgid "Believe it or not,{PA:10} it was actually Hayato||who suggested the kids all write this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_7"
msgid "Thinking back on how isolated he was at the||start,{PA:10} he's like a whole new person now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_8"
msgid "It's really all thanks to you.{PA:20}||I can't begin to thank you enough!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:305_3_9"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_2"
msgid "Hi,{PA:10} Ms.{PA:20} Suenaga!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_3"
msgid "Oh,{PA:10} Haruka!{PA:20}||You look well,{PA:10} dear.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_4"
msgid "I've got some cash to pass along.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_5"
msgid "Oh!{PA:20} Yes,{PA:10} of course!{PA:20} Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_9"
msgid "Thank you so much,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||You're a blessing to those children.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_10"
msgid "I'll be here any time you can help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_11"
msgid "Sorry,{PA:10} I'm actually shorter than I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_12"
msgid "Oh,{PA:10} I see.{PA:20} You're a good man to think of us.{PA:20}||Any time you're ready,{PA:10} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_13"
msgid "Oh,{PA:10} gracious!{PA:20} This is terrible!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_14"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_15"
msgid "Well,{PA:10} we just got the bill for those||roof repairs from before.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_16"
msgid "Mr.{PA:20} Kiryu,{PA:10} it's for 5,{PA:10}000,{PA:10}000 yen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_17"
msgid "Five million yen!?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_18"
msgid "His quote before was only 250,{PA:10}000 yen!{PA:20}||I asked about the difference,{PA:10} of course.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_19"
msgid "But he said it was for repairs on all the||other spots that were falling apart.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_20"
msgid "Wait,{PA:10} he repaired things you didn't ask for?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_21"
msgid "Apparently so,{PA:10} yes.{PA:20} The foundation,{PA:10} for one.{PA:20}||At least,{PA:10} so he says.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_22"
msgid "It took a miracle to get that first 250,{PA:10}000.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_23"
msgid "You just tell him to give me a call.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_0_24"
msgid "S-Sir?{PA:20} .{PA:20}.{PA:20}.{PA:20}I will.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_1_0"
msgid "Oh,{PA:10} gracious,{PA:10} no!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_2_0"
msgid "M-Mr.{PA:20} Kiryu,{PA:10} what should I.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_2_1"
msgid "You leave it to me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_2_2"
msgid "Go be with the kids.{PA:20}||They need you there at the orphanage.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}All right,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_1"
msgid "I got a call from the contractors saying||they're rescinding that bill!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_2"
msgid "I can't believe it!{PA:20}||How in the world did you convince them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_3"
msgid "I didn't do a thing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_4"
msgid "Oh,{PA:10} please!{PA:20} You're a hero to those kids.{PA:20}||You don't have to be so modest!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_5"
msgid "Really,{PA:10} sir.{PA:20} You saved all of our necks this||time.{PA:20} Oh,{PA:10} and here.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_6"
msgid "The kids wanted me to give you these.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_7"
msgid "      You received \"{CC:ffffc8}homemade cookies{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_9"
msgid "I can't speak for the flavor,{PA:10} but they made||them with love.{PA:20} That's bound to pack a kick.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:306_3_11"
msgid "Received 1❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_2"
msgid "Hi,{PA:10} Ms.{PA:20} Suenaga!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_3"
msgid "Haruka?{PA:20} Goodness!{PA:20}||You look well,{PA:10} dear.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_4"
msgid "I'd like to make a donation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_5"
msgid "Oh!{PA:20} Yes,{PA:10} of course!{PA:20} Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_9"
msgid "Thank you so much,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||You're a blessing to those children.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_10"
msgid "I'll be here any time you can help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_11"
msgid "Sorry,{PA:10} I'm actually shorter than I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_12"
msgid "Oh,{PA:10} I see.{PA:20} You're a good man to think of us.{PA:20}||Any time you're ready,{PA:10} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_13"
msgid "Oh,{PA:10} hello,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_14"
msgid "Mr.{PA:20} Kiryu,{PA:10} I'll never forget all your help.{PA:20}||No matter what happens.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_15"
msgid "Um.{PA:20}.{PA:20}.{PA:20} Is something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_16"
msgid "Wrong?{PA:20} Oh,{PA:10} no.{PA:20}.{PA:20}.{PA:20} I mentioned the headmaster||was resting up at home before,{PA:10} didn't I?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_17"
msgid "Yeah,{PA:10} I remember.{PA:20}||Has something happened to him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_18"
msgid "No,{PA:10} no!{PA:20} He's feeling worlds better!{PA:20}||Well enough to come back to work,{PA:10} actually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_19"
msgid "Well,{PA:10} that's good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_20"
msgid "Yes,{PA:10} it's wonderful.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_21"
msgid "But it does mean my time with the children||is coming to an end.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_22"
msgid "Ah.{PA:20}"
msgstr "Ah...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_23"
msgid "It was only six months,{PA:10} but saying goodbye||to them is so hard.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_24"
msgid "So I've decided to make a gift to them.{PA:20}||I'd like to give them a park!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_25"
msgid "A what?!{PA:20}"
msgstr "¿Una qué?...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_26"
msgid "A park!{PA:20}||Something that will last.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_27"
msgid "Still,{PA:10} it takes more than pocket change and||good intentions to get a park built.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_28"
msgid "Mr.{PA:20} Kiryu,{PA:10} could I ask you to help me find||an affordable contractor?{PA:20} For the kids!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_30"
msgid "I think building a park on one person's||savings is an awfully big dream.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_31"
msgid "I realize it's a stretch,{PA:10} I really do!{PA:20}||But still,{PA:10} I want to do this for them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_32"
msgid "I'll see what I can find.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_33"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_34"
msgid "I'll keep trying on my end as well!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_0_35"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_1_0"
msgid "Should old acquaintance be forgot,{PA:10}||And never brought to mind.{PA:20}.{PA:20}.{PA:20}♪"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_2_0"
msgid "I just knew I could count on you!{PA:20}||With your help,{PA:10} I know we can do this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_2_1"
msgid "I'll keep trying on my end as well!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_2_2"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_3_0"
msgid "I think I've got a lead on your park.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_3_1"
msgid "Really?!{PA:20}||Oh,{PA:10} Mr.{PA:20} Kiryu,{PA:10} thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_3_2"
msgid "It's the same guys who fixed your roof,{PA:10} but||they shouldn't give you any more trouble.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_3_3"
msgid "Is that so?{PA:20} Oh,{PA:10} how very generous of them!{PA:20}||They must still feel awful about before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_3_4"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} Something like that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_0"
msgid "Thanks to you,{PA:10} I was able to get that||park built,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_1"
msgid "Thank you.{PA:20} Thank you,{PA:10} thank you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_2"
msgid "O-Oh,{PA:10} Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20} I.{PA:20}.{PA:20}.{PA:20}||Today is.{PA:20}.{PA:20}.{PA:20} Was my last day with the kids.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_3"
msgid "They wrote this for me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_5"
msgid "         Dear Headmistress Suenaga,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_6"
msgid "         Thank you for everything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_7"
msgid "     We'll always remember you reading||    us books and how you fixed the roof.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_8"
msgid "      Taking Dogspot on walks with you||             was a lot of fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_9"
msgid "       Please come back to visit us!{PA:20}||        Dogspot will miss you,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_10"
msgid "      We'll all take care of Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_12"
msgid "                 Goodbye.{PA:20}"
msgstr "... Adiós.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_15"
msgid "M-Ms.{PA:20} Suenaga.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_16"
msgid "Sounds like the kids really loved you.{PA:20}||You should go visit them soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_17"
msgid "Oh,{PA:10} I will!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_18"
msgid "You've helped me help those children so||much,{PA:10} Mr.{PA:20} Kiryu.{PA:20} This is for you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_19"
msgid "      You received a \"{CC:ffffc8}hand-knit scarf{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_21"
msgid "And here.{PA:20} I took this picture just after||Haruka came to stay with us.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_22"
msgid "      You received a \"{CC:ffffc8}photo of Haruka{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_27"
msgid "I hope they help keep you warm this winter.{PA:20}||Please continue to help those kids,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_28"
msgid "I will.{PA:20} You take care of yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_29"
msgid "You be careful,{PA:10} too,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_31"
msgid "And you,{PA:10} too,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_32"
msgid "Thanks,{PA:10} Ms.{PA:20} Suenaga.{PA:20}.{PA:20}.{PA:20}||I'll see you soon!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:307_4_34"
msgid "Received 3❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_0"
msgid "Oh,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_1"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_2"
msgid "I just had my purse snatched!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_3"
msgid "Was there anything in it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_4"
msgid "Yes!{PA:20} A million yen in cash.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_5"
msgid "That was my money to study abroad!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_6"
msgid "What did the thief look like?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_7"
msgid "Like a thug.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_8"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_9"
msgid "He was in a white sweatshirt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_10"
msgid "I think he ran off down Nakamichi Street.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_11"
msgid "All right.{PA:20}||You wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_0_12"
msgid "Okay.{PA:20}.{PA:20}.{PA:20}"
msgstr "Bueno.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_1_0"
msgid "Oh,{PA:10} you've got company.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_1_1"
msgid "What's wrong,{PA:10} Natsuki?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_1_2"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} It's nothing.{PA:20}||I'll take care of it myself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::line:309_1_3"
msgid "See you later.{PA:20}"
msgstr "Hasta luego...{PA:20}"

