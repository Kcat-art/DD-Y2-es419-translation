msgid "Aggressive Guy"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:13"
msgid "Older Woman"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:14"
msgid "Headmistress"
msgstr "Directora"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:15"
