msgid "Date"
msgstr "Date"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:4"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:5"
msgid "Kaoru"
msgstr "Kaoru"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:6"
msgid "Haruka"
msgstr "Haruka"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:7"
msgid "Il Yu-Jin"
msgstr "I Ru-jeon"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:8"
msgid "Taxi Driver"
msgstr "Taxista"

msgctxt "MEDIA3/ARC/ST/ST_KAB0035.ARC/TALK_ST_KAB0035.BIN::name:9"
