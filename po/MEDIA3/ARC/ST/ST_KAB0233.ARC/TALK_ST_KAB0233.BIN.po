msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:297_2_3"
msgid "   You received a \"{CC:ffffc8}5-iron signed by Akagi{CR:00}\".{PA:20}"
