msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:297_3_0"
msgid "Guess that's all an amateur can hope for.{PA:20}||Keep on practicin',{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_0"
msgid "Huh?{PA:20} What?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_1"
msgid "You're in my way,{PA:10} buddy.{PA:20} Need me to crack||yer melon open with this club?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_2"
msgid "This girl look familiar?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_3"
msgid "        You showed him Miki's photo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Feh!{PA:20}||So what,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_5"
msgid "So you do remember her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_6"
msgid "Sure,{PA:10} I remember her.{PA:20} What of it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_7"
msgid "You the bitter ex-boyfriend or what?{PA:20}||Whatever ya were,{PA:10} it's over now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_8"
msgid "Now get lost!{PA:20}||Can't concentrate with ya buggin' me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_9"
msgid "Where is she?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_10"
msgid "Who the fuck ARE you?{PA:20}||I-I ain't got her no more!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_11"
msgid "Found a buyer,{PA:10} so I sold the bitch!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_12"
msgid "Kojima?{PA:20} Where is he?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_13"
msgid "H-How the fuck do ya know his name?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_14"
msgid "Kojima's.{PA:20}.{PA:20}.{PA:20} I dunno where he's at.{PA:20}||Maybe he's off on vacation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_15"
msgid "Or maybe I didn't sell her.{PA:20} Might've just||put her out with the other trash.{PA:10}{PA:20} Ah ha ha!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_16"
msgid "You belong in the gutter,{PA:10} not on a||golf course.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_17"
msgid "When I'm done,{PA:10} you'll never play again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_18"
msgid "Some balls ya got there,{PA:10} pal!{PA:20}||Care to say that again?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_19"
msgid "I'll say it as many times as you like.{PA:10}{PA:20}||From here on,{PA:10} I'm talking with my fists.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_0_20"
msgid "Don't get cocky now.{PA:20}||I'll iron ya flat,{PA:10} buddy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_1_0"
msgid "(There.{PA:20}.{PA:20}.{PA:20} That guy looks familiar.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:298_1_1"
msgid "(He was in one of Yuriko's photos.{PA:10}{PA:20}||One of the three con men.{PA:20}.{PA:20}.{PA:20} Kajiwara.)"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_0"
msgid "Gnngh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_1"
msgid "I-It was all Kojima's idea!{PA:20}||He was the guy callin' the shots,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_2"
msgid "I-I'm small potatoes,{PA:10} compared to him!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_3"
msgid "Where is he?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_4"
msgid "W-Wait just a sec,{PA:10} pal.{PA:20}||I'll ring him up right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_5"
msgid "Mr.{PA:20} Kojima?{PA:20} Y-Yeah,{PA:10} it's me.{PA:20}.{PA:20}.{PA:20}||Right.{PA:20}.{PA:20}.{PA:20} Yes,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_6"
msgid "Done run into a bit o' trouble with that.{PA:20}.{PA:20}.{PA:20}||Y-Yeah,{PA:10} that's right.{PA:20} Sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_7"
msgid "Okay.{PA:20} Got it,{PA:10} Mr.{PA:20} Kojima.{PA:20}||Goodbye.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:299_0_8"
msgid "H-He said to bring ya to him.{PA:20}"
msgstr ""

