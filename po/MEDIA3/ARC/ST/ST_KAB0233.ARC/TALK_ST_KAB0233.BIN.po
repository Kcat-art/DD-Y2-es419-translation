msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:294_1_2"
msgid "You a desk jockey,{PA:10} friend?{PA:20} A salary man?{PA:20}||You'd better get started then!{PA:20}"
