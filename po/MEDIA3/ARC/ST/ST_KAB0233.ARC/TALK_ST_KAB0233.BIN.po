msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:294_1_3"
msgid "No,{PA:10} I'm actually.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:294_1_4"
msgid "Ya don't gotta spell it out for me,{PA:10} friend.{PA:20}||I know.{PA:20} Yer boss's rough on ya,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:294_1_5"
msgid "But don't give up,{PA:10} buddy!{PA:20}||Get on his good side with yer golf skills!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0233.ARC/TALK_ST_KAB0233.BIN::line:294_1_6"
msgid "Golf's the lingua franca of the salary man!{PA:20}||You practice hard,{PA:10} you'll go places!{PA:20}"
