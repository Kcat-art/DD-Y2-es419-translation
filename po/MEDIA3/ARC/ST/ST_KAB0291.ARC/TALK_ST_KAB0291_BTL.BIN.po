msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:139_1_0"
msgid "     You now have access to a hideout.{PA:20}"
msgstr "Ahora tienes acceso al escondite.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:139_1_1"
msgid "Your health will recover while inside the"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:139_1_2"
msgid "hideout,{PA:10} where you can also save your game"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:139_1_3"
msgid "or manage your item inventory.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_0_0"
msgid "Kashiwagi"
msgstr "Kashiwagi"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_1_1"
msgid "I'm fine.{PA:20} Glad to hear you're alive.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_1_3"
msgid "I just got back to Kamurocho.{PA:20}"
msgstr "Acabo de regresar a Kamurocho.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_1_5"
msgid "Chairman Goda and Daigo were abducted.{PA:20}||I don't know who's behind it yet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_1_6"
msgid "I'll give you the specifics at Tojo HQ.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_2_0"
msgid "It's me,{PA:10} Kashiwagi.{PA:20}.{PA:20}.{PA:20} You all right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_2_2"
msgid "Where are you now?{PA:20}"
msgstr "¿Dónde estás ahora?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_2_4"
msgid "All of Kansai is buzzing,{PA:10} Kazuma.{PA:20}||What the hell happened down there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:140_2_6"
msgid "All right.{PA:20} I'll gather the officers.{PA:20}||See you then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:141_0_0"
msgid "The Go-Ryu Clan and the Jingweon mafia.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:141_0_1"
msgid "I guess no matter what comes up,{PA:10} we'll just||have to deal with it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_0_0"
msgid "They've got us spinning in circles.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_0_1"
msgid "I wish we had something to go on.{PA:20}||Anything at all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_1_0"
msgid "Good morning.{PA:20}||You're going to the funeral today,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_1_1"
msgid "I've got to touch base with the Osaka police||so I'll be out for a while.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_1_2"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_1_3"
msgid "Don't do anything stupid,{PA:10} okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_1_4"
msgid "I won't.{PA:20} I'll call you when I get back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:142_1_5"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_0"
msgid "The Fifth Chairman's funeral service is||tomorrow at Tojo Clan headquarters.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_1"
msgid "Yayoi is heading up the arrangements.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_2"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_3"
msgid "I'd like to pay my final respects as well.{PA:20}||I hope you won't mind my attending.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_4"
msgid "Don't be silly.{PA:20} I'll be a little late,{PA:10} but||I'll be there too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_5"
msgid "When you get to headquarters tomorrow,{PA:10} catch||Yayoi up on what's happened.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_6"
msgid "Will do.{PA:20}"
msgstr "Lo consideraré. Nos vemos.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0291.ARC/TALK_ST_KAB0291_BTL.BIN::line:143_0_7"
msgid "Thanks.{PA:20}"
msgstr "gracias.{PA:20}"

