msgid "Are you all right,{PA:10} Mr.{PA:20} Kagami?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_1"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} I think so.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_2"
msgid "There's something I want to ask you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_3"
msgid "Oh?{PA:20}"
msgstr "¿Oh?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_4"
msgid "Makoto was telling me about Kisaragi.{PA:20}.{PA:20}.{PA:20}||Said he scammed the hosts that work here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_5"
msgid "Something about foisting the tabs that||customers defaulted on onto the hosts.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_6"
msgid "Did he do the same to you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_7"
msgid "Heh.{PA:20}.{PA:20}.{PA:20} Not exactly.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_8"
msgid "A few years back,{PA:10} a whole wave of hosts I||scouted got fed up with his scams and ran.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_9"
msgid "I can't blame them,{PA:10} of course.{PA:20}||But still.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_10"
msgid "Still?{PA:20}"
msgstr "Es que...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_11"
msgid "Kisaragi said that it was my responsibility||to pay the tabs they ran out on.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_12"
msgid "I'm the one who scouted them,{PA:10} so their||running off was my fault.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_13"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_14"
msgid "Yeah,{PA:10} well.{PA:20}.{PA:20}.{PA:20}"
msgstr "Si tú {PA:10}lo dice{PA:20}s{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_15"
msgid "Anyway,{PA:10} Kazuma,{PA:10} you've got bigger worries.{PA:20}||You need to focus on beating out Takaya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_16"
msgid "If you can dethrone him,{PA:10} Adam will change.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_17"
msgid "I know it.{PA:20} And I know you can do it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_1_18"
msgid "I'll do my best.{PA:20}"
msgstr "Eso haré.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:293_0_0"
msgid "Good morning,{PA:10} all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:293_0_1"
msgid "Good morning,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:293_0_2"
msgid "Let's begin with this month's top host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:293_0_3"
msgid "I suspect you've all already heard,{PA:10} but we||have a new number one this month.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:293_0_4"
msgid "Kazuma is replacing Takaya's spot.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:293_0_5"
msgid "I want all of you to model yourselves on||Kazuma here in the future.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Kazuma.{PA:20}||I heard about you and Kisaragi.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_1"
msgid "Oh,{PA:10} that.{PA:20} Well,{PA:10} at least you're a free man||as of today,{PA:10} Mr.{PA:20} Kagami.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_2"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20} I don't know what to say.{PA:20}||How could I begin to thank you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_3"
msgid "I owe you a huge debt of gratitude.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_4"
msgid "My,{PA:10} my!{PA:20} What a man you are!{PA:20}||I knew you were the real deal,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_5"
msgid "So,{PA:10} have you given any thought to my offer?{PA:20}||It's still on the table,{PA:10} you know.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_6"
msgid "Yes,{PA:10} I have.{PA:20} Can I ask you a huge favor?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_7"
msgid "Lay it on me,{PA:10} handsome.{PA:20}||We'll see what I can do.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_8"
msgid "Could you buy this place off of Kisaragi?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_9"
msgid "This club?{PA:20}||That's a tall order.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_10"
msgid "But all right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_11"
msgid "Thank you.{PA:20}.{PA:20}.{PA:20}"
msgstr "Gracias.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_12"
msgid "I want Mr.{PA:20} Kagami to be the new owner.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_13"
msgid "That is.{PA:20}.{PA:20}.{PA:20} if you don't mind.{PA:20}||Well?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_14"
msgid "Kazuma,{PA:10} I.{PA:20}.{PA:20}.{PA:20}||But what about you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_15"
msgid "Don't worry about me.{PA:20}"
msgstr "No tienes de qué preocuparte.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_16"
msgid "With you in control,{PA:10} Adam will become a new||sort of club.{PA:20} One worth coming to.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_17"
msgid "Today's also my last day here.{PA:20}||I hope you'll understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_18"
msgid "Thank you for all your support,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_19"
msgid "Heh,{PA:10} please.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_20"
msgid "Any time you want.{PA:20}.{PA:20}.{PA:20} ANY time.{PA:20}||You'll always be welcome here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:294_0_21"
msgid "Heh,{PA:10} thanks.{PA:20}"
msgstr "Je, {PA:10}gracias.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_0"
msgid "Okay,{PA:10} boys!{PA:20} Listen up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_1"
msgid "This here's Kazuma.{PA:20}||He's starting here with us tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_2"
msgid "Everybody help show him the ropes,{PA:10} okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_3"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr "¡Sí, {PA:10}señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_4"
msgid "We're getting ready to open.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_5"
msgid "Let's have a great night,{PA:10} boys!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_0_6"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr "¡Sí, {PA:10}señor!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_1_0"
msgid "Kazuma,{PA:10} I've got some work for you.{PA:20}||Ready to get started?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:295_1_1"
msgid "Come with me to the back room.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_0"
msgid "My name's Haruki.{PA:20}||Nice to meet you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_1"
msgid "If you've got any questions,{PA:10} just ask me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_2"
msgid "Thanks,{PA:10} I will.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_3"
msgid "Mr.{PA:20} Kagami you met,{PA:10} he's the manager.{PA:20}||The owner's Mr.{PA:20} Kisaragi.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_4"
msgid "He only really comes around for the monthly||meetings,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_5"
msgid "Oh,{PA:10} really?{PA:20}"
msgstr "¿Oh,{PA:10} en serio?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_6"
msgid "The top host here's Takaya.{PA:20} He's the owner's||son,{PA:10} but don't get the wrong idea.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_7"
msgid "Anyway,{PA:10} I should get to it here.{PA:20}||Good luck tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_0_8"
msgid "Thanks.{PA:20}"
msgstr "gracias.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_0"
msgid "Oh,{PA:10} and one other thing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_1"
msgid "Hm?{PA:20}"
msgstr "¿Mm?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_2"
msgid "Do you know about the champagne call?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_3"
msgid "Champagne call?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_4"
msgid "Yeah,{PA:10} if they order a bottle of our finest.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_5"
msgid "Anybody who orders \"Champagne Premium Gold\"||gets a shout-out as special thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_6"
msgid "All the hosts join in.{PA:20} It's one more||encouragement to keep spending.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_7"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_8"
msgid "That's not actually our priciest bottle,{PA:10}||though.{PA:20} \"Le Charentais\" is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_9"
msgid "But at 3 million a bottle,{PA:10} you don't get a||lot of orders for it,{PA:10} heh.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_11"
msgid "So nobody taught you the champagne call?{PA:20}||Well,{PA:10} here.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_12"
msgid "I'll show you,{PA:10} so pay attention.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_14"
msgid ".{PA:20}.{PA:20}.{PA:20}Not bad!{PA:20}||You got it now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_15"
msgid "Yeah,{PA:10} I think so.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:296_1_16"
msgid "Great.{PA:20} Well,{PA:10} I've got to get started.{PA:20}||See you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_0"
msgid "Kazuma,{PA:10} you're here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_1"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_2"
msgid "Then we're ready to start.{PA:20}||Let's get this host-off going.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_3"
msgid "Your client is the top club owner in the||Ginza,{PA:10} Ayumi.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_4"
msgid "You'll take turns with her,{PA:10} and whoever nets||the most in sales is the winner.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_5"
msgid "She's already been informed about the nature||of the challenge.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_6"
msgid "Any questions?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_7"
msgid "I'm ready.{PA:20} Let's do this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_8"
msgid "No questions,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_9"
msgid "As defending champion,{PA:10} Takaya will begin.{PA:20}||You'll have a set amount of time with her.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_10"
msgid "Once his time with her is up,{PA:10} Kazuma,{PA:10} you'll||take over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_11"
msgid "Your sales total won't be disclosed until||both of your turns are over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_12"
msgid "You're up,{PA:10} Takaya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_0_13"
msgid "Here we go.{PA:20}"
msgstr "Aquí está.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_0"
msgid "Now,{PA:10} for the results.{PA:20}||The most sales for the night came from.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_1"
msgid "Takaya.{PA:20} Congratulations.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_2"
msgid "Ha ha ha ha!{PA:20}||As if that's some big surprise.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_4"
msgid "I suppose you just weren't ready.{PA:20}||It was just too soon.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_5"
msgid "For now,{PA:10} you should think about what cost||you the victory,{PA:10} and how you can improve it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_6"
msgid "Yes,{PA:10} sir.{PA:20}.{PA:20}.{PA:20} I'm sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_1_7"
msgid "I'll call you later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Kazuma.{PA:20}||It's over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_1"
msgid "Takaya wins.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_2"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_3"
msgid "Aaah ha ha ha!{PA:20}||She up and walked out on you!{PA:20} Hilarious!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_4"
msgid "I suppose you just weren't ready.{PA:20}||It was just too soon.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_5"
msgid "For now,{PA:10} you should think about what cost||you the victory,{PA:10} and how you can improve it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_6"
msgid "Yes,{PA:10} sir.{PA:20}.{PA:20}.{PA:20} I'm sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_2_7"
msgid "I'll call you later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_3_0"
msgid "Now,{PA:10} for the results.{PA:20}||The most sales for the night came from.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_3_1"
msgid "Kazuma.{PA:20} Congratulations.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_3_2"
msgid "N-No fucking way!{PA:20}||You're lying!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_3_3"
msgid "The totals don't lie,{PA:10} I'm afraid.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_3_4"
msgid "He cheated!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_3_5"
msgid "I'm the number one host here!{PA:20} ME!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_0"
msgid "Congratulations,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_1"
msgid "Thank you,{PA:10} madam.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_2"
msgid "You did wonderfully.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_3"
msgid "I had a fantastic time.{PA:20} Allow me to treat||you to one of anything you'd like.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_4"
msgid "One car.{PA:20} One house.{PA:20} You name it.{PA:20}||Choose carefully,{PA:10} dear.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_5"
msgid ".{PA:20}.{PA:20}.{PA:20}I understand.{PA:20} Thank you.{PA:20}||Please,{PA:10} give me a while to decide.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_6"
msgid "For tonight,{PA:10} I must bid you good evening.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_7"
msgid "All right.{PA:20} Good night,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_8"
msgid ".{PA:20}.{PA:20}.{PA:20}Kazuma.{PA:20}"
msgstr "K{PA:20}{PA:20}a{PA:20}zuma.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:297_4_9"
msgid "Received 1❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_0_0"
msgid "Well,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20} I'm afraid you didn't quite||make your quota tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_0_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_0_2"
msgid "It takes more than just idle chitchat to||succeed in this business.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_0_3"
msgid "Now go out front and think about that!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_1_0"
msgid "You tool!{PA:20} The customer is always,{PA:10} ALWAYS||right.{PA:20} You can't go making them angry!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_1_1"
msgid "I'm sorry,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_1_2"
msgid "Go out front and think about what you did!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_1_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_0"
msgid "Not bad at all,{PA:10} Kazuma.{PA:20}||For a beginner,{PA:10} I'm impressed.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_1"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_2"
msgid "All right,{PA:10} we're closing up for the night.{PA:20}||You're free to go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_3"
msgid "Here's your cut for today.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_4"
msgid "         You received 8,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_5"
msgid "I'll call you with your next shift again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_6"
msgid "Understood,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_2_7"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_3_0"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm afraid you didn't meet your quota||for the evening,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_3_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_3_2"
msgid "I told you before,{PA:10} you need to be||aggressive out there.{PA:20} Forceful,{PA:10} even!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_3_3"
msgid "You're letting the client run the show.{PA:20}||You've got to take control,{PA:10} understand?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_3_4"
msgid "Now go out front and think about what you||need to work on starting tomorrow!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_3_5"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_4_0"
msgid "You idiot!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_4_1"
msgid "You can't let the customer run the show!{PA:20}||I told you before,{PA:10} attack,{PA:10} attack,{PA:10} attack!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_4_2"
msgid "I'm sorry,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_4_3"
msgid "Go out front and cool off!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_4_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_0"
msgid "Heh,{PA:10} nice work out there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_1"
msgid "Thank you,{PA:10} sir.{PA:20}"
msgstr "Gracias, s{PA:10}eñor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_2"
msgid "Keep that pace up.{PA:20} Remember that a host||needs to be a little forceful sometimes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_3"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_4"
msgid "You're joining her after-hours next?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_5"
msgid "Yes,{PA:10} sir.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_6"
msgid "Here's your cut for today.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_7"
msgid "         You received 30,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_8"
msgid "One last bit of advice for tonight.{PA:20} Clients||are clients,{PA:10} in the club or out.{PA:20} Got it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_9"
msgid "Yes,{PA:10} sir.{PA:20} I'll watch my behavior.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_10"
msgid "Good.{PA:20} I'll call you with your next shift.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_11"
msgid "Understood,{PA:10} sir.{PA:20}||Have a good night.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_5_12"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_6_0"
msgid "Kazuma,{PA:10} Kazuma,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}||You didn't make your sales quota tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_6_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_6_2"
msgid "She's toying with you out there.{PA:20}||I told you to make her hungry for it!{PA:20}"
