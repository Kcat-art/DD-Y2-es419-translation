msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_9"
msgid "My dad owns this place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_10"
msgid "I don't have to tell you what that means,{PA:10}||do I?{PA:20} He owns you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_11"
msgid "Mr.{PA:20} Kagami here,{PA:10} too.{PA:20}||You work here because he lets you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_12"
msgid "Now,{PA:10} Mr.{PA:20} Kagami here owes my dad a whooole||lot of money from back in the day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_13"
msgid "My dad's letting him work it off here as the||club manager.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_15"
msgid "You're starting to piss me off.{PA:20}||Nobody likes an upstart,{PA:10} Kaz.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_16"
msgid "I figured it was time you learned who's||really in control here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_17"
msgid "It's time you got knocked down a peg or two,{PA:10}||so I called you out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_18"
msgid "Is that all?{PA:20} What a waste of time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_19"
msgid "And you're welcome to try knocking me down.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_20"
msgid "Excuse me?{PA:20}"
msgstr "¿Perdón?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_21"
msgid "I'm not a scrawny little pretty boy host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_22"
msgid "You cocky little.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_23"
msgid "So Adam's top host can't keep his title"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_24"
msgid "without resorting to threats?{PA:20}||Some number one you are.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_25"
msgid "What a douche.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_26"
msgid "You got a death wish,{PA:10} asshole?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_27"
msgid "H-Hey,{PA:10} now.{PA:20} Stop it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_28"
msgid "Takaya,{PA:10} you're the top host,{PA:10} so act like it.{PA:20}||Take him on out there on the club floor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_29"
msgid "Who the hell are you to tell me what to.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_30"
msgid "He's right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_31"
msgid "Let's settle this as hosts.{PA:20} We'll see who||can court a client better.{PA:20}"
msgstr ""

