msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_6_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_7_0"
msgid "You idiot!{PA:20}||I said make her hungry,{PA:10} not angry!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_7_1"
msgid "Sorry,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_7_2"
msgid "You need to learn to think before you speak!{PA:20}||Go out front and cool off!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_7_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_8_0"
msgid "Excellent work out there.{PA:20} You're really||coming along at this,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_8_1"
msgid "Thank you,{PA:10} sir.{PA:20}"
msgstr "Gracias, s{PA:10}eñor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_8_2"
msgid "Still,{PA:10} a client switching her regular host||is an easy recipe for tension at the club.{PA:20}"
