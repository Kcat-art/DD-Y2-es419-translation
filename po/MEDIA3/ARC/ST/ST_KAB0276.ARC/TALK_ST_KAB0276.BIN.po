msgid "Then it's settled.{PA:20}"
msgstr "Entonces, está decidido.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_35"
msgid "I'll ask Ayumi,{PA:10} the head of Ginza's top||club.{PA:20} Any objections?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_36"
msgid "Ayumi?{PA:20}||Heh,{PA:10} sounds like fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_37"
msgid "I'm sure you both know who she is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_38"
msgid "The richest,{PA:10} best known patroness in all of||the Ginza.{PA:20} The ultimate club queen.{PA:20}"
