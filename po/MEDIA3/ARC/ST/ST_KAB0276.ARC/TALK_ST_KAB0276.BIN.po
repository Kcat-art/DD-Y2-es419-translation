msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_10_3"
msgid "Yes,{PA:10} sir.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_11_0"
msgid "Good job tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_11_1"
msgid "I have to admit,{PA:10} I'm surprised you've come||this far along so quickly.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_11_2"
msgid "Thank you,{PA:10} sir.{PA:20}"
msgstr "Gracias, s{PA:10}eñor.{PA:20}"

