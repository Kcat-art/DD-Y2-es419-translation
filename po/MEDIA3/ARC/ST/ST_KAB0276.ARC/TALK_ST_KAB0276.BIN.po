msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_8_3"
msgid "She used to be Takaya's client.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_8_4"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_8_5"
msgid "I figure you'll be okay,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
