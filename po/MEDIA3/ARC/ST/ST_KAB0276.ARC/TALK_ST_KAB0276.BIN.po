msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_43"
msgid "You'll take turns with her,{PA:10} and whoever nets||more money in sales wins.{PA:20}"
