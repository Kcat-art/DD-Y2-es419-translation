msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_3"
msgid "Hey,{PA:10} rookie.{PA:20}||I'm half-surprised you showed up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Mr.{PA:20} Kagami!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_5"
msgid "You're really going at it these days,{PA:10} huh?{PA:20}||Think you're hot stuff?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:292_0_6"
msgid "Well,{PA:10} I'd say it's time you learned how||things really work around here.{PA:20}"
