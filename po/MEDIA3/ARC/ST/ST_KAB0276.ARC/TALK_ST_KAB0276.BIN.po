msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_9_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_9_2"
msgid "I mentioned before that you'll be put to the||test as a host here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_9_3"
msgid "You can't leave the client to push along the||conversation.{PA:20} Passive replies won't cut it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_9_4"
msgid "Now go out front and think about that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_9_5"
msgid "Yes,{PA:10} sir.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0276.ARC/TALK_ST_KAB0276.BIN::line:298_10_0"
