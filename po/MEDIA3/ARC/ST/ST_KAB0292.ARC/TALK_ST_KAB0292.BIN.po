msgid "Just now,{PA:10} some punks from the Go-Ryu Clan.{PA:20}.{PA:20}.{PA:20}||Whoa!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:292_2_4"
msgid "I-I'm okay.{PA:20}"
msgstr "E-estoy bien.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:292_2_5"
msgid "We'll do what we can here.{PA:20}||You take care of the rest of 'em!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:292_2_7"
msgid "Thanks!{PA:20} I'll hold them off until then.{PA:20}||Be careful,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:293_0_0"
msgid "Hey,{PA:10} Uncle Kaz,{PA:10} can I come with you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:293_0_1"
msgid "Haruka.{PA:20}.{PA:20}.{PA:20} I'm sorry,{PA:10} but there's somewhere||I need to go by myself right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:293_0_2"
msgid "Oh.{PA:20}"
msgstr "Vaya...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:293_0_3"
msgid "Well,{PA:10} I'll be here waiting,{PA:10} then.{PA:20}||Remember to come back and get me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:293_0_4"
msgid "Sure,{PA:10} let's go.{PA:20}"
msgstr "Clar{PA:10}o, vamos.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:293_0_5"
msgid "Yaaay!{PA:20}||Thanks,{PA:10} Uncle Kaz.{PA:20}"
msgstr "¡Sííí!{PA:20}|| ¡Gracia{PA:10}s, tío Kaz!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:294_0_0"
msgid "Now Ryuji Goda's our only problem.{PA:20}"
msgstr "Ahora nuestro único problema es Ryuji Goda...{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:294_0_1"
msgid "You can't lose to him,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:294_1_0"
msgid "At least now all the bombs are dead.{PA:20}||We made it through that mess in one piece.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:294_1_1"
msgid "Now Ryuji Goda's our only problem.{PA:20}"
