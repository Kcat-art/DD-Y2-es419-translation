msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:295_0_0"
msgid "Kazuma,{PA:10} there's something I want to talk to||you about.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:295_0_1"
msgid "Can you meet me back at Serena later?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:295_0_2"
