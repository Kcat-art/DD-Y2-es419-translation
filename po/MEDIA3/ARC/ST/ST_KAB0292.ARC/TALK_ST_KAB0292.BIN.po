msgctxt "MEDIA3/ARC/ST/ST_KAB0292.ARC/TALK_ST_KAB0292.BIN::line:295_0_3"
msgid "Sorry,{PA:10} this isn't really the place for it.{PA:20}||Plus I'm busy getting ready here,{PA:10} too.{PA:20}"
