msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:20_0_9"
msgid "(I've got nobody to call.)"
msgstr ""

