msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_32"
msgid "Over 30 types of hand-selected malts mix||with spirits aged in white oak barrels to"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_33"
msgid "produce a mellow flavor that's won a load of||titles at international taste tests.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_34"
msgid "The afterglow is better than sex,{PA:10} tiger.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_35"
msgid "And like sex,{PA:10} it makes a great gift.{PA:20}||Not that I get much of either.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_39"
msgid "This here rectangular bottle's probably the||most popular whiskey in Japan,{PA:10} tiger.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_40"
msgid "Some call it the father of Japanese whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_41"
msgid "Its popularity shows no signs of dropping,{PA:10}||even 70 years after it first debuted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_42"
msgid "Its flavor is perfectly balanced.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_43"
msgid "The container's shape is so characteristic,{PA:10}||folks started referring to the drink by it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_47"
msgid "People have been loving that one since the||day it first came out in 1860.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_48"
msgid "It's practically synonymous with bourbon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_49"
msgid "The flavor is very American--all smooth up||front,{PA:10} but sharp as soon as you swallow.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_50"
msgid "Not that I'm bitter,{PA:10} of course.{PA:20} And hey,{PA:10}||it's cheap enough to enjoy one casually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_54"
msgid "That's a mature,{PA:10} full-grape brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_55"
msgid "It's got that rich,{PA:10} dense brandy flavor and||bouquet you can really sink your teeth into.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_56"
msgid "The finish is wonderful,{PA:10} too.{PA:20} I drink this||stuff at home all the time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_57"
msgid "You can drink it straight or on the rocks,{PA:10}||cut it with water,{PA:10} cut it with tonic.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_58"
msgid "It's the only brandy you'd ever need.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_62"
msgid "That's one of Japan's top brandies.{PA:20} A whole"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_63"
msgid "lot of people agree that its taste is tops.{PA:20}||It's a best-seller!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_64"
msgid "If you're curious about the V.S.O.P.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_65"
msgid "It stands for Very Superior Old Pale.{PA:20}||Not just Superior.{PA:20}.{PA:20}.{PA:20} VERY Superior!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_66"
msgid "It's a classification,{PA:10} tiger.{PA:20}||That puts it in the top class for brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_67"
msgid "It's even tasty cut with fruit juice!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_71"
msgid "That's a nice,{PA:10} affordable brandy.{PA:20} Perfect||for a casual night's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_72"
msgid "The bouquet is clean and sharp,{PA:10} and the||fruity flavor of fresh grapes comes through.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_73"
msgid "It's got a nice,{PA:10} crisp finish,{PA:10} too,{PA:10} making||it very easy to drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_74"
msgid "You can drink it as brandy,{PA:10} or use it as the||base for a cocktail.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_75"
msgid "It's a good,{PA:10} strong specimen I'd recommend||to anyone looking to try out brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_79"
msgid "That's Suntory's major draft beer.{PA:20} I really||don't know what more needs to be said.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_80"
msgid "Suntory is picky about everything they put||into their drinks,{PA:10} but especially the water.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_81"
msgid "Their careful use of natural spring water||really lets the other ingredients sing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_82"
msgid "That keeps the flavor clean,{PA:10} so it's easy to||drink,{PA:10} and the finish is crisp and tasty.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_83"
msgid "You could go all night on these.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_87"
msgid "That's a prime example of Korean soju.{PA:20}||A spring water base gives it a clean taste,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_88"
msgid "while premium Korean barley gives it a||feel that's firm,{PA:10} smooth,{PA:10} supple.{PA:20}.{PA:20}.{PA:20} Ooh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_89"
msgid "And it's not too expensive!{PA:20} You don't get a||cost-performance ratio this good every day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_90"
msgid "There was a time this was all I'd drink.{PA:20}||These days,{PA:10} its taste is like an old friend.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_91"
msgid "The history only makes it all the sweeter.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_95"
msgid "That's another extremely popular Japanese||whiskey,{PA:10} honey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_96"
msgid "The unique influence of Yamazaki sherry wood||barrel aging has won it a lot of fans.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_97"
msgid "It just might be the line that best defines||Suntory's whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_98"
msgid "A lot of people call it \"Dharma\",{PA:10} because||the round shape looks like a daruma doll.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_104"
msgid "Ooh,{PA:10} the more I look at you,{PA:10} the cuter you||get,{PA:10} tiger!{PA:20} I could just eat you up!{PA:20}{PA:20} OMF!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_105"
msgid "Welcome to Kamurocho's own little drag spot.{PA:20}||Prettiest girls in town,{PA:10} I guarantee!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_106"
msgid "I just love this city!{PA:20} Where else are sexy||beasts like you just waltzing around?{PA:20} Hm?{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_108"
msgid "Come to think of it,{PA:10} you'd probably be a||knockout in heels and a long wig.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_109"
msgid "They say birds of a feather flock together!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_110"
msgid "Or maybe I should say,{PA:10} \"When in Rome.{PA:20}.{PA:20}.{PA:20}\".{PA:20}||Ooh,{PA:10} now the Romans knew how to party!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_111"
msgid "They could go for days,{PA:10} just churning and||thrusting and.{PA:20}.{PA:20}.{PA:20} Sorry.{PA:20} I'm done.{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_112"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_115"
msgid "Ooh,{PA:10} back again,{PA:10} I see!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_116"
msgid "I'm flattered,{PA:10} tiger.{PA:20}||All this way,{PA:10} just to see little ol' me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_118"
msgid "So,{PA:10} there's a guy I like,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_119"
msgid "I'm sure he's madly in love with me,{PA:10} too.{PA:20}||Or he will be when he figures out I exist.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_120"
msgid "Until then,{PA:10} I guess I just have to admire||him from afar.{PA:20}.{PA:20}.{PA:20} Or I'll stalk him some.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_121"
msgid "But you know what they say!{PA:20} Good things come||to those who wait,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_122"
msgid "I'm sure we'll be happy together someday.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_123"
msgid "Haste makes waste,{PA:10} Mother always said.{PA:20}||Ooh,{PA:10} but Daddy said fortune favors the bold.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_124"
msgid "Ugh,{PA:10} even in death,{PA:10} they still disagree!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_125"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_128"
msgid "You're back again!{PA:20}||Oh,{PA:10} you know how to make a girl happy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_129"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_131"
msgid "So I'm feeling awfully old these days.{PA:20}.{PA:20}.{PA:20}||Beauty fades fast,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_132"
msgid "I feel like I've been there,{PA:10} done that and||got the T-shirt.{PA:20} Hell,{PA:10} I'm philosophizing!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_133"
msgid "Thinking about the meaning of life and all.{PA:20}||What has my life been up 'til now,{PA:10} tiger?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_134"
msgid "Besides wild,{PA:10} I mean.{PA:20} Time waits for no man.{PA:20}||I haven't had much luck as a lady,{PA:10} either.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_135"
msgid "Well,{PA:10} Einstein said that life can't possibly||be as pointless as it seems at a glance.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_136"
msgid "He was a pretty smart guy.{PA:20} Nice hair,{PA:10} too.{PA:20}||I'm sure we're all part of some big plan.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_137"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_140"
msgid "Well,{PA:10} hey there,{PA:10} tiger!{PA:20}||Good to see you back again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_0_141"
msgid "Warms my little heart to know you've got a||crush on me,{PA:10} honey.{PA:20} Make yourself at home.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_1"
msgid "Hey there,{PA:10} Kazzy.{PA:20}||What can I get you,{PA:10} honey?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_5"
msgid "You're drunk,{PA:10} tiger!{PA:20}||I wouldn't drink any more tonight,{PA:10} hon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_8"
msgid "Care for another one,{PA:10} Kazzy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_9"
msgid "Well,{PA:10} if you're sure.{PA:20}||Come by and see us again real soon,{PA:10} hon!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_15"
msgid "That's one of Japan's best single-malt||whiskeys,{PA:10} tiger.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_16"
msgid "It's become such a status symbol you can||count on it staying on top,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_17"
msgid "It's a household name.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_18"
msgid "They use carefully tested,{PA:10} perfectly matured||malts to get that great,{PA:10} smooth flavor.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_19"
msgid "It's popular overseas,{PA:10} too.{PA:20} Not just here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_23"
msgid "They make that with mountain spring water at||Suntory's Hakushu distillery in the heart of"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_24"
msgid "the Japanese alps,{PA:10} so the taste is divine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_25"
msgid "Its distinctly creamy yet fruity feel sets||it apart from other Japanese whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_26"
msgid "I'd say take the first one straight for a||real kick,{PA:10} but what do I know from straight?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_27"
msgid "Oh,{PA:10} and it goes great with all kinds||of food,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_31"
msgid "That's Japan's premium whiskey,{PA:10} and it's won||over whiskey snobs the world over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_32"
msgid "Over 30 types of hand-selected malts mix||with spirits aged in white oak barrels to"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_33"
msgid "produce a mellow flavor that's won a load of||titles at international taste tests.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_34"
msgid "The afterglow is better than sex,{PA:10} tiger.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_35"
msgid "And like sex,{PA:10} it makes a great gift.{PA:20}||Not that I get much of either.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_39"
msgid "This here rectangular bottle's probably the||most popular whiskey in Japan,{PA:10} tiger.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_40"
msgid "Some call it the father of Japanese whiskey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_41"
msgid "Its popularity shows no signs of dropping,{PA:10}||even 70 years after it first debuted.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_42"
msgid "Its flavor is perfectly balanced.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_43"
msgid "The container's shape is so characteristic,{PA:10}||folks started referring to the drink by it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_47"
msgid "People have been loving that one since the||day it first came out in 1860.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_48"
msgid "It's practically synonymous with bourbon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_49"
msgid "The flavor is very American--all smooth up||front,{PA:10} but sharp as soon as you swallow.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_50"
msgid "Not that I'm bitter,{PA:10} of course.{PA:20} And hey,{PA:10}||it's cheap enough to enjoy one casually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_54"
msgid "That's a mature,{PA:10} full-grape brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_55"
msgid "It's got that rich,{PA:10} dense brandy flavor and||bouquet you can really sink your teeth into.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_56"
msgid "The finish is wonderful,{PA:10} too.{PA:20} I drink this||stuff at home all the time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_57"
msgid "You can drink it straight or on the rocks,{PA:10}||cut it with water,{PA:10} cut it with tonic.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_58"
msgid "It's the only brandy you'd ever need.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_62"
msgid "That's one of Japan's top brandies.{PA:20} A whole"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_63"
msgid "lot of people agree that its taste is tops.{PA:20}||It's a best-seller!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_64"
msgid "If you're curious about the V.S.O.P.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_65"
msgid "It stands for Very Superior Old Pale.{PA:20}||Not just Superior.{PA:20}.{PA:20}.{PA:20} VERY Superior!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_66"
msgid "It's a classification,{PA:10} tiger.{PA:20}||That puts it in the top class for brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_67"
msgid "It's even tasty cut with fruit juice!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_71"
msgid "That's a nice,{PA:10} affordable brandy.{PA:20} Perfect||for a casual night's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_72"
msgid "The bouquet is clean and sharp,{PA:10} and the||fruity flavor of fresh grapes comes through.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_73"
msgid "It's got a nice,{PA:10} crisp finish,{PA:10} too,{PA:10} making||it very easy to drink.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_74"
msgid "You can drink it as brandy,{PA:10} or use it as the||base for a cocktail.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_75"
msgid "It's a good,{PA:10} strong specimen I'd recommend||to anyone looking to try out brandy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_79"
msgid "That's Suntory's major draft beer.{PA:20} I really||don't know what more needs to be said.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_80"
msgid "Suntory is picky about everything they put||into their drinks,{PA:10} but especially the water.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_81"
msgid "Their careful use of natural spring water||really lets the other ingredients sing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_82"
msgid "That keeps the flavor clean,{PA:10} so it's easy to||drink,{PA:10} and the finish is crisp and tasty.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_83"
msgid "You could go all night on these.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_87"
msgid "That's a prime example of Korean soju.{PA:20}||A spring water base gives it a clean taste,{PA:10}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_88"
msgid "while premium Korean barley gives it a||feel that's firm,{PA:10} smooth,{PA:10} supple.{PA:20}.{PA:20}.{PA:20} Ooh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_89"
msgid "And it's not too expensive!{PA:20} You don't get a||cost-performance ratio this good every day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_90"
msgid "There was a time this was all I'd drink.{PA:20}||These days,{PA:10} its taste is like an old friend.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_91"
msgid "The history only makes it all the sweeter.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_95"
msgid "That's another extremely popular Japanese||whiskey,{PA:10} honey.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_96"
msgid "The unique influence of Yamazaki sherry wood||barrel aging has won it a lot of fans.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_97"
msgid "It just might be the line that best defines||Suntory's whiskeys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_98"
msgid "A lot of people call it \"Dharma\",{PA:10} because||the round shape looks like a daruma doll.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_104"
msgid "Ooh,{PA:10} the more I look at you,{PA:10} the cuter you||get,{PA:10} tiger!{PA:20} I could just eat you up!{PA:20}{PA:20} OMF!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_105"
msgid "Welcome to Kamurocho's own little drag spot.{PA:20}||Prettiest girls in town,{PA:10} I guarantee!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_106"
msgid "I just love this city!{PA:20} Where else are sexy||beasts like you just waltzing around?{PA:20} Hm?{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_108"
msgid "Come to think of it,{PA:10} you'd probably be a||knockout in heels and a blonde wig,{PA:10} Kazzy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_109"
msgid "They say birds of a feather flock together!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_110"
msgid "Or maybe I should say,{PA:10} \"When in Rome.{PA:20}.{PA:20}.{PA:20}\".{PA:20}||Ooh,{PA:10} now the Romans knew how to party!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_111"
msgid "They could go for days,{PA:10} just churning and||thrusting and.{PA:20}.{PA:20}.{PA:20} Ahem,{PA:10} excuse me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_112"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_115"
msgid "Ooh,{PA:10} back again,{PA:10} I see!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_116"
msgid "I'm flattered,{PA:10} tiger.{PA:20}||All this way,{PA:10} just to see little ol' me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_118"
msgid "So,{PA:10} there's a guy I like,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_119"
msgid "I'm sure he's madly in love with me,{PA:10} too.{PA:20}||Or he will be when he figures out I exist.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_120"
msgid "Until then,{PA:10} I guess I just have to admire||him from afar.{PA:20}.{PA:20}.{PA:20} Or I'll stalk him some.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_121"
msgid "But you know what they say!{PA:20} Good things come||to those who wait,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_122"
msgid "I'm sure we'll be happy together someday.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_123"
msgid "Haste makes waste,{PA:10} Mother always said.{PA:20}||Ooh,{PA:10} but Daddy said fortune favors the bold.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_124"
msgid "Ugh,{PA:10} even in death,{PA:10} they still disagree!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_125"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_128"
msgid "You're back again!{PA:20}||Oh,{PA:10} you know how to make a girl happy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_129"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_131"
msgid "So I'm feeling awfully old these days.{PA:20}.{PA:20}.{PA:20}||Beauty fades fast,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_132"
msgid "I feel like I've been there,{PA:10} done that,{PA:10} and||got the T-shirt.{PA:20} Hell,{PA:10} I'm philosophizing!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_133"
msgid "Thinking about the meaning of life and all.{PA:20}||What has my life been up 'til now,{PA:10} tiger?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_134"
msgid "Besides wild,{PA:10} I mean.{PA:20} Time waits for no man.{PA:20}||I haven't had much luck as a lady,{PA:10} either.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_135"
msgid "Well,{PA:10} Einstein said that life can't possibly||be as pointless as it seems at a glance.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_136"
msgid "He was a pretty smart guy.{PA:20} Nice hair,{PA:10} too.{PA:20}||I'm sure we're all part of some big plan!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_137"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_140"
msgid "Well,{PA:10} hey there,{PA:10} tiger!{PA:20}||Good to see you back again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_1_141"
msgid "Warms my little heart to know you've got a||crush on me,{PA:10} honey.{PA:20} Make yourself at home.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_2_0"
msgid "Hey,{PA:10} sailor!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_3_0"
msgid "||||||{IC:00_06}➿"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_5_0"
msgid "Th-Thanks,{PA:10} Kaz.{PA:20}.{PA:20}.{PA:20}||That creep was always giving me a hard time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_5_1"
msgid "Next time anybody gives you a hard time,{PA:10}||you just let ol' Ako know,{PA:10} honey!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0087.ARC/TALK_ST_KAB0087.BIN::line:302_5_2"
msgid "            You befriended Ako||             from Earth Angel!{PA:20}"
