msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0315.ARC/TALK_ST_KAB0315.BIN::line:20_2_4"
msgid "Hello?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0315.ARC/TALK_ST_KAB0315.BIN::line:20_2_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0315.ARC/TALK_ST_KAB0315.BIN::line:20_2_6"
msgid "I'd like to ask about Keima.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0315.ARC/TALK_ST_KAB0315.BIN::line:20_2_7"
msgid "How many stairs are in Tsutenkaku Tower?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0315.ARC/TALK_ST_KAB0315.BIN::line:20_2_8"
msgid "The number of stairs?{PA:20}"
