msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:311_1_4"
msgid "Some of 'em got hit so bad,{PA:10} they done gone||outta business now.{PA:20} The poor bastards.{PA:20}"
