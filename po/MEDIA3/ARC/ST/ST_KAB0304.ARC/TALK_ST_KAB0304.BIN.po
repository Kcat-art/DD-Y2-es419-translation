msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:311_1_8"
msgid "It's shady stuff,{PA:10} buddy.{PA:20} You be careful not||to start any trouble down there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:311_2_0"
msgid "Shadier 'n' a tree,{PA:10} I say.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:314_0_0"
msgid "Aww,{PA:10} nasty!{PA:20}||That stuff's not fit for human consumption!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_0_1"
msgid "I still say it was a cigarette or somethin'.{PA:20}||There's gotta be a sane explanation.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_0_2"
msgid "This ain't no action movie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_1_1"
msgid "Wanna hear the explosion's cause?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_1_2"
msgid "What was it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_1_3"
msgid "I think somebody just forgot to put out a||cigarette too close to a gas main.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_1_4"
msgid "This ain't an action movie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_1_5"
msgid "Ain't nobody crazy enough to blow up a whole||building on purpose in this country.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_1_6"
msgid "Still,{PA:10} Kanto's a scary place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:315_2_0"
msgid "The explosion's cause.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:316_0_0"
msgid "Hey,{PA:10} look.{PA:20}.{PA:20}.{PA:20}||She gonna be okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:316_0_1"
msgid ".{PA:20}.{PA:20}.{PA:20}She bleedin'?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:316_0_2"
msgid "Wonder what happened.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:316_0_3"
msgid "What happened||to that lady?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:317_0_1"
msgid "Seems Osaka's gettin' to be pretty nasty.{PA:20}||Lotsa folks out fightin' in the streets.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:317_0_2"
msgid "Been here a long time,{PA:10} but I've never seen||yakuza out in packs like this before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:318_0_0"
msgid "Hey,{PA:10} izzat guy okay?{PA:20}||He seems a bit off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:318_0_1"
msgid "Is he bleedin'?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:318_0_2"
msgid "He's hurt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:318_0_3"
msgid "Whoa!{PA:20}"
msgstr "¡Oh!{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:319_0_1"
msgid "Couldn't eat another bite!{PA:20}||I can't believe I choked it all down.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:319_0_2"
msgid "I'm never eatin' modan and okonomiyaki and||takoyaki all in one sittin' again!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:319_1_0"
msgid "Braaap.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_2"
msgid "Hey,{PA:10} buddy,{PA:10} perfect timing!{PA:20}||That jerk just ran off!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_3"
msgid "Ate half the food on the goddamn menu,{PA:10} then||split without payin' for any of it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_4"
msgid "Pisses me off!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_5"
msgid "Think ya could snag him for me,{PA:10} pal?{PA:20}||Please?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_6"
msgid "I'll treat ya to a hell of a meal!{PA:20} .{PA:20}.{PA:20}.{PA:20}Well?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_7"
msgid "What'd he look like?{PA:20} Hm.{PA:20}.{PA:20}.{PA:20}||He was a fat-ass!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_0_8"
msgid "It's up to you now,{PA:10} buddy!{PA:20} Thanks!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_1_0"
msgid "Hey!!{PA:20}||Someone tackle that guy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_2_1"
msgid "Wow!{PA:20} Didn't think ya'd actually nab him!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_2_2"
msgid "Thanks a million,{PA:10} pal!{PA:20}||Here's a little thanks for yer trouble.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_2_3"
msgid "          You received 20,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_2_4"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_2_5"
msgid "Now!{PA:20} Let's beat that money outta ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:320_2_6"
msgid "Dammit.{PA:20}.{PA:20}.{PA:20}||I ain't givin' up that easy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_0_1"
msgid "Hey!{PA:20} Yeah,{PA:10} you,{PA:10} chum!{PA:20}||You just glare at me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_0_2"
msgid "No.{PA:20} Not intentionally,{PA:10} anyway.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_0_3"
msgid "Don't gimme that!{PA:20} You WERE glarin' at me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_0_5"
msgid "Ah!{PA:20} And now ya rolled yer eyes at me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_0_6"
msgid "How 'bout I show ya what happens to folks||dumb enough to make fun o' me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_1"
msgid "Stop,{PA:10} wait.{PA:20}.{PA:20}.{PA:20} hold up!{PA:20}||C'mon,{PA:10} man,{PA:10} I'm beat here!{PA:20} I give!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_2"
msgid "Wait a.{PA:20}.{PA:20}.{PA:20} HEY!{PA:20} K-Kitagawa?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_3"
msgid "M-Mr.{PA:20} Kiryu,{PA:10} that there's my partner!{PA:20}||Ex-Mars Fighter,{PA:10} Kitagawa.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_4"
msgid "M-Minamizawa?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_5"
msgid "What the hell're ya doin' here?{PA:20}||Actin' like some kinda damn yakuza.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_6"
msgid "Ack!{PA:20} Gotta bolt.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:324_1_7"
msgid "H-Hey!{PA:20} Wait,{PA:10} Kitagawa!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:325_1_1"
msgid "Hey,{PA:10} bro!{PA:20} Help me catch him,{PA:10} would ya?!{PA:20}||I can't run for shit,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:325_1_2"
