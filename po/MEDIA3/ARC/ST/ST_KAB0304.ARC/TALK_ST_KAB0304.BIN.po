msgctxt "MEDIA3/ARC/ST/ST_KAB0304.ARC/TALK_ST_KAB0304.BIN::line:310_1_2"
msgid "It's awesome,{PA:10} buddy!{PA:20} It's roomy.{PA:20}||They got some fine dancers,{PA:10} too.{PA:20}"
