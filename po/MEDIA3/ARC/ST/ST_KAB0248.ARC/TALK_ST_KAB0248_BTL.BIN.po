msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::name:0"
msgid "Tamiyo"
msgstr "Tamiyo"

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::name:1"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:138_1_0"
msgid "     You now have access to a hideout.{PA:20}"
msgstr "Ahora tienes acceso al escondite.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:138_1_1"
msgid "Your health will recover while inside the"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:138_1_2"
msgid "hideout,{PA:10} where you can also save your game"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:138_1_3"
msgid "or manage your item inventory.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_1_0"
msgid "Leave gettin' this place ready to me,{PA:10} sugar.{PA:20}||You go get Kaoru here,{PA:10} fast!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_2_0"
msgid "What's holdin' up those bandages,{PA:10} sugar?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_2_1"
msgid "Get your skinny ass back here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_3_0"
msgid "Here you go.{PA:20}"
msgstr "Aquí tiene.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_3_1"
msgid "       You handed over the bandages.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_3_2"
msgid "Great.{PA:20} Thanks,{PA:10} sugar.{PA:20}||You're a saint.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_4_0"
msgid "Don't know where you're off to,{PA:10} sugar,{PA:10} but||you be careful.{PA:20} Leave Kaoru to me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_5_0"
msgid "Welcome to.{PA:20}.{PA:20}.{PA:20} Oh,{PA:10} it's you,{PA:10} sugar.{PA:20}||If you're after Kaoru,{PA:10} she ain't here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_5_1"
msgid "Where is she?{PA:20}"
msgstr "¿No sabría decirme en dónde está ella?{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_5_2"
msgid "Dunno what's happened,{PA:10} but.{PA:20}.{PA:20}.{PA:20}||Probably that bar on Sotenbori?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_5_3"
msgid "Usually drops in there when she's out alone.{PA:20}||She's a real regular.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_5_4"
msgid "The bar on Sotenbori.{PA:20}||Okay,{PA:10} I'll take a look.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_6_0"
msgid "Kaoru's probably in that bar on Sotenbori.{PA:20}||She's a real regular.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_6_1"
msgid "If ya need her,{PA:10} try lookin' there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_7_0"
msgid "Hmm?{PA:20} You're here awful early,{PA:10} sugar.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_7_1"
msgid "Kaoru's still asleep in back.{PA:20}||Want me wake her up?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_7_2"
msgid "No,{PA:10} don't bother.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_7_3"
msgid "Sorry 'bout that,{PA:10} sugar.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_8_0"
msgid "Kaoru's probably already down at Iwao||Bridge.{PA:20} You should head out,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_9_0"
msgid "Huh?{PA:20} Ain't ya meetin' Kaoru down at Iwao||Bridge,{PA:10} sugar?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_9_1"
msgid "She already left.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_9_2"
msgid "Probably there by now.{PA:20}||You should head out,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_10_0"
msgid "Don't go pushin' yerself too hard.{PA:20}||You just leave Kaoru to Mr.{PA:20} Kawara.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_11_0"
msgid "I don't figure it's much use sayin' it,{PA:10}||but don't push yerself too hard out there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_11_1"
msgid "Don't matter if ya rescue the poor girl if||ya die tryin'.{PA:20} Remember that,{PA:10} sugar.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_11_2"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_12_0"
msgid "Don't go forgettin' you're still wounded.{PA:20}||You be careful out there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_0"
msgid "How's the wound,{PA:10} sugar?{PA:20} Still hurtin' ya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_1"
msgid "Just a bit.{PA:20}||I'll make it,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_2"
msgid "Figure out where yer girl's at?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_3"
msgid "Yeah.{PA:20} Osakan Castle.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_4"
msgid "Huh?{PA:20} Well,{PA:10} if so,{PA:10} it's a bit aways,{PA:10} but a||taxi should get ya there in two shakes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_5"
msgid "All right.{PA:20} I'll catch a cab,{PA:10} then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/ST/ST_KAB0248.ARC/TALK_ST_KAB0248_BTL.BIN::line:139_13_6"
msgid "Don't go forgettin' you're still wounded.{PA:20}||You be careful out there.{PA:20}"
msgstr ""

