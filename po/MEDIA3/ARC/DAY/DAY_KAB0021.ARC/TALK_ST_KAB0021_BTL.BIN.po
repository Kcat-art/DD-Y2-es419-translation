msgctxt "MEDIA3/ARC/DAY/DAY_KAB0021.ARC/TALK_ST_KAB0021_BTL.BIN::line:139_0_0"
msgid "Welcome,{PA:10} welcome!{PA:20} Care to stay for a show,{PA:10}||sir?{PA:20} It'll be one to remember!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0021.ARC/TALK_ST_KAB0021_BTL.BIN::line:139_0_1"
msgid "Admission is only 3,{PA:10}000 yen.{PA:20}||Quite the bargain,{PA:10} if I do say so myself!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0021.ARC/TALK_ST_KAB0021_BTL.BIN::line:139_0_4"
msgid "Sure,{PA:10} I'll check it out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0021.ARC/TALK_ST_KAB0021_BTL.BIN::line:139_0_5"
