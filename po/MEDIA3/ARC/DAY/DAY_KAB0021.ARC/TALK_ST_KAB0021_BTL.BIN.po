msgctxt "MEDIA3/ARC/DAY/DAY_KAB0021.ARC/TALK_ST_KAB0021_BTL.BIN::line:139_6_5"
msgid "All right,{PA:10} then.{PA:20} That'll be 3,{PA:10}000 yen.{PA:20}||Enjoy the show!{PA:20}"
