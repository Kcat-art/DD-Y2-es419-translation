msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:308_0_0"
msgid "Seriously?!{PA:20}||Wonderful!{PA:20}❤"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:309_0_0"
msgid "Hey,{PA:10} look.{PA:20}||Ain't that blood?{PA:20}"
