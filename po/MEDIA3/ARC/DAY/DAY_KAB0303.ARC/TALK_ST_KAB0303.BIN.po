msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:307_1_0"
msgid "You serious?{PA:20}||Yeesh,{PA:10} that's scary!{PA:20}"
