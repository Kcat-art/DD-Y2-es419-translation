msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:309_0_2"
msgid "She gonna be okay?{PA:20}||That lady there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:309_0_3"
msgid "She don't look too good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:310_0_0"
msgid "Hey,{PA:10} look.{PA:20}||Ain't that blood?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:310_0_1"
msgid "Is he hurt?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:310_0_2"
msgid "Wonder if he's okay.{PA:20}||I dunno.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:310_0_3"
msgid "He looks pretty bad.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_1"
msgid "Hey!{PA:20} Hold it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_2"
msgid "Eek!{PA:20}"
msgstr "¡No!...{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_6"
msgid "Huff.{PA:20}.{PA:20}.{PA:20} pant.{PA:20}.{PA:20}.{PA:20}||K-Kitagawa!{PA:20} Why're ya runnin' away?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_7"
msgid "You should at least hear him out.{PA:20}||How long do you plan on running?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_8"
msgid "A-All right,{PA:10} fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_9"
msgid "Why'd ya say ya wanted to call it off,{PA:10} man?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_10"
msgid "Why'd ya disappear on me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_11"
msgid ".{PA:20}.{PA:20}.{PA:20}Yer setups suck ass.{PA:20}||Ain't nothin' there a guy can work with.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_12"
msgid "Nice.{PA:20}.{PA:20}.{PA:20} Very subtle.{PA:20}||I kinda realized that,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_13"
msgid "That ain't all,{PA:10} though.{PA:20}||My comebacks were for shit,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_14"
msgid "The two of us just weren't born for comedy.{PA:20}||Call it fate,{PA:10} man.{PA:20} It ain't happenin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_15"
msgid "So I said we should just stop tryin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_16"
msgid "Kitagawa.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kitagawa.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_17"
msgid "So what're ya even doin' these days?{PA:20}||Why're ya actin' like some kinda yakuza?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_18"
msgid "I sat in a manga café fer a month after that||drinkin' iced oolong tea.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_19"
msgid "What are ya,{PA:10} some kinda shut-in?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_20"
msgid "So there I was,{PA:10} readin' comics,{PA:10} right?{PA:20}||There was this one amazin' yakuza story.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_21"
msgid "After finishin' out the series,{PA:10} I didn't||have anythin' else to do,{PA:10} ya know?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_22"
msgid "So I joined the yakuza.{PA:20} It's like I HAD to.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_23"
msgid "No,{PA:10} you HAVE to be kidding me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_24"
msgid "What're ya,{PA:10} daft?!{PA:20} Who joins the yakuza for||a dumb-ass reason like that?{PA:20} Wake up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_26"
msgid "Ow!{PA:20} That huuurt!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_27"
msgid "Don't go hittin' me,{PA:10} man!{PA:20}||It'd be a crime to ruin a handsome face.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_28"
msgid "I'll remember that if I ever see one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_29"
msgid "Look,{PA:10} ya knocked my toupee outta place.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_30"
msgid "You're bald?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_31"
msgid "Been a while since I seen you,{PA:10} 'n' now it's||a damn circus when we finally meet up again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_32"
msgid "Hey,{PA:10} hold on!{PA:20}"
msgstr "¡Oig{PA:10}a, espere!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_33"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_34"
msgid "This.{PA:20}.{PA:20}.{PA:20} This is good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_35"
msgid "What's good?{PA:20}||The lopsided toupee look?{PA:20} I'd vote no.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_36"
msgid "Not that!{PA:20} This!{PA:20} This dynamic!{PA:20}||Don't ya feel it?{PA:20} This is workin'!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_37"
msgid "Actually.{PA:20}.{PA:20}.{PA:20} Hey,{PA:10} yeah.{PA:20}||You're playin' funny guy to my straight man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_38"
msgid "Yeah!{PA:20}"
msgstr "¡Sí!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_39"
msgid "Up 'til now,{PA:10} we been playin' it the other||way around.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_40"
msgid "But check us out!{PA:20} I'm all kinds o' out of||it,{PA:10} 'n' you're comin' at me with zingers!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_41"
msgid "I'm a natural funny man!{PA:20}||And yer straight man ain't bad,{PA:10} either!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_42"
msgid "I felt all my hair standin' up on end,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_43"
msgid "Ya ain't even got hair!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_44"
msgid "Hey,{PA:10} let's take this combination to the||Grand Prix,{PA:10} buddy.{PA:20} Whaddya say?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_45"
msgid "Kitagawa!{PA:20} Ya think we can do it?{PA:20}||All right!{PA:20} The Mars Fighters ride again!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_46"
msgid "Still feels a little strange,{PA:10} but I got a||good feelin' about this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_49"
msgid "Thank you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_50"
msgid "Without you givin' me that extra push,{PA:10} I'd||probably've given up on the comedy life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_51"
msgid "Me playin' the funny man.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_52"
msgid "That's probably all thanks to you knockin'||my brain loose,{PA:10} buddy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_53"
msgid "You're the one who picked the fight,{PA:10} ya ass!{PA:20}||Give the man a real apology!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_54"
msgid "Hey,{PA:10} that's right!{PA:20} Sorry,{PA:10} buddy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_55"
msgid "Honestly,{PA:10} you're always like that!{PA:20}||I give up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_56"
msgid "Wait,{PA:10} I thought ya just said we WEREN'T||gonna give up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_57"
msgid "Knock it off!{PA:20}"
msgstr "¡¡Espabila!!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_58"
msgid "Thank you,{PA:10} thank you!{PA:20}"
msgstr "¡Gracias,{PA:10} gracias!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:312_0_59"
msgid "Received 1❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:314_0_0"
msgid "Sigh.{PA:20}.{PA:20}.{PA:20} I'm awful sorry about that.{PA:20}||Talk about embarrassin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:314_0_1"
msgid "Seems like there's a story there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:314_0_2"
msgid "Boy howdy,{PA:10} yeah.{PA:20} Guy's a gamblin' addict.{PA:20}||Horses,{PA:10} casino games,{PA:10} the whole deal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:314_0_3"
msgid "First he loses all his cash,{PA:10} now he starts||shakin' me down for mine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:314_0_4"
msgid "Guess it's curtains for us,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:314_2_0"
msgid "Ugh,{PA:10} get it together already!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:315_0_0"
msgid "Huh?{PA:20} Wh-Whaddya want,{PA:10} old man?{PA:20}||This is a private matter,{PA:10} pal.{PA:20} Butt out!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:315_0_1"
msgid "You can hardly call it a private matter when||you're having it out on the street.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:315_0_2"
msgid "Aww,{PA:10} shut it!{PA:20}||Ain't got nothin' to do with you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:315_0_3"
msgid "Ugh,{PA:10} fuck this!{PA:20} We'll talk later,{PA:10} Keiko.{PA:20}||Ya better have that money ready then!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:315_1_0"
msgid "Just gimme the damn money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:316_0_0"
msgid "Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:316_0_1"
msgid "That's me.{PA:20}"
msgstr "Así es.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:316_0_2"
msgid "So,{PA:10} what's this about you not paying,{PA:10} huh?{PA:20}||The repairs at Sunflower,{PA:10} right?{PA:20}"
