msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:316_0_3"
msgid "We'll have to take the place as collateral.{PA:20}||All those kids,{PA:10} turned out on the street?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:316_0_4"
msgid "You're not touching those kids,{PA:10} and I've||told you,{PA:10} you're not getting paid.{PA:20}"
