msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:20_1_4"
msgid "It's Kiryu.{PA:20}"
msgstr "Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:20_1_5"
msgid "M-Mr.{PA:20} Kiryu!{PA:20} Boss!{PA:20} Yes,{PA:10} sir!{PA:20}||H-How can we help you today?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:20_1_6"
msgid "The folks at Sunflower want to build a kids'||park,{PA:10} but they're low on money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:20_1_7"
msgid "Can you do something for them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:20_1_8"
msgid "Yes,{PA:10} sir!{PA:20} Of course!{PA:20} Leave it to us,{PA:10} and||we'll whip something up for cheap!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:20_1_9"
msgid "Thanks.{PA:20}||That sounds great.{PA:20}"
msgstr ""

