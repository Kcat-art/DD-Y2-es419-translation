msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303.BIN::line:28_1_5"
