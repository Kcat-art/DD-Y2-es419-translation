msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::name:0"
msgid "Kurokawa"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::name:1"
msgid "Kiryu"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_0"
msgid "Huff.{PA:20}.{PA:20}.{PA:20} hah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_1"
msgid "I got a mean mug,{PA:10} yeah?{PA:20} Got it from my mom.{PA:20}||Folks always think I'm yakuza 'n' run off!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_2"
msgid "I tell 'em I'm not,{PA:10} but they're still all,{PA:10}||\"Ooh,{PA:10} he's all yakuza!{PA:20}\" and run off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_3"
msgid "Guy can't do a lick o' straight business,{PA:10}||I swear.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_4"
msgid "At this rate,{PA:10} I might as well go yakuza!{PA:20}||Serve 'em all right!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_5"
msgid "Anyhow,{PA:10} enough o' that.{PA:20} I saw you before.{PA:20}||{MS:0}Pretty strong,{PA:10} aren't ya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_6"
msgid "Numbnuts there was givin' me shit,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_7"
msgid "Oh,{PA:10} by the way,{PA:10} I'm Kurokawa,{PA:10} yeah?{PA:20}||Dunno why I'm askin' you.{PA:20} 'S my name.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_8"
msgid "Pretty one,{PA:10} too,{PA:10} if I say so myself.{PA:20}||Not like my old lady.{PA:20} That ugly bat ran off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_9"
msgid "Anyhow,{PA:10} enough o' that,{PA:10} too.{PA:20}||{MS:0}So what's yer name,{PA:10} buddy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_10"
msgid "Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_11"
msgid "Mr.{PA:20} Kiryu,{PA:10} huh?{PA:20}||First time in Osaka?{PA:20} Welcome,{PA:10} welcome!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_12"
msgid "I'd love to pay ya back,{PA:10} buddy.{PA:20}||{MS:0}Still,{PA:10} what to do?{PA:20} Hmm.{PA:20}.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_13"
msgid "Hmmmmm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_14"
msgid "You want anything,{PA:10} buddy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_15"
msgid "I may not look it,{PA:10} but I got a bead on most||all the info around here.{PA:20} No joke.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_16"
msgid "Ya need to know anything,{PA:10} just ask me.{PA:20}||I'll do what I can,{PA:10} yeah?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_0_17"
msgid "Anyhow,{PA:10} I'm around if you want me,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_1_0"
msgid "Whoa,{PA:10} hold it!{PA:20}||Wait a sec,{PA:10} buddy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_1_1"
msgid "I ain't no trouble!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_2_0"
msgid "Anything ya need,{PA:10} buddy?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_2_1"
msgid "Not really.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_2_2"
msgid "Yeah?{PA:20} Eh,{PA:10} well.{PA:20} Ya think of somethin',{PA:10}||just come ask me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_3_0"
msgid "Already talked to the cabaret folks.{PA:20}||You're all set,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_3_1"
msgid "It's just riiight down the way,{PA:10} yeah?{PA:20}||Go have fun!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_4_0"
msgid "M-Mr.{PA:20} Kiryu,{PA:10} big news!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_4_1"
msgid "What is it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_4_2"
msgid "It's all over the news!{PA:20} Check out the big||TV they got runnin' over there!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0303.ARC/TALK_ST_KAB0303_BTL.BIN::line:138_5_0"
msgid "Hey!{PA:20}||Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

