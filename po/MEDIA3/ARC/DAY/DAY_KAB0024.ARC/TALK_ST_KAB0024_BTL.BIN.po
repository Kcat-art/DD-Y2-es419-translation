msgstr "Kaoru"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::name:1"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::name:2"
msgid "Haruka"
msgstr "Haruka"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::name:3"
msgid "Date"
msgstr "Date"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::name:4"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::name:5"
msgid "Il Yu-Jin"
msgstr "I Ru-jeon"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_1"
msgid "Wait,{PA:10} you're going in here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_2"
msgid "(I've got Sayama with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_3"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_4"
msgid "Doesn't look like I have much of a choice.{PA:20}||Fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_5"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_6"
msgid "You sure?{PA:20} I don't really care.{PA:20}"
msgstr "¿Seguro? No hab{PA:20}ría tenido problemas con esperarte.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_7"
msgid "Are you going in here,{PA:10} Uncle Kaz?{PA:20}"
msgstr "¿Entrarás allí, {PA:10}tío Kaz?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_8"
msgid "(I've got Haruka with me.{PA:20} What do I do?)"
msgstr "(¿Haruka me está acompañ{PA:20}ando. ¿Entro?)."

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_9"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Okay.{PA:20} I'll stay right here.{PA:20}||Have fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_11"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_12"
msgid "Really?{PA:20} If it's because of me,{PA:10} you don't||have to,{PA:10} Uncle Kaz.{PA:20} I'll be fine here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_13"
msgid "Whoa,{PA:10} whoa.{PA:20} Kazuma,{PA:10} you're going in HERE?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_14"
msgid "(I've got Date with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_15"
msgid "Yeah.{PA:20} Care to join me,{PA:10} Date?{PA:20}||Should be a fun time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_16"
msgid ".{PA:20}.{PA:20}.{PA:20}I'll pass.{PA:20}||Go have your fun.{PA:20} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_17"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_18"
msgid "You sure?{PA:20} Won't bother me.{PA:20}||I can keep myself busy for an hour.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_19"
msgid "You're not thinking of going in,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_20"
msgid "(I've got Daigo with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_21"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr "Cla{PA:10}ro.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_22"
msgid "All right,{PA:10} well.{PA:20}.{PA:20}.{PA:20}||I'll just wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_23"
msgid "Thanks,{PA:10} Daigo.{PA:20} I'll catch up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_24"
msgid "No,{PA:10} not right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_1_25"
msgid "Yeah?{PA:20} Well,{PA:10} a'ight then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_2_1"
msgid "*Sigh* Finally.{PA:20}||Now c'mon,{PA:10} let's get out of here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_2_2"
msgid "You took foreeever!{PA:20}||I'm bored,{PA:10} let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_2_3"
msgid "All done with your fun?{PA:20}||Let's get back to work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_2_4"
msgid "Fucking finally.{PA:20}||Let's go already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_4_0"
msgid "(There's no time for that now.{PA:20} I need to||find a hospital.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0024.ARC/TALK_ST_KAB0024_BTL.BIN::line:138_5_0"
msgid "No,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||This not where I wanted to go.{PA:20}"
msgstr ""

