msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_18"
msgid "Videos?{PA:20}||Of what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_19"
msgid "H-Hey,{PA:10} that's right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_20"
msgid "You seem like a tough guy.{PA:20}||M-Maybe you'd be interested.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_21"
msgid "My name's Kamiyama.{PA:20} I'll add you to my list||of approved customers.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_22"
msgid "There are always new titles coming out,{PA:10} or||rare finds.{PA:20}.{PA:20}.{PA:20} Some even I don't know about.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_23"
msgid "I-If you ever want to shop,{PA:10} just.{PA:20}.{PA:20}.{PA:20}||Just let me know,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_25"
msgid "Wh-Which one do you want?{PA:20}||They're all 10K.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_26"
