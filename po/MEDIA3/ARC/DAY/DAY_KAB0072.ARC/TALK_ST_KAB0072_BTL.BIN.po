msgstr "Kiryu"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::name:3"
msgid "Erudite Yakuza"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::name:4"
msgid "Kamiyama"
msgstr "Kamiyama"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_0_1"
msgid "I-I ain't selling a damn thing.{PA:20}||Who said I was?{PA:20} .{PA:20}.{PA:20}.{PA:20}They lied!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_4"
msgid "Nnh?{PA:20} So you ARE doing business,{PA:10} you perv!{PA:20}||I said we own all the tits on video here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_5"
msgid "N-No,{PA:10} I'm.{PA:20}.{PA:20}.{PA:20} I'm not selling any porn.{PA:20}.{PA:20}.{PA:20}||I swear,{PA:10} they're.{PA:20}.{PA:20}.{PA:20} They're all clean.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_6"
msgid "Oh,{PA:10} sure!{PA:20} You're selling kids' flicks||in this cozy little back alley.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_7"
msgid "Fine,{PA:10} if it's not skin flicks,{PA:10} then what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_8"
msgid "Some kinda weirdo fetish thing?{PA:20}||Something so far gone it's not porno?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_9"
msgid "N-No!{PA:20} Nothing like that.{PA:20}.{PA:20}.{PA:20}||Well,{PA:10} I.{PA:20}.{PA:20}.{PA:20} I guess it's a little.{PA:20}.{PA:20}.{PA:20} weird.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_10"
msgid "I knew it!{PA:20} All right,{PA:10} boys,{PA:10} trash everything||in his bag!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_11"
msgid "P-Please,{PA:10} no!{PA:20} Don't!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_12"
msgid "            Will you stop them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_13"
msgid "H-He's pretty strong.{PA:20}.{PA:20}.{PA:20}||C'mon,{PA:10} boys,{PA:10} put your backs into it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_14"
msgid "P-Please,{PA:10} nooo!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_15"
msgid "            Will you stop them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_16"
msgid "(Not my problem.)"
msgstr "No sé."

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_17"
msgid "Hey,{PA:10} c'mon,{PA:10} let the guy go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_18"
msgid "Huh?{PA:20} Who the hell are you?{PA:20} You've gotta pay||to do business in this town,{PA:10} asshole.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_19"
msgid "That's life.{PA:20} Now get lost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_20"
msgid "Yeah,{PA:10} you're right.{PA:20}"
msgstr "Sí, {PA:10}tienes razón.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_21"
msgid "Damn straight I'm right.{PA:20}||Now move along already!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_22"
msgid "He's back in a deserted alley.{PA:20}||He's not taking up anybody's turf here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_23"
msgid "Aw,{PA:10} come on.{PA:20} You're in the biz,{PA:10} too,{PA:10} right?{PA:20}||You know you've gotta set an example.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_24"
msgid "We don't care who pays,{PA:10} of course.{PA:20}||You're free to pay for him if you care to.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_25"
msgid "This spot runs 300,{PA:10}000 yen.{PA:20}||What do you say?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_27"
msgid ".{PA:20}.{PA:20}.{PA:20}Take it.{PA:20}"
msgstr "n{PA:20}{PA:20}o{PA:20} puedo{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_28"
msgid "280.{PA:20}.{PA:20}.{PA:20} 290.{PA:20}.{PA:20}.{PA:20} 300,{PA:10}000 yen.{PA:20} Thank you kindly.{PA:20}||We'll be seeing you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_30"
msgid "(.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_31"
msgid "Heh,{PA:10} it seems your mouth is bigger than your||bank account,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_32"
msgid "You're not getting any money from me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_33"
msgid "What?{PA:20} First you get in our face,{PA:10} then you||can't pay?{PA:20} What the hell's your problem?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_1_34"
msgid "Ugh,{PA:10} talking it out is just a waste of time.{PA:20}||Whoever you are,{PA:10} it's time for a dirt nap.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_0"
msgid "Wh-Who are you?{PA:20}||You're not a rank-and-file member.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_1"
msgid "I'm not yakuza.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_2"
msgid "Heh,{PA:10} hilarious.{PA:20} Still,{PA:10} we can't have word||getting out that a civilian beat us down.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_3"
msgid "I'm not telling anybody,{PA:10} so don't go getting||any stupid ideas about retribution.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Understood.{PA:20}||We'll write this spot out of our turf.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_8"
msgid "Th-Thank you.{PA:20}.{PA:20}.{PA:20} sir.{PA:20}"
msgstr "¡G-Gracias, {PA:20}s{PA:20}e{PA:20}ñor!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_9"
msgid "What were you thinking?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_10"
msgid "You had to know this would happen if you||just set up shop on the streets.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_11"
msgid "I'm sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr "Lo siento.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_12"
msgid "I had a working agreement with Mr.{PA:20} Majima,{PA:10}||b-back when he was still in charge.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_13"
msgid "Majima?{PA:20}"
msgstr "majima{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_14"
msgid "Why not give those guys the money you used||to pay Majima,{PA:10} then?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_15"
msgid "I didn't pay Majima any money.{PA:20}.{PA:20}.{PA:20}||He said he didn't need it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_16"
msgid "What?{PA:20} Majima's got a few screws loose,{PA:10} but||he's not that far gone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0072.ARC/TALK_ST_KAB0072_BTL.BIN::line:138_2_17"
msgid "H-He let me work in exchange for a couple of||my top-grade videos.{PA:20}"
