msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_0_0"
msgid "(Looks like I'm short on cash.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_0_1"
msgid "(I'll need at least 11,{PA:10}000 yen here.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_1"
msgid "Wait,{PA:10} you're going in here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_2"
msgid "(I've got Sayama with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_3"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_4"
msgid "Doesn't look like I have much of a choice.{PA:20}||Fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_5"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_6"
msgid "You sure?{PA:20} I don't really care.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_7"
msgid "Are you going in here,{PA:10} Uncle Kaz?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_8"
msgid "(I've got Haruka with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_9"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Okay.{PA:20} I'll stay right here.{PA:20}||Have fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_11"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_12"
msgid "Really?{PA:20} If it's because of me,{PA:10} you don't||have to,{PA:10} Uncle Kaz.{PA:20} I'll be fine here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_13"
msgid "Whoa,{PA:10} whoa.{PA:20} Kazuma,{PA:10} you're going in HERE?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_14"
msgid "(I've got Date with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_15"
msgid "Yeah.{PA:20} Care to join me,{PA:10} Date?{PA:20}||Should be a fun time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_16"
msgid ".{PA:20}.{PA:20}.{PA:20}I'll pass.{PA:20}||Go have your fun.{PA:20} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_17"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_18"
msgid "You sure?{PA:20} Won't bother me.{PA:20}||I can keep myself busy for an hour.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_19"
msgid "You're not thinking of going in,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_20"
msgid "(I've got Daigo with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_21"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_22"
msgid "All right,{PA:10} well.{PA:20}.{PA:20}.{PA:20}||I'll just wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_23"
msgid "Thanks,{PA:10} Daigo.{PA:20} I'll catch up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_24"
msgid "No,{PA:10} not right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_3_25"
msgid "Yeah?{PA:20} Well,{PA:10} a'ight then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_4_1"
msgid "*Sigh* Finally.{PA:20}||Now c'mon,{PA:10} let's get out of here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_4_2"
msgid "You took foreeever!{PA:20}||I'm bored,{PA:10} let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_4_3"
msgid "All done with your fun?{PA:20}||Let's get back to work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_4_4"
msgid "Fucking finally.{PA:20}||Let's go already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_6_0"
msgid "(There's no time for that now.{PA:20} I need to||find a hospital.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:138_7_0"
msgid "No,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||This not where I wanted to go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0107.ARC/TALK_ST_KAB0107_BTL.BIN::line:139_0_0"
msgid "This is \"{CC:ffc8c8}Shine{CR:00}\".{PA:20}||Be careful in there.{PA:20}"
msgstr ""

