msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::name:9"
msgid "Unknown Voice"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::name:10"
msgid "Tamura"
msgstr ""

