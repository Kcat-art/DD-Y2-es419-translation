msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_8_26"
msgid "To the pier,{PA:10} sir?{PA:10}{MS:0}{PA:20}||I'm ready when you are.{PA:20} Just hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_0"
msgid "(The guy who beat Komaki is supposed to be||waiting for me at the pier.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_1"
msgid "(If he took down the old guy,{PA:10} he's strong.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_2"
msgid "(I shouldn't drag anyone else into this.{PA:20}||They might get hurt.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_3"
msgid "(I'll go to the pier when I'm alone.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_7"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_8"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_9"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_10"
msgid "Cab fare starts at 660 yen,{PA:10} sir.{PA:20}||{MS:0}Where to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_11"
msgid "South end of Nakamichi Street,{PA:10} sir?{PA:10}{MS:0}{PA:20}||You got it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_13"
msgid "West end of Shichifuku Street,{PA:10} sir?{PA:10}{MS:0}{PA:20}||You got it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_15"
msgid "I see,{PA:10} sir.{PA:20}||Well,{PA:10} I'll be here next time!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_16"
msgid "Tojo Headquarters.{PA:20}.{PA:20}.{PA:20}?{PA:10}{MS:0}{PA:20}||I won't ask any questions,{PA:10} sir.{PA:20} Hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_25"
msgid "Police Headquarters?{PA:20} Everything all right,{PA:10}{MS:0}{PA:10}||sir?{PA:20} In any case,{PA:10} hop in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_27"
msgid "Sorry,{PA:10} it sounded like you said \"Sotenbori\".{PA:20}||.{PA:20}.{PA:20}.{PA:20}You're serious?!{PA:20} It'll cost you,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_28"
msgid "I'd say on the order of 30,{PA:10}000 yen.{PA:20}.{PA:20}.{PA:20}||Are you sure?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_30"
msgid "Well,{PA:10} hop in!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:285_9_32"
msgid "Sure,{PA:10} you say that,{PA:10} but look at you!{PA:20}||You don't have the money,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:286_5_0"
msgid "(There's no time for that now.{PA:20} I need to||find a hospital.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:286_6_0"
msgid "Where are you going,{PA:10} Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_0"
msgid "It's been forever,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_1"
msgid "Hey,{PA:10} Tamura.{PA:20} How goes the info business?{PA:20}||You're still dealing,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_2"
msgid "That's right,{PA:10} same as ever!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_3"
msgid "How about you,{PA:10} Mr.{PA:20} Kiryu?{PA:20}||I haven't seen you around in a while.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_4"
msgid "Yeah,{PA:10} I don't live here anymore.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_5"
msgid "I see.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_6"
msgid "Well,{PA:10} if you ever need anything,{PA:10} you just||let me know,{PA:10} all right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_7"
msgid "I'll cut you a good deal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_0_8"
msgid "You can usually find me by the theater.{PA:20}||I'll see you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:288_1_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_0_0"
msgid "Kaoru"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_1_1"
msgid "Oh,{PA:10} hey,{PA:10} Sayama.{PA:20}||Sorry I couldn't call you before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_1_3"
msgid "Yeah,{PA:10} Sengoku's men.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_1_5"
msgid "I can't talk right now.{PA:20}||We'll catch up later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_1_7"
msgid "Near Purgatory.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_2_0"
msgid "Hello?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_2_2"
msgid "I know what happened,{PA:10} more or less.{PA:20}||I hear the Omi are in Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_2_4"
msgid "The Sengoku family?{PA:20} But why?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_2_6"
msgid "Where are you now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:289_2_8"
msgid "I'm right nearby.{PA:20}||I'll head over there now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:290_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Unngh.{PA:20} Sh-Shit.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_0"
msgid "Huff.{PA:20}.{PA:20}.{PA:20} pant.{PA:20}.{PA:20}.{PA:20} Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}||It's terrible!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_1"
msgid "What's wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_2"
msgid "Men from the Go-Ryu Clan have shown up all||over town and are raising hell!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_3"
msgid "They're going crazy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_4"
msgid "Yeah,{PA:10} I just got a call from the bartender||down at Bantam.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_5"
msgid "Please,{PA:10} hurry,{PA:10} Mr.{PA:20} Kiryu!{PA:20}||At this rate,{PA:10} the whole town is gonna be.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_0_6"
msgid "I know.{PA:20} I'm on my way.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:292_1_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_0_0"
msgid "Hello?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_0_2"
msgid "Yuya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_0_4"
msgid "Yuya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_0_6"
msgid "All right.{PA:20} Sit tight,{PA:10} I'll be there soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_1_0"
msgid "M-Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_1_2"
msgid "Just now,{PA:10} some punks from the Go-Ryu Clan.{PA:20}.{PA:20}.{PA:20}||Whoa!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_1_4"
msgid "I-I'm okay.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_1_5"
msgid "We'll do what we can here.{PA:20}||You take care of the rest of 'em!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:293_1_7"
msgid "Thanks!{PA:20} I'll hold them off until then.{PA:20}||Be careful,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_0_1"
msgid "GAAaaah,{PA:10} shut up SHUT UP!{PA:20}||Maybe I should just move away.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_1_1"
msgid "Something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_1_2"
msgid "Yeah,{PA:10} something's wrong!{PA:20} They're doing some||kinda construction in the park there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_1_3"
msgid "The noise keeps me up the whole damn night!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_1_4"
msgid "I'm such a light sleeper,{PA:10} even if I wear||earplugs and stick a pillow over my head.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_1_5"
msgid "And this town's friggin' loud to begin with.{PA:20}||Maybe I should just move away.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:295_2_0"
msgid "Aww,{PA:10} shut up already!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:296_0_0"
msgid "I hear all the homeless folk from this park||all moved off someplace together.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:296_0_1"
msgid "It's just a rumor,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:296_0_2"
msgid "Apparently they were going to start their||own country.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_0"
msgid "Tonight was the best night ever.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_1"
msgid "If you ever come to my country,{PA:10} Mr.{PA:20} Kiryu,{PA:10}||I would be happy to show you around,{PA:10} too!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_2"
msgid "Thanks,{PA:10} I'll look forward to that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_3"
msgid "This is my thank you for everything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_4"
msgid "        You received 300,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_5"
msgid "Here,{PA:10} take this too!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_6"
msgid "         You received an Il Yu-Jin||          \"{CC:ffffc8}signed publicity photo{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_8"
msgid "Please be well,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Let's meet again some day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_9"
msgid "Sure.{PA:20} I'll see you around.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:297_0_11"
msgid "Received 3❟500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_0"
msgid "Hey,{PA:10} where'd you get those shoes?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_1"
msgid "Huh?{PA:20} You can't have 'em!{PA:20}||I got these fair and square!{PA:20} They're mine!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_2"
msgid "Fair and square?{PA:20} What are you talking about?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_3"
msgid "This lady was drunk off her ass in the park,{PA:10}||sleepin' out in the cold.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_4"
msgid "She looked like she was freezin' her ass off||so I covered her up with my cardboard.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_5"
msgid "She saw my dirty old shoes and offered me||these out of thanks for my kindness!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_6"
msgid "I don't got any others.{PA:20} You can't have 'em!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_9"
msgid "I'll trade you these boots for them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_10"
msgid "Whoa!{PA:20} Those look amazin'!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_11"
msgid "Here,{PA:10} take these dinky little things.{PA:20}||They kinda smell now.{PA:20} Sorry,{PA:10} pal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_12"
msgid "   You traded your pair of \"{CC:ffffc8}hybrid boots{CR:00}\"||          for the \"{CC:ffffc8}dancer's shoes{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_14"
msgid "That's fine.{PA:20} They look good on you.{PA:20}||You keep them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_15"
msgid "Yeah,{PA:10} maybe I will!{PA:20}||And quit starin' at 'em like that!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_0_16"
msgid "I don't got any others.{PA:20}||You can't have 'em!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_1_0"
msgid "(What's with that guy's shoes?{PA:20}||Are those ballet slippers?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:298_1_1"
msgid "(Talk about a fashion statement!)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0054.ARC/TALK_ST_KAB0054.BIN::line:299_0_0"
msgid "Ohhh yeah.{PA:20} These are great!{PA:20}"
msgstr ""

