msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_4"
msgid "No!{PA:20} You were?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_5"
msgid "Yeah,{PA:10} man.{PA:20} You missed out.{PA:20}||It was pretty sweet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_6"
msgid "Still,{PA:10} how rich would you have to be to pull||a stunt like that?{PA:20}"
