msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:11"
msgid "Man 1"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:12"
msgid "Man 2"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:13"
