msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_0_0"
msgid "C'mooon,{PA:10} money!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_0"
msgid "Hard to believe it's been a whole year.{PA:20}"
msgstr "(Me cuesta creer que ya pasó todo un año...).{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_1"
msgid "Since what?{PA:20}"
msgstr "¿Desde qué?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_2"
msgid "Oh,{PA:10} around this time last year,{PA:10} they say a||bunch of cash just fell down from the sky.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_3"
msgid "Oh,{PA:10} that,{PA:10} yeah.{PA:20} I got a few thousand!{PA:20}||You weren't around for that?{PA:20}"
