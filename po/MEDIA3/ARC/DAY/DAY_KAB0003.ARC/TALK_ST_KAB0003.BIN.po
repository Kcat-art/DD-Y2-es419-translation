msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:287_1_7"
msgid "So.{PA:20}.{PA:20}.{PA:20} what are you doing out here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:287_1_8"
msgid "H-Hey,{PA:10} shut up!{PA:20} Just because you know||better doesn't mean you're immune!{PA:20}"
