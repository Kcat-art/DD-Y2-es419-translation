msgid "Man"
msgstr "Hombre"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:2"
msgid "Unknown Man"
msgstr "Hombre misterioso"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:3"
msgid "Date"
msgstr "Date"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:4"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:5"
msgid "Kaoru"
msgstr "Kaoru"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:6"
msgid "Haruka"
msgstr "Haruka"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:7"
msgid "Il Yu-Jin"
msgstr "I Ru-jeon"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:8"
msgid "\"God\" Ezawa"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::name:9"
