msgctxt "MEDIA3/ARC/DAY/DAY_KAB0003.ARC/TALK_ST_KAB0003.BIN::line:288_1_8"
msgid "You're buying tonight,{PA:10} by the way.{PA:20}||You can use your money from heaven.{PA:20}"
