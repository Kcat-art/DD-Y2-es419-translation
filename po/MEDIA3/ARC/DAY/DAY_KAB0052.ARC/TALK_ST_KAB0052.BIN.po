msgstr "Kaoru"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::name:6"
msgid "Haruka"
msgstr "Haruka"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::name:7"
msgid "Il Yu-Jin"
msgstr "I Ru-jeon"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::name:8"
msgid "Go-Ryu Member"
msgstr "Miembro del Go-Ryu"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::name:9"
msgid "Blackmailer"
