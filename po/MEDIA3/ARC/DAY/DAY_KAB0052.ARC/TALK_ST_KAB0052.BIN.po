msgid "Makoto"
msgstr "Makoto"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::name:11"
msgid "Tamao"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::name:12"
