msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_6_6"
msgid "I'm sure he'll show his true colors before||too long tonight.{PA:20}"
msgstr ""

