msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:284_1_0"
msgid "(There's something here.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:284_1_1"
msgid "Take the locker key?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:284_1_2"
msgid "Picked up \"{CC:ffffc8}Taihei Blvd.{PA:20} West locker key #42{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:284_1_3"
msgid "(It says Taihei Blvd.{PA:20} West lockers.{PA:20}||That must be where this key goes.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:284_1_5"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_1"
msgid "Wait,{PA:10} you're going in here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_2"
msgid "(I've got Sayama with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_3"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_4"
msgid "Doesn't look like I have much of a choice.{PA:20}||Fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_5"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_6"
msgid "You sure?{PA:20} I don't really care.{PA:20}"
msgstr "¿Seguro? No hab{PA:20}ría tenido problemas con esperarte.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_7"
msgid "Are you going in here,{PA:10} Uncle Kaz?{PA:20}"
msgstr "¿Entrarás allí, {PA:10}tío Kaz?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_8"
msgid "(I've got Haruka with me.{PA:20} What do I do?)"
msgstr "(¿Haruka me está acompañ{PA:20}ando. ¿Entro?)."

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_9"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Okay.{PA:20} I'll stay right here.{PA:20}||Have fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_11"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_12"
msgid "Really?{PA:20} If it's because of me,{PA:10} you don't||have to,{PA:10} Uncle Kaz.{PA:20} I'll be fine here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_13"
msgid "Whoa,{PA:10} whoa.{PA:20} Kazuma,{PA:10} you're going in HERE?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_14"
msgid "(I've got Date with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_15"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr "Cla{PA:10}ro.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_16"
msgid "Well,{PA:10} I guess I'll wait out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_17"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_18"
msgid "You sure?{PA:20} Won't bother me.{PA:20}||I can keep myself busy for an hour.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_19"
msgid "You're not thinking of going in,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_20"
msgid "(I've got Daigo with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_21"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr "Cla{PA:10}ro.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_22"
msgid "Hey,{PA:10} you're the boss,{PA:10} man.{PA:20}||I'll just wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_23"
msgid "Thanks,{PA:10} Daigo.{PA:20} I'll catch up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_24"
msgid "No,{PA:10} not right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_2_25"
msgid "Yeah?{PA:20} Well,{PA:10} a'ight then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_3_1"
msgid "*Sigh* Finally.{PA:20}||Now c'mon,{PA:10} let's get out of here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_3_2"
msgid "You took foreeever!{PA:20}||I'm bored,{PA:10} let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_3_3"
msgid "All done with your fun?{PA:20}||Let's get back to work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_3_4"
msgid "Fucking finally.{PA:20}||Let's go already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:285_5_0"
msgid "No,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||This not where I wanted to go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:286_0_0"
msgid "Gaah!{PA:20} He's back!{PA:20}||Eeeek!{PA:20} S-Stay away!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:287_0_0"
msgid "Wh-Wha-!{PA:20} K-Kazuma Kiryu?!{PA:20}||What the hell's he doing here?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_0"
msgid "Gwaaaaugh!{PA:20} M-My bones!{PA:20} All my poor bones!{PA:20}||An ambulance!{PA:20} Quick,{PA:10} get me an ambulance!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_1"
msgid "They're broken!{PA:20} My bones,{PA:10} they're broken!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_2"
msgid "You're fine.{PA:20} Why kill me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_3"
msgid "It's a compound fracture!{PA:20} A complex compound||fracture,{PA:10} fractured complicatedly!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Hey.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} Oye.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_5"
msgid "Gaah!{PA:20} Th-That yakuza said that if I killed||you,{PA:10} he'd pay me 10 million yen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_6"
msgid "You know how it is.{PA:20}.{PA:20}.{PA:20} Money makes honest men||do the craziest things.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_7"
msgid "A yakuza?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_8"
msgid "Y-Yes,{PA:10} sir!{PA:20} Precisely,{PA:10} sir!{PA:20} He had a Kansai||accent,{PA:10} and was a yakuza,{PA:10} sir.{PA:20} Yes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_9"
msgid "U-Umm,{PA:10} this isn't much of an apology,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_10"
msgid "I-I mean it's really not much of anything at||all,{PA:10} but.{PA:20}.{PA:20}.{PA:20} Please,{PA:10} take this,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_11"
msgid "          You received 50,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_12"
msgid "T-Take care,{PA:10} sir.{PA:20} So long!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:288_0_13"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_0"
msgid "E-Excuse me!{PA:20}||Mr.{PA:20} Kiryu?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_1"
msgid "Hm?{PA:20}"
msgstr "¿Mm?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_2"
msgid "There's something I need to ask of you.{PA:20}||Please,{PA:10} please help me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Do I know you?{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} ¿Te conozco?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_4"
msgid "My name's Makoto.{PA:20} I work as a host at a||local bar called Adam.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_5"
msgid "And my freaking boss scammed me!{PA:20} Guy's name||is Kisaragi,{PA:10} by the way.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_6"
msgid "He's got me nailed for 10 million in tabs!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_7"
msgid ".{PA:20}.{PA:20}.{PA:20}Tabs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_8"
msgid "Yes,{PA:10} like when a customer runs a tab?{PA:20}||Well,{PA:10} sometimes they drink,{PA:10} but don't pay.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_9"
msgid "When that happens,{PA:10} the hosts have to cover||the cost out of their own pocket.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_10"
msgid "Are you serious?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_11"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} Sí.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_12"
msgid "But at our place,{PA:10} the owner's setting it all||up behind the scenes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_13"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_14"
msgid "I knew something was fishy,{PA:10} so I looked into||what was going on.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_15"
msgid "The owner pays customers to run out on tabs.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_16"
msgid "He's telling them to do it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_18"
msgid "At the outset,{PA:10} he wasn't too pushy about||collecting,{PA:10} but now I know.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_19"
msgid "He was just setting us up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_20"
msgid "Once the amount gets high enough,{PA:10} he comes||down on us like a ton of bricks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_21"
msgid "He's got a bunch of us hosts up to our necks||in debt now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_22"
msgid "Some of them have run off in the middle of||the night to get away.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_23"
msgid "He's got us working for no pay now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_24"
msgid "That's not right.{PA:20}.{PA:20}.{PA:20}||But what's any of that got to do with me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_25"
msgid "Well,{PA:10} sir,{PA:10} I used to work at Stardust a||long time ago.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_26"
msgid "Yuya there used to talk about you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_27"
msgid "You heard about me through Yuya?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_28"
msgid "He said you saved this city last year.{PA:20}||{MS:0}He was talking about you,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_29"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_30"
msgid "I'll make it worth your while,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_31"
msgid "You've got to stop Kisaragi from doing this||to people!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_32"
msgid ".{PA:20}.{PA:20}.{PA:20}So,{PA:10} what do you propose?{PA:20} You want me to||just walk in and punch the guy out?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_33"
msgid "He's a very.{PA:20}.{PA:20}.{PA:20} cautious man.{PA:20}||He never lets people know where he is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_34"
msgid "He's practically never at the club.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_35"
msgid "But once a month he comes around to||announce the number one host for the month.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_36"
msgid "Right now,{PA:10} his son Takaya is the top host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_37"
msgid "Okay.{PA:20}.{PA:20}.{PA:20} so?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_38"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_39"
msgid "Would you become the number one host at Adam?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_40"
msgid "You've got to be joking.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_41"
msgid ".{PA:20}.{PA:20}.{PA:20}The owner's got everybody working there||under his thumb.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_42"
msgid "We can't beat Takaya's sales,{PA:10} no matter what||we do.{PA:20} It's a rigged game!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_43"
msgid "The only way this is going to happen is for||someone new to come in and take the spot!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_44"
msgid "That's the only way you're going to make||contact with Kisaragi.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_45"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_46"
msgid "I'm a host,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_47"
msgid "I know you've got what it takes!{PA:20}||I guarantee it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_48"
msgid "So please.{PA:20}.{PA:20}.{PA:20} Please,{PA:10} help me!{PA:20} All of us!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_49"
msgid "You're our last hope,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_50"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_51"
msgid ".{PA:20}.{PA:20}.{PA:20}All right,{PA:10} fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_52"
msgid "Y-You'll do it?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_53"
msgid "Yeah,{PA:10} I'll do it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_54"
msgid "Thank you!{PA:20} Thank you,{PA:10} thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_55"
msgid "So,{PA:10} where do I start?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_56"
msgid "Head to Adam now and get an interview with||the manager,{PA:10} Mr.{PA:20} Kagami.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_57"
msgid "An interview?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_58"
msgid "Right.{PA:20} But don't worry,{PA:10} you'll be fine!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_59"
msgid "Mr.{PA:20} Kagami's a good guy.{PA:20} Even if you trip up||a bit,{PA:10} he'll okay anyone with passion.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_60"
msgid "Adam's just over there,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_61"
msgid "Well,{PA:10} I've got to go chase down some of the||customers who defaulted now.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_62"
msgid "But I'll let Mr.{PA:20} Kagami know to expect you!{PA:20}||I'll keep in touch,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_64"
msgid ".{PA:20}.{PA:20}.{PA:20}Find another guy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_65"
msgid "B-But there ISN'T anyone else!{PA:20}||Please,{PA:10} sir.{PA:20}.{PA:20}.{PA:20} If you don't help me,{PA:10} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_66"
msgid "I just don't know how I'll stay alive.{PA:20}.{PA:20}.{PA:20}||I've got to.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_67"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_68"
msgid "10 million is just too much.{PA:20}||There's no way I can repay that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_69"
msgid "I've got to go chase down those tabs now.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_70"
msgid "Welcome to the rest of my life,{PA:10} I guess.{PA:20}.{PA:20}.{PA:20}||Crawling around,{PA:10} scraping for money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_71"
msgid "You're giving up,{PA:10} just like that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_0_72"
msgid "Well,{PA:10} are you going to help me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:289_1_0"
msgid "If Mr.{PA:20} Kiryu can't help,{PA:10} I'm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:290_0_0"
msgid "(Well,{PA:10} guess I'll start by chatting up any||likely ladies I see.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:290_1_0"
msgid "(I should probably wait until I'm alone to||pull in business for the club.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:291_0_0"
msgid "(That should do it.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_0_0"
msgid "Ahh,{PA:10} Kazuma.{PA:20}||This way.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_0_1"
msgid "Sorry to have kept you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_0_2"
msgid "Ready to go?{PA:20}"
msgstr "¿Ya está listo?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_1_0"
msgid "Excuse me,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_1_1"
msgid "Just what is the meaning of this?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_1_2"
msgid "Who is this person you're with?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:294_1_3"
msgid "I fail to see how we can enjoy an after-||hours date with them around.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Kazuma.{PA:20}"
msgstr "K{PA:20}{PA:20}a{PA:20}zuma.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_0_1"
msgid "Don't think you can cheat me out of my||rightful position that easily.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_0_2"
msgid "The host-off is over,{PA:10} Takaya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_0_3"
msgid "It's not your position anymore.{PA:20}||Adam's top host is me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_0_4"
msgid "Shut up!{PA:20}||Kill this fucking punk!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_1_0"
msgid "N-Nngh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_1_1"
msgid "I don't ever want to see you here again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_1_2"
msgid "Urrngh?!{PA:20}||D-Dad.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:295_1_3"
msgid "?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:296_0_0"
msgid "(Kagami wanted me inside.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:296_0_1"
msgid "(I should head back in to Adam for now.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_0_0"
msgid "Takaya.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_0_1"
msgid "I hear you lost in a sales competition.{PA:20}||Is that true?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_0_2"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_0_3"
msgid "And to a rookie host,{PA:10} no less.{PA:20}||Are you trying to shame me out of business?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_0_4"
msgid "Get the hell out of here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_0_5"
msgid "D-Dad.{PA:20}.{PA:20}.{PA:20} Anngh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_0"
msgid "You're Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_1"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_2"
msgid "I hear you performed impressively.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_3"
msgid "Thank you,{PA:10} sir.{PA:20}"
msgstr "Gracias, s{PA:10}eñor.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_4"
msgid "You're quite something if you beat Takaya.{PA:20}||I'm impressed.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_5"
msgid "I'm here for the monthly meeting.{PA:20}||I'll announce your top-host status there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:297_1_6"
msgid "Yes,{PA:10} sir.{PA:20}||I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:298_0_0"
msgid "Kisaragi"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:298_1_1"
msgid "Hello,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:298_1_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:298_2_0"
msgid "Kazuma?{PA:20} This is Kisaragi,{PA:10} Adam's owner.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:298_2_2"
msgid "I'd like to treat you to a drink to||celebrate your recent success.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:298_2_3"
msgid "Meet me at Shellac in the Champion District.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||It's me,{PA:10} Makoto!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_1"
msgid "You did it!{PA:20} You really saved us all!{PA:20}||Oh,{PA:10} thank you so much,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_2"
msgid "So,{PA:10} what about that reward you promised me?{PA:20}||You said you'd make it worth my while.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_3"
msgid "Uhhh.{PA:20}.{PA:20}.{PA:20}||You remembered that part,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_4"
msgid "Ha ha.{PA:20}.{PA:20}.{PA:20}||I figured as much.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_5"
msgid "Can I ask you to wait until I make top host||at Adam,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_6"
msgid "Once I'm number one,{PA:10} I'll treat you to the||most amazing meal of your life,{PA:10} I swear!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_7"
msgid ".{PA:20}.{PA:20}.{PA:20}Is that all right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_8"
msgid "Heh,{PA:10} I don't see that I have much choice.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_9"
msgid "I promise I'll make top host,{PA:10} Mr.{PA:20} Kiryu!{PA:20}||I give you my word as a man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_10"
msgid "Good luck,{PA:10} Makoto.{PA:20} I'll be waiting.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:299_0_11"
msgid "Received 3❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||How was it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_1"
msgid "Fine.{PA:20}.{PA:20}.{PA:20}||I got through the interview all right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_2"
msgid "I knew it!{PA:20} Do they have you pulling in||customers now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_3"
msgid "Yeah.{PA:20} Kagami told me to get three women.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_4"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_5"
msgid "Well,{PA:10} you won't find anyone around here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_6"
msgid "No?{PA:20}"
msgstr "No{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_7"
msgid "I'd recommend trying Shichifuku St.{PA:20}||You'll have better luck there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_8"
msgid "Shichifuku Street?{PA:20}||Okay,{PA:10} I'll try there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_0_9"
msgid "Thanks,{PA:10} Mr.{PA:20} Kiryu!{PA:20} Let me know if there's||anything I can do to help.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_1"
msgid "I heard you got stuck helping Takaya out.{PA:20}||Sorry about that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_2"
msgid "It's fine.{PA:20}.{PA:20}.{PA:20}||Host work is tough,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_3"
msgid "It's fine,{PA:10} you're doing great!{PA:20}||Look,{PA:10} everybody starts out slow.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_4"
msgid "But I believe in you.{PA:20}||You can do this,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_5"
msgid ".{PA:20}.{PA:20}.{PA:20}I'll do what I can.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_1_6"
msgid "Thank you.{PA:20} I've got to go for now.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_1"
msgid "I heard you took on your first solo client!{PA:20}||That's great!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_2"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_3"
msgid "Don't get down because you didn't quite hit||Mr.{PA:20} Kagami's sales quota.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_4"
msgid "It's hard work getting these women to drink.{PA:20}||I don't know how you do it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_5"
msgid "Get them happy enough,{PA:10} and they'll spring||for the good stuff!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_6"
msgid "Yeah?{PA:20}"
msgstr "¿Sí?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_7"
msgid "You've just got to smooth talk them into a||warm,{PA:10} fuzzy place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_8"
msgid "Anyway,{PA:10} I'm heading home for the night.{PA:20}||I'll see you around.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_2_9"
msgid "And stay positive!{PA:20} You're doing fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_1"
msgid "I can't believe you stole away one of||Takaya's regulars.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_2"
msgid "That's amazing!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_4"
msgid "So you ran into a rough patch.{PA:20} But still,{PA:10}||I think she's really fallen for you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_5"
msgid "This could be just the leverage you need to||break his whole setup apart!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_3_6"
msgid "Please,{PA:10} just keep at it!{PA:20}||I'll do anything I can to help you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||I just heard!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_1"
msgid "Sounds like you got one hell of a client||asking for you by name.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_2"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_3"
msgid "Even I wouldn't have known what to do with||someone like her.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_5"
msgid "I'd say this proves you're as good a host as||anybody,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_6"
msgid "I know you'll be able to make that quota.{PA:20}||You just need to keep at it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_4_7"
msgid "I believe in you,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Good luck!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||I heard the big news!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_1"
msgid "You're going head-to-head with Takaya!{PA:20}||This is it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_2"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_3"
msgid "Win this face-off,{PA:10} and you're Adam's number||one host,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_4"
msgid "You have to beat him!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_5"
msgid "I'll do what I can.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_5_6"
msgid "I know you can do it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_6_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}||I just heard!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_6_1"
msgid "You're going to meet the owner now,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_6_2"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} He wants me to meet him in the||Champion District.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_6_3"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}||Please be careful.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0052.ARC/TALK_ST_KAB0052.BIN::line:300_6_4"
msgid "You've got to watch your back around him.{PA:20}||Kisaragi is an animal.{PA:20}"
msgstr ""

