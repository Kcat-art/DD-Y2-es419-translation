msgid "I doubt it'll help much,{PA:10} but hey,{PA:10}||why not?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:320_0_0"
msgid "Heh,{PA:10} I won't have shit to||steal until next payday.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:321_0_0"
msgid "(.{PA:20}.{PA:20}.{PA:20}?{PA:20} My money!{PA:20}||{MS:0}Classic pickpocket trick.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:321_0_1"
msgid "       A pickpocket stole 20,{PA:10}000 yen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:321_1_0"
msgid "(.{PA:20}.{PA:20}.{PA:20}?!{PA:20} Not again!)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:321_1_2"
msgid "(I'm out 30,{PA:10}000 yen.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:321_1_3"
msgid "       A pickpocket stole 30,{PA:10}000 yen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:322_0_0"
msgid "Oh,{PA:10} sorry,{PA:10} man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:323_0_3"
msgid "Oops!{PA:20} My bad!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:325_0_0"
msgid "You'd think you'd feel it if a guy||jammed his hand down your pants.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:326_0_0"
msgid "That's the power of distraction,{PA:10}||I guess.{PA:20} Ha ha!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:327_0_0"
msgid "Maybe we should stop coming this way.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:328_0_0"
msgid "They say there are pickpockets.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:329_0_0"
msgid "(Damn,{PA:10} I lost track of the peeping Tom.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_0"
msgid "(Hm.{PA:20}.{PA:20}.{PA:20} I should ask her if she'd work at||Marietta for us.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_1"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_2"
msgid "Ever think of working in a cabaret,{PA:10} miss?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_3"
msgid "What does that,{PA:10} like,{PA:10} even mean?{PA:20}||What do girls even DO there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_4"
msgid "Well,{PA:10} let me start with a question.{PA:20}||How old are you now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_5"
msgid "I'm 20.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_6"
msgid "Great,{PA:10} then you're all clear.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_7"
msgid "All clear to what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_8"
msgid "The job is chatting and sharing drinks with||the clients,{PA:10} so you can't really be a minor.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_9"
msgid "If you're motivated,{PA:10} you can earn a bundle.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_10"
msgid "Wow,{PA:10} really?{PA:20}"
msgstr "¡¿Eh?!{PA:10} ¡¿En serio?!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_11"
msgid "Hm,{PA:10} it's still kinda vague.{PA:20} I dunno.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_12"
msgid "Well,{PA:10} you could start and see if you like||the work.{PA:20} Learn on the job.{PA:20} Get paid.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_13"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mm.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_15"
msgid "Eh,{PA:10} I haven't done anything crazy in a||while.{PA:20} I'll give it a try!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_16"
msgid "You will?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_17"
msgid "Sure.{PA:20} I'm Hanako,{PA:10} by the way.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:335_0_18"
msgid "So,{PA:10} uh,{PA:10} where's your club,{PA:10} mister?{PA:20}"
