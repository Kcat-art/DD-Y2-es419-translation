msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_1"
msgid "Um.{PA:20}.{PA:20}.{PA:20} Is something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_3"
msgid "Yeah,{PA:10} I remember.{PA:20}||Has something happened to him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_5"
msgid "Well,{PA:10} that's good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_7"
msgid "Ah.{PA:20}"
msgstr "Ah...{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_9"
msgid "A what?!{PA:20}"
msgstr "¿Una qué?...{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_12"
msgid "I think building a park on one person's||savings is an awfully big dream.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_13"
msgid "I'll see what I can find.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_17"
msgid "Okay,{PA:10} I'll see what I can find.{PA:20}"
msgstr "Entie{PA:10}ndo. Veré qué puedo averiguar{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_18"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_0_21"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_0"
msgid "Hello,{PA:10} Mr.{PA:20} Kiryu?{PA:20}||This is Ms.{PA:20} Suenaga,{PA:10} from Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_1"
msgid "Mr.{PA:20} Kiryu,{PA:10} I'll never forget all your help.{PA:20}||No matter what happens.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_3"
msgid "Wrong?{PA:20} Oh,{PA:10} no.{PA:20}.{PA:20}.{PA:20} I mentioned the headmaster||was resting up at home before,{PA:10} didn't I?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_5"
msgid "No,{PA:10} no!{PA:20} He's feeling worlds better!{PA:20}||Well enough to come back to work,{PA:10} actually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_7"
msgid "Yes,{PA:10} it's wonderful.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_8"
msgid "But it does mean my time with the children||is coming to an end.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_10"
msgid "It was only six months,{PA:10} but saying goodbye||to them is so hard.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_11"
msgid "So I've decided to make a gift to them.{PA:20}||I'd like to give them a park!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_13"
msgid "A park!{PA:20}||Something that will last.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_14"
msgid "Still,{PA:10} it takes more than pocket change and||good intentions to get a park built.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_15"
msgid "Mr.{PA:20} Kiryu,{PA:10} could I ask you to help me find||an affordable contractor?{PA:20} For the kids!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_18"
msgid "I realize it's a stretch,{PA:10} I really do!{PA:20}||But still,{PA:10} I want to do this for them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_19"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_20"
msgid "I'll keep trying on my end as well!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_23"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108.BIN::line:19_1_24"
msgid "私も、{PA:10}もう少し色々あたってみます！{PA:20}"
msgstr ""

