msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_1_0"
msgid "Th-Thank you so much!{PA:20}"
msgstr "¡M-muchas gracias!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_1_1"
msgid "What happened?{PA:20}"
msgstr "¿Qué pasó?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_1_2"
msgid "See,{PA:10} I asked this guy to settle his tab.{PA:20}||All of a sudden,{PA:10} his goon got in my face.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_1_3"
msgid "Who was it?{PA:20}||The guy with the tab,{PA:10} I mean.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_1_4"
msgid "Some yakuza named \"{CC:ffc8c8}Daigo Dojima{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_1_5"
msgid "He was headed towards the {MS:0}\"{CC:ffc8c8}theater{CR:00}\".{PA:20}||He's probably long gone by now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_2_0"
msgid "You really saved my ass,{PA:10} man.{PA:20}"
msgstr "¡Me acaba de salvar la {PA:10}vida!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:141_2_1"
msgid "You're looking for \"{CC:ffc8c8}Daigo Dojima{CR:00}\"?{PA:20}||I saw him head towards the \"{CC:ffc8c8}theater{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0108.ARC/TALK_ST_KAB0108_BTL.BIN::line:142_0_0"
