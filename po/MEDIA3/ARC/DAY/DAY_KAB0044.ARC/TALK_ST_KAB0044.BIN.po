msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:304_1_2"
msgid "Right here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:304_1_3"
msgid "Go down the alley across the way,{PA:10} then take||a left into the empty lot.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:304_2_0"
msgid ".{PA:20}.{PA:20}.{PA:20}What?{PA:20}||If you've got no business with me,{PA:10} leave.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:305_0_0"
msgid "(I guess the other partygoers have already||gone off to the club.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_3"
msgid "Please!{PA:20} You have to help me!{PA:20}||This man's been stalking me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_4"
msgid "So you're a cheating slut AND a liar?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_5"
msgid "             Will you help her?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_6"
msgid "Not my problem.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_7"
msgid "That's cold,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_8"
msgid "Hey,{PA:10} knock it off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_0_9"
msgid "This is none of your freaking business!{PA:20}||Stay the fuck out of it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_1_0"
msgid "Help!{PA:20} Somebody help!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_0"
msgid "Whew,{PA:10} you saved me there.{PA:20} You're so strong!{PA:20}||Could you do me a huuuge favor?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_1"
msgid "I need to get to Theater Square.{PA:20}||Would you escort me there?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_2"
msgid "Just thinking that man is still out there||really freaks me out!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_3"
msgid "        Will you go along with her?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_4"
msgid "Don't push your luck,{PA:10} lady.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_5"
msgid "I suppose that is asking a bit much.{PA:20}||I'm sorry to have been so presumptuous.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_6"
msgid "Fine,{PA:10} I'll play bodyguard.{PA:20} Theater Square?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:306_2_7"
msgid "That's right.{PA:20} Thank you so much!{PA:20}||{MS:0}Shall we be going,{PA:10} then?{PA:20} Tee hee!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:307_0_3"
msgid "Who the hell is this,{PA:10} Akemi?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:307_0_4"
msgid "You have any idea whose woman you're||putting the moves on there,{PA:10} asshole?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:307_1_0"
msgid "Akemi!{PA:20} Hey,{PA:10} Akemi!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:307_2_0"
msgid "Nngh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:307_2_1"
msgid "What the hell is going on?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:307_2_2"
msgid "I have no idea!{PA:20} He just came at us out of||the blue.{PA:20} He must have been drunk.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:308_0_0"
