msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:296_0_2"
msgid "I wonder what they were doing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:297_0_0"
msgid "They're.{PA:20}.{PA:20}.{PA:20} too strong.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:298_0_0"
msgid "Sure are a lot of Kansai folks today.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:299_0_0"
msgid "Yeah,{PA:10} seriously.{PA:20}||I was just noticing that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_0_0"
msgid "Maybe you were right this time,{PA:10} son.{PA:20}||Your actions saved us all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_1_0"
msgid "You're the one who was fighting off those||yakuza from Kansai,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_1_1"
msgid "I'm a pacifist by nature.{PA:20} I hate violence.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_1_2"
msgid "But when they came storming in,{PA:10} I.{PA:20}.{PA:20}.{PA:20}||I couldn't do a thing to stop them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_1_3"
msgid "I didn't even know where to begin.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_1_4"
msgid "It hurt to see these people tearing||apart my town while I just stood there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_1_5"
msgid "Maybe you were right this time,{PA:10} son.{PA:20}||Your actions saved us all.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:300_2_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20} You're that man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:301_0_0"
msgid "That hostess-looking chick that walked past||down the alley,{PA:10} man.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:301_0_1"
msgid "Yeah,{PA:10} talk about fine!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:301_1_0"
msgid "She was a cutie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:302_1_0"
msgid "Definitely my type.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:304_0_0"
msgid "Can I help you with something?{PA:20}"
