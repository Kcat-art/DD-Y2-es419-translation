msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:327_1_0"
msgid "Oh,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}||I didn't know you had company.{PA:20}.{PA:20}.{PA:20}"
