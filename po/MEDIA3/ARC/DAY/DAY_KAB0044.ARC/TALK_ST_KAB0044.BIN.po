msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:327_0_4"
msgid "He's my whole life,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}"
