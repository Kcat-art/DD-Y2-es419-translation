msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:291_1_6"
msgid "I figured I'd ask him who to bet on in||tomorrow's cycling race.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:291_2_0"
msgid "Should be around here someplace.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:292_0_0"
msgid "I hear they still haven't caught the||bomber yet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:293_0_0"
msgid "Yeah,{PA:10} it's still closed off.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_0_0"
msgid "Seriously,{PA:10} it's such a waste to let this||place just go unused.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_1_0"
msgid "Shangri-La used to be so plush.{PA:20}||Now look at it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_1_1"
msgid "I guess it makes sense after that happened||there,{PA:10} but still.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_1_2"
msgid "It's such a waste to see it abandoned||like this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_1_3"
msgid "It's on a prime lot,{PA:10} too.{PA:20} As big as it is,{PA:10}||I'd bet the land alone is worth a bundle.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_1_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Or is somebody still using it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_1_5"
msgid "Yeah right!{PA:20} As if.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:294_2_0"
msgid "Shangri-La's gone to hell.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:295_0_0"
msgid "This building lost its power a little||while ago.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:296_0_1"
msgid "I saw some men going into the Millennium||Tower before.{PA:20} Isn't it still closed?{PA:20}"
