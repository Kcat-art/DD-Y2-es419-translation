msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:328_1_0"
msgid "(Hm.{PA:20}.{PA:20}.{PA:20} I would ask her if she'd work at||Marietta for us,{PA:10} but.{PA:20}.{PA:20}.)"
