msgctxt "MEDIA3/ARC/DAY/DAY_KAB0044.ARC/TALK_ST_KAB0044.BIN::line:327_0_2"
msgid "I only looked away for a second,{PA:10} and||Aime-chan just disappeared!{PA:20}"
