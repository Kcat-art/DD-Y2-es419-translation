msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_1_0"
msgid "(I need to find Daigo now.{PA:20} I'll have to come||back here another time.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_2_0"
msgid "(I need to get the stuff Sayama asked for.{PA:20}||\"{CC:ffffc8}Underwear{CR:00}\" and \"{CC:ffffc8}beer{CR:00}\".{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_6_0"
msgid "(Sayama's probably not here yet.{PA:20}||Guess I'll go kill some time.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_8_0"
msgid "(Date said he'd call me as soon as he took||care of preparations.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_8_1"
msgid "(I should hold off on going into Serena||until I get word from him.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_9_0"
msgid "(Damn,{PA:10} I left Haruka.{PA:20}.{PA:20}.{PA:20} I should go grab her||and make sure she gets back to Serena okay.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_12_0"
msgid "(There's no time for that now.{PA:20} I need to||find a hospital.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0074.ARC/TALK_ST_KAB0074_BTL.BIN::line:138_13_0"
msgid "Where are you going,{PA:10} Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

