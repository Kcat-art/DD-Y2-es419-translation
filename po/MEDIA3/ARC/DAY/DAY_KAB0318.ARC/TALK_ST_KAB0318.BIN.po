msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_3"
msgid "Kazuma!{PA:20}||You came!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_4"
msgid "I apologize for asking you to meet me in||such a place.{PA:20}"
