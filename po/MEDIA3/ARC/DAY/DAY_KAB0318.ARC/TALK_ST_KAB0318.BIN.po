msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:300_0_3"
msgid "How much do they think I spent on this?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:300_0_4"
msgid "I'm gettin' it back,{PA:10} I swear.{PA:20}"
msgstr "Lo voy a recuperar,{PA:10} lo juro.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_1"
msgid "Hold up,{PA:10} just a second!{PA:20}||I'm tellin' ya,{PA:10} it's a misunderstandin'!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_2"
msgid "I can't believe it!{PA:20}||You were just leadin' me on this whole time!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_3"
msgid "I wasn't,{PA:10} I swear!{PA:20}||I meant it when I proposed to ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_4"
msgid "Look,{PA:10} whatever!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_5"
msgid "When are ya gonna give me back the money I||gave ya for our wedding?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_6"
msgid "Um.{PA:20}.{PA:20}.{PA:20} Soon!{PA:20} Real soon!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:301_0_7"
msgid "Ugh,{PA:10} forget it!{PA:20}||I don't want to see yer mug again!{PA:20} EVER!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_2"
msgid "Honestly.{PA:20}.{PA:20}.{PA:20} I'm disappointed in you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_3"
msgid "What?{PA:20}||Jun?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_4"
msgid "We were gonna meet up tonight!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_5"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} right.{PA:20}"
msgstr "Ah, c{PA:20}as{PA:20}i {PA:20}lo olvido...{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_6"
msgid "So why the hell you off makin' girls cry?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_7"
msgid "That was.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_8"
msgid "And what's this about ya proposin'?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_9"
msgid "No,{PA:10} she.{PA:20}.{PA:20}.{PA:20} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_10"
msgid "And you're scammin' her for money,{PA:10} too?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_12"
msgid "Makes me sick to think I paid ya my hard-||earned money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_13"
msgid "\"Wanna get hitched?{PA:20}\" my ass!{PA:20}||{MS:0}Ugh,{PA:10} thinkin' about it's makin' me sick.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_14"
msgid "H-Hey,{PA:10} you've got a guy with ya there,{PA:10} too!{PA:20}||Don't make me out to be the bad guy!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_15"
msgid "Unlike SOME people,{PA:10} Kazzy here's got||some class!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_16"
msgid "Now get lost!{PA:20}||I'm tired o' lookin' at ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:303_0_17"
msgid "F-Fine.{PA:20} I'm goin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_2"
msgid "Thanks for before,{PA:10} Kazzy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_3"
msgid "I just don't know what I'd o' done without||you bein' there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_4"
msgid "I didn't do a thing.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_5"
msgid "No,{PA:10} no!{PA:20} Just havin' ya there made all the||difference.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_6"
msgid "I'll be more careful.{PA:20}||If it's too good to be true.{PA:20}.{PA:20}.{PA:20} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_7"
msgid "Right.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_8"
msgid "So,{PA:10} Kazzy.{PA:20} Whaddya say?{PA:20}||Shall we celebrate tonight's lesson?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_9"
msgid "Celebrate how?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_10"
msgid "Oh,{PA:10} I think I could come up with a couple||ways to make a guy feel good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_12"
msgid "I don't just say this to anybody,{PA:10} mind.{PA:20}||So,{PA:10} how's about it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:304_0_13"
msgid "C'mon,{PA:10} Kazzy.{PA:30}{PA:20}||{MS:0}It'll be fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_1"
msgid "Oh,{PA:10} Kazzy,{PA:10} you're unstoppable!{PA:20}||You're a beast!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_2"
msgid "You thought so,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_3"
msgid "Heh,{PA:10} I did.{PA:20} Wish every man had your kick.{PA:20}||Thanks for tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_4"
msgid "Though now you're probably addicted to me,{PA:10}||huh?{PA:20} I almost feel kinda bad.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_5"
msgid "Heh,{PA:10} yeah.{PA:20} It's all your fault.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_6"
msgid "Still,{PA:10} it's goodbye for now,{PA:10} I'm afraid.{PA:20}||I'll see ya back at the club,{PA:10} yeah?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_7"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_8"
msgid "Love ya,{PA:10} babe!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:305_0_9"
msgid "Received 2❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:308_0_1"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:308_0_2"
msgid "I never imagined I'd find myself as I am||now,{PA:10} free to choose any path I wish.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:308_0_3"
msgid "I'll never forget you.{PA:20}"
msgstr "Siempre lo recordaré...{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:308_0_4"
msgid "I'm happy for you.{PA:20}"
msgstr "Me alegro por ustedes.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:308_0_5"
msgid "Thank you,{PA:10} for today.{PA:20}||I'll be in touch.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:308_0_6"
msgid "Good night,{PA:10} Kazuma.{PA:20}"
