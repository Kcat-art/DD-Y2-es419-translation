msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_23_0"
msgid "I.{PA:20}.{PA:20}.{PA:20} I'll keep my mouth shut.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_24_0"
msgid "Hello,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_25_0"
msgid "If it ain't one o' dem Kanto assholes!{PA:20} I'll||make sure ya never set foot in Osaka again.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_26_0"
msgid "Hey,{PA:10} old man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_27_0"
msgid "Oooh.{PA:20}.{PA:20}.{PA:20} Th-This is all I got!{PA:20}||J-Just take it and go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_27_1"
msgid "Received \"15❟000 yen\""
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_28_0"
msgid "I'm real sorry.{PA:20} Okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_29_0"
msgid "Nice day,{PA:10} ain't it,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_30_0"
msgid "What's yer deal,{PA:10} ya little prick?{PA:20}||Who the fuck do ya think ya are?{PA:20} "
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_31_0"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_32_0"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20}||I got a little carried away,{PA:10} ya know?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_32_1"
msgid "Received \"Broken Stun Gun\""
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_33_0"
msgid "Man,{PA:10} today's just not my day.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:285_34_0"
msgid "Hey,{PA:10} boss.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_0_0"
msgid "(There's something here.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_0_1"
msgid "Take the locker key?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_0_2"
msgid "Picked up \"{CC:ffffc8}Shofukucho locker key #7{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_0_4"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_1_0"
msgid "(There's something here.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_1_1"
msgid "Take the locker key?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_1_2"
msgid "Picked up \"{CC:ffffc8}Shofukucho locker key #7{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_1_3"
msgid "(It says Shofukucho lockers.{PA:20}||That must be where this key goes.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:286_1_5"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_1"
msgid "Wait,{PA:10} you're going in here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_2"
msgid "(I've got Sayama with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_3"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_4"
msgid "Doesn't look like I have much of a choice.{PA:20}||Fine.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_5"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_6"
msgid "You sure?{PA:20} I don't really care.{PA:20}"
msgstr "¿Seguro? No hab{PA:20}ría tenido problemas con esperarte.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_7"
msgid "Are you going in here,{PA:10} Uncle Kaz?{PA:20}"
msgstr "¿Entrarás allí, {PA:10}tío Kaz?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_8"
msgid "(I've got Haruka with me.{PA:20} What do I do?)"
msgstr "(¿Haruka me está acompañ{PA:20}ando. ¿Entro?)."

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_9"
msgid "Yeah.{PA:20} Sorry,{PA:10} but I need you to wait for me||out here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Okay.{PA:20} I'll stay right here.{PA:20}||Have fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_11"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_12"
msgid "Really?{PA:20} If it's because of me,{PA:10} you don't||have to,{PA:10} Uncle Kaz.{PA:20} I'll be fine here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_13"
msgid "Whoa,{PA:10} whoa.{PA:20} Kazuma,{PA:10} you're going in HERE?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_14"
msgid "(I've got Date with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_15"
msgid "Yeah.{PA:20} Care to join me,{PA:10} Date?{PA:20}||Should be a fun time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_16"
msgid ".{PA:20}.{PA:20}.{PA:20}I'll pass.{PA:20}||Go have your fun.{PA:20} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_17"
msgid "No,{PA:10} I'll come back another time.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_18"
msgid "You sure?{PA:20} Won't bother me.{PA:20}||I can keep myself busy for an hour.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_19"
msgid "You're not thinking of going in,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_20"
msgid "(I've got Daigo with me.{PA:20} What do I do?)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_21"
msgid "Yeah,{PA:10} I am.{PA:20}"
msgstr "Cla{PA:10}ro.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_22"
msgid "All right,{PA:10} well.{PA:20}.{PA:20}.{PA:20}||I'll just wait here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_23"
msgid "Thanks,{PA:10} Daigo.{PA:20} I'll catch up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_24"
msgid "No,{PA:10} not right now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_1_25"
msgid "Yeah?{PA:20} Well,{PA:10} a'ight then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_2_1"
msgid "*Sigh* Finally.{PA:20}||Now c'mon,{PA:10} let's get out of here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_2_2"
msgid "You took foreeever!{PA:20}||I'm bored,{PA:10} let's go!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_2_3"
msgid "All done with your fun?{PA:20}||Let's get back to work.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_2_4"
msgid "Fucking finally.{PA:20}||Let's go already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_3_0"
msgid "(I don't have time for this now.{PA:20} I need to||find that bar,{PA:10} Aoi.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_4_0"
msgid "(This isn't the time to fool around.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_4_1"
msgid "(I need to get Sayama to Aoi,{PA:10} and fast.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_5_0"
msgid "(There's no time right now.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:287_5_1"
msgid "(I need to get to Aoi.)"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:288_0_1"
msgid "You wait here,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:288_0_2"
msgid "Okay.{PA:20}"
msgstr "Okey.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_1"
msgid "Okay,{PA:10} here.{PA:20} Let's do this.{PA:20}||You have a cell phone,{PA:10} Pops?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_2"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_3"
msgid "Thanks!{PA:20} Let's see here.{PA:20}.{PA:20}.{PA:20}"
msgstr "¡Grac{PA:20}ias! Veamos.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_4"
msgid "H-Hey!{PA:20}"
msgstr "¡O-oiga!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_5"
msgid "All righty,{PA:10} that'll do it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_6"
msgid "I programmed in my private number.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_0_7"
msgid "As soon as ya change yer mind,{PA:10} call me!{PA:20}||I'll be waitin' for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_1"
msgid "Hey,{PA:10} miss!{PA:20} You there,{PA:10} little angel!{PA:20}"
msgstr "¡Ni{PA:10}ñita{PA:20}, no ti{PA:10}enes idea!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_2"
msgid "You're a golden egg.{PA:20} A diamond in the rough!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_3"
msgid "I can tell!{PA:20} Girl like you comes around maybe||once in a decade.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_4"
msgid "No,{PA:10} no,{PA:10} no.{PA:20}.{PA:20}.{PA:20} Once in a century!{PA:20}||You're a talent in the making!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_5"
msgid "Who are you,{PA:10} mister?{PA:20} What do you want?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_6"
msgid "Ever dream about becoming a star,{PA:10} angel?{PA:20}||Bein' a big celebrity?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_7"
msgid "Of course ya have!{PA:20} Everybody does.{PA:20}||Anybody would!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_8"
msgid "Haruka?{PA:20}"
msgstr "¡¿Haruka?!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_9"
msgid "You this angel's daddy?{PA:20}||Ah,{PA:10} allow me to introduce myself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_10"
msgid "I'm the president of Sotenbori Productions.{PA:20}||Nice to meet ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_11"
msgid "Sotenbori Productions?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_12"
msgid "We're a talent agency.{PA:20}"
msgstr "¡Una agencia de talentos!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_13"
msgid "So how's about it,{PA:10} Pops?{PA:20}||Think ya could let us take in angel here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_14"
msgid "I can guarantee she'd grow up to be the||biggest star in Japan.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_15"
msgid "Is that so?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_16"
msgid "Our office's just over yonder.{PA:20} What's say||we have a little chat?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_17"
msgid "Come on,{PA:10} Uncle Kaz.{PA:20} Let's go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:289_1_18"
msgid "Ahh,{PA:10} hey,{PA:10} Pops!{PA:20} Just a quick chat!{PA:20}||If you're in a rush now,{PA:10} maybe next time?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_1"
msgid "C'mon,{PA:10} babe.{PA:20}||Give it a damn rest!{PA:20}"
msgstr "Por favo{PA:10}r, nena{PA:20}.|| ¡No te compliques tanto!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_2"
msgid "I said it before 'n' I'll say it again!{PA:20}||You agents are all crooks!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_3"
msgid "I did everythin' y'all said,{PA:10} and I still||got nothin'!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_4"
msgid "Oh,{PA:10} don't give me that!{PA:20}"
msgstr "¡Oh,{PA:10} por favor, estás exagerando!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_5"
msgid "The reason you ain't got nothin' is 'cause||ya ain't put enough effort in!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_6"
msgid "In this world,{PA:10} it's a person's effort that||decides whether they sell or not!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_7"
msgid "Have a little self-reliance,{PA:10} babe!{PA:20}||Don't expect others to do it all for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:290_0_8"
msgid "I don't need to take that from you!{PA:20}||Give back my money!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_1"
msgid "Hey,{PA:10} ya heard?{PA:20}"
msgstr "Oiga, ¿le {PA:10}cuento algo interesante?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_2"
msgid "That girl there got took in by some scheme||at a fraudulent talent agency.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_3"
msgid "I've followed the whole saga.{PA:20}||The girl's real dumb,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_4"
msgid "Soon as the agency said it'd pay for it,{PA:10} she||gets her teeth done,{PA:10} gets her face done.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_5"
msgid "Of course the doctors're all in on it,{PA:10} too.{PA:20}||Anybody with any sense'd know that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_6"
msgid "Makes me wonder what the young folk these||days are thinkin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:291_0_7"
msgid "I bet her folks'd cry if they saw her||swappin' out her whole body like that.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:292_0_1"
msgid "Who are those guys?{PA:20}"
msgstr "¡¿Quiénes son ellos?!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:292_0_2"
msgid "Boys from a rival agency.{PA:20}||Real pieces of work,{PA:10} those guys.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:292_0_3"
msgid "Do as they please,{PA:10} 'cause the Omi backs 'em.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:292_0_4"
msgid "C'mon,{PA:10} don't get suckered in by this chump.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:292_0_5"
msgid "Our agency'll take way better care of ya.{PA:20}"
msgstr "¡Nuestra agencia sabrá cuidarte mucho mejor!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:292_0_6"
msgid "Let go of me!{PA:20}"
msgstr "¡Déjeme en paz!{PA:20}"

