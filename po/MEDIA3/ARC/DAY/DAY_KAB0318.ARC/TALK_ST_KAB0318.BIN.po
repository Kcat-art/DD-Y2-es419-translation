msgid "Received 2❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_1"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:15}{PA:20}||That was wonderful.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_2"
msgid "I could feel yer love.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_3"
msgid "I had a good time,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_4"
msgid "I ain't ever felt like that before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_5"
msgid "I hope you'll come see me again.{PA:20}||There,{PA:10} at the club?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_6"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_7"
msgid "Promise?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_8"
msgid "Well,{PA:10} it's good night for now.{PA:20}.{PA:20}.{MS:0}{PA:30}{PA:20}||Love ya,{PA:10} Kazuma!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:311_0_9"
msgid "Received 2❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_4"
msgid "Kazuma?{PA:20}||What brings ya out here?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_5"
msgid "Who the hell are you?{PA:20}"
msgstr "¿Quién demonios eres tú?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_6"
msgid "Nana.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_7"
msgid "I never told ya,{PA:10} Kazuma,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_8"
msgid "I gotta pay this guy 10 million by tomorrow.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_9"
msgid "It's that,{PA:10} or lose a shop that's real||important to me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_10"
msgid "Your orphan friend's shop,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_11"
msgid "How'd you know about him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_12"
msgid "I done told her the deadline's tomorrow.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_13"
msgid "Can't see why she has to keep buggin' me to||push it back to next week.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_14"
msgid "Those kids finally made it this far!{PA:20}||They got a place o' their own now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_15"
msgid "I'll take on the debt myself.{PA:20}||Their happiness is cheap at 10 million.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_16"
msgid "Can't ya please,{PA:10} please just give me 'til||next week?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_17"
msgid "If ya had that 10 million on ya,{PA:10} I'd let ya||pay,{PA:10} no problem.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_18"
msgid "And I told ya I just spent my cash on havin'||the orphanage renovated!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_19"
msgid "Ain't no problem o' mine,{PA:10} lady.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_20"
msgid "I run a business,{PA:10} not a charity.{PA:20}||A deadline's a deadline,{PA:10} follow?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_21"
msgid "Gotta pay the bills here,{PA:10} baby.{PA:20}||Anyhow,{PA:10} I'm done here.{PA:20} Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_22"
msgid "No,{PA:10} wait!{PA:20}||Please!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_23"
msgid "If ya give me till next week,{PA:10} I'll pay 15!{PA:20}||No,{PA:10} 20 million!{PA:20} I swear!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_24"
msgid "Contract's a contract,{PA:10} babe.{PA:20}||Give it up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_25"
msgid "Then I'll pay.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_26"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_27"
msgid "Kazuma?{PA:20}"
msgstr "¡¿Kazuma?!{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_30"
msgid "I'll pay the 10 million.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_32"
msgid "          Pay the 10 million yen?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_33"
msgid "Here's your money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_34"
msgid "S-Serious?!{PA:20} You gotta be crazy,{PA:10} pal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_35"
msgid "Just take it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_36"
msgid "          You paid 10 million yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_37"
msgid "That should settle it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_38"
msgid "I don't believe it!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_39"
msgid "Hey,{PA:10} I don't care who pays,{PA:10} long as I get||paid in full.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_40"
msgid "I got my 10 million.{PA:20} Here,{PA:10} have a receipt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_41"
msgid "I'm done here,{PA:10} folks.{PA:20}||Thanks,{PA:10} have a good night.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_43"
msgid ".{PA:20}.{PA:20}.{PA:20}At least,{PA:10} I wish I could.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_44"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_45"
msgid "Then I'm done here.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_46"
msgid "Kazuma,{PA:10} I.{PA:20}.{PA:20}.{PA:20}||I'm sorry to put ya in that position.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_49"
msgid "Just a minute.{PA:20}||You really gonna pay 10 million?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_50"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_51"
msgid "Guess I can wait,{PA:10} but I ain't waitin' long!{PA:20}||Get me that cash soon,{PA:10} or I'm walkin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_52"
msgid "(Well.{PA:20}.{PA:20}.{PA:20}?)"
msgstr "Es qu{PA:20}e{PA:20}.{PA:20}.."

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_54"
msgid "I wish I could.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_55"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_56"
msgid "Then I'm done here.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_57"
msgid "Kazuma,{PA:10} I.{PA:20}.{PA:20}.{PA:20}||I'm sorry to put ya in that position.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_60"
msgid "Just give me a little longer.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_61"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20} Still don't see why you should be||payin',{PA:10} but it's yer money to spend.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_0_62"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_1_3"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_1_5"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:312_1_6"
msgid "I'm real sorry!{PA:20}||See ya later!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_2"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}||Sure ya don't mind?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_3"
msgid "It's no problem.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_4"
msgid "I don't know what to say.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_5"
msgid "You don't have to say anything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_6"
msgid "Kazuma,{PA:10} I.{PA:20}.{PA:20}.{PA:20}||Them kids are like my family.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_7"
msgid "Thinkin' o' their smiles gets me through my||day,{PA:10} ya know?{PA:20} They're my strength.{PA:20}"
