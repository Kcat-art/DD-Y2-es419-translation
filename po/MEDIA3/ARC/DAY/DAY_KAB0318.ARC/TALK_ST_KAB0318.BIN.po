msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_5"
msgid "It's fine.{PA:20}"
msgstr "No es nada.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_6"
msgid "I spoke with my parents.{PA:20} I told them I'd||choose my own partner in life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_7"
msgid "They were furious,{PA:10} of course,{PA:10} but in the end||I think they understood.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_8"
msgid "That's good.{PA:20}||I'm proud of you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_9"
msgid "It's all thanks to you.{PA:20}||{MS:0}I'm so grateful.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_10"
msgid "I didn't do anything.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_11"
msgid "I think I love you!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_12"
msgid "What?!{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_13"
msgid "I wish I could be with you always,{PA:10} but I||know you're a Tokyo man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_14"
msgid "So at least allow me to have tonight.{PA:20}||A memory of you to cherish.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_16"
msgid "Unless.{PA:20}.{PA:20}.{PA:30}{PA:20}||{MS:0}Unless you have other plans?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_17"
msgid "You're sure?{PA:20}"
msgstr "¿Está seguro?{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:309_0_18"
msgid "More sure than I've ever been before.{PA:20}"
