msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:310_0_4"
msgid "You're pretty wild,{PA:10} you know that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:310_0_5"
msgid "Wild for you.{PA:20}.{PA:20}.{PA:20}"
