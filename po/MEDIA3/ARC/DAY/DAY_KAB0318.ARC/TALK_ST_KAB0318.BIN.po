msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:310_0_1"
msgid "Mmm,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}||It's like I'm still dreaming.{PA:20}"
