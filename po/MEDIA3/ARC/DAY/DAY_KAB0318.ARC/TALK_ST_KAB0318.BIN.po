msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_8"
msgid "They call me the Billiken Gal,{PA:10} but I'm doin'||it for myself.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_9"
msgid "Heh,{PA:10} the name still fits.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_10"
msgid "And those kids are safe now.{PA:20}||Thanks to you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_11"
msgid "It was my pleasure.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_12"
msgid "No way!{PA:20}||I'm payin' ya back,{PA:10} I swear.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_13"
msgid "How 'bout ya let me make a down payment?{PA:20}||{MS:0}C'mon,{PA:10} Kazuma.{PA:20} No dawdlin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:313_0_14"
