msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:300_0_1"
msgid "It's like a sick joke.{PA:20}"
msgstr "De verdad ya no los soporto.{PA:20}"

msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:300_0_2"
msgid "Registration fees,{PA:10} lesson fees,{PA:10} photo||costs 'n' more!{PA:20}"
