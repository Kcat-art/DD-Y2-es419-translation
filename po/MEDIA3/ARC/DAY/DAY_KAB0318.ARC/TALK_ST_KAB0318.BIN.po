msgctxt "MEDIA3/ARC/DAY/DAY_KAB0318.ARC/TALK_ST_KAB0318.BIN::line:310_0_9"
msgid "Oh,{PA:10} I did.{PA:20} Thanks,{PA:10} Kazuma.{PA:20}||{MS:0}See you later,{PA:10} I hope!{PA:20}"
msgstr ""

