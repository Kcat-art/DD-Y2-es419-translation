msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0247.ARC/TALK_ST_KAB0247.BIN::line:30_2_7"
msgid "Thanks,{PA:10} sugar.{PA:20}||See ya soon.{PA:20}"
