msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0247.ARC/TALK_ST_KAB0247.BIN::line:31_1_0"
msgid "          Get Kaoru to Aoi before||          she runs out of health.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0247.ARC/TALK_ST_KAB0247.BIN::line:31_2_0"
msgid "(She's hurt worse than I thought.{PA:20}||I need to hurry!)"
