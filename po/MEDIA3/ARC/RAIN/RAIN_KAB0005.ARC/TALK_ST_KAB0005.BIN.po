msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_3_1"
msgid "The Go-Ryu Clan.{PA:20}.{PA:20}.{PA:20}||They've invaded Kamurocho,{PA:10} and they're.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_3_2"
msgid "I know.{PA:20} I'm on my way.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_4_0"
msgid "Looks like the Go-Ryu have gone quiet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_4_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_4_2"
msgid "You're amazing,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||You stopped the whole lot of them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_4_3"
msgid "Minus one,{PA:10} anyway.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_4_4"
msgid "Good luck,{PA:10} sir.{PA:20} I'll be thinking of you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_5_0"
msgid "Hey,{PA:10} Mr.{PA:20} Kiryu.{PA:20} Remember that video place,{PA:10}||Beam?{PA:20} Used to deal in black market stuff?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_5_1"
msgid "Apparently,{PA:10} they've changed the password.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_5_2"
msgid "Oh,{PA:10} really?{PA:20}"
msgstr "¿Oh,{PA:10} en serio?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_5_3"
msgid "Yeah.{PA:20} A guy named \"{CC:ffc8c8}Nitta{CR:00}\" should know it.{PA:20}||He always sits in the first row at Asia.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_5_4"
msgid "For a fee,{PA:10} he'll tell you what it is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_5_5"
msgid "Thanks,{PA:10} that's good to know.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_0"
msgid "Oh,{PA:10} hey,{PA:10} Mr.{PA:20} Kiryu.{PA:20}||Here for some info?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_1"
msgid "Have you got anything on a ring of con men||posing as loan collectors?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_2"
msgid "Yeah,{PA:10} they're all over the place these days.{PA:20}||Always shake folks down for exactly 401K.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_3"
msgid "We info dealers have taken to calling them||the yakuza retirement plan.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_4"
msgid "They skim personal info off of people with||signature drives for fake charities.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_5"
msgid "They've got some yakuza goons on staff,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_6"
msgid "If folks don't cough up the money,{PA:10} those||heavies come by to trash their place.{PA:20}"
