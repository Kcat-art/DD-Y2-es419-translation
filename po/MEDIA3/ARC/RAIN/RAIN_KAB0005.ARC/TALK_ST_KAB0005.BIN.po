msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_8"
msgid "Do you know where they're based?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_9"
