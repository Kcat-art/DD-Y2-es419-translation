msgid "You know the convenience store between||{CC:ffc8c8}Nakamichi{CR:00} and {CC:ffc8c8}Pink St.{CR:00}{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0005.ARC/TALK_ST_KAB0005.BIN::line:297_6_11"
