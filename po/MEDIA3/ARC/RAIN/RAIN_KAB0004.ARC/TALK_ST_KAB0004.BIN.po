msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:298_0_0"
msgid "Hmm?{PA:20} Amano Building?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:298_0_1"
msgid "This is my first time in Kamurocho,{PA:10} son.{PA:20}||I don't know where anything is!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:298_0_2"
msgid "Boy,{PA:10} howdy!{PA:20} I'd heard the rumors,{PA:10} but I||never thought it'd be THIS crowded.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:299_0_0"
msgid "Goddamned Go-Ryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:300_0_0"
msgid "I saw you fighting before.{PA:20}||You're so strong!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:300_1_0"
msgid "You're the man who fought against all those||Kansai yakuza types,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:300_1_1"
msgid "I saw you before!{PA:20}||Know that you've got at least one fan here!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:300_2_0"
msgid "Ahh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_1"
msgid "Heyyy,{PA:10} Kazu.{PA:20} I been waitin'!{PA:20}||This town's seriously too confusin'!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_2"
msgid "I'm late fer my reservation now!{PA:20}||Missed my chance to see Yuya,{PA:10} dammit.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_3"
msgid "You need to check your priorities,{PA:10} Granny.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_4"
msgid "Look,{PA:10} Yuya's a friend of mine.{PA:20}||I'll ask him to get you in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_5"
msgid "What?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_6"
msgid "Why didn't ya tell me that sooner?{PA:20}||Teasin' old ladies a hobby o' yours?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_7"
msgid "Calm down.{PA:20} You'll get to meet him.{PA:20}||But first.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_8"
msgid ".{PA:20}.{PA:20}.{PA:20}What?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_9"
msgid "You've got some explaining to do.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_10"
msgid "E-Explainin'?{PA:20} Explain what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_11"
msgid "I need to know who you really are.{PA:20}||What are you hiding,{PA:10} Granny?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_12"
msgid "I-I ain't hidin' anythin'.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_13"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20} Then I'll just drop it.{PA:20}||Too bad about missing out on Yuya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_14"
msgid "Wh-Whaaat?!{PA:20} That ain't FAIR,{PA:10} Kazu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_15"
msgid "Then give me some answers.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_16"
msgid "Awright,{PA:10} fine!{PA:20}||You want to know,{PA:10} I'll tell ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_17"
msgid "Or I would,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_0_18"
msgid "Hm?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_1"
msgid "Whaddya want,{PA:10} ya damn failure?{PA:20}||I ain't goin' back.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_2"
msgid "You don't need to go anywhere.{PA:20}||I'm snuffin' ya out right here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_3"
msgid "What's that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_4"
msgid "We got no need for ya anymore.{PA:20}||I'll just take over the Lotus School.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_5"
msgid "Hah!{PA:20} Big talk fer a little squirt like you!{PA:20}||Ya ain't even as good as Ka Long was.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_6"
msgid "I feel I've surpassed Ka Long in every way.{PA:20}||I got everything needed to carry the school.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_7"
msgid "Ya got a big mouth on a fat head.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_8"
msgid "Here,{PA:10} I'll give ya a little test.{PA:20}||Come on,{PA:10} let's see what ya got,{PA:10} pup.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_9"
msgid "Fine.{PA:20} I'll get rid o' the both o' ya.{PA:20}||Saves me a trip.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_10"
msgid ".{PA:20}.{PA:20}.{PA:20}?{PA:20}||Kazu ain't got nothin' to do with this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_11"
msgid "Bai Ren,{PA:10} don't ya know who he is?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_12"
msgid "He's Kazuma Kiryu.{PA:20} He killed Lau Ka Long a||year ago.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_13"
msgid "And now since ya joined up with him,{PA:10} you're||a traitor to the school.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_14"
msgid "Wait,{PA:10} Kazu?{PA:20} That true?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_15"
msgid "You're the guy killed Lau Ka Long?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_16"
msgid "It's true.{PA:20} It happened last year.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_17"
msgid "The Snake Flower Triad kidnapped someone||important to me.{PA:20} Lau was their leader.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_18"
msgid "Plus,{PA:10} I owed him one for setting me up 13||years ago.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_19"
msgid "There's a lot of history there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_20"
msgid ".{PA:20}.{PA:20}.{PA:20}You taught Lau Ka Long,{PA:10} Granny?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_21"
msgid "I did.{PA:20} But I kicked him out the school a||long time ago.{PA:20} Fool lost his humanity.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_22"
msgid "Humanity?{PA:20} Please.{PA:20} You 'n' me are of the||Snake Flower Triad,{PA:10} same as him!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_23"
msgid "Ka Long's the reason the triad got crushed.{PA:20}||It's his own fault 'n' none o' Kazu's.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_24"
msgid "Deluded ol' bag.{PA:20}.{PA:20}.{PA:20} Anyhow,{PA:10} nobody asked fer||an opinion from the walkin' dead.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_25"
msgid "Dead?{PA:20} That was yer daddy in bed!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_1_26"
msgid "Now stop flappin' those gums,{PA:10} pup.{PA:20} I'm||right here.{PA:20} Come get me if ya can!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_1"
msgid "Ugh,{PA:10} what an embarrassment.{PA:20}||Yer a decade shy o' Ka Long's skill,{PA:10} kid.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_2"
msgid "Rrngh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_3"
msgid "I'd say this makes things pretty clear.{PA:20}||Now call off your men,{PA:10} Yen Long.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_4"
msgid ".{PA:20}.{PA:20}.{PA:20}Rrrgh.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_5"
msgid "Well?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_6"
msgid "F-Fine.{PA:20} I'll tell 'em to leave her alone.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_7"
msgid "Hueh heh hah!{PA:20}||Ain't worth worryin' yerself,{PA:10} Kazu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_8"
msgid "I ain't ready to let a whelp like this one||get the best o' me yet.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_9"
msgid "Beatin' me ain't that easy,{PA:10} Yen Long.{PA:20}||Better get to practicin'.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_2_10"
msgid "Rraagh!{PA:20}||This.{PA:20}.{PA:20}.{PA:20} This isn't over!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_1"
msgid "Thanks fer yer help,{PA:10} Kazu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_2"
msgid "Don't worry about it.{PA:20} You'd have taken care||of them just fine without me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_3"
msgid "Hueh heh.{PA:20} Damn right!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_4"
msgid "But ya saved me the trouble,{PA:10} handsome.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_5"
msgid "Can I ask you something?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_6"
msgid "What's that?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_7"
msgid "Did you know I was the man who killed Ka||Long when you first approached me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_8"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_9"
msgid "Could be.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_10"
msgid "Inhuman or no,{PA:10} a pupil's a pupil.{PA:20} I still||had a soft spot for the damn fool.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_11"
msgid "If the guy who offed him was as big an idiot||as he was,{PA:10} I'da killed him myself.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_12"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_13"
msgid "But ya ain't.{PA:20}||Yer a real man,{PA:10} Kazu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_14"
msgid "Sorry 'bout that,{PA:10} handsome.{PA:20}||Nobody likes to be tested,{PA:10} I know.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_15"
msgid "Heh,{PA:10} it's all right.{PA:20}||This was actually pretty fun.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_16"
msgid "Well,{PA:10} it's about time fer my train home.{PA:20}||It's back to Osaka for this granny.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_17"
msgid "I'll see you around.{PA:20}||You be careful out there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_18"
msgid "The hell do ya think yer talkin' to?{PA:20}||Ain't nothin' stoppin' me before I hit 100.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_19"
msgid "Oh,{PA:10} and here.{PA:20} Take this,{PA:10} handsome.{PA:20}||It's probably what they were after.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_20"
msgid "  You were given||\"{CC:ffffc8}Taihei Blvd.{PA:20} West locker key #27{CR:00}\""
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_22"
msgid "Drop me a line if you're ever in Osaka.{PA:20}||Later,{PA:10} handsome!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:301_3_23"
msgid "Received 2❟000 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:307_0_0"
msgid "Let's get outta this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:308_0_0"
msgid "I wish it'd stop||raining soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:309_0_0"
msgid "ACK!{PA:20} I left the||laundry out to dry!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:310_0_0"
msgid "Drinking at this hour?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0004.ARC/TALK_ST_KAB0004.BIN::line:311_0_0"
msgid "I told you!{PA:20}"
msgstr ""

