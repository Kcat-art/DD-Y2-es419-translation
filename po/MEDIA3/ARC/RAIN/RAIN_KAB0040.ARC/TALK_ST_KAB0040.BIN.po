msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:310_1_4"
msgid "It's a lovely host club called Adam.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:310_1_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:310_1_6"
msgid ".{PA:20}.{PA:20}.{PA:20}I can't help but feel sorry,{PA:10} looking at||you flounder here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:310_1_7"
msgid "All right,{PA:10} fine.{PA:20}||I'll go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:310_1_8"
msgid "Thank you,{PA:10} miss!{PA:20}||Please,{PA:10} allow me to show you there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:310_2_0"
msgid "(Hm.{PA:20}.{PA:20}.{PA:20} How about her?)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_0"
msgid "Excuse me,{PA:10} miss,{PA:10} are you free this evening?{PA:20}"
