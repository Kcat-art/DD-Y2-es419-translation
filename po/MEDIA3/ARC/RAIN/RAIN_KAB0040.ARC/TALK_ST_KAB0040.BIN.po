msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_0_1"
msgid "Hey there!{PA:20} Old guy!{PA:20} So a friend of mine got||sent to the hospital a while back.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_0_2"
msgid "And I think you had something to do with it.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_0_3"
msgid "I think he's feeling lonely there,{PA:10} so I||figured I'd send you in to keep him company.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_0_4"
msgid "I did a little asking around on who did it||to my boy,{PA:10} and folks say it was you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_0_5"
msgid "I hope your insurance is paid up,{PA:10} man.{PA:20}||Get ready to hurt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_1_0"
msgid "Hey there!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_2_1"
msgid "Yo,{PA:10} old guy!{PA:20} I actually just remembered.{PA:20}||Is that hair really hair?{PA:20} Like,{PA:10} real hair?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_2_2"
msgid "Because my friend said the guy who did it||was a skinhead.{PA:20} Sure that's not a wig?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_2_3"
msgid "One of those blows to the head kinda jogged||my memory,{PA:10} you know?{PA:20} Whu-bam,{PA:10} OH!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_2_4"
msgid "Never was good with remembering details.{PA:20}.{PA:20}.{PA:20}||Anyway,{PA:10} sorry to.{PA:20}.{PA:20}.{PA:20} make you beat me up?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_2_5"
msgid "I don't really know.{PA:20} Anyway,{PA:10} take this.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:282_2_6"
msgid "Received \"Ogre Knuckles\""
msgstr ""

