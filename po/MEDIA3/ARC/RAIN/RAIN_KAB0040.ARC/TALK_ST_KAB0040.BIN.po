msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_1"
msgid "Ugh.{PA:20}.{PA:20}.{PA:20}||Tokyo folks are so cold.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Is something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_3"
msgid "I just came in from Iwate today,{PA:10} right?{PA:20}||Well,{PA:10} I got all turned around here.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_4"
msgid "I'm trying to find this host club I read||about,{PA:10} but I can't figure left from right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_5"
msgid "It's called Stardust.{PA:20} Maybe you heard of it?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_6"
msgid "Anyway,{PA:10} I been saving up money for tonight,{PA:10}||and now it's like it's not gonna happen.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_7"
msgid "Ah,{PA:10} Stardust is on Tenkaichi Street,{PA:10} miss.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_8"
msgid "Oh,{PA:10} really?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_9"
msgid "The manager there is a host named Yuya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_10"
msgid "Oh,{PA:10} right,{PA:10} I remember!{PA:20} Thanks,{PA:10} mister!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_11"
msgid ".{PA:20}.{PA:20}.{PA:20}Although I'd actually recommend a host||club called Adam over the Stardust.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0040.ARC/TALK_ST_KAB0040.BIN::line:311_0_12"
msgid "Hm,{PA:10} think I'll stick with Stardust,{PA:10} thanks.{PA:20}"
msgstr ""

