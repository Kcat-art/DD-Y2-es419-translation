msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_14"
msgid "Let the poor girl leave the nest.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_15"
msgid "Kazuma?{PA:20}"
msgstr "¡¿Kazuma?!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_16"
msgid "What could you possibly know about her?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_17"
msgid "The master has spared no effort in raising||Miss Madoka to be a woman of stature.{PA:20}"
