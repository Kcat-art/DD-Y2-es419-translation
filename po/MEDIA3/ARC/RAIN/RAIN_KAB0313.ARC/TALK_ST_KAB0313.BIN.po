msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_4"
msgid "Kyubei!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_5"
msgid "What's going on here?{PA:20}"
msgstr "¿Qué está pasando aquí?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_6"
msgid "It has long been my duty to see to the||young miss.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_7"
msgid "I have no idea who you are,{PA:10} sir,{PA:10} but Miss||Madoka has a promising future ahead of her.{PA:20}"
