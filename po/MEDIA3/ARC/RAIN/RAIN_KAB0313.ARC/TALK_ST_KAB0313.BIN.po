msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_8"
msgid "She also has a fiancé.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_9"
msgid "Kyubei,{PA:10} that's quite enough!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_10"
msgid "I have my orders from your father,{PA:10} miss.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_11"
msgid "This is my life,{PA:10} Kyubei,{PA:10} not my father's.{PA:20}||I don't need your interference!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_12"
msgid "I understand your feelings,{PA:10} miss.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_13"
msgid "But I cannot sit idly by and watch you||tread this path of folly any longer!{PA:20}"
