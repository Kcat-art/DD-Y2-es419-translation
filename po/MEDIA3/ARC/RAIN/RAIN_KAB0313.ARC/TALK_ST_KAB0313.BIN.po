msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:294_7_4"
msgid "This doesn't concern you.{PA:20}||{MS:0}We're here for the young lady.{PA:20}"
