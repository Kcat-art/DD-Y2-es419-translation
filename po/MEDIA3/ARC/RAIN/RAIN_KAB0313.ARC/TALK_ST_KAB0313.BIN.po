msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_18"
msgid "Maybe he should have.{PA:20} People need to make||mistakes if they hope to learn in life.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_19"
msgid "Don't you think she has the right to make||her own mistakes?{PA:20}"
