msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_3"
msgid "Worthless!{PA:20} And you call yourselves guards||to the Shirakawa family?!{PA:20}"
