msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_21"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0313.ARC/TALK_ST_KAB0313.BIN::line:295_0_22"
