msgid "H-Here,{PA:10} please accept this.{PA:20}.{PA:20}.{PA:20}||as my apology!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:283_32_2"
msgid "Received \"10❟000 yen\""
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:283_33_0"
msgid "S-Sorry!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:283_34_0"
msgid "Hi again,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_0_0"
msgid "(There's something here.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_0_1"
msgid "Take the locker key?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_0_2"
msgid "Picked up \"{CC:ffffc8}Shofukucho locker key #30{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_0_4"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_1_0"
msgid "(There's something here.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_1_1"
msgid "Take the locker key?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_1_2"
msgid "Picked up \"{CC:ffffc8}Shofukucho locker key #30{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_1_3"
msgid "(It says Shofukucho lockers.{PA:20}||That must be where this key goes.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:284_1_5"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:286_1_0"
msgid "This place is off limits.{PA:20}||Move along.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:286_1_1"
msgid "Try showing him the shogi piece we got.{PA:20}||The horse.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:286_1_2"
msgid "Wow!{PA:20} Dunno where ya got this,{PA:10} or HOW ya||got it but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:286_1_3"
msgid "Head on in.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:286_1_5"
msgid "Why don't ya just go home,{PA:10} kids?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:288_0_0"
msgid "(I should hurry to \"{CC:ffc8c8}Osakan Castle{CR:00}\".)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_0_1"
msgid "It's the end of the road,{PA:10} Esaki.{PA:20}||Give it up.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_0_2"
msgid "Rrragh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_0"
msgid "Ngh!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_1"
msgid "There's nowhere left to run.{PA:20} Now,{PA:10} talk!{PA:20}||Where is Sengoku?{PA:20} Where's Haruka?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_2"
msgid ".{PA:20}.{PA:20}.{PA:20}I can't say.{PA:20} Blabbin' to you'd be like||signin' my own death warrant.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_3"
msgid "How about I sign it for you right now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_4"
msgid "Th-That's inhuman!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_6"
msgid "H-Hold on,{PA:10} hold on.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_7"
msgid "Yes,{PA:10} hello?{PA:20} .{PA:20}.{PA:20}.{PA:20}Huh?{PA:20} What?!{PA:20}||Then what was I.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_8"
msgid "B-But isn't that.{PA:20}.{PA:20}.{PA:20}?{PA:20}||Y-Yes,{PA:10} sir.{PA:20} Understood,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_9"
msgid "Mr.{PA:20} Sengoku told me to bring ya to him.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_10"
msgid "If I go,{PA:10} I'm dead for sure.{PA:20}||Go by yer damn self.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_11"
msgid "Where is he?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_12"
msgid "\"{CC:ffc8c8}Osakan Castle{CR:00}\".{PA:20}||You'll see when ya get there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_13"
msgid "\"{CC:ffc8c8}Osakan Castle{CR:00}\"?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_14"
msgid "Uh.{PA:20}.{PA:20}.{PA:20} hey.{PA:20}||I know it's a little late fer this,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_15"
msgid "Think ya could protect me?{PA:20}||Only a matter of time 'til they come for me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_16"
msgid "Hmph,{PA:10} I'm afraid not.{PA:20}||Try praying to Billiken over there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:289_1_17"
msgid ".{PA:20}.{PA:20}.{PA:20}It's over.{PA:20} It's all over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:290_0_1"
msgid "Ya look like ya hate Kansai folk,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:290_0_2"
msgid "That's not true.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:290_0_3"
msgid "We may talk like drunk sailors,{PA:10} but we're||as good a bunch of folks as you'll find.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:291_0_1"
msgid "Keima?{PA:20} Like the Indian food?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:291_0_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Wait,{PA:10} that's keema.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:291_0_3"
msgid "Like the cancer treatment?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:291_0_4"
msgid "That's chemo!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_0_0"
msgid "What's up,{PA:10} Kazu?{PA:20}||Need help with somethin'?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_0_1"
msgid "Nothing in particular.{PA:20}||I was just passing by.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_0_2"
msgid "Aww,{PA:10} that's right sweet o' ya,{PA:10} handsome.{PA:20}||I'm always here for ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_0_3"
msgid "Heh,{PA:10} thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_0"
msgid "Hello there,{PA:10} Haruka!{PA:20} So good to see ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_1"
msgid "How have you been,{PA:10} Granny?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_2"
msgid "Oh,{PA:10} I'm right as rain,{PA:10} honey!{PA:20}||And feelin' better,{PA:10} now that you're around!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_4"
msgid "Here,{PA:10} angel.{PA:20} Take this.{PA:20}||Can't let ya go hungry,{PA:10} can I?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_5"
msgid "       You received a \"{CC:ffffc8}snack sampler{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_7"
msgid "Come on back any time,{PA:10} Haruka!{PA:20}||I'll give Kazu cab fare to get ya here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_1_8"
msgid "          You received 1,{PA:10}000 yen"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_0"
msgid "Heyyy,{PA:10} Kazu.{PA:20}||Been waitin' for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_1"
msgid "        Will you give her something?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_2"
msgid "I just thought I'd drop by and say hi.{PA:20}||Nothing much to report.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_3"
msgid "Yeah?{PA:20} Well,{PA:10} I'm still waitin' on that iron||umbrella here!{PA:20} Make it a fancy one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_5"
msgid "Don't go teasin' me like that,{PA:10} Kazu!{PA:20}||I want a trendy iron umbrella!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_6"
msgid "Thanks fer the thought,{PA:10} but I don't need it.{PA:20}||Use that yer damn self.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_7"
msgid "What,{PA:10} no umbrella?{PA:20} Tryin' to wait me out?{PA:20}||Think I'll just die 'n' let ya off the hook?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_8"
msgid "Well,{PA:10} it ain't gonna happen!{PA:20}||I ain't goin' anywhere,{PA:10} Kazu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_9"
msgid "    You gave her a \"{CC:ffffc8}trendy iron umbrella{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_11"
msgid "Yeah,{PA:10} that's the stuff!{PA:20} Lookit that.{PA:20}.{PA:20}.{PA:20}||Now that's style!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_12"
msgid "Bet it took some diggin' to find this,{PA:10} huh?{PA:20}||Can't just find it in any ol' shop.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_13"
msgid "Well,{PA:10} here.{PA:20} I'll trade ya this.{PA:20}||Read it good 'n' thorough,{PA:10} now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_14"
msgid " You received the \"{CC:ffffc8}Lotus Senki Encyclopedia{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_16"
msgid "(.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_17"
msgid "     You glanced through the contents.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_2_18"
msgid "  You learned the \"{CC:ffc8c8}Lotus Style Flare Fist{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_0"
msgid "Heyyy,{PA:10} Kazu.{PA:20}||I been waitin' for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_1"
msgid "        Will you give her something?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_2"
msgid "I just thought I'd drop by and say hi.{PA:20}||Nothing much to report.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_3"
msgid "Yeah?{PA:20} Well,{PA:10} I'm still waitin' on that shot||o' Yuya!{PA:20} Somethin' to keep the nights warm.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_5"
msgid "Don't go teasin' me like that,{PA:10} Kazu!{PA:20}||I want a mug shot o' Yuya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_6"
msgid "Thanks fer the thought,{PA:10} but I don't need it.{PA:20}||Use that yer damn self.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_7"
msgid "What,{PA:10} no photo?{PA:20} Tryin' to wait me out?{PA:20}||Think I'll just die 'n' let ya off the hook?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_8"
msgid "Well,{PA:10} it ain't gonna happen!{PA:20}||I ain't goin' anywhere,{PA:10} Kazu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_9"
msgid "    You gave her \"{CC:ffffc8}Yuya's publicity photo{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_11"
msgid "Yeah,{PA:10} that's the stuff!{PA:20} Lookit that.{PA:20}.{PA:20}.{PA:20}||I could spend hours lookin' at his mug!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_12"
msgid "What a man.{PA:20}.{PA:20}.{PA:20} What!{PA:20} A!{PA:20} Man!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_13"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_14"
msgid "Bet it took some doin' to find this,{PA:10} huh?{PA:20}||They don't just hand these out,{PA:10} ya know.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_15"
msgid "Well,{PA:10} here.{PA:20} I'll trade ya this.{PA:20}||Read it good 'n' thorough,{PA:10} now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_16"
msgid " You received the \"{CC:ffffc8}Lotus Nanki Encyclopedia{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_18"
msgid "(.{PA:20}.{PA:20}.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_19"
msgid "     You glanced through the contents.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_3_20"
msgid "  You learned the \"{CC:ffc8c8}Lotus Style Stone Body{CR:00}\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_0"
msgid "Heyyy,{PA:10} Kazu.{PA:20}||Who's the little angel?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_1"
msgid "She's.{PA:20}.{PA:20}.{PA:20} More or less my daughter,{PA:10} really.{PA:20}||She lives with me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_2"
msgid "My name is Haruka Sawamura.{PA:20} It's very nice||to meet you,{PA:10} Granny!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_3"
msgid "My,{PA:10} my!{PA:20} Cute as a button,{PA:10} sharp as a tack!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_4"
msgid "Kazu,{PA:10} I don't know what to say!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_5"
msgid ".{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_6"
msgid "Ya done granted my wish fer a grandkid!{PA:20}||You're so good to me,{PA:10} Kazu.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_7"
msgid "Huh?{PA:20} We were just in the neighborhood.{PA:20}||I didn't mean for it to be a big deal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_8"
msgid "Aww,{PA:10} that don't matter.{PA:20} Either way,{PA:10} I'm||feelin' high as a cloud,{PA:10} handsome!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_9"
msgid "Here,{PA:10} lemme give ya this.{PA:20} Just promise to||bring Haruka here back for a visit sometime!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0354.ARC/TALK_ST_KAB0354.BIN::line:293_4_10"
