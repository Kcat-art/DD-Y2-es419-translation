msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::name:0"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::name:1"
msgid "Date"
msgstr "Date"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::name:2"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::name:3"
msgid "Kaoru"
msgstr "Kaoru"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::name:4"
msgid "Haruka"
msgstr "Haruka"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::name:5"
msgid "Il Yu-Jin"
msgstr "I Ru-jeon"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_0_0"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_1_1"
msgid "How are things on your end?{PA:20}"
msgstr "¿Cómo van las cosas por ahí?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_2_5"
msgid "Yeah,{PA:10} I'll make it.{PA:20} I might not be a rock||like you,{PA:10} but I can still take a beating.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:0_2_7"
msgid "I've got it covered.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_0_0"
msgid "Tamiyo"
msgstr "Tamiyo"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_1_0"
msgid "This is Kiryu.{PA:20}"
msgstr "Habla Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_1_2"
msgid "Oh,{PA:10} hello.{PA:20}||How is she doing?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_1_4"
msgid "That's good.{PA:20}"
msgstr "Qué bien.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_1_6"
msgid "Just the bandages?{PA:20}||I'll pick some up on my way there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_2_0"
msgid "It's me.{PA:20}"
msgstr "Soy yo.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_2_2"
msgid "Calmed down,{PA:10} finally.{PA:20}||Medicine's set in,{PA:10} so she's fast asleep.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_2_4"
msgid "Anyhow,{PA:10} sorry to trouble ya,{PA:10} but think you||could pick up some spare bandages,{PA:10} sugar?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_2_5"
msgid "I'm out and I'd feel better having||some on hand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:2_2_7"
msgid "Thanks,{PA:10} sugar.{PA:20}||See ya soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:3_1_0"
msgid "          Get Kaoru to Aoi before||          she runs out of health.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:3_2_0"
msgid "(She's hurt worse than I thought.{PA:20}||I need to hurry!)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:3_3_0"
msgid "(She's bleeding even worse!)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:3_4_0"
msgid "Hey,{PA:10} stay with me!{PA:20}"
msgstr "¡Oy{PA:10}e, resiste!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:3_4_1"
msgid "Sayama!{PA:20}"
msgstr "¡Sayama!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:4_1_0"
msgid "   Head to the clinic at the west end of|| Taihei Blvd.{PA:20} without alerting the police.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:4_2_0"
msgid "His bleeding's gotten worse.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:4_2_1"
msgid "We need to stay low around the cops.{PA:20}||This is a lot of blood to have to explain.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:4_2_2"
msgid "Yeah,{PA:10} let's hurry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:4_3_0"
msgid "Kazuki's fading.{PA:20}||Can he make it?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:4_3_1"
msgid "Kazuki!{PA:20}||Hey,{PA:10} stay with me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:5_0_0"
msgid "Rgh.{PA:20}.{PA:20}.{PA:20} Not here.{PA:20} Not like this.{PA:20}.{PA:20}.{PA:20}"
msgstr "(No {PA:20}p{PA:20}u{PA:20}edo... res{PA:20}istir... más...{PA:20}){PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:6_0_0"
msgid "Masashi"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:6_1_1"
msgid "Okay,{PA:10} thanks.{PA:20}"
msgstr "Gra{PA:10}cias.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:6_2_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} sir!{PA:20}||I've got the totals for tonight!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:6_2_1"
msgid "Come to the club next time you're passing||by,{PA:10} sir.{PA:20} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:7_2_0"
msgid "What do you think the problem is?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:7_2_1"
msgid "We should get a move on to Purgatory.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:7_3_0"
msgid "I'm still impressed you took the Go-Ryu Clan||on single-handedly and lived,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:7_3_1"
msgid "You're one hell of a man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_2_0"
msgid "We need info on the Amano Building.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_2_1"
msgid "Let's go see Tamura outside the theater.{PA:20}||He should know where it is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_3_0"
msgid "Daigo Dojima is waiting,{PA:10} isn't he?{PA:20}"
msgstr "Daigo Dojima está esperando, ¿{PA:10}no es cierto?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_3_1"
msgid "Let's go find that leader kid.{PA:20} Get the key||from him and get inside already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_4_0"
msgid "This should get us in.{PA:20}"
msgstr "Esto debería servirnos para entrar.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_4_1"
msgid "Let's hurry to the Amano Building and get||Daigo back already!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_5_0"
msgid "Date's waiting,{PA:10} isn't he?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_5_1"
msgid "We've got a name to go on now.{PA:20}||We should regroup and talk it over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_6_0"
msgid "I can't believe things turned out like this.{PA:20}||I was the one who shot him.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_6_1"
msgid "This Kage guy's up in the Millennium Tower,{PA:10}||right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_6_2"
msgid "Let's go see him and clear Date's name.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_7_0"
msgid "Who could those guys in the transformer||room be?{PA:20} I wonder.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_8_0"
msgid "Shangri-La,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_8_1"
msgid "Shouldn't we get a move on?{PA:20}"
msgstr "Tenemos que darnos prisa.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_9_0"
msgid "I'm not sure I really get what's happening.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_9_1"
msgid "Still,{PA:10} for now we need to find Sengoku's men||and stop them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_10_0"
msgid "Hey,{PA:10} wrong way!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_11_0"
msgid "Hold it!{PA:20}"
msgstr "¡Detente!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_12_0"
msgid "Let's head to \"{CC:ffc8c8}Tsutenkaku Tower{CR:00}\".{PA:20}||We'll see what we can see.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_12_1"
msgid "Let's look for the binoculars with the||yellow sticker on them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_13_0"
msgid "That memo is our only lead right now.{PA:20}||Let's give that number a call.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_14_0"
msgid "The number of stairs in Tsutenkaku Tower?{PA:20}||Hmm,{PA:10} maybe we could ask somebody.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_15_0"
msgid "\"Black bear,{PA:10} grilled guts,{PA:10} three times\"?{PA:20}||What's that supposed to mean?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_15_1"
msgid "Guts?{PA:20} Bears?{PA:20} Three times?{PA:20}||I'm totally lost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_15_2"
msgid "Well,{PA:10} if it's grilled,{PA:10} maybe it has||something to do with food.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_16_0"
msgid "Guts?{PA:20} Bears?{PA:20} Three times?{PA:20}||I'm totally lost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_16_1"
msgid "Well,{PA:10} if it's grilled,{PA:10} maybe it has||something to do with food.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_17_0"
msgid "We found the shogi piece we need to get in.{PA:20}||Let's go check out Keima.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:8_18_0"
msgid "We don't have much time.{PA:20} Let's get going to||the Millennium Tower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:9_2_0"
msgid "Hey!{PA:20} That way's too crowded.{PA:20}||Let's take another route.{PA:20}"
msgstr "Oye,{PA:20} hay mucha gente por allá. {PA:20}Mejor|| vayamos por otro lado.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:9_3_0"
msgid "There are still cops all over the place.{PA:20}||Let's head to Bantam and lay low for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:9_4_0"
msgid "Let's take a cab to police headquarters.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:9_4_1"
msgid "Still,{PA:10} Archive Room 13?{PA:20}||Why would Bessho be there,{PA:10} of all places?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_2_0"
msgid "Once you're ready to go,{PA:10} we can head back||to Kaoru's place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_3_0"
msgid "It's been a while since we got to go out and||spend time together!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_0"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} Something smells here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_1"
msgid "Hm?{PA:20} Smells like what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_2"
msgid "Like a mystery!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_3"
msgid "Don't be silly,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_4"
msgid "C'mon,{PA:10} Uncle Kaz!{PA:20}||Let's go to Vidal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_5"
msgid "We might figure something out there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_4_6"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20}"
msgstr "A {PA:20}su{PA:20}s {PA:20}órdenes...{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_5_0"
msgid "So now we know the players!{PA:20}||Her client,{PA:10} Katsumi,{PA:10} and Hikaru the host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_5_1"
msgid "Right.{PA:20}||Let's go see what Yuya knows.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_6_0"
msgid "Let's hurry,{PA:10} Haruka!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_6_1"
msgid "Okay!{PA:20}"
msgstr "¡Está bien!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_7_1"
msgid "See,{PA:10} Uncle Kaz?{PA:20} I told you it smelled like||a mystery!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_7_2"
msgid "Your intuition is scary sometimes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_7_3"
msgid "Maybe I'll grow up to be a private eye.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_7_4"
msgid "I'm sure you'd be an ace detective,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_7_5"
msgid "Really?{PA:20}||All right!{PA:20} Now to find my next big case.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:10_7_6"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:11_1_0"
msgid "I want go to where music playing,{PA:10} people||dancing,{PA:10} okay?{PA:20} Thanks,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:11_1_1"
msgid "(Is this even worth it?)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:11_1_2"
msgid "All right,{PA:10} follow me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:11_1_3"
msgid "Thanks,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:11_1_4"
msgid "You're on your own from here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0402.ARC/TALK_ST_KAB0402.BIN::line:11_1_5"
