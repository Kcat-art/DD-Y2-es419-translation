msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:315_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry,{PA:10} but I||don't follow.{PA:20}"
