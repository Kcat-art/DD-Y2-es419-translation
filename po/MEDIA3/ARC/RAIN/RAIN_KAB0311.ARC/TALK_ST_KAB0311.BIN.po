msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:317_0_0"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} Buy an umbrella?{PA:20}||Dry 'n' broke?{PA:20} Hm.{PA:20}.{PA:20}.{PA:20}"
