msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:325_0_0"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} Okonomiyaki last||night.{PA:20} So tonight.{PA:20}.{PA:20}.{PA:20}"
