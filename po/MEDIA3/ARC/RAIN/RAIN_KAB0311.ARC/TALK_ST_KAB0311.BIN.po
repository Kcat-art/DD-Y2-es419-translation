msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:312_2_8"
msgid "You're takin' me into this place without||any money?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:312_2_9"
msgid ".{PA:20}.{PA:20}.{PA:20}.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:312_2_10"
msgid "It don't work that way,{PA:10} Kazuma.{PA:20} Ya have||to see to that BEFORE comin' here,{PA:10} yeah?{PA:20}"
