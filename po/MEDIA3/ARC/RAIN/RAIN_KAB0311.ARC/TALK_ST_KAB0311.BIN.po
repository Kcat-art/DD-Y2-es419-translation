msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:316_0_0"
msgid "Then,{PA:10} ya know,{PA:10} just||POW.{PA:20}.{PA:20}.{PA:20}"
