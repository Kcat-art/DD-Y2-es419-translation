msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:312_1_3"
msgid "I'm about done for the night,{PA:10} I think.{PA:20}||See ya at the club before too long?{PA:20}"
