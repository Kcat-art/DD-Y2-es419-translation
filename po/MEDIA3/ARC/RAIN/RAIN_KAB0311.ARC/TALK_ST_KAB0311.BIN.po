msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0311.ARC/TALK_ST_KAB0311.BIN::line:319_0_0"
msgid "Must be in a rush.{PA:20}||Got no umbrella.{PA:20}.{PA:20}.{PA:20}"
