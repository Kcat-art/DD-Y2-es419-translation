msgid "He hung up on me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_0_0"
msgid "Daigo"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:28_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
