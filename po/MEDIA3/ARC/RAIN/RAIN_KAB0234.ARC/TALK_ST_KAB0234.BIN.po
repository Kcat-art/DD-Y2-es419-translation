msgid "Are you Jongka?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_2"
msgid "Yeah,{PA:10} I used to be.{PA:20}||Nobody calls me that now,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_3"
msgid "Gave up playin',{PA:10} see?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_4"
msgid "Why'd you stop?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_5"
msgid "Wouldn't have,{PA:10} if those dirty yakuza hadn't||cheated me!{PA:20} Bastards forced me into debt.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_6"
msgid "I was doing okay running away from 'em.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_7"
msgid "But.{PA:20}.{PA:20}.{PA:20} Well,{PA:10} they got my baby girl.{PA:20}||Bastards took my little Yukiko.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_8"
msgid "Now they tell me if I ever wanna see||her again,{PA:10} I need to get 'em 5 million yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_9"
msgid "Hey,{PA:10} buddy!{PA:20} You're a decent guy!{PA:20}||Would ya lend me 5 million?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Ain't somethin' you can ask a guy.{PA:20}||I mean,{PA:10} who's got that kinda cash?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_11"
msgid "Do you have an invitation to Reach Towers,{PA:10}||the mahjong parlor?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_12"
msgid "To Reach Towers?{PA:20} What invitation?{PA:20}||{MS:0}Oh,{PA:10} a cherry tile,{PA:10} ya mean?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_13"
msgid "Yeah,{PA:10} sometimes they won't let ya in if ya||don't have one.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_14"
msgid "Hey,{PA:10} how's this?{PA:20} You get me back my baby||girl,{PA:10} Yukiko,{PA:10} and I give you this tile.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_15"
msgid "Ya look like the rough 'n' tumble sort.{PA:20}||Think you could help a guy out?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_16"
msgid "All right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_17"
msgid "No shit?!{PA:20} Oh,{PA:10} that's great!{PA:20} There's lockers||just across Bishamon Bridge,{PA:10} yeah?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_5_18"
