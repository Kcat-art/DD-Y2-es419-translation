msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:299_0_3"
msgid "Well,{PA:10} I love winnin' at it.{PA:20} Hate losin' so||much,{PA:10} I pumped in 300 grand today alone.{PA:20}"
