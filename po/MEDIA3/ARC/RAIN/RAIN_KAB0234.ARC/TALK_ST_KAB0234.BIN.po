msgid "Feh.{PA:20}||Well,{PA:10} excuse me fer even askin',{PA:10} then.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:289_2_0"
