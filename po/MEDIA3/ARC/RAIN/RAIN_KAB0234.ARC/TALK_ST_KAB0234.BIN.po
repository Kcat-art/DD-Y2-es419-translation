msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:20_0_8"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:20_0_9"
msgid "(I've got nobody to call.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0234.ARC/TALK_ST_KAB0234.BIN::line:20_0_11"
msgid "出たらまずいテキスト"
msgstr ""

