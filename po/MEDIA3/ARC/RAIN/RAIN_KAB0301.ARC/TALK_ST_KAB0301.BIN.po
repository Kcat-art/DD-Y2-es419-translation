msgid "He hung up on me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0301.ARC/TALK_ST_KAB0301.BIN::line:28_0_0"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0301.ARC/TALK_ST_KAB0301.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr "¿Cómo van las cosas por ahí?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0301.ARC/TALK_ST_KAB0301.BIN::line:28_1_3"
