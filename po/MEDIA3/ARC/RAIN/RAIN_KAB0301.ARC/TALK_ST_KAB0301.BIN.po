msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0301.ARC/TALK_ST_KAB0301.BIN::line:20_0_8"
msgid "出たらまずいテキスト"
msgstr ""

