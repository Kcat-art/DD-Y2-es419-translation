msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_20_0"
msgid "I'm gonna beat the shit outta you til||yer own mom don't even recognize ya!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_21_0"
msgid "Huh!?{PA:20}"
msgstr "¡¿Eh?!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_22_0"
msgid "Uh.{PA:20}.{PA:20}.{PA:20} I.{PA:20}.{PA:20}.{PA:20} I'm sorry!{PA:20}||I give up!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_22_1"
msgid "Just take it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_22_2"
msgid "Received \"10❟000 yen\""
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_23_0"
msgid "I.{PA:20}.{PA:20}.{PA:20} I'm sorry!{PA:20}||Just go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_24_0"
msgid "Hiya,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_25_0"
msgid "You're that Kiryu dude from Tokyo,{PA:10} ain't||ya?{PA:20} Well,{PA:10} you're dead now!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_26_0"
msgid "Hey,{PA:10} you there!{PA:20}"
msgstr "¡O{PA:10}ye, tú!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_27_0"
msgid "Uh.{PA:20}.{PA:20}.{PA:20} I.{PA:20}.{PA:20}.{PA:20} I'm sorry!{PA:20}||This is all I have,{PA:10} but it's yours!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_27_1"
msgid "Received \"15❟000 yen\""
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_28_0"
msgid "I'll never try this again,{PA:10} I swear.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_29_0"
msgid "Hello!{PA:20}"
msgstr "¿Hola?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_30_0"
msgid "Hey!{PA:20} Yer that Kiryu guy from the Tojo Clan!{PA:20}||Lemme welcome you to Kansai!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_31_0"
msgid "What's this,{PA:10} then?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_32_0"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20} I just sorta lost control there.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_32_1"
msgid "Received \"Modified Lighter\""
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:283_33_0"
msgid "Damn.{PA:20}.{PA:20}.{PA:20}"
msgstr "Maldición{PA:20}.{PA:20}..{PA:20}"

