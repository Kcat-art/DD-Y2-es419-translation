msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_6_2"
msgid "Guy named Kinoshita's waitin' for ya at||\"{CC:ffc8c8}White Snake Ramen{CR:00}\".{PA:20} Talk to him.{PA:20}"
