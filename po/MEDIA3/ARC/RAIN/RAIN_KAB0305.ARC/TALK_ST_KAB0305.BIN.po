msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_1"
msgid "Hey,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_2"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_3"
msgid "You headed straight for the hotel?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_4"
msgid "I haven't given it any thought.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_5"
msgid "Yeah,{PA:10} well,{PA:10} I told you I've got nothing||but bad memories here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_6"
msgid "Sorry,{PA:10} but I'm not really in the mood to||hit the town tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_7"
msgid "I think I'll take a walk then.{PA:20}||You get some rest.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_8"
msgid "Way ahead of you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_9"
msgid "Be careful.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:295_0_10"
msgid "You too.{PA:20} Watch your back.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_0"
msgid "Hell of a night,{PA:10} huh?{PA:20}"
msgstr "Vaya noche, {PA:10}¿eh?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_1"
msgid "In a lot of ways.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_2"
msgid "Huh?{PA:20} What else happened?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_3"
msgid "Oh,{PA:10} just had a little run-in last night.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_4"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_5"
msgid "It's nothing.{PA:20}"
msgstr "Solo es un rasguño...{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_6"
msgid "You should call Yayoi later and make sure||that Kashiwagi's all right.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_7"
msgid "Yeah,{PA:10} I will.{PA:20}"
msgstr "Eso{PA:10} haré.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_8"
msgid "Come talk to me when you're ready to go.{PA:20}||This is the Omi Alliance.{PA:20} Be prepared.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_0_9"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_0"
msgid "All ready to go?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_1"
msgid "Just give me a minute.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_2"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_3"
msgid "We might not make it back.{PA:20}||Take your time getting ready.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_4"
msgid "Yeah,{PA:10} I'm all set.{PA:20}"
msgstr "Sí, {PA:10}ya lo estoy.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_5"
msgid "If you're sure.{PA:20}||There's no turning back now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_6"
msgid "I know.{PA:20}"
msgstr "Lo sé.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:296_1_7"
msgid "Then let's go.{PA:20}||Hop in the car.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_0"
msgid "Hey,{PA:10} Mr.{PA:20} Kiryu!{PA:20} What's got ya all worked up?{PA:20}||Something happen?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_1"
msgid "Do you know a bar called Aoi?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_2"
msgid "Sure.{PA:20}||{MS:0}Ya head from here to Shofukucho,{PA:10} yeah?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_3"
msgid "There's an info center down there called||Night Life Dojo.{PA:20} With me so far?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_4"
msgid "Turn at the T there and you're at Aoi.{PA:20}||Can't miss it,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_5"
msgid "Okay,{PA:10} thanks.{PA:20}"
msgstr "Gra{PA:10}cias.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_0_6"
msgid "No need to run.{PA:20} Bar ain't gonna run off!{PA:20}"
msgstr "¿Por qué tanto apuro? El b{PA:20}ar no tiene patas; ¡no se irá a||ningún lado!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_1_0"
msgid "I'm looking for a bar called Aoi.{PA:20}"
msgstr "Estoy buscando un bar llamado Aoi.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_1_1"
msgid "Sure thing,{PA:10} buddy.{PA:20}||{MS:0}Head down to Shofukucho,{PA:10} yeah?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_1_2"
msgid "Turn at the T there,{PA:10} and you're at Aoi.{PA:20}||Easy as pie.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_0"
msgid "Ahh,{PA:10} Mr.{PA:20} Kiryu!{PA:20} How's it hangin'?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_1"
msgid "Is there anything you can tell me about||Esaki,{PA:10} the information dealer?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_2"
msgid "Esaki?{PA:20} Can't tell you anything good.{PA:20}||Man's a rat,{PA:10} far as I've heard.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_3"
msgid "Oh,{PA:10} wait.{PA:20} Esaki looked me up once.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_4"
msgid "Askin' about \"almonds\".{PA:20}||And I doubt he was hungry for nuts.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_5"
msgid "Dunno what \"almonds\" are.{PA:20} Doubt I want to.{PA:20}||Rest assured,{PA:10} it ain't pretty.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_6"
msgid "Ooh!{PA:20} I just remembered.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_7"
msgid "Bartender at that place on Sotenbori was||sayin' something about almonds before.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_8"
msgid "Somethin' about 100 grand,{PA:10} 200 grand a pop.{PA:20}||Can't rightly remember.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_9"
msgid "Why not go ask that bartender,{PA:10} buddy?{PA:20}||Probably the quickest way to go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_2_10"
msgid "Okay,{PA:10} thanks.{PA:20}"
msgstr "Gra{PA:10}cias.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_3_0"
msgid "Seems Esaki wanted to know about the \"price||of almonds\".{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_3_1"
msgid "Well,{PA:10} that bartender on Sotenbori was||talkin' about almonds before.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_3_2"
msgid "Why not go ask him,{PA:10} buddy?{PA:20}||Probably the quickest way to go.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_0"
msgid "What's the trouble,{PA:10} buddy?{PA:20}||You're lookin' awful pale there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_1"
msgid "They've taken Haruka.{PA:20}"
msgstr "Secuestraron a Haruka.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_2"
msgid "What?{PA:20} Taken?{PA:20} Like kidnapped,{PA:10} ya mean?!{PA:20}||Yer little princess?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_3"
msgid "Do you know where Sengoku is now?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_4"
msgid "Sengoku?!{PA:20} It gets worse!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_5"
msgid "All right,{PA:10} Mr.{PA:20} Kiryu.{PA:20} Lemme dig around,{PA:10} see||what all I can find for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_4_6"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_5_0"
msgid "This ain't good,{PA:10} man.{PA:20}||I'll dig around,{PA:10} see what I can find for ya.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:297_6_1"
msgid "All set for ya,{PA:10} Mr.{PA:20} Kiryu.{PA:20}"
