msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_1"
msgid "Um.{PA:20}.{PA:20}.{PA:20} Is something wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_3"
msgid "Yeah,{PA:10} I remember.{PA:20}||Has something happened to him?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_5"
msgid "Well,{PA:10} that's good.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_7"
msgid "Ah.{PA:20}"
msgstr "Ah...{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_9"
msgid "A what?!{PA:20}"
msgstr "¿Una qué?...{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_12"
msgid "I think building a park on one person's||savings is an awfully big dream.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_13"
msgid "I'll see what I can find.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_17"
msgid "Okay,{PA:10} I'll see what I can find.{PA:20}"
msgstr "Entie{PA:10}ndo. Veré qué puedo averiguar{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_18"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_0_21"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_0"
msgid "Hello,{PA:10} Mr.{PA:20} Kiryu?{PA:20}||This is Ms.{PA:20} Suenaga,{PA:10} from Sunflower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_1"
msgid "Mr.{PA:20} Kiryu,{PA:10} I'll never forget all your help.{PA:20}||No matter what happens.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_3"
msgid "Wrong?{PA:20} Oh,{PA:10} no.{PA:20}.{PA:20}.{PA:20} I mentioned the headmaster||was resting up at home before,{PA:10} didn't I?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_5"
msgid "No,{PA:10} no!{PA:20} He's feeling worlds better!{PA:20}||Well enough to come back to work,{PA:10} actually.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_7"
msgid "Yes,{PA:10} it's wonderful.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_8"
msgid "But it does mean my time with the children||is coming to an end.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_10"
msgid "It was only six months,{PA:10} but saying goodbye||to them is so hard.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_11"
msgid "So I've decided to make a gift to them.{PA:20}||I'd like to give them a park!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_13"
msgid "A park!{PA:20}||Something that will last.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_14"
msgid "Still,{PA:10} it takes more than pocket change and||good intentions to get a park built.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_15"
msgid "Mr.{PA:20} Kiryu,{PA:10} could I ask you to help me find||an affordable contractor?{PA:20} For the kids!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_18"
msgid "I realize it's a stretch,{PA:10} I really do!{PA:20}||But still,{PA:10} I want to do this for them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_19"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_20"
msgid "I'll keep trying on my end as well!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_23"
msgid "Oh,{PA:10} thank you!{PA:20} With you on my side,{PA:10} I feel||like I can really make this happen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:19_1_24"
msgid "私も、{PA:10}もう少し色々あたってみます！{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_0_6"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_0_7"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_0_8"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_0_9"
msgid "(I've got nobody to call.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_0_11"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_0_13"
msgid "出たらまずいテキスト"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_3"
msgid "Hello.{PA:20} Imitation Renovating here.{PA:20}||What can I do you for?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_4"
msgid "It's Kiryu.{PA:20}"
msgstr "Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_5"
msgid "M-Mr.{PA:20} Kiryu!{PA:20} Boss!{PA:20} Yes,{PA:10} sir!{PA:20}||H-How can we help you today?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_6"
msgid "The folks at Sunflower want to build a kids'||park,{PA:10} but they're low on money.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_7"
msgid "Can you do something for them?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_8"
msgid "Yes,{PA:10} sir!{PA:20} Of course!{PA:20} Leave it to us,{PA:10} and||we'll whip something up for cheap!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_1_9"
msgid "Thanks.{PA:20}||That sounds great.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_4"
msgid "Hello?{PA:20}"
msgstr "¿Hola?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_6"
msgid "I'd like to ask about Keima.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_7"
msgid "How many stairs are in Tsutenkaku Tower?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_8"
msgid "The number of stairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_12"
msgid ".{PA:20}.{PA:20}.{PA:20}||Black bear,{PA:10} grilled guts,{PA:10} three times.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_13"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_15"
msgid "*Click*"
msgstr "Bip."

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:20_2_16"
msgid "He hung up on me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_0_0"
msgid "Daigo"
msgstr "Daigo"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr "¿Cómo van las cosas por ahí?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_2_0"
msgid "It's me.{PA:20} Daigo.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_2_2"
msgid "No problems for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_2_3"
msgid "I've got Chairman Goda with me.{PA:20}||We're in a car,{PA:10} headed for Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_2_5"
msgid "Yeah,{PA:10} I'll make it.{PA:20} I might not be a rock||like you,{PA:10} but I can still take a beating.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:28_2_7"
msgid "I've got it covered.{PA:20}||Later.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_0_0"
msgid "Tamiyo"
msgstr "Tamiyo"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_1_0"
msgid "This is Kiryu.{PA:20}"
msgstr "Habla Kiryu.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_1_2"
msgid "Oh,{PA:10} hello.{PA:20}||How is she doing?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_1_4"
msgid "That's good.{PA:20}"
msgstr "Qué bien.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_1_6"
msgid "Just the bandages?{PA:20}||I'll pick some up on my way there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_2_0"
msgid "It's me.{PA:20}"
msgstr "Soy yo.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_2_2"
msgid "Calmed down,{PA:10} finally.{PA:20}||Medicine's set in,{PA:10} so she's fast asleep.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_2_4"
msgid "Anyhow,{PA:10} sorry to trouble ya,{PA:10} but think you||could pick up some spare bandages,{PA:10} sugar?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_2_5"
msgid "I'm out and I'd feel better having||some on hand.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:30_2_7"
msgid "Thanks,{PA:10} sugar.{PA:20}||See ya soon.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:31_1_0"
msgid "          Get Kaoru to Aoi before||          she runs out of health.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:31_2_0"
msgid "(She's hurt worse than I thought.{PA:20}||I need to hurry!)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:31_3_0"
msgid "(She's bleeding even worse!)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:31_4_0"
msgid "Hey,{PA:10} stay with me!{PA:20}"
msgstr "¡Oy{PA:10}e, resiste!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:31_4_1"
msgid "Sayama!{PA:20}"
msgstr "¡Sayama!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:32_1_0"
msgid "   Head to the clinic at the west end of|| Taihei Blvd.{PA:20} without alerting the police.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:32_2_0"
msgid "His bleeding's gotten worse.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:32_2_1"
msgid "We need to stay low around the cops.{PA:20}||This is a lot of blood to have to explain.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:32_2_2"
msgid "Yeah,{PA:10} let's hurry.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:32_3_0"
msgid "Kazuki's fading.{PA:20}||Can he make it?!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:32_3_1"
msgid "Kazuki!{PA:20}||Hey,{PA:10} stay with me!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:33_1_0"
msgid "(The blood's not stopping!{PA:20} .{PA:20}.{PA:20}.{PA:20}Poison?{PA:20}||Either way,{PA:10} I've got to hurry to Aoi.)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:33_2_0"
msgid "Rgh.{PA:20}.{PA:20}.{PA:20} Not here.{PA:20} Not like this.{PA:20}.{PA:20}.{PA:20}"
msgstr "(No {PA:20}p{PA:20}u{PA:20}edo... res{PA:20}istir... más...{PA:20}){PA:20}.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:34_0_0"
msgid "Masashi"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:34_1_1"
msgid "Okay,{PA:10} thanks.{PA:20}"
msgstr "Gra{PA:10}cias.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:34_2_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} sir!{PA:20}||I've got the totals for tonight!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:34_2_1"
msgid "Come to the club next time you're passing||by,{PA:10} sir.{PA:20} I'll be here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:35_2_0"
msgid "What do you think the problem is?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:35_2_1"
msgid "We should get a move on to Purgatory.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:35_3_0"
msgid "I'm still impressed you took the Go-Ryu Clan||on single-handedly and lived,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:35_3_1"
msgid "You're one hell of a man.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_2_0"
msgid "We need info on the Amano Building.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_2_1"
msgid "Let's go see Tamura outside the theater.{PA:20}||He should know where it is.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_3_0"
msgid "Daigo Dojima is waiting,{PA:10} isn't he?{PA:20}"
msgstr "Daigo Dojima está esperando, ¿{PA:10}no es cierto?{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_3_1"
msgid "Let's go find that leader kid.{PA:20} Get the key||from him and get inside already.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_4_0"
msgid "This should get us in.{PA:20}"
msgstr "Esto debería servirnos para entrar.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_4_1"
msgid "Let's hurry to the Amano Building and get||Daigo back already!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_5_0"
msgid "Date's waiting,{PA:10} isn't he?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_5_1"
msgid "We've got a name to go on now.{PA:20}||We should regroup and talk it over.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_6_0"
msgid "I can't believe things turned out like this.{PA:20}||I was the one who shot him.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_6_1"
msgid "This Kage guy's up in the Millennium Tower,{PA:10}||right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_6_2"
msgid "Let's go see him and clear Date's name.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_7_0"
msgid "Who could those guys in the transformer||room be?{PA:20} I wonder.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_8_0"
msgid "Shangri-La,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_8_1"
msgid "Shouldn't we get a move on?{PA:20}"
msgstr "Tenemos que darnos prisa.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_9_0"
msgid "I'm not sure I really get what's happening.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_9_1"
msgid "Still,{PA:10} for now we need to find Sengoku's men||and stop them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_10_0"
msgid "The chief said that Murai should be in||the Shinseicho district.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_10_1"
msgid "Let's go hear what he has to say.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_10_2"
msgid "Are you sure about this?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_10_3"
msgid "Don't worry about me.{PA:20}"
msgstr "No tienes de qué preocuparte.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_10_4"
msgid "I think I can handle anything that comes||at me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_10_5"
msgid "Now let's hurry.{PA:20}||Follow me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_11_0"
msgid "Hey,{PA:10} wrong way!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_12_0"
msgid "Hold it!{PA:20}"
msgstr "¡Detente!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_13_0"
msgid "Let's head to \"{CC:ffc8c8}Tsutenkaku Tower{CR:00}\".{PA:20}||We'll see what we can see.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_13_1"
msgid "Let's look for the binoculars with the||yellow sticker on them.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_14_0"
msgid "That memo is our only lead right now.{PA:20}||Let's give that number a call.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_15_0"
msgid "The number of stairs in Tsutenkaku Tower?{PA:20}||Hmm,{PA:10} maybe we could ask somebody.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_16_0"
msgid "\"Black bear,{PA:10} grilled guts,{PA:10} three times\"?{PA:20}||What's that supposed to mean?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_16_1"
msgid "Guts?{PA:20} Bears?{PA:20} Three times?{PA:20}||I'm totally lost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_16_2"
msgid "Well,{PA:10} if it's grilled,{PA:10} maybe it has||something to do with food.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_17_0"
msgid "Guts?{PA:20} Bears?{PA:20} Three times?{PA:20}||I'm totally lost.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_17_1"
msgid "Well,{PA:10} if it's grilled,{PA:10} maybe it has||something to do with food.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_18_0"
msgid "We found the shogi piece we need to get in.{PA:20}||Let's go check out Keima.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:36_19_0"
msgid "We don't have much time.{PA:20} Let's get going to||the Millennium Tower.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:37_2_0"
msgid "Hey!{PA:20} That way's too crowded.{PA:20}||Let's take another route.{PA:20}"
msgstr "Oye,{PA:20} hay mucha gente por allá. {PA:20}Mejor|| vayamos por otro lado.{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:37_3_0"
msgid "There are still cops all over the place.{PA:20}||Let's head to Bantam and lay low for now.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:37_4_0"
msgid "Let's take a cab to police headquarters.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:37_4_1"
msgid "Still,{PA:10} Archive Room 13?{PA:20}||Why would Bessho be there,{PA:10} of all places?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_2_0"
msgid "La la la laaa♪"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_2_1"
msgid "Hey,{PA:10} Uncle Kaz,{PA:10} do you hear singing?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_2_2"
msgid "Yeah,{PA:10} it's coming from the riverside.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_2_3"
msgid "C'mon,{PA:10} let's go check it out!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_3_0"
msgid "Once you're ready to go,{PA:10} we can head back||to Kaoru's place.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_4_0"
msgid "It's been a while since we got to go out and||spend time together!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_0"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} Something smells here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_1"
msgid "Hm?{PA:20} Smells like what?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_2"
msgid "Like a mystery!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_3"
msgid "Don't be silly,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_4"
msgid "C'mon,{PA:10} Uncle Kaz!{PA:20}||Let's go to Vidal.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_5"
msgid "We might figure something out there.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_5_6"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20}"
msgstr "A {PA:20}su{PA:20}s {PA:20}órdenes...{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_6_0"
msgid "So now we know the players!{PA:20}||Her client,{PA:10} Katsumi,{PA:10} and Hikaru the host.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_6_1"
msgid "Right.{PA:20}||Let's go see what Yuya knows.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_7_0"
msgid "Let's hurry,{PA:10} Haruka!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_7_1"
msgid "Okay!{PA:20}"
msgstr "¡Está bien!{PA:20}"

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_8_1"
msgid "See,{PA:10} Uncle Kaz?{PA:20} I told you it smelled like||a mystery!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_8_2"
msgid "Your intuition is scary sometimes.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_8_3"
msgid "Maybe I'll grow up to be a private eye.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_8_4"
msgid "I'm sure you'd be an ace detective,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_8_5"
msgid "Really?{PA:20}||All right!{PA:20} Now to find my next big case.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:38_8_6"
msgid "Received 500 experience points.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_0"
msgid "I want go to where music playing,{PA:10} people||dancing,{PA:10} okay?{PA:20} Thanks,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_1"
msgid "(Is this even worth it?)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_2"
msgid "All right,{PA:10} follow me.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_3"
msgid "Thanks,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_4"
msgid "You're on your own from here.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_5"
msgid "What?{PA:20} Why?!{PA:20}||I come all the way to Kamurocho!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_6"
msgid "Please keep showing me around,{PA:10} Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_7"
msgid "(Is this even worth it?)"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0305.ARC/TALK_ST_KAB0305.BIN::line:39_1_8"
