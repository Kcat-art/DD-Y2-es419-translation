msgid "Unknown Man"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:3"
msgid "Date"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:4"
msgid "Daigo"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:5"
msgid "Kaoru"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:6"
msgid "Haruka"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:7"
msgid "Il Yu-Jin"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:8"
msgid "Police Officer"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:9"
msgid "Sengoku Member"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::name:10"
