msgid "⋯⋯どうした？{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_0_3"
msgid "Five million yen!?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_0_5"
msgid "Wait,{PA:10} he made repairs on things you didn't||ask him to?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_0_7"
msgid "You just tell him to give me a call.{PA:20}||I'll straighten him out.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_0"
msgid "Hello,{PA:10} Mr.{PA:20} Kiryu?{PA:20}||Terrible news,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_2"
msgid "Well,{PA:10} sir,{PA:10} we just got the bill for those||roof repairs from before.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_3"
msgid "Mr.{PA:20} Kiryu,{PA:10} it's for 5,{PA:10}000,{PA:10}000 yen!{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_5"
msgid "His quote before was only 250,{PA:10}000 yen!{PA:20}||I asked about the difference,{PA:10} of course.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_6"
msgid "But he said it was for repairs on all the||other spots that were falling apart.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_8"
msgid "Apparently so,{PA:10} yes.{PA:20} The foundation,{PA:10} for one.{PA:20}||At least,{PA:10} so he says.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_9"
msgid "It took a miracle to get that first 250,{PA:10}000.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:15_1_11"
msgid "S-Sir?{PA:20} .{PA:20}.{PA:20}.{PA:20}I will.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_0_0"
msgid "Man"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_1_1"
msgid "She'll pay for the work she contracted.{PA:20}||Your quote was for 250,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_1_3"
msgid "Without their knowledge or permission.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_0"
msgid "Hello?{PA:20} I'm with Imitation Renovating.{PA:20}||The Suenaga lady told me to call you.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_1"
msgid "You the guy who's gonna pay that 5 mil||she owes for all those repairs?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_3"
msgid "Ha ha!{PA:20} We been gettin' a lot of||you people lately.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_4"
msgid "Think you can weasel out of a bill.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_5"
msgid "We made those repairs so's those orphans||would be safe,{PA:10} you hear me?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_7"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0011.ARC/TALK_ST_KAB0011.BIN::line:16_2_8"
msgid "Perhaps you'd understand the situation more||clearly if we spoke in person.{PA:20}"
msgstr ""

