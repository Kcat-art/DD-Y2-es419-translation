msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0109.ARC/TALK_ST_KAB0109.BIN::line:28_0_0"
msgid "Daigo"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0109.ARC/TALK_ST_KAB0109.BIN::line:28_1_1"
msgid "How are things on your end?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0109.ARC/TALK_ST_KAB0109.BIN::line:28_1_3"
msgid "Good.{PA:20}||Are you okay?{PA:20}"
msgstr ""

msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0109.ARC/TALK_ST_KAB0109.BIN::line:28_1_5"
msgid "Good to hear.{PA:20}||I'm leaving the truce in your hands.{PA:20}"
msgstr ""

