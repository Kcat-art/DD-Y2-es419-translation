msgctxt "MEDIA3/ARC/RAIN/RAIN_KAB0109.ARC/TALK_ST_KAB0109.BIN::line:287_0_4"
msgid "Then these crazy quacking foreigners||showed up.{PA:20}.{PA:20}.{PA:20} Y-You're not with them?{PA:20}"
