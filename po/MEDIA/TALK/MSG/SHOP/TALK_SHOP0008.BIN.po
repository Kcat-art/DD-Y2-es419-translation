msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_0_0"
msgid "A men's cologne.{PA:20} It emits male pheromones,{PA:10}||apparently.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_1_0"
msgid "A bouquet of bright red roses.{PA:20} Any woman||would be thrilled to receive these.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_2_0"
msgid "This bouquet of pink lilies makes a great||gift for the ladies.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_3_0"
msgid "This cookie sampler is a decent present for||any occasion.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_4_0"
msgid "This caviar skin bag is an unbeatable gift||for any woman.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_5_0"
msgid "This monogrammed bag would definitely make||a good present.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_6_0"
msgid "This high-class necklace would make a||good gift for a woman.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_7_0"
msgid "This Italian women's watch would make a||wonderful present.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_8_0"
msgid "This scarf made in France would make a||fantastic gift.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_9_0"
msgid "This lucky bracelet will supposedly improve||your chances with the ladies.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_10_0"
msgid "They say this bracelet makes the wearer||irresistible to women.{PA:20} Seriously!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_11_0"
msgid "This charm from the Goddess of Children is||quite old.{PA:20} It should help you in fights.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_12_0"
msgid "A yakuza who left the biz sold me this long||dagger.{PA:20} Said he didn't need it any more.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_13_0"
msgid "This Lau family Chinese broadsword is old,{PA:10}||but still quite sharp.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_14_0"
msgid "A kodachi used by THE Musashi Miyamoto.{PA:20}||Well,{PA:10} it's by the same swordsmith,{PA:10} at least.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_15_0"
msgid "This is a short sword by Mifune.{PA:20} They use it||for ceremonies,{PA:10} but it's got a good blade.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_16_0"
msgid "Although it's unsigned,{PA:10} this katana is sharp||and glimmering.{PA:20} I recommend it myself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_17_0"
msgid "A shield from Europe.{PA:20} It'd be neat to have||around,{PA:10} if you're into that sort of thing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_18_0"
msgid "This chain mail's heavy,{PA:10} but I think you can||manage.{PA:20} Well,{PA:10} it's not really in style.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_19_0"
msgid "Just a replica of armor made from a sacred||tree.{PA:20} The original is a national treasure.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0008.BIN::line:2_20_0"
msgid "This Iai Katana is very sharp.{PA:20} Be careful!{PA:20}"
msgstr ""

