msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_0_0"
msgid "An old-style,{PA:10} semi-automatic pistol.{PA:20} It's||pretty old,{PA:10} so it's not a very accurate shot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_1_0"
msgid "A 9mm pistol.{PA:20} It's easy to use,{PA:10} and||precise,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_2_0"
msgid "A police baton.{PA:20} It's compact and easy to||wield.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_3_0"
msgid "This is a military survival knife.{PA:20} It's||built for battle.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_4_0"
msgid "This blade,{PA:10} with its long reach,{PA:10} is nice to||have in battle.{PA:20} It does a lot of damage.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_5_0"
msgid "This is a light,{PA:10} easy-to-carry stick that||extends like a fishing rod.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_6_0"
msgid "A wooden katana made from oak.{PA:20} It's a||formidable weapon when mastered.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_7_0"
msgid "A wooden sword made from a dark hardwood.{PA:20}||It's really powerful for a blunt weapon.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_8_0"
msgid "The blackjack packs a punch without leaving||marks.{PA:20} You see 'em in movies a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_9_0"
msgid "The ability to leave an opponent helpless||has made the stun gun popular for defense.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_10_0"
msgid "Brass knuckles.{PA:20} You're used to these,{PA:10} aren't||you?{PA:20} Press {IC:00_00}➿ for a cool move.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_11_0"
msgid "You can blind an enemy for a while with||this pepper spray.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_12_0"
msgid "The classic Chinese broadsword.{PA:20} I think it's||easier to use than a dagger.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_13_0"
msgid "An electric bomb.{PA:20} Think of it like a stun||gun you can throw.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_14_0"
msgid "A handmade,{PA:10} old-style semi-automatic pistol.{PA:20}||There's only one round in the chamber.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_15_0"
msgid "A shotgun.{PA:20} I'll sell it to you,{PA:10} but don't go||crazy with it now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_16_0"
msgid "You wear this under your clothes.{PA:20} You can||wear it around town that way.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_17_0"
msgid "This bulletproof shield is easy to carry,{PA:10}||strong and useful.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_18_0"
msgid "Shin guards built from steel.{PA:20} They're heavy,{PA:10}||but you can't be tripped when wearing them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_19_0"
msgid "Wrap this cloth binding around the||midsection to protect your vital parts.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_20_0"
msgid "This binding is famous in yakuza circles.{PA:20}||It's got quite a reputation.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0049.BIN::line:2_21_0"
msgid "This cloth binding is thick enough that most||punches will be ineffective.{PA:20}"
msgstr ""

