msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_0_0"
msgid "When you feel like you need a boost of HEAT,{PA:10}||it'll give you what you need to keep going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_1_0"
msgid "This is what you need to refresh your spirit||and bring some excitement to your life.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_2_0"
msgid "A drink famous for its slogan,{PA:10} \"One shot to||live tough\".{PA:20} The weakest of the series.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_3_0"
msgid "A drink famous for its slogan,{PA:10} \"One shot to||live tough\".{PA:20} This will keep you going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_4_0"
msgid "A drink famous for its slogan,{PA:10} \"One shot to||live tough\".{PA:20} It'll nearly fully restore you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_5_0"
msgid "A wooden hammer.{PA:20} How about some do-it-||yourself carpentry?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_6_0"
msgid "This high-class umbrella makes for a good||weapon.{PA:20} It's pretty durable,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_7_0"
msgid "A beer bottle with nothing in it.{PA:20}||Hey,{PA:10} we'll sell anything here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_8_0"
msgid "A kettle.{PA:20} An important household item.{PA:20}||It probably hurts to get hit with too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_9_0"
msgid "A lamp used for bedside reading.{PA:20} It won't||last long if you use it as a weapon.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_10_0"
msgid "A softball.{PA:20}.{PA:20}.{PA:20} Don't you know?{PA:20} It really||hurts if someone holds this and punches you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_11_0"
msgid "A sledgehammer.{PA:20} You can use it just about||anywhere.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_12_0"
msgid "A modified lighter.{PA:20} Well,{PA:10} think of it like||a mini flamethrower.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_13_0"
msgid "A modified iron.{PA:20} You can carry it around||town without the police coming after you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_14_0"
msgid "A modified portable stove.{PA:20} Hit someone with||this,{PA:10} and they'll catch fire.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_15_0"
msgid "An iron pipe.{PA:20} It's made from scraps,{PA:10}||so it's cheap.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_16_0"
msgid "The spiked bat is a must-have for any rough-||neck.{PA:20} You've used these before,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_17_0"
msgid "The cloth in the fighter's binding is thick||enough that most punches'll be ineffective.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_18_0"
msgid "Hercules-brand gloves.{PA:20} When you grab||something,{PA:10} they'll give you a jolt of power.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_19_0"
msgid "An old hand grenade.{PA:20} I found it.{PA:20}||I don't know how powerful it is,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_20_0"
msgid "A flash grenade.{PA:20} It's so bright,{PA:10} anyone||who gets hit goes down.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_21_0"
msgid "A tear gas grenade.{PA:20} It'll temporarily blind||nearby enemies.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_22_0"
msgid "A smoke grenade.{PA:20} You can temporarily blind||enemies in an area.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_23_0"
msgid "An older Chinese broadsword.{PA:20} Since last year||you can find 'em around Kamurocho.{PA:20} Strange.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_24_0"
msgid "A wooden sword made from hardwood.{PA:20}||It's really strong.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_25_0"
msgid "A sword blessed by fire spirits.{PA:20} You can't||appreciate it until you've cut with it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_26_0"
msgid "An amazing sword even when compared to other||mystical swords.{PA:20} This is my favorite sword.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0059.BIN::line:2_27_0"
msgid "They say this guy's some famous celebrity||yakuza.{PA:20} I don't get it at all.{PA:20}"
msgstr ""

