msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_0_0"
msgid "This crowbar is 60cm long.{PA:20} Please only use||it for prying things open.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_1_0"
msgid "The stun gun is a popular choice for self||defense.{PA:20} Please only use it as such.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_2_0"
msgid "A plate with the character for \"dragon\",{PA:10}||apparently written by a famous calligrapher.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_3_0"
msgid "A plate made of marble.{PA:20} It's aesthetically||pleasing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_4_0"
msgid "A plate made from a tortoise shell.{PA:20} It's||a rare piece of art.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_5_0"
msgid "A plate made of gold.{PA:20} It's an antique.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_6_0"
msgid "A short sword used by Miyamoto Musashi.{PA:20}||It's been made into a dagger.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_7_0"
msgid "Mifune's Kodachi.{PA:20} This short sword is quite||an item.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_8_0"
msgid "You might've seen this katana on late-night||TV.{PA:20} It's a stun gun and katana,{PA:10} all-in-one!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_9_0"
msgid "This wooden sword is made from hard,{PA:10} dense||wood.{PA:20} It has a nice heft to it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_10_0"
msgid "This famous \"Mugetsu\" sword is one of three||with \"getsu\" (moon) in its name.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_11_0"
msgid "Hewn from a sacred tree,{PA:10} this sword should||never have been made.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_12_0"
msgid "Fearless Binding.{PA:20} Underground gamblers are||known to wear this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_13_0"
msgid "Demon's Binding.{PA:20} Tightly bound,{PA:10} thick cloth||with steel to protect the body.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0022.BIN::line:2_14_0"
msgid "Sacred Tree Armor.{PA:20} This came in about six||months ago,{PA:10} I think.{PA:20}"
