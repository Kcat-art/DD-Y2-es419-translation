msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_0_0"
msgid "You can get a feel for a shop's sushi from||their egg sushi.{PA:20} Ours is top notch!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_1_0"
msgid "Why are they called kappa rolls?{PA:20} Because||kappas love cucumbers,{PA:10} that's why!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_2_0"
msgid "There are lots of different kinds of tuna,{PA:10}||but our shop uses only the top maguro cut.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_3_0"
msgid "With our sweet shrimp sushi you'll find||unrivaled freshness and quality!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_4_0"
msgid "Crunchy fin-muscle tissue from a certain||kind of halibut.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_5_0"
msgid "When you bite into our tsubugai shellfish||you'll feel the summer ocean breeze!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_6_0"
msgid "The more you chew our fresh octopus,{PA:10} the||more you'll fall in love with it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_7_0"
msgid "Lately a lot of amberjack is farm-raised,{PA:10}||but we only use freshly caught.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_8_0"
msgid "Our seasonal fatty amberjack is freshly||caught.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_9_0"
msgid "This is the season for halibut,{PA:10} and ours||is freshly caught.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_10_0"
msgid "This striped jack is the king of mackerel.{PA:20}||They're best eaten raw in the summertime.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_11_0"
msgid "This golden-eyed fish is fresh and tasty.{PA:20}||Caught this very morning.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_12_0"
msgid "Farmed salmon roe has a different taste,{PA:10}||but ours is straight from the ocean.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_13_0"
msgid "The ark shell has red blood and has been a||part of Japanese culture for centuries.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_14_0"
msgid "This is the highest grade of tuna.{PA:20}||It will absolutely melt in your mouth!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_15_0"
msgid "This top-shelf abalone isn't for the||thrifty.{PA:20} But it's worth it!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_16_0"
msgid "Our first-rate sea urchin roe is delivered||fresh from Numazu port.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0037.BIN::line:2_17_0"
msgid "We use an entire lobster for this||extravagant red miso soup.{PA:20}"
msgstr ""

