msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_0_0"
msgid "The famous Staminan,{PA:10} for when your mind and||body need a small boost.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_1_0"
msgid "When you're really tired,{PA:10} this'll give your||mind and body a big boost.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_2_0"
msgid "Staminan Royale is our most effective drink||for restoring the mind and body.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_3_0"
msgid "There is nothing more effective at healing||the mind and body.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_4_0"
msgid "When you feel like you need a HEAT boost,{PA:10}||it'll give you what you need to keep going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_5_0"
msgid "This is what you need to refresh your spirit||and bring some excitement to your life.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_6_0"
msgid "For when you need to really refresh your||spirit and get your HEAT on.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_7_0"
msgid "This high-class umbrella makes for a good||weapon.{PA:20} It's pretty durable,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_8_0"
msgid "A wooden hammer.{PA:20} How about some do-it-||yourself carpentry?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_9_0"
msgid "A sake bottle for glass collectors.{PA:20}||If you're interested,{PA:10} buy it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_10_0"
msgid "A common piece of wood,{PA:10} used for construc-||tion.{PA:20} Or,{PA:10} you can build a fire with it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_11_0"
msgid "Darts.{PA:20} They're great for killing time.{PA:20}||Don't go throwing 'em at people,{PA:10} now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_12_0"
msgid "A kettle.{PA:20} Because it's cold out.{PA:20}||It'll boil water for you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_13_0"
msgid "A ball.{PA:20} It's great for killing time.{PA:20}||Plus it's cheap.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_14_0"
msgid "Bug spray.{PA:20} It's winter,{PA:10} so there's not much||demand for it now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_15_0"
msgid "A saw.{PA:20} It's pretty convenient to have||around.{PA:20} Priceless around these parts.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_16_0"
msgid "You can actually use this gentleman's||umbrella as a weapon.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_17_0"
msgid "Rope.{PA:20} You can use it in a lot of different||ways.{PA:20} Try it out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_18_0"
msgid "A Chinese cleaver.{PA:20} It's got some weight to||it,{PA:10} making it great for chopping.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_19_0"
msgid "A water pot.{PA:20} Found at a junk yard.{PA:20}||It still works.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_20_0"
msgid "A pair of pliers.{PA:20} It's a household item,{PA:10} so||I'll let it go for cheap.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_21_0"
msgid "A bat.{PA:20} If you buy a ball,{PA:10} you gotta get||this,{PA:10} too.{PA:20} It's a pretty good bat.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_22_0"
msgid "A lamp.{PA:20} It's fragile,{PA:10} so be careful with it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_23_0"
msgid "A golf club.{PA:20} You can get some good hits||if used properly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_24_0"
msgid "A crowbar.{PA:20} You can use it to pull nails.{PA:20}||It's cheap.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_25_0"
msgid "An ashtray.{PA:20} It's made of pretty hard glass,{PA:10}||but it'll break if you hit it too hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_26_0"
msgid "A beer bottle.{PA:20} Well,{PA:10} my philosophy is to||sell anything and everything.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_27_0"
msgid "A sledgehammer.{PA:20} I don't think it's too||useful for most people.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_28_0"
msgid "This attaché case is built sturdy.{PA:20} Looks||like it could cause some pain.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_29_0"
msgid "Table salt.{PA:20} Everyone needs it.{PA:20}||Don't get it in your eyes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_30_0"
msgid "A police baton.{PA:20} It's compact and easy to||wield.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_31_0"
msgid "Brass knuckles.{PA:20} You're used to these,{PA:10} aren't||you?{PA:20} Press {IC:00_00}➿ for a cool move.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_32_0"
msgid "A regular lighter with some modifications.{PA:20}||For defensive purposes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_33_0"
msgid "The blackjack.{PA:20} It just flat-out hurts.{PA:20}||Give it a shot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_34_0"
msgid "A stun gun.{PA:20} Popular with the younger||folks these days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_35_0"
msgid "Pepper spray.{PA:20} A tool for protection.{PA:20}||Don't expect too much from it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_36_0"
msgid "With this specially made baton,{PA:10} you can||electrocute your opponents when you hit them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_37_0"
msgid "A modified iron.{PA:20} You can carry it around||town without the police coming after you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_38_0"
msgid "A modified portable stove.{PA:20} Hit someone with||this,{PA:10} and they'll catch fire.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_39_0"
msgid "An iron pipe.{PA:20} I found this lying around,{PA:10}||but it makes a decent weapon.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_40_0"
msgid "The butterfly knife doesn't pack a lot of||power.{PA:20} Maybe use it for fruit?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_41_0"
msgid "A ninja dagger.{PA:20} It's light and easy to use.{PA:20}||I doubt it's authentic or anything.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_42_0"
msgid "This dagger is old,{PA:10} but it's sharp.{PA:20}||It's a good knife.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_43_0"
msgid "The long dagger?{PA:20} It's a good item.{PA:20}||It's almost an antique,{PA:10} in a good way.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/SHOP/TALK_SHOP0060.BIN::line:2_44_0"
