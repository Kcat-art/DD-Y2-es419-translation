msgctxt "MEDIA/TALK/MSG/TALK_TUTORIAL.BIN::line:7_8_0"
msgid "Times remaining:      "
msgstr ""

msgctxt "MEDIA/TALK/MSG/TALK_TUTORIAL.BIN::line:8_0_0"
msgid "You've completed the Fight Tutorial.{PA:20}||Defeat the remaining enemies.{PA:20}"
msgstr ""

