msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_16"
msgid "That's too bad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_17"
msgid "Y{MS:2}{MS:1}{MS:0}eah,{PA:10} I guess you wouldn't be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_18"
msgid "Guarding a girl probably wouldn't||s{MS:0}uit you anyway.{PA:20}"
