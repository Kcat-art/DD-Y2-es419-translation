msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_11"
msgid "I see.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_12"
msgid "W{MS:2}{MS:1}{MS:0}hat?{PA:20} You'd make the perfect||bodyguard!{PA:20}"
