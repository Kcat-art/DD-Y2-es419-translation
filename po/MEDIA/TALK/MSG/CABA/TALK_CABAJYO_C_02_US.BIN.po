msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_18"
msgid "B{MS:3}{MS:2}{MS:1}{MS:0}ut you had me for a second!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_19"
msgid "Maybe I could see you in that way.{PA:20}.{PA:20}.{PA:20}||I mean.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_20"
msgid "If no one else goes for me,{PA:10}||I wonder if you'd take me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_20_0"
msgid "T{MS:0}here are a lot of lies they tell||on TV stars' bios.{PA:20}"
