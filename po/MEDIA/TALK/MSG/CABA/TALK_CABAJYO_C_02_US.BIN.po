msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_4"
msgid "Aren't you popular with the guys?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_5"
msgid "I {MS:0}don't know that,{PA:10} either.{PA:20}"
