msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_0"
msgid "W{MS:1}{MS:0}hen I was on TV,{PA:10}||I had to wear all sorts of costumes.{PA:20}"
