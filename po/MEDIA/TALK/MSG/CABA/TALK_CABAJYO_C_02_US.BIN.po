msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_14"
msgid "Don't worry,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_15"
msgid "I{MS:2}{MS:1}{MS:0} don't get involved with||the people I work with.{PA:20}"
