msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_15"
msgid "No,{PA:10} just as a patient.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_16"
msgid "Y{MS:2}{MS:1}{MS:0}ou were mischievous,{PA:10} weren't you?{PA:20}||Always getting into fights as a kid,{PA:10} I'll bet.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_17"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_18"
msgid "Y{MS:0}ou're young at heart,{PA:10} aren't you?{PA:20}"
