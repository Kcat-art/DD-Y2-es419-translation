msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_10"
msgid "That's not.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_11"
msgid "T{MS:0}hen what?{PA:20}||It's okay.{PA:20} I get it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_12"
msgid "I'll become a good cook,{PA:10}||and then find me a good man.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_13"
msgid "A{MS:2}{MS:1}{MS:0}nd it'll be too late for you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_14"
msgid "T{MS:2}{MS:1}{MS:0}omorrow.{PA:20}.{PA:20}.{PA:20} That's awfully soon.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_15"
msgid "I was joking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_16"
msgid "I {MS:2}{MS:1}{MS:0}know.{PA:20} I was||just playing along.{PA:20}"
