msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_16"
msgid "I still don't know the real thing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_17"
msgid "Oh,{PA:10} {MS:2}{MS:1}{MS:0}that was kind of dirty!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_18"
msgid "W{MS:0}ell.{PA:20}.{PA:20}.{PA:20}||There were a lot of different pictures.{PA:20}.{PA:20}.{PA:20}"
