msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_3"
msgid "D{MS:0}o guys really||like girls in costumes?{PA:20} I mean,{PA:10} I guess so!{PA:20}"
