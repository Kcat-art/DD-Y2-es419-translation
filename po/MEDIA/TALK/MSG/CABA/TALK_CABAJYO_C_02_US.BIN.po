msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_14"
msgid "I trained as hard as I could.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_15"
msgid "T{MS:1}{MS:0}hat's why you're so strong now.{PA:20}"
