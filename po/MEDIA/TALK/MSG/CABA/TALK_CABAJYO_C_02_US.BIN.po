msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_11"
msgid "T{MS:2}{MS:1}{MS:0}hat's a great idea!{PA:20}||You can still do it,{PA:10} can't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_12"
msgid "Heh.{PA:20}.{PA:20}.{PA:20} Now it's a little too late.{PA:20}"
