msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_19"
msgid "Being a bodyguard would be no problem.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_20"
msgid "Y{MS:2}{MS:1}{MS:0}eah,{PA:10} the manager isn't||the only person who protects a girl.{PA:20}"
