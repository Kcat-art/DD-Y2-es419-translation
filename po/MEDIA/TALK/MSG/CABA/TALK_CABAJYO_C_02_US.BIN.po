msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_1"
msgid "I went to so many auditions,{PA:10}||and I finally made my dream come true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_2"
msgid "Did you have a dream||w{MS:0}hen you were little?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_3"
msgid "E{MS:0}ven when you were a kid?{PA:20}"
