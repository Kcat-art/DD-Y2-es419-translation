msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_12"
msgid "N{MS:1}{MS:0}urses' uniforms are cute.{PA:20}||And nurses are so clean!{PA:20}"
