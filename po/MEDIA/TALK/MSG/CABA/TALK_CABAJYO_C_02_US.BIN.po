msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_20"
msgid "H{MS:2}{MS:1}{MS:0}ey,{PA:10} do you want to see them or something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_21"
msgid "You're being kind of a typical||guy,{PA:10} Kazuma.{PA:20}"
