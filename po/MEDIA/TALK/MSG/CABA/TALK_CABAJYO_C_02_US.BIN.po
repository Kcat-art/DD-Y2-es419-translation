msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_22"
msgid "I{MS:1}{MS:0}'m not liking this at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_0"
msgid "W{MS:0}hen I was a girl,{PA:10} I||always wanted to be on TV.{PA:20}"
