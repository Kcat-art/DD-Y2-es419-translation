msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_8"
msgid "It was supposed to be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_9"
msgid "I{MS:2}{MS:1}{MS:0} think you'd be better off||giving up the comedy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_10"
msgid "I'm not worried about it.{PA:20}||It's just.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_11"
msgid "I just wondered if guys really||got off to pictures like that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_12"
msgid "If they don't know the real thing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_13"
msgid "W{MS:1}{MS:0}hat.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_14"
msgid "If they can't see the real thing,{PA:10} there's||no difference between that and a fake.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_16_15"
msgid "Well,{PA:10} you wouldn't look||at those pictures of me,{PA:10} would you?{PA:20}"
