msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_0"
msgid "I{MS:0}'m thinking about taking||cooking classes.{PA:20}"
