msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_3"
msgid "I {MS:1}{MS:0}wonder.{PA:20}.{PA:20}.{PA:20}||I {MS:2}don't really even know.{PA:20}"
