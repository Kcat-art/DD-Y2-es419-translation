msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_20_2"
msgid "On mine,{PA:10} when I was on television.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_20_3"
msgid "it said I was a D cup,{PA:10}||but {MS:2}{MS:1}{MS:0}that was a big lie.{PA:20}"
