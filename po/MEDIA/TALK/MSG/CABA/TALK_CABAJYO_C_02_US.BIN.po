msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_5"
msgid "B{MS:1}{MS:0}ut it might be better||not to have a dream.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_6"
msgid "W{MS:3}{MS:2}{MS:1}{MS:0}ithout dreams,{PA:10} you won't have to endure the||pain when you realize they're only dreams.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_7"
msgid "With {MS:2}{MS:1}{MS:0}your hands?{PA:20}||I {MS:3}can sort of see it.{PA:20}"
