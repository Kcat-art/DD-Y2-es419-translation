msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_15_5"
msgid "If I ever make a comeback,{PA:10}||w{MS:2}{MS:1}{MS:0}ill you be my manager?{PA:20}"
