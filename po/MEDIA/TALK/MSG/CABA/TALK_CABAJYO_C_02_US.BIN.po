msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_19_9"
msgid "T{MS:2}{MS:1}{MS:0}hat's.{PA:20}.{PA:20}.{PA:20} You mean you||aren't interested?{PA:20}"
