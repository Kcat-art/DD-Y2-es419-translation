msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_8"
msgid "I don't work well in a team.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_9"
msgid "Incidentally,{PA:10} what kind of craftsman||did you want to be?{PA:20}"
