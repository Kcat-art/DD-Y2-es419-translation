msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_17"
msgid "Yeah,{PA:10} anytime.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_17_18"
msgid "T{MS:2}{MS:1}{MS:0}hat's wonderful!{PA:20}❤||You're my hero,{PA:10} Kazuma!{PA:20}"
