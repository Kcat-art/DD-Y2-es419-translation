msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_02_US.BIN::line:9_18_5"
msgid "What,{PA:10} d{MS:2}{MS:1}{MS:0}o you have a||Lolita complex or something?{PA:20}"
