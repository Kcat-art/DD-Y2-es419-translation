msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_19_16"
msgid "I don't think it's very realistic.{PA:20}||For one thing,{PA:10} I like my friends.{PA:20}"
