msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:10_0_16"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||Tuition is certainly expensive.{PA:20}"
