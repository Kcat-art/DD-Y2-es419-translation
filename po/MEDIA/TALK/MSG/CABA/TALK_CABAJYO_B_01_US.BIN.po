msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:39_1_0"
msgid "How about I help out with that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:39_2_0"
msgid "You have things you need to do first.{PA:20}"
