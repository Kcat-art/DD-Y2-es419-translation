msgid "That's true,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr "Sí, per{PA:10}o..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_18_10"
msgid "Having to redo my makeup every time I||get tired {MS:0}would be a waste of time.{PA:20}"
