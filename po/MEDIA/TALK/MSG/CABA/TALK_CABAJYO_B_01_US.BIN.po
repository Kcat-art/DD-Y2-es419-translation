msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_13_18"
msgid "That's true.{PA:20}"
msgstr "Sí, es cierto.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_0"
msgid "I {MS:0}really {MS:1}like this area.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_1"
msgid "Some of the other girls||say it's crowded and noisy,{PA:10} but"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_2"
msgid "I feel at ease here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_3"
msgid "S{MS:1}{MS:0}o since I came to Tokyo,{PA:10}||I've always lived in this area.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_4"
msgid "Where do you live,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_5"
msgid "I {MS:0}think this area||suits you,{PA:10} Kazuma.{PA:20}"
