msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_0"
msgid "Y{MS:1}{MS:0}ou go to a lot of places,{PA:10} don't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_1"
msgid "I{MS:0}'m busy because of school and this job.{PA:20}||I wish I could travel more.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_2"
msgid "You don't have to go far to have fun.{PA:20}||Next time,{PA:10} how about we go together?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_3"
msgid "G{MS:0}o where?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_4"
msgid "W{MS:0}e{MS:1}ll.{PA:20}.{PA:20}||{MS:2}Isn't that a little generic?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_5"
msgid "Is it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_6"
msgid "French cuisine while looking||out at the city at night,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_7"
msgid "Yeah,{PA:10} that's what I was thinking.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_8"
msgid "I {MS:0}want{MS:1} something stimulating that isn't||a common part of everyday life.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_9"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_10"
msgid "M{MS:0}mmm,{PA:10} a hot spring.{PA:20}.{PA:20}.{PA:20}||Aren't they full of old people?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_11"
msgid "Young people go,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_15_12"
msgid "But at a hot spring you||just sort of sit and stare,{PA:10} don't you?{PA:20}"
