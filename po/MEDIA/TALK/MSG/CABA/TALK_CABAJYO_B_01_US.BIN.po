msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_6"
msgid "Like a character in a detective||novel!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_7"
msgid "J{MS:2}{MS:1}{MS:0}ust don't die on me,{MS:3}{PA:10} okay?{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_8"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

