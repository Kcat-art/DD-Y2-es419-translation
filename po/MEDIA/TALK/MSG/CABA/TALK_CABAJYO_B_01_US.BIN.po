msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Nothing.{PA:20}"
msgstr "{PA:20}N{PA:20}{PA:20}ada.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_12"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_13"
msgid "Do you like moving?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_14"
msgid "I have friends who can't||live in the same place for even a year.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_15"
msgid "One says she wants to constantly||have a fresh start.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_14_16"
msgid "But {MS:0}I'd rather live where I can feel at ease,{PA:10}||even if it's boring.{PA:20}"
msgstr ""

