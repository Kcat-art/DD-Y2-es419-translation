msgstr "Empleado"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:0_0_0"
msgid "W{MS:1}{MS:0}elcome!{PA:20} I'm Natsuki.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:0_1_0"
msgid "W{MS:0}elcome.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_0_0"
msgid "N{MS:0}ice to meet you!{PA:30}{PA:20}||T{MS:1}hanks for choosing me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_1_0"
msgid "I{MS:0}t's been a while,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_1_1"
msgid "T{MS:0}hanks for choosing||me again tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_2_0"
msgid "Kazuma,{PA:10} it feels like I haven't seen you||for so long!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_2_1"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20}"
msgstr "Lo siento{PA:20}.{PA:20}..{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_3_0"
msgid "That was great!{PA:20}||{MS:0}Let's have fun today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_3_1"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_4_0"
msgid "You know,{PA:10} I was hoping||we could go out before work.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_4_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_4_2"
msgid "Forget it.{PA:20}||Let's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_5_0"
msgid "Thanks for taking me out||{MS:0}after work the other day.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_5_1"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_5_2"
msgid "We should go again sometime.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_6_0"
msgid "I was hoping to go||out with you after work.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_6_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:1_6_2"
msgid "Forget it.{PA:20}||Let's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:2_0_0"
msgid "K{MS:0}azuma!{PA:20}❤||Y{MS:1}ou look great today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:2_1_0"
msgid "K{MS:0}azuma,{PA:10} you're||{MS:1}looking handsome as usual.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:2_2_0"
msgid "K{MS:0}azuma.{PA:20}.{PA:20}.{PA:20}||{MS:1}You should try to dress a little nicer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_0_0"
msgid "I{MS:1}{MS:0}s this for real!?{PA:20}||How {MS:2}wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_0_1"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_0_2"
msgid "T{MS:0}hanks so much.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_1_0"
msgid "Is this for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_1_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_1_2"
msgid "T{MS:0}hank you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_2_0"
msgid "Is this for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_2_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_2_2"
msgid "Um{MS:0},{PA:10} thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:3_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_0_0"
msgid "W{MS:0}hat would you like to drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_0_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_1_0"
msgid "Hm?{PA:20}||Your glass is empty,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_1_1"
msgid "W{MS:0}hat will you have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_1_2"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_0"
msgid "W{MS:0}hat!?{PA:20}||Are you serious!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_1"
msgid "O{MS:0}h,{PA:10} wow!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_2"
msgid "I haven't had a lot of customers||{MS:0}o{MS:1}rder the gold.{PA:20} This is great!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_3"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_4"
msgid "Thanks,{PA:10} Kazuma!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_5"
msgid "Oh,{PA:10} a joke.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_2_6"
msgid "Well,{PA:10} whatever.{PA:20}||I'll bring you something else.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_3_0"
msgid "What,{PA:10} really!?{PA:20}"
msgstr "¿Qué? {PA:10}¿En serio?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_3_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_3_2"
msgid "T{MS:0}hat's my Kazuma!{PA:20}||You really know how to spend money!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_4_0"
msgid "O{MS:0}kay,{PA:10} I'll be right back with it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_4_1"
msgid "Thanks!{PA:20}"
msgstr "¡Gracias!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:4_5_0"
msgid "I didn't think you drank||stuff like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_0_0"
msgid "I'm feeling kind of hungry.{PA:20}||H{MS:0}ow about some food,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_0_2"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_0_3"
msgid "No,{PA:10} I'm fine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_1_0"
msgid "I like that,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_1_1"
msgid "O{MS:0}h,{PA:10} Kazuma!{PA:20}❤||You know just what I like.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_2_0"
msgid "Got it!{PA:20}❤||Just a second.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:5_3_0"
msgid "Oh{MS:0}.{PA:20}.{PA:20}.{PA:20}||So you like that,{PA:10} do you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_0_0"
msgid "W{MS:0}ell,{PA:10} a little bit longer then.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_0_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_1_0"
msgid "I had fun today.{PA:20}||I'd like to talk to you again.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_1_1"
msgid "Why don't we exchange email addresses?{PA:20}||What do you think?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_1_2"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_1_3"
msgid "All right.{PA:20}||{MS:0}I{MS:1}'ll email you later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_2_0"
msgid "O{MS:0}ur time's up already.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_2_1"
msgid "I{MS:0} like talking to you,{PA:10}||so I hope you come back soon!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_3_0"
msgid "S{MS:0}ee you again,{PA:10} Kazuma!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_0"
msgid "K{MS:0}azuma,{PA:10} are you free today?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_1"
msgid "What's up?{PA:20}"
msgstr "¿Qué ocurre, Date-san?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_2"
msgid "I really enjoy our time together,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_3"
msgid "and I was hoping we could||hang out a little more.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_4"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_5"
msgid "R{MS:0}eally?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_6"
msgid "Okay,{PA:10} let's meet by the lockers||in front of the theater.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_7"
msgid "Okay.{PA:20}"
msgstr "Okey.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_4_8"
msgid "Be there or be square!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_0"
msgid "A{MS:0}re you going to go home after this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_1"
msgid "Why?{PA:20}"
msgstr "¿Por qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_2"
msgid "Well,{PA:10} I'm feeling pretty hungry"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_3"
msgid "and I was thinking I'd like||to go somewhere with you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_4"
msgid "Yeah,{PA:10} okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_5"
msgid "Oh,{PA:10} good!{PA:20}||T{MS:0}hanks,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_5_6"
msgid "I'll call you later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_0"
msgid "Kazuma,{PA:10} I have something to ask you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_1"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_2"
msgid "Next time,{PA:10} before you come to the club,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_3"
msgid "I was hoping we could maybe||go somewhere together.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_4"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_5"
msgid "Oh,{PA:10} good!{PA:20}||I'm looking forward to it,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_6_6"
msgid "I'll call you later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_7_0"
msgid "Kazuma,{PA:10} {MS:0}are you busy later?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_7_1"
msgid "What's up?{PA:20}"
msgstr "¿Qué ocurre, Date-san?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_7_2"
msgid "I still want to thank you for the other||day,{PA:10} and so I thought,{PA:10} maybe today.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_7_3"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_7_4"
msgid "Okay,{PA:10} let's meet by the lockers||in front of the theater.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:6_7_5"
msgid "This time come alone,{PA:10} okay?{PA:20}||See you there!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:7_0_0"
msgid "T{MS:0}hank you for coming.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:8_0_0"
msgid "Champagne call!{PA:20}"
msgstr ""

