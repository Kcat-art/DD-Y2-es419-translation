msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_20_6"
msgid "But {MS:0}someday,{PA:10} perhaps.{PA:20}.{PA:20}.{PA:20}"
