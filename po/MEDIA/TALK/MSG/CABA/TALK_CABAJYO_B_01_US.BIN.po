msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:8_0_8"
msgid "Drink!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_0"
msgid "K{MS:0}azuma,{PA:10} you remind me||of a character in a detective novel.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_1"
msgid "H{MS:0}ow so?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_2"
msgid "Y{MS:0}ou're like a nice guy||with a bit of danger.{PA:20} I like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_3"
msgid "S{MS:0}o what kind of women||are you attracted to?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_4"
msgid "H{MS:0}ow surprising!{PA:20}||That's pretty old-fashioned.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_5"
msgid ".{PA:20}.{PA:20}.{PA:20}Really?{PA:20}"
msgstr ".{PA:20}..{PA:20} {PA:20}¿En serio?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_6"
msgid "It's that whole Madonna-whore complex.{PA:20}||Old-fashioned types are like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_7"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_8"
msgid "M{MS:0}en are sure hung up on looks,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_9"
msgid "If a woman was beautiful,{PA:10} would it||matter if she had no personality?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_10"
msgid "But if she's got a good personality.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_11"
msgid "Yeah,{PA:10} I guess she'd be unstoppable.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_12"
msgid "S{MS:0}o what do you think of me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_13"
msgid "You're beautiful.{PA:20}||But I don't know you very well yet.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_14"
msgid "W{MS:0}ell,{PA:10} come by often and find out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_15"
msgid "So the bad guy likes bad girls.{PA:20}.{PA:20}.{PA:20}||{MS:0}That makes sense.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_16"
msgid "P{MS:0}eople sometimes think I'm||{MS:2}{MS:1}sort of a bad girl.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_17"
msgid "Do you think so?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_18"
msgid "O{MS:0}h,{PA:10} so that's how I come||across to people,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_19"
msgid "I{MS:0}nteresting.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_20"
msgid "Don't worry about it.{PA:20}||It's not necessarily a bad thing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_21"
msgid "H{MS:0}a ha!{PA:20}||I suppose it wouldn't be,{PA:10} to you.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_22"
msgid "L{MS:0}et's keep drinking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_23"
msgid "I{MS:0} think so,{PA:10} too!{PA:20}||You're good at reading people,{PA:10} Kazuma.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_24"
msgid "I'm just like anyone else.{PA:20}||Although I can seem a bit strong-minded.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_25"
msgid "Are you sure you only \"seem\" that way?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_26"
msgid "Well,{PA:10} I am pretty opinionated,{PA:10}||but that's normal for girls these days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_27"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_28"
msgid "E{MS:0}xcuse me?{PA:20}||That's so rude,{PA:10} Kazuma!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_29"
msgid "Can't a woman be smart AND||have a personality?!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_0_30"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_0"
msgid "Huh?{PA:20} You want to know my day job?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_2"
msgid "Y{MS:0}ou probably think I mess around all day.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_3"
msgid "No,{PA:10} I think the opposite.{PA:20}||I'll bet your day job's your real job.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_4"
msgid "Wow,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}||{MS:0}That's right!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_5"
msgid "N{MS:0}ow the question is.{PA:20}.{PA:20}.{PA:20}||What's my real job?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_6"
msgid "W{MS:0}rong!{PA:20}||I've never worked in an office before.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_7"
msgid "Do I look like an office drone?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_8"
msgid "I guess not.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_9"
msgid "I{MS:0}'d hate working in an office.{PA:20}||It sounds so boring!{PA:20} Is that how I seem?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_10"
msgid "No,{PA:10} you seem calm and mature.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_11"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20} {MS:1}I don't||know if I buy that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_12"
msgid "Oh,{PA:10} well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_13"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_14"
msgid "S{MS:0}orry!{PA:20}||That's wrong!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_15"
msgid "Do I really look like a nurse?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_16"
msgid "Well,{PA:10} maybe.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_17"
msgid "And {MS:0}isn't the idea of a sexy nurse||a little outdated?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_18"
msgid "Is it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_19"
msgid "I{MS:0}t seems a little chauvinistic to me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_20"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_21"
msgid "C{MS:0}orrect!{MS:1}{PA:20}||And at a top university too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_22"
msgid "T{MS:0}o be frank,{PA:10} I'm working here||to pay for my tuition.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_23"
msgid "My parents said they'd pay for me,{PA:10}||but I'm not a child anymore.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_24"
msgid "When I graduate,{PA:10} I want to study abroad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_25"
msgid "That's impressive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_26"
msgid "I'm just doing what I want.{PA:20}||{MS:0}Everyone should follow their dream.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_27"
msgid "I don't think many kids these days think||like that.{PA:20} You seem pretty special.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_1_28"
msgid "Really?{PA:20}||{MS:1}{MS:0}Aww!{PA:20} T{MS:2}hanks!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_0"
msgid "W{MS:0}hat do you dream about,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_1"
msgid "I've been sleeping like a log lately||and don't have dreams.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_2"
msgid "N{MS:0}o,{PA:10} no!{PA:20}||I mean,{PA:10} your dreams for the future.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_3"
msgid "I've never thought about it.{PA:20}||What about you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_4"
msgid "Me?{PA:20} Well.{PA:20}.{PA:20}.{PA:20}||What do you think it is?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_5"
msgid "I{MS:0} don't think I'd enjoy teaching.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_6"
msgid "I get impatient when people don't pick||up on things quickly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_7"
msgid "And I don't like repeating myself.{PA:20}||So.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_8"
msgid "To be a good teacher,{PA:10} those||are qualities you'd need in spades.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_9"
msgid "A{MS:0} lot of students want to teach.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_10"
msgid "Once I'm out of school,{PA:10} though,{PA:10}||{MS:1}{MS:0}I{MS:2}'d like to stay out!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_12"
msgid "A{MS:0}mazing,{PA:10} that's right!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_13"
msgid "You're pretty good at reading||people,{PA:10} aren't you,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_14"
msgid "I{MS:0} respect that.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_15"
msgid "S{MS:0}ince I'm studying a foreign language,{PA:10}||I want to use it to really communicate.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_16"
msgid "And isn't the idea of being an||interpreter kind of romantic?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_17"
msgid "That's also why I'm earning money,{PA:10}||so when I graduate I can go abroad!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_18"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_19"
msgid "I{MS:0} haven't given any thought to marriage.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_20"
msgid "Lots of women really want that,{PA:10}||{MS:2}{MS:1}{MS:0}but I want to live my life for me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_2_21"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_0"
msgid "W{MS:0}hat!?{PA:20}||Do I have a boyfriend!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_1"
msgid "That's pretty forward,{PA:10} Kazuma.{PA:20}||{MS:1}{MS:0}D{MS:2}oes it really matter?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_2"
msgid "My boyfriend.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_3"
msgid "T{MS:0}hat's pretty common,{PA:10} isn't it?{PA:20}||Maybe I let my guard down.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_4"
msgid "B{MS:0}ut too bad!{PA:20} That's wrong.{PA:20}||I'm single.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_5"
msgid "I gotcha!{PA:20}||Didn't I?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_6"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_3_7"
msgid "T{MS:1}{MS:0}his isn't a place to find love.{PA:20}"
