msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_17_7"
msgid "And you might{MS:0} not realize it,{PA:10} but lots||of girls are sensitive to the smell.{PA:20}"
