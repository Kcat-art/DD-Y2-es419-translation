msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_18_4"
msgid "But if I drink too much coffee,{PA:10}||I can't sleep.{PA:20}.{PA:20}.{PA:20}"
