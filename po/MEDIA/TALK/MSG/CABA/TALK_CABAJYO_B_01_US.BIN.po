msgid "Drink it up!{PA:20} Drink!{PA:20} Drink!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:8_0_2"
msgid "Drink it up!{PA:20} Drink!{PA:20} Drink!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:8_0_3"
msgid "Drink it up!{PA:20} Drink!{PA:20} Drink!{PA:20}"
msgstr ""

