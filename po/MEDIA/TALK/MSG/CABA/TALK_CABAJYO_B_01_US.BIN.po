msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_01_US.BIN::line:9_19_15"
msgid "T{MS:0}hat's not a terrible idea,{PA:10}||but.{PA:20}.{PA:20}.{PA:20}"
