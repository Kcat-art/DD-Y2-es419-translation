msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_12_1"
msgid "Hm{MS:0}.{PA:20}.{PA:20}.{PA:20}||I watch a lot of thrillers.{PA:20}"
