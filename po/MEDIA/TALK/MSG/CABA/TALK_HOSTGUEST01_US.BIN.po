msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_1"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Play dirty?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_2"
msgid "Like,{PA:10} force me to order more bottles||or push me for expensive gifts.{PA:20}"
