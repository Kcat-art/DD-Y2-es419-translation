msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_8"
msgid "Why's that?{PA:20}"
msgstr "¿Y eso por qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_9"
msgid "The hosts in the final round really||look like they could be models.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_10"
msgid "I think you should focus on your charm||more than your looks.{PA:20}"
