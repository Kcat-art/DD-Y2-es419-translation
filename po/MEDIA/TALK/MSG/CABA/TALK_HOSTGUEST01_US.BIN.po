msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_15_19"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_0"
msgid "K{MS:0}azuma,{PA:10} you don't||play dirty,{PA:10} do you?{PA:20}"
