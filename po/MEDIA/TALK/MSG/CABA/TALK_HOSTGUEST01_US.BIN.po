msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_6"
msgid "Right.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_7"
msgid "I{MS:0} think you're setting your sights too high.{PA:20}"
