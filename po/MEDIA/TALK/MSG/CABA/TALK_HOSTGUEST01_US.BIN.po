msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_3"
msgid "Don't you want to increase your sales?{PA:20}||Give it a try,{PA:10} Kazuma!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_4"
msgid "H{MS:0}a ha ha ha ha!{PA:20}||Yeah!{PA:20} That's it!{PA:20}"
