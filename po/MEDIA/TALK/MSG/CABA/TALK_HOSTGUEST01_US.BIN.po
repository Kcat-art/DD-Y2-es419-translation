msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_2"
msgid "What if you entered?{PA:20}||You might do pretty well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_3"
msgid "W{MS:0}hat?{PA:20} You're giving up that easily?{PA:20}"
