msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_10"
msgid ".{PA:20}.{PA:20}.{PA:20}That's not true.{PA:20}"
msgstr "¡{PA:20}E{PA:20}s{PA:20}o no es cierto!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_11"
msgid "H{MS:0}a ha ha!{PA:20}||You sound like an old man!{PA:20}"
