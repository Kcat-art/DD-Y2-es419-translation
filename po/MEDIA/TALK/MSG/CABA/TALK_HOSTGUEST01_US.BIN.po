msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_3"
msgid "W{MS:0}hat?{PA:20}||What does that mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_4"
msgid "Er.{PA:20}.{PA:20}.{PA:20} I mean I want to be big and||strong like a dragon.{PA:20}"
