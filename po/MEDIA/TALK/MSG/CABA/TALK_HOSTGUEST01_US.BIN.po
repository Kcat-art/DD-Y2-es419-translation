msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_1_7"
msgid "I{MS:0}t can.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_1_8"
msgid "But now I can bury myself in work.{PA:20}||It's like a weight has been lifted.{PA:20}"
