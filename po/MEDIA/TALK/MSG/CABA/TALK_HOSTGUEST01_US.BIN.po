msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_11"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}I see.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {MS:0}{PA:20}Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_12"
msgid "What does that mean?{PA:20}"
msgstr "¿A qué se refiere?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_13"
msgid "I'm plenty satisfied||being with you here right now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_14"
msgid "A{MS:0}re you?{PA:20}||That's so sweet of you to say!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_0"
msgid "You're {MS:0}in really good shape.{PA:20}||Do you play any sports?{PA:20}"
