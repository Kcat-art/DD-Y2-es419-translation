msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_5"
msgid "Like that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_6"
msgid "There are a lot of"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_16_7"
msgid "girls who can't say no to that,{PA:10}||or like being ordered around.{PA:20}"
