msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_17_0"
msgid "T{MS:0}here's a contest to choose the||number one host in all of Japan,{PA:10} right?{PA:20}"
