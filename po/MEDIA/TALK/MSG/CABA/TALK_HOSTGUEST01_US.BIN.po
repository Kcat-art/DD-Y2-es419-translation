msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_8"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20} I was joking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_18_9"
msgid "But I'll bet you've broken||lots of hearts,{PA:10} Kazuma.{PA:20}"
