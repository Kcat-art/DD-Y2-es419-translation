msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_11_13"
msgid "All {MS:0}right.{PA:20}"
msgstr "Está{MS:0} bien.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST01_US.BIN::line:5_11_14"
msgid "Oh,{PA:10} {MS:0}really?{PA:20}||You think so?{PA:20}"
