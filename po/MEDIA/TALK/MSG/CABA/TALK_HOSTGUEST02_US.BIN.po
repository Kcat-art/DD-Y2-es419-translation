msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_0_2"
msgid "It's that time already?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_0_3"
msgid "What should I do?{PA:20}"
msgstr "(¿Qué debería hacer?...).{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_1_0"
msgid "Okay,{PA:10} give me an extension!{PA:20}"
