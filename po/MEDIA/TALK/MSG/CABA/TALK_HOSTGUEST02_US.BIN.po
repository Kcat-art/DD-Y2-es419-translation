msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_2_1"
msgid "Leaving so soon?{PA:20}"
msgstr "¿Ya se va?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_3_0"
msgid "I had fun today.{PA:20}❤||Kazuma,{PA:10} do you have plans later?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_3_1"
msgid "Maybe we could go out afterwards.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_3_2"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_3_3"
msgid "Great!{PA:20}❤||I'll contact you later then.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_3_4"
msgid "Be sure to come!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:3_3_5"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:4_0_0"
msgid "I'm not having a good time,{PA:10} so I'm leaving.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:4_0_1"
msgid "What?{PA:20}||So soon?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_0"
msgid "K{MS:0}azuma,{PA:10} sorry for surprising||you like that!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_1"
msgid "Thank you for selecting me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_2"
msgid "Do you remember before,{PA:10}||when you were helping Takaya?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_3"
msgid "Y{MS:0}eah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_4"
msgid "S{MS:0}ince then I haven't||stopped thinking about you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_5"
msgid "So I changed my selection!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_6"
msgid "W{MS:0}hat?{PA:20}||No,{PA:10} not at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_7"
msgid "But weren't you just with||Takaya the other day?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_8"
msgid "Well,{PA:10} maybe.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_9"
msgid "But I like you more||than I ever liked him.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_10"
msgid "You still don't trust me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_11"
msgid "So prove it to me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_12"
msgid "Okay,{PA:10} I will.{PA:20}||You're so demanding!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_13"
msgid "What?{PA:20}||Really?{PA:20}"
msgstr "¿Qué? ¿{PA:20}En|| serio?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_14"
msgid "It's true.{PA:20}||There's just something about you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_15"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||That's nice to hear,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_16"
msgid "You didn't seem to be||all that interested before.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_17"
msgid "I'm not sure I believe it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_18"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_19"
msgid "H{MS:0}a ha ha!{PA:20}||I'll see what I can do.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_20"
msgid "I'll keep you entertained.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_21"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_22"
msgid "But {MS:0}I had a different||idea of how this would go.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_23"
msgid "How so?{PA:20}"
msgstr "¿Cómo?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_24"
msgid "I didn't think||you'd be so doting.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_25"
msgid "I thought you were somewhat||cooler than that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_0_26"
msgid ".{PA:20}.{PA:20}.{PA:20}I can be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_0"
msgid "I {MS:0}think I told you that I||work at a cabaret club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_1"
msgid "How about next time you come see me at||my club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_2"
msgid "W{MS:0}hat?{PA:20}||Not every day!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_3"
msgid "H{MS:0}uh?{PA:20} Why not?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_4"
msgid "I mean hosts are busy too,{PA:10} aren't they?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_5"
msgid "W{MS:0}ell,{PA:10} yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_6"
msgid "I don't remember you||being such a liar.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_7"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_8"
msgid "O{MS:0}h,{PA:10} sorry!{PA:20}||{MS:1}That isn't what I meant.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_9"
msgid "That's what it sounded like to me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_10"
msgid "I just thought it'd be nice to be able||to talk with you somewhere else.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_11"
msgid "R{MS:0}eally?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_12"
msgid "Y{MS:0}es,{PA:10} yes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_13"
msgid "I would pay for everything,{PA:10}||so don't worry!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST02_US.BIN::line:5_1_14"
msgid "I just like seeing you,{PA:10} that's all!{PA:20}❤"
