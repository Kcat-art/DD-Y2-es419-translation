msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:0"
msgid "Kagami"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:1"
msgid "Kiryu"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:2"
msgid "Akko"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:3"
msgid "Iori"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:4"
msgid "Tamao"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:5"
msgid "Takaya"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:6"
msgid "Ayumi"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::name:7"
msgid "System"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_0"
msgid "Hey,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_1"
msgid "So lately business at our host club,{PA:10}||\"Adam\",{PA:10} has really been booming.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_2"
msgid "Did you know we're even closing||in on the Stardust in sales numbers?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_3"
msgid "So I hear.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_4"
msgid "It's all thanks to the hard work||of our employees,{PA:10} you know.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_5"
msgid "You were referred to us by the former||host,{PA:10} Makoto,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_6"
msgid "That's right.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_7"
msgid "Do you remember what I said||when I interviewed you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_8"
msgid "Of course.{PA:20}||In this business,{PA:10} only the strong survive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_9"
msgid "Right.{PA:20}||He who makes the highest sales is king.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_10"
msgid "Even as a rookie,{PA:10} if your sales are good,{PA:10}||you can be number one.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_11"
msgid "As a host,{PA:10} your||goal should be to be number one.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_12"
msgid "Okay,{PA:10} boss.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_13"
msgid ".{PA:20}.{PA:20}.{PA:20}So,{PA:10} you've called women to the club||from the streets like I've asked.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_14"
msgid "I have.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_15"
msgid "Great.{PA:20}||{MS:0}Next,{PA:10} you'll work support.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_16"
msgid "What does that mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_17"
msgid "You'll sit at the other hosts' tables||and help them out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_18"
msgid "Stir up conversation and||try to help improve sales.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_19"
msgid "Got it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_20"
msgid "I'll put you at.{PA:20}.{PA:20}.{PA:20}||Takaya's table.{PA:20} He's our number one.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_21"
msgid "Okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_22"
msgid "But {MS:0}you can't just||sit there{MS:2}{MS:1} and do nothing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_23"
msgid "Let's set your quota.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_24"
msgid "I want you to sell at least||30,{PA:10}000 yen in drinks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_25"
msgid "If you can top that,{PA:10} I'll consider you||ready.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_26"
msgid "Got that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_27"
msgid "Yes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_28"
msgid "Oh,{PA:10} and watch what you say to the customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_29"
msgid "If you upset them,{PA:10} they might leave.{PA:20}||Then you lose everything.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_30"
msgid "I'll be careful.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_31"
msgid "Let me give you some advice.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_32"
msgid "That's one of our regulars,{PA:10} a cabaret girl.{PA:20}||She comes here to blow off stress.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_33"
msgid "Okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_34"
msgid "At any rate,{PA:10} keep the conversation||moving along.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_0_35"
msgid "I got it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_0"
msgid "Good evening.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_1"
msgid "Kazuma,{PA:10} you did really well the other day,{PA:10}||for a beginner.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_2"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_3"
msgid "We've got a lot of customers today.{PA:20}||{MS:0}All the employees are busy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_4"
msgid "I see.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_5"
msgid "So today I'm going to set you up one-on-one||with a customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_6"
msgid "Okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_7"
msgid "It'll be a walk-in customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_8"
msgid "Walk-ins judge a club on the first host||they get.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_9"
msgid "If they have a good experience,{PA:10} there's a||chance they'll become really good customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_10"
msgid "If they have a bad one,{PA:10} then||they probably won't be coming back.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_11"
msgid "Also,{PA:10} we get a lot of our business by||word of mouth.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_12"
msgid "Worst case scenario,{PA:10} a bad experience could||hurt our club's reputation.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_13"
msgid "The first impression is that important.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_14"
msgid "I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_15"
msgid "Looking at how well you did helping out,{PA:10}||I can tell you've got what it takes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_16"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_17"
msgid "Being considerate to the||customer is of the utmost importance.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_18"
msgid "Don't ever forget that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_19"
msgid "I won't.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_20"
msgid "A new walk-in is here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_21"
msgid "G{MS:0}ood evening.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_22"
msgid "All right.{PA:20}.{PA:20}.{PA:20} Let me just give you a little||bit of advice.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_23"
msgid "Sure.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_24"
msgid "With this one,{PA:10} I think you can be a little||aggressive.{PA:20} Make her really fall for you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_25"
msgid "Okay,{PA:10} boss.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_26"
msgid "Looking at her,{PA:10} I can||tell she has a bit of money.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_27"
msgid "She's the type who comes||here looking for pseudo love.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_28"
msgid "I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_29"
msgid "Your quota this time is||80,{PA:10}000 yen.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_30"
msgid "Okay,{PA:10} boss.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_31"
msgid "I don't need to tell you that if you||upset the customer you lose it all,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_32"
msgid "Gotcha.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_1_33"
msgid "All right.{PA:20}||Get going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_0"
msgid "Good evening.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_1"
msgid "Hey,{PA:10} you're here,{PA:10} Kazuma.{PA:20}||Takaya,{PA:10} our number one,{PA:10} is off today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_2"
msgid "Half our club sales are from||people who choose Takaya.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_3"
msgid "That's why it's a bit quiet in here today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_4"
msgid "I see.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_5"
msgid "Actually,{PA:10} just now one of Takaya's||customers contacted us.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_6"
msgid "Do you remember a girl named Iori?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_7"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_8"
msgid "She came to talk about||changing from Takaya.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_9"
msgid "What?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_10"
msgid "At our club,{PA:10} host selections are permanent.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_11"
msgid "If you choose a host,{PA:10} unless something comes||up,{PA:10} you can't change that selection.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_12"
msgid "The host Iori wanted to make her permanent||one.{PA:20}.{PA:20}.{PA:20} was you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_13"
msgid "What does that mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_14"
msgid "It's simple.{PA:20}||She's into you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_15"
msgid "Oh.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_16"
msgid "She'll be here soon.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_17"
msgid "H{MS:0}i.{PA:20}❤||Kazuma,{PA:10} I choose you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_18"
msgid "Listen up.{PA:20}||My club is all about talent.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_19"
msgid "She was Takaya's,{PA:10} but don't hold back.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_20"
msgid "Got it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_21"
msgid "Let me give you some advice.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_22"
msgid "Today,{PA:10} this customer's going to be||hitting on you,{PA:10} hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_23"
msgid "But.{PA:20}.{PA:20}.{PA:20} You can't let her get what she wants||that easily.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_24"
msgid "You've got to be a tease.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_25"
msgid "Okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_26"
msgid "Your quota today is 200,{PA:10}000 yen.{PA:20}||I've set it high.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_27"
msgid "If she loses interest and leaves,{PA:10}||you lose it all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_28"
msgid "Okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_2_29"
msgid "Great.{PA:20}||Now get going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_0"
msgid "Good evening.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_1"
msgid "Hey,{PA:10} you're here,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_2"
msgid "You're just about at the level||of a full-fledged host,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_3"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_4"
msgid "Well,{PA:10} the customers you got were a blessing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_5"
msgid "I didn't think you'd do this||well in this short amount of time.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_6"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_7"
msgid "But we'll test your true worth||now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_8"
msgid "Okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_9"
msgid "Yesterday we put your photo in our||monthly club magazine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_10"
msgid "One of our customers is interested in you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_11"
msgid "I see.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_12"
msgid "She begged me to let her||have a go at you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_13"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_14"
msgid "That customer has singlehandedly||dominated the beauty spa industry.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_15"
msgid "They say her assets are||quite impressive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_16"
msgid "One time,{PA:10} she spent 10 million yen in a||single day.{PA:20} She's our best customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_17"
msgid "It's a lot of pressure,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_18"
msgid "but I believe that you||can handle yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_19"
msgid "Okay,{PA:10} boss.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOST_CMN_US.BIN::line:0_3_20"
