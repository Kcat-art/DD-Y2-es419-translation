msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_12"
msgid "That's true.{PA:20}"
msgstr "Sí, es cierto.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_13"
msgid "B{MS:0}oring?!{PA:20}||{MS:1}Well,{PA:10} you might think so.{PA:20}.{PA:20}.{PA:20}"
