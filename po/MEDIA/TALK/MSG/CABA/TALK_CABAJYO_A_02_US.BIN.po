msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_16"
msgid "Maybe so.{PA:20}"
msgstr "Tal vez...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_17"
msgid "I{MS:0} work a lot; I should||be allowed some time to relax!{PA:20}"
