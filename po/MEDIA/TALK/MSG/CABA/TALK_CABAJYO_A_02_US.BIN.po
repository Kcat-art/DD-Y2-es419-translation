msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_13"
msgid "D{MS:0}on't try to sweet-talk me,{PA:10} Kazzy.{PA:20}||I'm on to you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_14"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mm.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_15"
msgid "Y{MS:0}ou can tell?{PA:20}||The truth is,{PA:10} it's full of padding.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_16"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_17"
msgid "I{MS:0} mean the top is so baggy.{PA:20}||So I had to put in a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_18"
msgid "You're a human pillow.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_0"
msgid "T{MS:0}he other day,{PA:10} when I was singing karaoke,{PA:10}||a man suddenly came in.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_1"
msgid "He gave me his business card||and said he's a music producer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_2"
msgid "A lot of guys say that to pick up girls.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_3"
msgid "I'm sure he was full of it.{PA:20}||I mean,{PA:10} he was,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_4"
msgid "I{MS:0}'d love to be famous!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_5"
msgid "I'd be on TV all the time,{PA:10} and I'd meet||other famous people.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_6"
msgid "I {MS:0}want to see what it's like having||people go nuts when they see me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_7"
msgid "Well then,{PA:10} you should practice,{PA:10} and then||work your way towards it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_8"
msgid "I {MS:0}know.{PA:20}||It's kind of a pipe dream,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_9"
msgid "T{MS:0}here's nothing wrong with having a dream.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_10"
msgid "I guess not.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_11"
msgid "Well,{PA:10} if you put it like that,{PA:10}||it doesn't sound like you think I can.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_12"
msgid "I mean,{PA:10} I'd love to be on TV and stuff,{PA:10}||but it's not like I love singing that much.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_13"
msgid "It's probably not so easy to do.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_14"
msgid "You're a smart girl.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_15"
msgid "Hee{MS:1}{MS:0} hee!{PA:20} You're such a sweetie!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_16"
msgid "W{MS:0}hy?{PA:20} You don't think I can do it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_17"
msgid "It's a tough industry.{PA:20} I've seen girls||ruin their lives trying to make it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_18"
msgid "R{MS:0}eally?{PA:20} That's scary!{PA:20}||I don't want that to happen to me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_13_19"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_14_0"
msgid "W{MS:0}hat do you think of the||food we serve here?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_14_1"
msgid "It's not bad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_14_2"
msgid "I{MS:0}t's pretty good,{PA:10} right?{PA:20}||But isn't the selection kind of limited?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_14_3"
msgid "I{MS:0} guess,{PA:10} but don't you||get sick of always having the same thing?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_14_4"
msgid "I'm a creature of habit.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_14_5"
