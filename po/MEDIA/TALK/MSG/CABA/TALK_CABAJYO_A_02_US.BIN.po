msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_1"
msgid "Why do you ask?{PA:20}"
msgstr "¿Por qué la pregunta?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_2"
msgid "I have to wear stuff like this for work,{PA:10}||{MS:1}{MS:0}b{MS:2}ut isn't it kind of sexy?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_3"
msgid "W{MS:0}hat?{PA:20}||Really?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_4"
msgid "Not really.{PA:20}"
msgstr "No.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_5"
msgid "M{MS:0}an.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_6"
msgid "This is the first time anyone's ever||said that to me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_7"
msgid "Sorry,{PA:10} but you asked.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_8"
msgid ".{PA:20}.{PA:20}.{PA:20}I{MS:0}t's not like I'm wearing it||because I want to!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_9"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_10"
msgid "H{MS:0}ee hee!{PA:20}||Thanks!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_11"
msgid "It makes you look very womanly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_12_12"
msgid "O{MS:0}h,{PA:10} stop!{PA:20}❤"
