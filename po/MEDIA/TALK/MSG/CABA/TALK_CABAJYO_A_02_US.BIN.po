msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_0"
msgid "H{MS:0}ey,{PA:10} Kazzy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_1"
msgid "I'm curious.{PA:20}.{PA:20}.{PA:20}||Do you like girls with big boobs?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_2"
msgid "That was out of the blue!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_3"
msgid "B{MS:0}ut I mean,{PA:10}||all guys are like that,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_4"
msgid "A{MS:0}ww,{PA:10} I knew it.{PA:20}||You're the same way.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_5"
msgid "Well,{PA:10} what do you think of mine?{PA:20}||{MS:0}I've got no hope,{PA:10} do I?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_6"
msgid "That's not true.{PA:20}"
msgstr "¡Eso no es cierto!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_7"
msgid "I wonder if they'll get any bigger.{PA:20}.{PA:20}.{PA:20}||{MS:1}{MS:0}S{MS:2}igh.{PA:20}.{PA:20}.{PA:20} I'm so sad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_8"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_9"
msgid "R{MS:0}eally!?{PA:20}||F{MS:1}or reals!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_10"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_11"
msgid "For really reals,{PA:10} swear?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_12"
msgid "Uh,{PA:10} yeah.{PA:20}"
msgstr "Sí..{PA:10}. Este...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_13"
msgid "T{MS:0}hat's great!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_14"
msgid "It's nice to know not every guy is hooked||on {MS:0}big ones!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_16"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_17"
msgid "Then what do you look for in a girl?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_18"
msgid "Let's see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Veamos..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_19"
msgid ".{PA:20}.{PA:20}.{PA:20}Empathy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_20"
msgid ".{PA:20}.{PA:20}.{PA:20}||{MS:0}I {MS:1}don't know much about stuff like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_21"
msgid "When you grow up,{PA:10} you'll understand.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_0_22"
msgid "H{MS:0}ey!{PA:20}||I AM grown up!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_0"
msgid "I{MS:0} love to listen to music,{PA:10}||but I love singing even more!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_1"
msgid "D{MS:0}o you like to sing?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_2"
msgid "Singing,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_3"
msgid "Y{MS:0}eah,{PA:10} like do you go to karaoke,{PA:10}||or sing in the shower or anything?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_4"
msgid "R{MS:0}eally!?{PA:20} {MS:1}I want||to hear you sing,{PA:10} {MS:2}Kazzy!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_5"
msgid "No one wants to hear me sing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_6"
msgid "That's not true!{PA:20} Singing is so freeing!{PA:20}||But the most important thing is to have fun.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_7"
msgid "It's pretty fun to sing at karaoke bars,{PA:10}||don't you think?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_8"
msgid "Yeah,{PA:10} maybe.{PA:20}"
msgstr "Un {PA:10}poco.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_9"
msgid "T{MS:0}he next time you go,{PA:10}||you've got to take me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_10"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_11"
msgid "Y{MS:0}ou sing in the shower?{PA:20}||{MS:1}T{MS:2}hat's so cute!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_12"
msgid "Cute.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_13"
msgid "Y{MS:0}eah!{PA:20} I love singing in the shower,{PA:10} too.{PA:20}||You always sound better in the shower.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_14"
msgid "But I used to live on the first floor,{PA:10}||so people walking by could hear me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_15"
msgid "I{MS:0}t was soooo embarrassing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_16"
msgid "So be careful when you sing in the shower.{PA:20}||Someone might be listening!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_17"
msgid "Gotcha.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_18"
msgid "O{MS:0}h,{PA:10} that's too bad.{PA:20}||It's such a waste,{PA:10} you've got a nice voice!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_19"
msgid "Not nice enough to sing in front of people.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_20"
msgid "Y{MS:0}ou're so bashful!{PA:20}||{MS:1}I'll give you a crash course in karaoke!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_21"
msgid "Once you get used to it,{PA:10} you'll have fun!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_22"
msgid "I'll think about it.{PA:20}"
msgstr "Lo pensaré...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_23"
msgid "Y{MS:0}ou don't seem very excited.{PA:20}||{MS:1}But if you're ever in the mood,{PA:10} let me know!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_1_24"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_0"
msgid "I{MS:0}'m not very good at a lot of things,{PA:10}||but I'm a pretty awesome baker!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_1"
msgid "I make cookies and apple pies.{PA:20}.{PA:20}.{PA:20}||Even cream puffs.{PA:20} I can make a mean puff!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_2"
msgid "You're really into it,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_3"
msgid "Y{MS:0}eah.{PA:20} My grandma taught me||when I was little.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_4"
msgid "W{MS:0}ant to try something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_5"
msgid "For you,{PA:10} I'd make anything.{PA:20}||You name it!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_6"
msgid "Maybe something not too sweet.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_7"
msgid "O{MS:0}kay!{PA:20} I'll make you the best||non-sweet sweets ever!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_8"
msgid "L{MS:0}ook forward to it!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_9"
msgid "I can't wait.{PA:20}"
msgstr "No puedo esperar.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_10"
msgid "O{MS:0}h,{PA:10} I see.{PA:20}.{PA:20}.{PA:20}||A lot of guys don't like sweets,{PA:10} do they?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_11"
msgid "I just can't get into them.{PA:20}||But I'm sure they're great.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_12"
msgid "Yeah,{PA:10} they're really good.{PA:20}||{MS:1}{MS:0}It's too bad I can't get you to try them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_13"
msgid "Sorry.{PA:20}"
msgstr "Perdón.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_14"
msgid "H{MS:0}ee hee hee hee!{PA:20}❤||You're so funny!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_15"
msgid "S{MS:0}orry,{PA:10} Kazzy,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_16"
msgid "but it's not going to be that easy!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_17"
msgid "What do I need to do?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_18"
msgid "I {MS:1}{MS:0}wonder.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_19"
msgid "Y{MS:0}ou need to convince me to like you||more than anyone else in the world.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_2_20"
msgid "Hm.{PA:20} Sounds like a challenge.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_0"
msgid "I {MS:0}started paragliding.{PA:20}||It's sort of like a parachute.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_1"
msgid "That sounds dangerous.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_2"
msgid "I {MS:0}know,{PA:10}||but I've always wanted to do it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_3"
msgid "Y{MS:0}ou jump into the air and it swooshes you up||and you float away.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_4"
msgid "Y{MS:0}eah,{PA:10} it's really fun!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_5"
msgid "When you're flying,{PA:10} you forget everything||and it feels so natural.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_6"
msgid "It sounds liberating.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_7"
msgid "Y{MS:0}eah,{PA:10} exactly.{PA:20} It's great!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_8"
msgid "I {MS:0}want to try doing||it with you!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_9"
msgid "I'll think about it.{PA:20}"
msgstr "Lo pensaré...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_10"
msgid "I{MS:0}t's not scary!{PA:20}||Well,{PA:10} after you get used to it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_11"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_12"
msgid "Or could it be.{PA:20}.{PA:20}.{PA:20}||Are you afraid of heights or something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_13"
msgid "Not really.{PA:20}||What about you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_14"
msgid "T{MS:0}o be honest,{PA:10} I am a little.{PA:20}||But it feels so good to fly!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_15"
msgid "As soon as you jump,{PA:10} your butt wiggles for||a second.{PA:20} It's the best feeling!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_16"
msgid "Hey Kazzy.{PA:20}.{PA:20}.{PA:20}||{MS:0}W{MS:1}e should wiggle our butts together!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_18"
msgid "Y{MS:0}eah,{PA:10} it's really fun.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_19"
msgid "There's nothing more fun||than paragliding,{PA:10} in my opinion.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_20"
msgid "What makes it so good?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_21"
msgid "T{MS:0}he squirming feeling you get when you jump||and the feeling of freedom are the best.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_22"
msgid "Squirming.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_23"
msgid "I'm thinking about going next week.{PA:20}||I{MS:0}f you come,{PA:10} we can squirm together!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_3_24"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_0"
msgid "M{MS:0}an,{PA:10} I wish||I were taller!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_1"
msgid "When you're short,{PA:10} no matter how stylish you||dress,{PA:10} you still look like a kid.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_2"
msgid "Is that right?{PA:20}"
msgstr "¿Cierto?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_3"
msgid "W{MS:0}hen Karen wears jeans,{PA:10}||she looks so cool.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_4"
msgid "I{MS:0}'m so jealous!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_5"
msgid "Y{MS:0}eah,{PA:10} you're right.{PA:20}.{PA:20}.{PA:20}||But when we pick clothes to wear here.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_6"
msgid "Just pick something that suits you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_7"
msgid "I{MS:0}t's not that.{PA:20}||It's just that so few clothes suit me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_8"
msgid "G{MS:0}uys just don't understand||this sort of thing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_9"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_10"
msgid "Ha{MS:0} ha ha!{PA:20}"
msgstr "¡Ja{MS:0}, ja, ja!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_11"
msgid "But I don't like milk.{PA:20}||I feel sick when I drink it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_12"
msgid "I like yogurt,{PA:10} though.{PA:20}||Is yogurt good enough?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_13"
msgid "Maybe it's just your age.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_14"
msgid "W{MS:0}hat a mean thing to say!{PA:20}||{MS:1}You're cruel!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_16"
msgid "T{MS:0}hanks,{PA:10} Kazzy!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_17"
msgid "A lot of people say that,{PA:10}||but I still want to be taller.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_18"
msgid "What about your parents?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_19"
msgid "T{MS:0}hat's the thing.{PA:20} They're both tall!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_20"
msgid "S{MS:0}o maybe someday I'll suddenly grow tall!{PA:20}||A girl can dream.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_4_21"
msgid "Good luck with that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_0"
msgid "I{MS:0} had a rough day the other day,{PA:10}||so I went to sing karaoke with my friend.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_1"
msgid "We sang and sang and sang,{PA:10} and before we||knew it,{PA:10} it had been eight hours!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_2"
msgid "You've got some stamina.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_3"
msgid "Y{MS:0}eah,{PA:10} right?{PA:20}||But my throat got really dry.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_4"
msgid "D{MS:0}o you go to karaoke too,{PA:10} Kazzy?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_5"
msgid "W{MS:0}ow,{PA:10} you go to karaoke too?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_6"
msgid "Sometimes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_7"
msgid "T{MS:0}hat's so weird!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_8"
msgid "I can't even imagine you||in a karaoke room!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_9"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_10"
msgid "I{MS:0} didn't think so.{PA:20}||But sometimes you sing at bars,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_11"
msgid "When everyone else is singing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_12"
msgid "Y{MS:0}eah,{PA:10} that's how I||picture you.{PA:20} {MS:1}I'm relieved.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_13"
msgid "Relieved.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_14"
msgid "I{MS:0} couldn't see you singing in a||private karaoke room.{PA:20} That would be weird.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_16"
msgid "W{MS:0}ell then,{PA:10} should we go?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_17"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_18"
msgid "B{MS:0}ut I bet while we're singing,{PA:10}||you'll put your arm around me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_19"
msgid "Could be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_20"
msgid "That's.{PA:20}.{PA:20}.{PA:20}||If that happened.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_21"
msgid "I'd totally freak out!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_22"
msgid "In a bad way?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_23"
msgid "Geez.{PA:20}.{PA:20}.{MS:0}{PA:20} Don't be so serious!{PA:20}||{MS:2}{MS:1}M{MS:3}aybe you should go sing alone!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_5_24"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_0"
msgid "W{MS:0}hen I was in high school,{PA:10} we all||traded our home-made lunches.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_1"
msgid "Like with your boyfriend?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_2"
msgid "No,{PA:10} just the girls.{PA:20}||We were really just trying to show off.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_3"
msgid "I {MS:0}wanted to impress them,{PA:10} so every||morning I woke up early and worked hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_4"
msgid "Before I knew it,{PA:10}||{MS:1}{MS:0}m{MS:2}ine were the most popular.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_5"
msgid "That's cute.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_6"
msgid "And {MS:0}thanks to that,{PA:10}||I grew to love cooking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_7"
msgid "R{MS:0}eally!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_8"
msgid "W{MS:0}ell then,{PA:10} next time I'll make you something.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_9"
msgid "What do you like more,{PA:10} rice balls or soup?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_10"
msgid "Rice balls.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_11"
msgid "O{MS:0}kay!{PA:20} I'll make you some||{MS:1}extra-delicious rice balls!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_12"
msgid "You'll see!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_13"
msgid "Great.{PA:20}"
msgstr "Excelente.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_14"
msgid "T{MS:0}hat's so mean!{PA:20}||You don't believe in me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_15"
msgid "Next time I'll make something and bring it in.{PA:20}||You'll eat it and like it!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_16"
msgid "Okay,{PA:10} I'm expecting something good.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_17"
msgid "I{MS:0}'ll make something that'll||blow you away!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_18"
msgid "Hee{MS:0} hee!{PA:20} Well,{PA:10} maybe.{PA:20}.{PA:20}.{PA:20}❤||A wife.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_19"
msgid "My husband.{PA:20}.{PA:20}.{PA:20}||I wonder what kind of person he'll be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_20"
msgid "He could be like me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_6_21"
msgid "H{MS:0}ee hee!{PA:20} Maybe!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_0"
msgid "T{MS:0}he other weekend,{PA:10} it rained,{PA:10}||so we had to cancel"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_1"
msgid "my paragliding lesson.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_2"
msgid "I was looking forward to it so much.{PA:20}||{MS:2}{MS:1}{MS:0}I was so disappointed.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_3"
msgid "Y{MS:0}eah.{PA:20} Just a bit more and||I'll earn my technical license.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_4"
msgid "Technical license?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_5"
msgid "I{MS:0}t's a paragliding license.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_6"
msgid "If you have that,{PA:10} you can fly without||an instructor.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_7"
msgid "I want to show you!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_8"
msgid "I look forward to seeing it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_9"
msgid "T{MS:0}hat's easier said than done!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_10"
msgid "It really depends on the weather,{PA:10} and||the reservations get booked up fast.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_11"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_12"
msgid "I{MS:0}t's a sport you can't do by yourself,{PA:10}||so everyone scrambles to get an instructor.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_13"
msgid "Seems tough.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_14"
msgid "I{MS:0}t is!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_15"
msgid "Next time,{PA:10} I hope it's clear out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_16"
msgid "Y{MS:0}ou think I don't know that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_17"
msgid "Hm?{PA:20}"
msgstr "¿Mm?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_18"
msgid "Even as a kid,{PA:10} whenever I'd go outside to play||it would always start raining.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_19"
msgid "I{MS:0}t has always been this way||for me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_20"
msgid "O{MS:0}h,{PA:10} I know!{PA:20} Maybe I should||find a guy who makes rainy days go away.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_7_21"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_0"
msgid "K{MS:0}azzy,{PA:10} I want||to be taller.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_1"
msgid "Why?{PA:20}"
msgstr "¿Por qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_2"
msgid "B{MS:0}ecause since I work here,{PA:10}||I always want to dress up nice,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_3"
msgid "but they don't sell fashionable||clothes in my size.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_4"
msgid "W{MS:0}ell,{PA:10} it's not like they don't sell them||ANYWHERE,{PA:10} but there isn't a lot out there.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_5"
msgid "What about getting your clothes||custom made?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_6"
msgid "B{MS:0}ut that's so expensive!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_7"
msgid "I'll introduce you to my friend's shop.{PA:20}||They should be able to do it for cheap.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_8"
msgid "R{MS:0}eally!?{PA:20} That would be sweet!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_9"
msgid "I'll show you next time.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_11"
msgid "T{MS:0}hat's not nice,{PA:10} Kazzy!{PA:20}||Treating me like a child.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_12"
msgid "I{MS:0} don't shop at kids' stores||because I have pride!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_13"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_14"
msgid "I{MS:0} don't think you get it,{PA:10} Kazzy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_15"
msgid "Why don't you wear what looks good on you||and start your own trends?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_16"
msgid "W{MS:0}hat?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_17"
msgid "Then size wouldn't matter,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_18"
msgid "W{MS:0}ell,{PA:10} that's one way to look at it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_8_19"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_9_0"
msgid "I{MS:0}'ve been getting into Japanese country music.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_9_1"
msgid "You seem too young for that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_9_2"
msgid "I{MS:0} wonder sometimes.{PA:20} Before,{PA:10} I||thought it sucked 'cause it was so outdated.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_9_3"
msgid "Maybe I like it because I'm so sensitive,{PA:10}||or because the lyrics are so sad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_9_4"
msgid "D{MS:0}o you like Japanese country music,{PA:10} Kazzy?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_9_5"
msgid "S{MS:0}o you like it too!{PA:20}"
msgstr ""

