msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_0"
msgid "I{MS:0}t's almost the New Year.{PA:20}||What are your plans,{PA:10} Kazzy?{PA:20}"
