msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_24"
msgid "And that's why you sleep through it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_25"
msgid "H{MS:0}a ha ha!{PA:20} That's right!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_0"
msgid "H{MS:0}ey Kazzy,{PA:10}||what are your hobbies?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_1"
msgid "Hobbies.{PA:20}.{PA:20}.{PA:20}"
msgstr "¿Pasatiemp{PA:20}os{PA:20}?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_2"
msgid "Let's see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Veamos..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_3"
msgid "Y{MS:0}eah,{PA:10} I can see that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_4"
msgid "You always seem busy.{PA:20}||But you don't complain,{PA:10} do you?{PA:20}"
