msgstr "¿Qué le pasó?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_5"
msgid "Y{MS:0}eah,{PA:10} there's a customer who always||requests me,{PA:10} but then he just teases me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_6"
msgid "But if you're right,{PA:10} then||maybe he just likes me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_7"
msgid "Maybe.{PA:20}"
msgstr "Quizá.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_8"
msgid "M{MS:0}aybe I'm wrong.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_9"
msgid "I{MS:0} thought so.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_10"
msgid "Did something happen?{PA:20}"
msgstr "¿Qué le pasó?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_11"
msgid "Y{MS:0}eah,{PA:10} there's a customer who always||requests me,{PA:10} but then he just teases me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_12"
msgid "He might just be using that as a diversion.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_13"
msgid "Using me to relieve stress?{PA:20}||{MS:1}{MS:0}W{MS:2}hat a pain!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_14"
msgid "It would be so much nicer||{MS:2}{MS:1}{MS:0}i{MS:3}f all my customers were as kind as you!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_15"
msgid "It's my pleasure.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_16"
msgid "W{MS:0}hat do you mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_17"
msgid "What what,{PA:10} tell me!{PA:20} I don't get it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_19_18"
msgid "Well,{PA:10} let's just leave it at that.{PA:20}||Can I have a refill,{PA:10} please?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_0"
msgid "H{MS:0}ey Kazzy,{PA:10} if I were an animal,{PA:10}||what do you think I'd be?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_1"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} An animal?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_2"
msgid "W{MS:0}hen I was little,{PA:10} I always stuck close to my||parents,{PA:10} so they said I was like a dog.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_3"
msgid "Really?{PA:20} But.{PA:20}.{PA:20}.{PA:20}||{MS:1}{MS:0}I don't really want to be like a puppy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_4"
msgid "Why not?{PA:20}"
msgstr "¿Por qué, no?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_5"
msgid "W{MS:0}ell,{PA:10} puppies are always using their||eyes to beg and stuff.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_6"
msgid "It's like,{PA:10} they're so calculating!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_7"
msgid "You think so?{PA:20}"
msgstr "¿Tú crees?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_8"
msgid "R{MS:0}ight!{PA:20} I like||cats more than dogs.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_9"
msgid "They like to be taken care of,{PA:10} but they're||not such beggars.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_10"
msgid "They have pride.{PA:20}||I like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_11"
msgid "You're the same way.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_12"
msgid "Hee {MS:0}hee!{PA:20} You're good!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_13"
msgid "A {MS:0}piglet!{PA:20} You're so mean!{PA:20}||We're talking about my personality!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_14"
msgid "Y{MS:0}ou should never compare a girl||to a pig!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_15"
msgid "I mean,{PA:10} I've got enough body issues||as it is!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_16"
msgid "I {MS:0}try so hard.{PA:20}.{PA:20}.{PA:20}||But I'll never feel beautiful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_20_17"
msgid "I'm sorry.{PA:20}"
msgstr "le pido disculpas.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_0"
msgid "I{MS:0} live alone,{PA:10} and||sometimes it gets pretty lonely.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_1"
msgid "I{MS:0}'m thinking of getting a cat.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_2"
msgid "Where does your family live?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_3"
msgid "In Tokyo.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_4"
msgid "Why don't you live with your family,{PA:10} then?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_5"
msgid "No,{PA:10} I can't.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_6"
msgid "Well,{PA:10} there's been some||family drama.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_7"
msgid "You don't get along with your parents?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_8"
msgid "No,{PA:10} we get along.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_9"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_10"
msgid "When I'm home.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_11"
msgid "I{MS:0}t brings back memories.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_12"
msgid "I won't make you talk about it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_13"
msgid "Thanks.{PA:20}.{PA:20}.{PA:20}||{MS:2}{MS:1}{MS:0}Y{MS:3}ou're so sweet!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_14"
msgid "A guy.{PA:20}.{PA:20}.{PA:20} Yeah,{PA:10} well.{PA:20}.{PA:20}.{PA:20}||That might be it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_15"
msgid "Then you should live together.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_16"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} If I could||do that,{PA:10} that'd be cool.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_18"
msgid "T{MS:0}hey're fine with my work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_19"
msgid "My dad doesn't know what I do,{PA:10}||but my mom supports me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_20"
msgid "Then what?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_21"
msgid "Well.{PA:20}.{PA:20}.{PA:20} When I'm home,{PA:10}||it brings back a lot of memories.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_0_22"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_0"
msgid "I{MS:0} hate the rain.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_1"
msgid "Because you get wet?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_2"
msgid "No.{PA:20}.{PA:20}.{PA:20} A year ago.{PA:20}.{PA:20}.{PA:20} My brother||got into a bike accident.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_4"
msgid "While he was on his way to pick me up,{PA:10}||it started to rain and his tire slipped.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_5"
msgid "I{MS:0}f only I didn't ask||him to come.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_6"
msgid "Whenever I'm home it's hard.{PA:20}.{PA:20}.{PA:20}||So I moved out.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_7"
msgid "Yeah.{PA:20}.{PA:20} That's what everyone says.{PA:20}||{MS:0}But I can't see it that way.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_8"
msgid "So it's really hard for me to be alone||on rainy days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_9"
msgid "Then you should be with someone.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_11"
msgid "When things are tough,{PA:10} let me know.{PA:20}||I can at least be by your side.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_12"
msgid "Y{MS:0}eah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_13"
msgid "T{MS:0}hank you,{PA:10} Kazzy.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_14"
msgid "I{MS:0} know.{PA:20}||But I loved him.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_15"
msgid "It was always my dream he'd give me his||blessing for my husband someday.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_16"
msgid "But.{PA:20}.{PA:20}.{PA:20}"
msgstr "Pero.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_17"
msgid "Do you think your brother would approve||of you blaming yourself like this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_18"
msgid "W{MS:0}hat.{PA:20}.{PA:20}.{PA:20}?{PA:20}➿I guess not.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_19"
msgid "You should be happy.{PA:20} He'd want that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_20"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_21"
msgid "I{MS:0} can't just forget it.{PA:20}||He died because of me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_22"
msgid "I{MS:0}t was my fault.{PA:20} If I forget it,{PA:10}||then what about my brother?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_1_23"
msgid "I think he would be much more upset to know||he's causing his sister so much pain.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_0"
msgid "I{MS:0}n high school when we traded lunches,{PA:10}||my brother would always taste mine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_1"
msgid "W{MS:0}hen I think about it now,{PA:10} at first||it must have tasted pretty horrible.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_2"
msgid "But my brother never once||said so.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_3"
msgid "He always said it was delicious.{PA:20}||It made me so happy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_4"
msgid "B{MS:0}ut now there's no one||to eat what I make.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_5"
msgid "W{MS:0}hat.{PA:20}.{PA:20}.{PA:20}?{PA:20}||You'd eat it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_6"
msgid "But I won't say just anything is delicious.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_7"
msgid "T{MS:0}hat's okay!{PA:20}||Because now I'm a great cook!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_8"
msgid "Will you come over and||try my cooking sometime?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_9"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_10"
msgid "T{MS:1}{MS:0}hat would be great!{PA:20}❤❤❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_11"
msgid "I don't have anyone like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_12"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_13"
msgid "Y{MS:0}eah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_14"
msgid "When I look at guys,{PA:10} I||always end up comparing them to my brother.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_15"
msgid "That sounds daunting.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_16"
msgid "D{MS:0}aunting?{PA:20} What do you mean?{PA:20}||Are you competing with him?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_17"
msgid "It doesn't seem like I'd stand a chance.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_18"
msgid "T{MS:0}hat's not true.{PA:20}||You're kind and mature.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_19"
msgid "A{MS:0}nd so sweet!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_20"
msgid "Shucks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_21"
msgid "Mom and Dad||know about my lunches.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_22"
msgid "When I cook for them,{PA:10} it brings||back a lot of memories.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_23"
msgid "So it's also kind of hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:10_2_24"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:11_0_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} Kazzy.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:11_0_1"
msgid "You.{PA:20}.{PA:20}.{PA:20} came.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:11_0_2"
msgid "I wanted to see your face.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:11_0_3"
msgid "When you say stuff like that,{PA:10} it||{MS:0}makes me so happy!{PA:20}❤"
msgstr ""

