msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_2_1"
msgid "If you leave,{PA:10} I'm going||to be so lonely.{PA:20}.{PA:20}.{PA:20}"
