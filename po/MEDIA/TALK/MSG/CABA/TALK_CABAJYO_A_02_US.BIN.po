msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_10"
msgid "T{MS:0}hat's an old man's hobby.{PA:20}||I can't picture you doing that.{PA:20}"
