msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_0"
msgid "Hee{MS:0} hee hee!{PA:20}||You're so funny,{PA:10} Kazzy!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_1"
msgid "Oh yeah,{PA:10} here's my email address!{PA:20}❤||Give me yours too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_2"
msgid "I'll send you lots of spam to make sure||y{MS:0}ou don't forget me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_3"
msgid "Spam?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_4"
msgid "Don't be like that.{PA:20}"
msgstr "No seas así.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_5"
msgid "I only send spam to people I really like!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_6"
msgid "And when we get to know each other better,{PA:10}||I might send you more personal emails.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_1_7"
msgid "Just be sure to reply sometimes.{PA:20}||One-way communication is so sad!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:6_2_0"
msgid "A{MS:0}www,{PA:10} our time's up already.{PA:20}"
