msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_14"
msgid "But.{PA:20}.{PA:20}.{PA:20}"
msgstr "Pero.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_15"
msgid "I shouldn't have to justify||a little relaxation!{PA:20}"
