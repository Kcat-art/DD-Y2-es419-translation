msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:0_0_0"
msgid "H{MS:1}{MS:0}i there!{PA:20}||T{MS:2}hanks for picking me!{PA:20}"
