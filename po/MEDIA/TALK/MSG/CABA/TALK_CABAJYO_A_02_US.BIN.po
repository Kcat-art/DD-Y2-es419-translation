msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_6"
msgid "I guess so.{PA:20}"
msgstr "Supongo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_7"
msgid "B{MS:0}onsai!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_11_8"
msgid "H{MS:0}a ha!{PA:20} I don't believe you!{PA:20}"
