msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_02_US.BIN::line:9_10_11"
msgid "But you always look so busy.{PA:20}||{MS:1}{MS:0}You should at least rest on the New Year!{PA:20}"
