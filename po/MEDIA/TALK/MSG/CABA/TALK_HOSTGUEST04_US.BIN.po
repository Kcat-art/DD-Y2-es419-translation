msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_3_1"
msgid "I {MS:0}see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Ent{MS:0}iendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_3_2"
msgid "A lot of time has passed since||I started in this industry.{PA:20}"
