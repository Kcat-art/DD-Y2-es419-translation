msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_5_7"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}❤||Thanks.{PA:20}"
