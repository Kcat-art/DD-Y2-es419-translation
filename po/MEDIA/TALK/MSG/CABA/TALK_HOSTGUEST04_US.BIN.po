msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_4_7"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}❤||I guess that's true.{PA:20}"
