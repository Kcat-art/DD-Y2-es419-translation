msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_0"
msgid "K{MS:0}azuma,{PA:10} what's your hobby?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_1"
msgid "W{MS:0}ell.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_2"
msgid "A{MS:0}hahaha!{PA:20}||Kazuma,{PA:10} you're a card.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_3"
msgid "B{MS:0}y being a host,{PA:10} I||meet so many interesting people.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_4"
msgid "H{MS:0}eh!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_5"
msgid "I have fun meeting||different hosts,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_6"
msgid "I{MS:0} see.{PA:20}||So your hobby and job are one and the same.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_7"
msgid "Y{MS:0}es they are.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_8"
msgid "B{MS:0}ut there's more to being a host||than just seducing women.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_9"
msgid "I guess that's true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_10"
msgid "W{MS:0}hat!?{PA:20}||You don't have any hobbies?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_11"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Nope,{PA:10} nothing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_12"
msgid "That makes it hard to keep a conversation going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_13"
msgid "Everyone should have a hobby.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_14"
msgid "Without one,{PA:10} life is just dull.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_0_15"
msgid "Maybe.{PA:20}"
msgstr "Quizá.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_0"
msgid "K{MS:0}azuma,{PA:10} why did you become||a host?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_1"
msgid "L{MS:0}et's see.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_2"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}I haven't heard that one.{PA:20}||Not for a long time,{PA:10} at least.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_3"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_4"
msgid "You won't fool any customers||with lines like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_5"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}I'm sorry.{PA:20}"
msgstr "L{PA:20}o{PA:20} {MS:0}{PA:20}lamento...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_6"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||I see.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_7"
msgid "A{MS:0}s a host,{PA:10} I am the product.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_8"
msgid "I want to know how much value I have||as a product.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_9"
msgid "I{MS:0} see.{PA:20}"
msgstr "Y{MS:0}a veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_10"
msgid "But isn't it about how much||you can entertain the customer?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_11"
msgid "You won't do well if you're always||thinking about yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_12"
msgid ".{PA:20}.{PA:20}.{PA:20}Yeah.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_13"
msgid "A{MS:0}hahaha!{PA:20}||Is that so?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_14"
msgid "It's not something I'd expect a host to say.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_15"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Yeah.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{MS:0}{PA:20} Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_16"
msgid "Well,{PA:10} that may have been how I got started,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_17"
msgid "but in the end,{PA:10} it's all about keeping||people happy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_18"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}||{MS:2}{MS:1}That's right.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_1_19"
msgid "The way I got started is pretty simple,{PA:10} too.{PA:20}"
msgstr ""

