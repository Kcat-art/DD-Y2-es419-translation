msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_4_0"
msgid "T{MS:0}his is embarrassing for me||to admit,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
