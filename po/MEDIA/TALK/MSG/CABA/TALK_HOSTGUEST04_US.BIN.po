msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_4_3"
msgid "But now,{PA:10} somehow,{PA:10} I grew up to manage clubs||in the Ginza.{PA:20}"
