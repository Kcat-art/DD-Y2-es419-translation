msgid "So it must be pretty smart.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_7_20"
msgid "T{MS:0}hat's not true.{PA:20}||It was a stray cat.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_7_21"
msgid "Is that so?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_7_22"
msgid "So I don't think price has||anything to do with it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_7_23"
msgid "It has more to do with upbringing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_7_24"
msgid "That may be true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_0"
msgid "This is just between you and me,{PA:10} but||once upon a time.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_1"
msgid "I fell in love with one of||my customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_2"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Really?{PA:20}"
msgstr ".{PA:20}..{PA:20} {MS:0}{PA:20}¿En serio?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_3"
msgid "In the end,{PA:10} it didn't work out.{PA:20}||But maybe it was for the best.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_4"
msgid "That's certainly true.{PA:20}.{PA:20}.{PA:20}||But maybe I regret what I've become.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_5"
msgid "But what's wrong with that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_6"
msgid "I think that he would support||what you're doing now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_7"
msgid "He{MS:0}h.{PA:20} You think so?{PA:20}||That makes me feel better.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_8"
msgid "T{MS:0}hanks.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_9"
msgid "H{MS:0}uh?{PA:20} Too late for what?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_10"
msgid "For you to go seek him||out,{PA:10} the man you loved.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_11"
msgid "W{MS:0}hat are you talking about?{PA:20}||I lost him.{PA:20} He's married to someone else.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_12"
msgid "So it is too late!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_13"
msgid "Oh.{PA:20} I see.{PA:20}"
msgstr "Oh.{PA:20} Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_14"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Sorry about that.{PA:20}"
msgstr "P{PA:20}e{PA:20}r{MS:0}{PA:20}dón por eso...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_15"
msgid "L{MS:0}ay off the jokes!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_16"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm not good enough?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_17"
msgid "T{MS:0}hat's not what||I'm saying.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_18"
msgid ".{PA:20}.{PA:20}.{PA:20}I see.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_19"
msgid "This isn't the time to go||hitting on me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_8_20"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{MS:0}{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_0"
msgid "K{MS:0}azuma,{PA:10} have you learned anything||from this job?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_1"
msgid "L{MS:0}et's see.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_2"
msgid "A{MS:0}hahaha!{PA:20}||That's important,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_3"
msgid "I{MS:0}n a customer-oriented industry,{PA:10}||it's indispensable.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_4"
msgid "But it's funny to think about a||tough guy like you reading a room.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_5"
msgid "I{MS:0}t's kind of cute,{PA:10} actually.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_6"
msgid ".{PA:20}.{PA:20}.{PA:20}Is it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_7"
msgid "I {MS:0}see.{PA:20}||How do you spot them?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_8"
msgid "The key is brand-name products.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_9"
msgid "You can tell when you see their clothes||and accessories.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_10"
msgid "W{MS:0}ow,{PA:10} so you only judge||them on their appearance?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_11"
msgid "Just because they look rich doesn't||mean they're going to be a good customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_12"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_13"
msgid "A{MS:0}haha!{PA:20}||Is that right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_14"
msgid "Well then,{PA:10} what's||your technique?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_15"
msgid "Well,{PA:10} first you stare at them||like this,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_16"
msgid "T{MS:0}hat isn't going to||seduce anyone,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_9_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_0"
msgid "W{MS:0}hen I was a young girl,{PA:10}||my parents disappeared.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_1"
msgid "So I was raised at||a relative's house.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_2"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Now I feel down.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_3"
msgid "But I guess you can't help but||feel bitter at your parents.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_4"
msgid "I don't feel any bitterness||towards them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_6"
msgid "Sorry to bring up such a||depressing topic.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_7"
msgid "Yes,{PA:10} I think it does.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_8"
msgid "Maybe {MS:0}now that's all I||really want.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_9"
msgid "H{MS:0}arboring bitterness would only||hurt you,{PA:10} anyway.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_10"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}But I'll be that stability{MS:2}{MS:1}||if you'll have me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_11"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20} How nice of you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_12"
msgid "T{MS:0}hanks.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_13"
msgid "Okay,{PA:10} how will you make||me forget?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_14"
msgid "We{MS:0}ll,{PA:10} uh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_15"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_16"
msgid "It's all right,{PA:10} you're off the spot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_10_17"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_0"
msgid "At {MS:0}Ginza clubs,{PA:10} when you choose a hostess,{PA:10}||she's your permanent hostess from then on.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_1"
msgid "Y{MS:0}eah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_2"
msgid "Plus,{PA:10} we don't allow walk-in customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_3"
msgid "You can only be introduced||by a current customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_4"
msgid "I {MS:0}see.{PA:20}"
msgstr "Ya{MS:0} veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_5"
msgid "They say a good club is built||on a foundation of good customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_6"
msgid "Well,{PA:10} certainly the customers||play a role.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_7"
msgid "Some clubs go under because a single||important customer stops coming.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_8"
msgid "In the end,{PA:10} it's a very||fickle business.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_9"
msgid "Isn't it our job to see||that everything comes together?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_10"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Yeah.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{MS:0}{PA:20} Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_11"
msgid "Y{MS:0}ou won't succeed if you||think like that,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_12"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_13"
msgid "It{MS:0}'s definitely a limiting rule,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_14"
msgid "but we can better serve the customer if||it's one-on-one like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_15"
msgid "Because every customer is important to us.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_16"
msgid "I {MS:0}see.{PA:20}"
msgstr "Ya{MS:0} veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_17"
msgid "Kazuma,{PA:10} it's like you don't get how||to interact with customers yet.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_18"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{MS:0}{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_19"
msgid "I {MS:0}see.{PA:20}||Host clubs have permanent hosts,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_20"
msgid "B{MS:0}ut we can't relax just because||selections are permanent.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_21"
msgid "We need to make sure we treat the customers||right,{PA:10} every time we see them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_22"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}❤||Exactly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_11_23"
msgid "That spirit is important.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_0"
msgid "T{MS:0}he other day I got into a big fight||with one of the hostesses at my club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_1"
msgid "She said she didn't like the way I did things.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_2"
msgid "And then she threatened||to quit.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_3"
msgid "It would be really tough if||we lost her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_4"
msgid "I {MS:0}see.{PA:20}"
msgstr "Ya{MS:0} veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_5"
msgid "T{MS:0}hat's true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_6"
msgid "But in this business you have to be able to||rely on your coworkers,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_7"
msgid "If {MS:0}she wants to quit,{PA:10} let her.{PA:20}||The ones that stay are the real deal.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_8"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_9"
msgid "That's a pretty simplistic||view of the world.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_10"
msgid "W{MS:0}hy do you say that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_11"
msgid "In this business,{PA:10} people are always||coming and going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_12"
msgid "So in the end,{PA:10} eventually she'll probably||be back at your club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_13"
msgid "I don't allow that kind of thing||at my club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_14"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_15"
msgid "K{MS:0}azuma,{PA:10} try to think before||you speak.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_16"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{MS:0}{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_17"
msgid "I {MS:0}know,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_18"
msgid "I think she probably wanted to||make the club successful,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_19"
msgid "You should really talk||it out with her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_20"
msgid "I think she'll definitely see||where you're coming from.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_21"
msgid "Y{MS:0}ou might be right.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_12_22"
msgid "I'm glad we talked about this.{PA:20}❤||I feel a little better now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_0"
msgid "I {MS:0}look pretty young,{PA:10} don't I?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_1"
msgid "First-time customers don't believe that||I run the club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_2"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20} Isn't that funny?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_3"
msgid "You think so?{PA:20}"
msgstr "¿Tú crees?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_4"
msgid "I{MS:0}f you didn't have the knowledge,{PA:10}||you wouldn't make it as a business manager.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_5"
msgid "That's true.{PA:20}"
msgstr "Sí, es cierto.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_6"
msgid "But if people think you're unreliable,{PA:10}||it affects the club's image negatively.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_7"
msgid "I {MS:0}see.{PA:20}"
msgstr "Ya{MS:0} veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_8"
msgid "T{MS:0}hat's what I have to worry about.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_9"
msgid "So you think so||too?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_10"
msgid "B{MS:0}ut I don't think that has to||work against you necessarily.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_11"
msgid "If someone talks to you once,{PA:10}||they'll see how great you are.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_12"
msgid "H{MS:2}{MS:1}{MS:0}eh.{PA:20}.{PA:20}.{PA:20}||I hope so.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_13"
msgid "T{MS:0}hanks.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_14"
msgid "H{MS:0}ey!{PA:20}||That's not very helpful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_15"
msgid "Sorry.{PA:20}"
msgstr "Perdón.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_16"
msgid "I'm working hard to be the best||manager I can be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_17"
msgid "I{MS:0} didn't come here to listen||to you belittle me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_13_18"
msgid "I.{PA:20}.{PA:20}.{MS:0}{PA:20} didn't mean.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_0"
msgid "H{MS:0}ey,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_1"
msgid "Our work involves a lot of drinking,{PA:10}||doesn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_2"
msgid "Y{MS:0}es.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_3"
msgid "So it's important that we really||take care of our health.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_4"
msgid "When I drink too much,{PA:10} the next||day my skin is always so chapped.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_5"
msgid "I drank a lot yesterday,{PA:10}||but does my skin look okay?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_6"
msgid "Yes.{PA:20}.{PA:20}.{PA:20}||That might be it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_7"
msgid "I{MS:0}f you think you're tired,{PA:10}||it'll get worse.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_8"
msgid "But I'll make you feel||rested and relaxed.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_9"
msgid "How about right here,{PA:10} right now,{PA:10}||we dance naked?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_10"
msgid "A{MS:0}hahaha!{PA:20}||We can't do that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_11"
msgid "But you're funny!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_12"
msgid "H{MS:0}ave you ever heard of a hostess club||run by someone who didn't drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_13"
msgid "Don't be ridiculous!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_14"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{MS:0}{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_15"
msgid "H{MS:0}uh?{PA:20} You can't?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_16"
msgid "Y{MS:0}our skin is quite pretty.{PA:20}||I can't tell at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_17"
msgid "J{MS:0}ust look!{PA:20}||My skin's usually a lot smoother than this!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_18"
msgid "Oh.{PA:20} Okay.{PA:20}.{PA:20}.{PA:20}"
msgstr "Ah, {PA:20}esta bi{PA:20}en{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_14_19"
msgid "Don't just say what you think I want to hear.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_0"
msgid "F{MS:0}rom the moment I became a hostess,{PA:10}||I was always sure one day I'd run a club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_1"
msgid "S{MS:0}o your dream has come true then?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_2"
msgid "Y{MS:0}es.{PA:20}||But I went through a lot to get here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_3"
msgid "H{MS:0}ey!{PA:20}||What's that supposed to mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_4"
msgid "I mean.{PA:20}.{PA:20}.{PA:20} You hear a lot about it.{PA:20}.{PA:20}.{PA:20}||Like working girls.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_5"
msgid "I'm not that sort of person!{PA:20}||Kazuma.{PA:20}.{PA:20}.{PA:20} You're so rude!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_6"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_7"
msgid "Ahaha!{PA:20}||I get that a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_8"
msgid "But if you have good sense of how||to treat customers,{PA:10} your age doesn't matter.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_9"
msgid "I{MS:0} see.{PA:20}"
msgstr "Y{MS:0}a veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_10"
msgid "It's the same with hosts,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_11"
msgid "A 20-year-old host could become||the number one host.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_12"
msgid "So don't you go getting||careless,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_13"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}I won't.{PA:20}"
msgstr "¡{PA:20}N{PA:20}{MS:0}{PA:20}o te...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_14"
msgid "W{MS:0}hat's that supposed to mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_15"
msgid "It'll be tough to maintain your position||as the number one club in the Ginza.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_16"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}||Are you worried about me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_17"
msgid "I{MS:0}f it's all right,{PA:10} I'd like||to visit your club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_15_18"
msgid "A{MS:0}haha!{PA:20}||You can come anytime.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_0"
msgid "So K{MS:0}azuma.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_1"
msgid "When you look at me,{PA:10} what||kind of a woman do you see?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_2"
msgid "Huh?{PA:20}||What do you mean?{PA:20}"
msgstr "¿Eh? {PA:20}¿Qué|| quieres decir?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_3"
msgid "Just answer truthfully.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_4"
msgid "W{MS:0}ell.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_5"
msgid "S{MS:0}o that's how||you see me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_6"
msgid "No{MS:0} one could refuse a demand||from a lovely woman such as yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_7"
msgid "O{MS:0}h.{PA:20}||I don't ever make any demands,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_8"
msgid ".{PA:20}.{PA:20}.{PA:20}Oh.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Oh.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_9"
msgid "A{MS:0}hahaha!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_10"
msgid "You think that because of what||I do,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_11"
msgid "Y{MS:0}eah,{PA:10} maybe.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_12"
msgid "I don't think you'd have time for||someone with a small income.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_13"
msgid "W{MS:0}hat's that supposed to mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_14"
msgid "I don't choose men based||on their income.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_15"
msgid "I'm not in a very good mood now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_16"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{MS:0}{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_17"
msgid "W{MS:0}hat?{PA:20}||You can tell?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_18"
msgid "I can tell because you're||a good person.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_19"
msgid "P{MS:0}lus,{PA:10} I'll bet you can't turn down||a guy,{PA:10} even if he's no good for you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_20"
msgid "W{MS:0}ow!{PA:20}||You've really pegged me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_21"
msgid "Heh.{PA:20}.{PA:20}.{PA:20}||I do get deceived often.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_16_22"
msgid "You have a good eye||for people,{PA:10} Kazuma.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_0"
msgid "K{MS:0}azuma,{PA:10} are you the type who||devotes themselves to someone they love?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_1"
msgid "W{MS:0}ell.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_2"
msgid "O{MS:0}kay,{PA:10} say a woman you were in love"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_3"
msgid "with had a huge debt.{PA:20}||What would you do?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_4"
msgid "A{MS:0}hahaha!{PA:20}||I like that you don't mess around.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_5"
msgid "That's probably the best thing to do.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_6"
msgid "Y{MS:0}es.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_7"
msgid "Long ago,{PA:10} a man I was dating had||a huge debt.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_8"
msgid "When I found out,{PA:10} I broke things off||at once.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_9"
msgid "W{MS:0}hen I look back now,{PA:10} I'm glad I did.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_10"
msgid "If we had kept going like that,{PA:10} it||would have been really difficult.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_11"
msgid ".{PA:20}.{PA:20}.{PA:20}I see.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_12"
msgid "O{MS:0}h?{PA:20}||I see.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_13"
msgid "T{MS:0}hat's part of what it means||to be a man,{PA:10} after all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_14"
msgid "B{MS:0}ut I wonder.{PA:20}.{PA:20}.{PA:20}||Would she just rack up a new debt later?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_16"
msgid "I think it'd be just a temporary||fix.{PA:20} You'd be in trouble down the line.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_17"
msgid "You think?{PA:20}"
msgstr "¿Tú crees?...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_18"
msgid "T{MS:0}hat's not wise.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_19"
msgid "I{MS:0}'d go as far away||as it would take.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_20"
msgid "Don't you think that's||completely reckless?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_21"
msgid "Life is different from TV.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_17_22"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}I guess so.{PA:20}"
msgstr "S{PA:20}{PA:20}u{MS:0}{PA:20}pongo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_1"
msgid "If you could be reincarnated,{PA:10}||who would you like to come back as?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_2"
msgid "W{MS:0}ell.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_3"
msgid "Y{MS:0}ou like being||a host that much?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_4"
msgid "Y{MS:0}eah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_5"
msgid "By meeting people,{PA:10} I can grow||as a person.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_6"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||But is that how you really feel?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_7"
msgid "That sounds like a bunch of hooey.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_8"
msgid ".{PA:20}.{PA:20}.{PA:20}Does it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_9"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_10"
msgid "A {MS:0}man's got to make a name for himself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_11"
msgid "But what kind of company?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_12"
msgid "I haven't decided yet.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_13"
msgid "O{MS:0}h.{PA:20}.{PA:20}.{PA:20}||Not much to talk about then.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_18_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

