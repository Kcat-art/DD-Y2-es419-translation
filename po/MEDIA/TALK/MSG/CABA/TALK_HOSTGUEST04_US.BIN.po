msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST04_US.BIN::line:5_2_8"
msgid "I'm{MS:0} grateful for the||offer,{PA:10} but.{PA:20}.{PA:20}.{PA:20} honestly?{PA:20}"
