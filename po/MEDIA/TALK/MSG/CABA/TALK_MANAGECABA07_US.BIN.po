msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::name:0"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::name:1"
msgid "Sakura"
msgstr "Sakura"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_0_0"
msgid "How have you been doing here lately?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_1_0"
msgid "I'm doing very well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_1_1"
msgid "Being able to drink and earn money.{PA:20}.{PA:20}.{PA:20}||I think this is a fabulous job.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_2_0"
msgid "I've been doing well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_2_1"
msgid "I think I've gotten used to it here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_3_0"
msgid "Okay,{PA:10} I guess.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_3_1"
msgid "Sometimes I have trouble with the customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_4_0"
msgid "Maybe I'm wasting my time.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_4_1"
msgid "I can't get into the conversations||and I'm having a rough time.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_5_0"
msgid "Am I really cut out for this kind of work?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_5_1"
msgid "I feel like I'm really wasting my time.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_6_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_6_1"
msgid "The club is doing really well,{PA:10} isn't it?{PA:20}||There are so many customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_6_2"
msgid "I hope it keeps up like this!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_7_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_7_1"
msgid "Nothing at the moment.{PA:20}||There are plenty of customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_7_2"
msgid "So things are good!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_7_3"
msgid "If I can earn the club more money,{PA:10}||maybe I can have a raise?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_8_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_8_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Nothing really,{PA:10} but maybe you should||work on the club's atmosphere?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_9_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_9_1"
msgid "There aren't many customers,{PA:10} but||I guess that's the way things are.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_9_2"
msgid "But I feel like if we keep this up,{PA:10}||the club is going to shut down.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_10_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_10_1"
msgid ".{PA:20}.{PA:20}.{PA:20}We never really have customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:0_10_2"
msgid "Maybe you should spend more||money on the club's interior or something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_0_0"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_1_0"
msgid "What?{PA:20} For me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_1_1"
msgid "How wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_2_0"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_3_0"
msgid "T-Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_3_1"
msgid "I guess.{PA:20}.{PA:20}.{PA:20}"
msgstr "Si tú lo dices{PA:20}.{PA:20}..{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_4_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} Yes.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_4_1"
msgid "To be honest,{PA:10} I don't want it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_5_0"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:1_5_1"
msgid "What should I do with that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_0_0"
msgid "(Maybe I should give her a talking-to.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_1_0"
msgid "You've been letting service slip lately.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_1_1"
msgid "If you drive customers away,{PA:10}||they'll never request you again.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_1_2"
msgid "I see.{PA:20}.{PA:20}.{PA:20}||It's a tough business,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_1_3"
msgid "But I'll do my best!{PA:20}||I'm indebted to you,{PA:10} after all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_1_4"
msgid "(I think that got through to her.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_0"
msgid "Are you satisfied with how things are going?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_1"
msgid "You'll never make a good candidate||for top hostess if you are.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_2"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_3"
msgid "Me?{PA:20} A candidate for top hostess?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_4"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_5"
msgid "But maybe I was wrong about you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_6"
msgid "You don't have to say that.{PA:20}||I'm doing the best that I can!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_2_7"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_3_0"
msgid "You should pay more attention to your looks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_3_1"
msgid "It's very important in this business.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_3_2"
msgid "What!?{PA:20}"
msgstr "¡¿Qué?!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_3_3"
msgid "My appearance is what I||pay the most attention to!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_3_4"
msgid "Do you really have a good||eye for women?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:2_3_5"
msgid "(I should have complimented her.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_0_0"
msgid "(Maybe I should use positive reinforcement.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_1_0"
msgid "You look great.{PA:20}||Did you change something recently?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_1_1"
msgid "What?{PA:20} Really?{PA:20}"
msgstr "¿Qué? {PA:20}¿En serio?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_1_2"
msgid "Thank you!{PA:20}"
msgstr "¡Gracias!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_1_3"
msgid "That's so wonderful to hear||from you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_1_4"
msgid "(That went well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_2_0"
msgid "You're doing well with your customers.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_2_1"
msgid "Well.{PA:20}.{PA:20}.{PA:20}||I don't know about that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_2_2"
msgid "(That didn't go very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_3_0"
msgid "You've been getting requests recently.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_3_1"
msgid "I haven't gotten that much.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_3_2"
msgid "You don't need to try to butter me up.{PA:20}||It seems like you're trying too hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:3_3_3"
msgid "(That didn't go well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_0_0"
msgid "(I could give her a 100,{PA:10}000 yen bonus.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_0_1"
msgid "You've been working hard recently.{PA:20}||Here's a bonus.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_0_2"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_1_0"
msgid "What?!{PA:20} Really?{PA:20}||{MS:1}{MS:0}Thank you very much.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_1_1"
msgid "Yay!{PA:20}"
msgstr "¡Sí!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_2_0"
msgid "What?{PA:20} Really?{MS:0}{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_3_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20}||Thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:4_3_1"
msgid "(Why isn't she happier?)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:5_0_0"
msgid "Can I go back now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:5_0_1"
msgid "Excuse me.{PA:20}"
msgstr "¡Mesero!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:5_0_2"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_0_0"
msgid "Chinatsu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_1_0"
msgid "Excuse me,{PA:10} but can I talk to you||about Miho?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_1_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_1_2"
msgid "Her perfume really||smells bad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_1_3"
msgid "I think it's bothering||the customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_1_4"
msgid "It's hard to be around her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_2_0"
msgid "Rika N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_3_0"
msgid "Ran N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_4_0"
msgid "Akira N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_5_0"
msgid "Mayu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_6_0"
msgid "Excuse me,{PA:10} but can I talk to you||about Hanako?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_6_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_6_2"
msgid "A customer just||complained about her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_6_3"
msgid "She can be pretty cheeky sometimes.{PA:20}||It's hard to watch.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_7_0"
msgid "Sakura N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_8_0"
msgid "Excuse me,{PA:10} but can I talk to you||about Ai?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_8_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_8_2"
msgid "When she's here,{PA:10} she's very courteous,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_8_3"
msgid "but sometimes she talks trash about||the club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_8_4"
msgid "Just hearing that||makes me want to throw in the towel.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:6_9_0"
msgid "Yuri N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:7_0_0"
msgid "Give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:7_1_0"
msgid "Don't give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:8_0_0"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA07_US.BIN::line:8_1_0"
msgid "Not yet.{PA:20}"
msgstr "Aún no.{PA:20}"

