msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_14"
msgid "O{MS:0}h?{PA:20} So you're bad,{PA:10} are you?{PA:20}"
