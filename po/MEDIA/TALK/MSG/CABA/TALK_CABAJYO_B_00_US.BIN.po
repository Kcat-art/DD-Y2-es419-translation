msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_0"
msgid "I{MS:0} have the cutest little||doggie at home.{PA:20}"
