msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_10"
msgid "And you like dogs,{PA:10} so.{PA:20}.{PA:20}.{MS:0}{PA:20}||{MS:3}{MS:2}{MS:1}Therefore,{PA:10} you must be a good person!{PA:20}❤"
