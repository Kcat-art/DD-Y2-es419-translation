msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:0_0_0"
msgid "I{MS:1}{MS:0}t's nice to meet you.{PA:30}{PA:20}||{MS:2}I'm Yuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:0_1_0"
msgid "Yay!{PA:20}❤||Y{MS:0}ou came!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_0_0"
msgid "W{MS:0}elcome!{PA:20}||I'm Yuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_0_1"
msgid "Let's have some fun.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_1_0"
msgid "Kazuma,{PA:10} you're back?{PA:20}||That's wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_1_1"
msgid "Let's have a good talk tonight!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_2_0"
msgid "Oh,{PA:10} Kazuma!{PA:20}||I'm sorry about before.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_2_1"
msgid "It doesn't bother me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_3_0"
msgid "That was fun!{PA:20}||I'm so glad we still get to hang out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_3_1"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_4_0"
msgid "I was hoping we could||go out before work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_4_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_4_2"
msgid "It's okay.{PA:20}||Let's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_5_0"
msgid "Thanks for going out with me after work||the other day.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_5_1"
msgid "Sure.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_5_2"
msgid "Let's go out again sometime!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_6_0"
msgid "I was hoping||we could go out after work.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_6_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:1_6_2"
msgid "It's okay.{PA:20}||Let's drink.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:2_0_0"
msgid "Y{MS:0}ou're dressed even nicer than usual.{PA:20}||{MS:3}{MS:2}{MS:1}You take my breath away!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:2_1_0"
msgid "Y{MS:0}ou look a bit different today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:2_2_0"
msgid "You dress nice,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:2_2_1"
msgid "But maybe you should try wearing some||cologne or accessories.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_0_0"
msgid "I{MS:0}s that for me!?{PA:20}||Are you sure?{PA:20} It looks so expensive!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_0_1"
msgid "Yeah,{PA:10} don't worry about it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_0_2"
msgid ".{PA:20}.{PA:20}.{MS:1}{MS:0}{PA:20}Thank you,{PA:10} Kazuma.{PA:20}||It's great.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_1_0"
msgid "Is this for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_1_1"
msgid "It's nothing special.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_1_2"
msgid "Yes,{PA:10} it is.{PA:20}||T{MS:0}hanks,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_2_0"
msgid "You're giving this to me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_2_1"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_2_2"
msgid "T{MS:0}hanks,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_3_0"
msgid "Um,{PA:10} {MS:0}Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_3_1"
msgid "Yeah,{PA:10} what?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_3_2"
msgid "I'm thrilled you got me a present,{PA:10}||{MS:0}but I don't really want this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:3_3_3"
msgid "Oh.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_0_0"
msgid "Kazuma,{PA:10} {MS:0}what will you have to drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_0_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_1_0"
msgid "Your glass is almost empty.{PA:20}||W{MS:0}hat will you have next?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_1_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_2_0"
msgid "T{MS:0}he gold!?{PA:20}||You don't have to spend that much!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_2_1"
msgid "T{MS:0}hank you,{PA:10} Kazuma.{PA:20}||You're trying to help my sales,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_2_2"
msgid "Sorry to make you spend so much.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_2_3"
msgid "Don't worry about it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_2_4"
msgid "Oh,{PA:10} K{MS:0}azuma!{PA:20}❤❤❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_2_5"
msgid "I see.{PA:20}.{PA:20}.{PA:20}||I'll bring something else then.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_3_0"
msgid "O{MS:0}kay.{PA:20}||{MS:2}{MS:1}Thank you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_4_0"
msgid "H{MS:0}old on a sec.{PA:20}||I'll bring it right away.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:4_5_0"
msgid "G{MS:0}ot it!{PA:20}||Hold on a sec.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_0_0"
msgid "A{MS:0}ren't you hungry,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_0_1"
msgid "If you're feeling hungry,{PA:10}||I'll bring you the menu.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_0_3"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_0_4"
msgid "No,{PA:10} I'm fine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_1_0"
msgid "That's {MS:0}my favorite!{PA:20}||We must like the same things.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_2_0"
msgid "Hold on a sec.{PA:20}||It'll be ready right away.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:5_3_0"
msgid "O{MS:0}h,{PA:10} you like that?{PA:20}||Well,{PA:10} everyone has different tastes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_0_0"
msgid "Are you sure,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_0_1"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_0_2"
msgid "Then {MS:0}let's talk a bit longer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_1_0"
msgid "Time's up already.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_1_1"
msgid "I{MS:0} had a lot of fun||talking with you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_1_2"
msgid "Hey,{PA:10} can I get your email address?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_1_3"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_1_4"
msgid "T{MS:0}hanks.{PA:20}||I'll{MS:1} send you an email later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_2_0"
msgid "Aww.{PA:20}.{PA:20}.{PA:20} too bad,{PA:10} our time's up.{PA:20}||I {MS:0}hope you'll come back again.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:6_2_1"
msgid "I'll send you an email later.{PA:20}"
