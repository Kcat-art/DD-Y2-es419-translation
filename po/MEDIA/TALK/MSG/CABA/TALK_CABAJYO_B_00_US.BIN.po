msgid ".{PA:20}.{PA:20}.{PA:20}Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_25"
msgid "I wish I could||relax like a cat.{PA:20}"
