msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_26"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_27"
msgid "I{MS:0} see.{PA:20}||That's too bad!{PA:20}"
