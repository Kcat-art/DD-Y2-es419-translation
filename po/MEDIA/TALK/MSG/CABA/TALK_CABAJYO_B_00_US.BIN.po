msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_3_7"
msgid "Right?{PA:20} But.{PA:20}.{PA:20}.{PA:20}||{MS:2}{MS:1}{MS:0}I{MS:3}t's so exciting to buy them.{PA:20}"
