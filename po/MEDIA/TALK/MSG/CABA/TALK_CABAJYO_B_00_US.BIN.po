msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_6"
msgid "T{MS:0}hat's what I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_B_00_US.BIN::line:9_2_7"
msgid "I figured you must be a dog person||from the way you carry yourself.{PA:20}"
