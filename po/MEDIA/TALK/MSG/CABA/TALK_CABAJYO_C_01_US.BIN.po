msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:0_1_0"
msgid "G{MS:0}ood evening.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_0"
msgid "T{MS:0}hank you for selecting me.{PA:20}||My name is Madoka.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_1"
msgid "Oh,{PA:10} you aren't from||around here,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_2"
msgid "Where are you from?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_3"
msgid "Tokyo.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_4"
msgid "And you came all the way to Osaka?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_5"
msgid "I had something to deal with here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_0_6"
msgid "I{MS:0} see.{PA:20}"
msgstr "Y{MS:0}a veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_1_0"
msgid "Welcome,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_1_1"
msgid "I {MS:0}was hoping I'd see you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_2_0"
msgid "Ah,{PA:10} Kazuma.{PA:20}.{PA:20}.{PA:20}||I'm sorry about the other day.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_2_1"
msgid "Don't worry about it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_3_0"
msgid "That was fun,{PA:10} wasn't it?{PA:20}||Let's keep it going at the club,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_3_1"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_4_0"
msgid "I was hoping we could||go out before work.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_4_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_4_2"
msgid "Just forget about it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_5_0"
msgid "Thank you for going out with me the||other day.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_5_1"
msgid "Sure.{PA:20}.{PA:20}.{PA:20}"
msgstr "Clar{PA:20}o{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_5_2"
msgid "Let's do it again!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_6_0"
msgid "I was hoping we could||go out after work.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_6_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:1_6_2"
msgid "Just forget about it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:2_0_0"
msgid "T{MS:0}hose are fabulous clothes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:2_0_1"
msgid "They really seem to reflect your||brooding personality.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:2_1_0"
msgid "Is that how people dress in Tokyo?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:2_1_1"
msgid "I don't quite get it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:2_2_0"
msgid ".{PA:20}.{PA:20}.{PA:20}It seems like you don't care||{MS:0}s{MS:1}o much about how you look.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_0_0"
msgid "What!?{PA:20}||Is this really for me!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_0_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_0_2"
msgid "T{MS:0}hank you,{PA:10} Kazuma.{PA:20}||I will treasure it forever❤.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_1_0"
msgid "Is this for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_1_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_1_2"
msgid "T{MS:0}hank you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_2_0"
msgid "This is for me.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_2_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_2_2"
msgid "Oh.{PA:20}.{PA:20}.{MS:0}{PA:20}||{MS:1}Well,{PA:10} I'll accept it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_3_0"
msgid "Is that for me.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_3_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_3_2"
msgid "It seems quite frugal.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:3_3_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_0_0"
msgid "Kazuma,{PA:10} {MS:0}what will you have to drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_0_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_1_0"
msgid "Oh,{PA:10} your glass is empty.{PA:20}||{MS:0}What will you have to drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_1_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_2_0"
msgid "So that'll be the Champagne Gold.{PA:20}||Is that right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_2_1"
msgid "Please wait a moment.{PA:20}||{MS:1}{MS:0}I'll go order it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_2_2"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_2_3"
msgid "Ah.{PA:20}.{PA:20}.{PA:20}||So then,{PA:10} what will you have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_3_0"
msgid "That suits you very well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_3_1"
msgid "Does it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_3_2"
msgid "Yes,{PA:10} it does.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_3_3"
msgid "Anything less than this,{PA:10}||and things would feel out of balance.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_4_0"
msgid "All right,{PA:10} please wait a moment.{PA:20}"
msgstr ""

