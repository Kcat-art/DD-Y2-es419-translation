msgid "E{MS:0}xcuse me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_5_0"
msgid "You can drink||that stuff?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_5_1"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_5_2"
msgid "Nothing.{PA:20} It's just not what I'd expect.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:4_5_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:5_0_0"
msgid "Kazuma,{PA:10} {MS:0}will you have something to eat?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:5_0_2"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:5_0_3"
msgid "No,{PA:10} I'm fine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:5_1_0"
msgid "I see you like this,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_C_01_US.BIN::line:5_1_1"
msgid "It's one of my favorites.{PA:20}||It seems we have something in common!{PA:20}❤"
