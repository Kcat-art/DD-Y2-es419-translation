msgid "Our sales are quite good.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_2_1"
msgid "Customers are plentiful.{PA:20}||But maybe we can do a little bit better.{PA:20}"
