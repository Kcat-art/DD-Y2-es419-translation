msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_5_2"
msgid "If we don't do something at once,{PA:10}||the club may go out of business.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_6_0"
msgid "As for the employees.{PA:20}.{PA:20}.{MS:0}{PA:20}||They're working together beautifully.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_6_1"
msgid "Everyone seems extremely||motivated.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_6_2"
msgid "And it seems their motivation is||boosting the sales numbers,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_7_0"
msgid "As for the employees,{PA:10}||they seem fairly motivated.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_7_1"
msgid "But it seems some of the girls||are a little bit dissatisfied.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_7_2"
msgid "The girls' morale impacts our sales||numbers,{PA:10} so we need to keep an eye out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_8_0"
msgid "As for the employees,{PA:10}||they aren't doing very well at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:0_8_1"
msgid "The girls' lack of motivation is||affecting their sales,{PA:10} I think.{PA:20}"
