msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:8_6_4"
msgid "Mr.{PA:20} Itakura wants to talk to you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_0"
msgid "Currently,{PA:10} Marietta has"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_1"
msgid "2 million yen in capital.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_2"
msgid "That's the budget you have to make||improvements.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_3"
msgid "Once you make changes to the club,{PA:10}||we will calculate the total sales.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_4"
msgid "If sales are good,{PA:10}||the money will be added to our capital.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_5"
msgid "Of course,{PA:10} if sales are bad,{PA:10}||the capital will slowly run out.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_0_6"
msgid "Let's do the best we can!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_1_0"
msgid "We've gotten a little bigger!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_1_1"
msgid "This is thanks to you,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_1_2"
msgid "We have some for operating expenses,{PA:10} too.{MS:0}{PA:20}||Please use it as you will.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_1_3"
msgid "We can grow bigger.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_1_4"
msgid "Good luck!{PA:20}"
msgstr "Suerte.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_2_0"
msgid "We've made it this far!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_2_1"
msgid "At this rate we could be the top||club in Kamurocho!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_2_2"
msgid "We have some more for operating expenses.{MS:0}{PA:20}||Please use it as you will.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:9_2_3"
msgid "Good luck!{PA:20}"
msgstr "Suerte.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_1"
msgid "Our sales numbers are rising,{PA:10} and the club||is feeling a little cramped.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_2"
msgid "So!{PA:20}"
msgstr "¿Qué tal?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_3"
msgid "Shall we expand the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_4"
msgid "Yes!{PA:20} I'll get construction started at once!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_5"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGEMAN_US.BIN::line:10_0_6"
msgid "Please let me know when you want to expand.{PA:20}"
msgstr ""

