msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::name:0"
msgid "Kiryu"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::name:1"
msgid "Chinatsu"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_0_0"
msgid "How've you been doing here lately?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_1_0"
msgid "I'm doing just great.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_1_1"
msgid "No real problems.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_2_0"
msgid "I'm doing well,{PA:10} I guess.{PA:20}||I'm getting along with the customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_2_1"
msgid "No real problems.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_3_0"
msgid "I'm doing all right.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_3_1"
msgid "If I could earn a little more,{PA:10} then||I'd have no complaints.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_4_0"
msgid "To be honest,{PA:10} I'm not doing so well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_4_1"
msgid "Maybe I'm not cut out for||this kind of work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_5_0"
msgid "I don't know why I'm doing||so poorly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_5_1"
msgid "I guess I'm a little tired.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_6_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_6_1"
msgid "Nothing at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_6_2"
msgid "I mean,{PA:10} thanks to you we're all||thriving,{PA:10} and the customers are satisfied.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_7_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_7_1"
msgid "It looks like the customers||are all satisfied.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_7_2"
msgid "I think if we try a little bit harder,{PA:10} we'll||do even better.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_8_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_8_1"
msgid "There aren't very many customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_8_2"
msgid "I'm sure things will get better||around here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_8_3"
msgid "As long as we address the customers'||complaints,{PA:10} we should be fine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_9_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_9_1"
msgid "There are so few customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_9_2"
msgid "I'm doing my best,{PA:10} but the club's||atmosphere could be better.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_10_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_10_1"
msgid "We'll never succeed at this rate.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_10_2"
msgid "There aren't any customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:0_10_3"
msgid "Can't you do something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_0_0"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_1_0"
msgid "What!?{PA:20} For me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_1_1"
msgid "How wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_2_0"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_3_0"
msgid "Is this.{PA:20}.{PA:20}.{PA:20} for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_3_1"
msgid "Thank you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_4_0"
msgid "Huh.{PA:20}.{PA:20}.{PA:20} What's this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_4_1"
msgid "Are you hitting on me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_4_2"
msgid "That's pretty inappropriate.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_5_0"
msgid "What's this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:1_5_1"
msgid "I don't want it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_0_0"
msgid "(Maybe I should give her a talking-to.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_1_0"
msgid "You're our top hostess,{PA:10} so how about||you put in a little bit more enthusiasm?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_1_1"
msgid ".{PA:20}.{PA:20}.{PA:20}I understand.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_1_2"
msgid "I'll do my best to try to||{MS:0}pep it up a little!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_1_3"
msgid "(Seems like she gets it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_2_0"
msgid "You don't seem very enthusiastic these days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_2_1"
msgid "Do you even want to be here?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_2_2"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_2_3"
msgid "I guess maybe I've just been losing a||little focus.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_2_4"
msgid "I'll try a little harder.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_2_5"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_3_0"
msgid "You know,{PA:10} we don't need people who||don't want to be here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_3_1"
msgid "Do you think that's you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_3_2"
msgid ".{PA:20}.{PA:20}.{PA:20}I want to be here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_3_3"
msgid ".{PA:20}.{PA:20}.{PA:20}And I'm doing my best||here,{PA:10} you know!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:2_3_4"
msgid "(I should have complimented her.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_0_0"
msgid "(Maybe I should use positive reinforcement.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_1_0"
msgid "You've got what it takes to be number one.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_1_1"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_1_2"
msgid "It's so nice to hear that||from you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_1_3"
msgid "(That went well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_2_0"
msgid "You've become a model employee.{PA:20}||Others look up to you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_2_1"
msgid ".{PA:20}.{PA:20}.{PA:20}I see.{PA:20}||Thank you.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_2_2"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_3_0"
msgid "You've been working hard recently.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_3_1"
msgid "Be sure to keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_3_2"
msgid "What else can I do?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_3_3"
msgid "Can I go now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:3_3_4"
msgid "(That didn't work at all.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_0_0"
msgid "(I could give her a 100,{PA:10}000 yen bonus.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_0_1"
msgid "You've been working hard recently.{PA:20}||Here's a bonus for you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_0_2"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_1_0"
msgid "What?{PA:20} Really?!{PA:20}||{MS:1}{MS:0}Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_1_1"
msgid "This is great!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_2_0"
msgid "What?{PA:20} Really?!{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_3_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20}.{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:4_3_1"
msgid "(Isn't she happy?)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:5_0_0"
msgid "Can I go back now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:5_0_1"
msgid "Excuse me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:5_0_2"
msgid "Why not?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_0_0"
msgid "Chinatsu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_1_0"
msgid "Miho N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_2_0"
msgid "Rika N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_3_0"
msgid "Ran N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_4_0"
msgid "Akira N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_5_0"
msgid "Mayu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_6_0"
msgid "Excuse me.{PA:20}||You know Hanako,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_6_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_6_2"
msgid "I don't think she's cut out for this work.{PA:20}||She's always getting in my way.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_6_3"
msgid "She makes it hard for me to work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_6_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_7_0"
msgid "Sakura N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_8_0"
msgid "Ai N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:6_9_0"
msgid "Yuri N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:7_0_0"
msgid "Give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:7_1_0"
msgid "Don't give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:8_0_0"
msgid "Yes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA00_US.BIN::line:8_1_0"
msgid "Not yet.{PA:20}"
msgstr ""

