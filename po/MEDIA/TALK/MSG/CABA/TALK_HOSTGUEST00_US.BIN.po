msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST00_US.BIN::line:5_15_7"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}Something pricey shows{MS:1}||a person's feelings.{PA:20}"
