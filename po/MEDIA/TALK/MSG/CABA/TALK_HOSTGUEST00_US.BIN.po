msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST00_US.BIN::line:5_0_14"
msgid "If you knew how much money||I've spent on Takaya.{PA:20}.{PA:20}.{PA:20}"
