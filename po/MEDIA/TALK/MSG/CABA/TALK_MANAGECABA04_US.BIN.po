msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::name:0"
msgid "Kiryu"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::name:1"
msgid "Akira"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_0_0"
msgid "How've you been doing here lately?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_1_0"
msgid "I've been doing great!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_1_1"
msgid "I feel like I can take anything on!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_2_0"
msgid "I'm doing great.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_2_1"
msgid "I'm not having any real problems.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_3_0"
msgid "All right,{PA:10} I guess.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_3_1"
msgid "I'm doing what I can.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_4_0"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm not doing so well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_4_1"
msgid "I don't have good sense for this business.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_5_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Terribly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_5_1"
msgid "I'm so tired.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_6_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_6_1"
msgid "We have a lot of customers,{PA:10} so||there's nothing I need to say.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_7_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_7_1"
msgid "We're getting a decent amount of customers||and we're doing pretty good,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_7_2"
msgid "Just keep up the good work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_8_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_8_1"
msgid "Well.{PA:20}.{PA:20}.{PA:20} We just seem like a||mediocre cabaret club now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_8_2"
msgid "I think we should try to bring in||more customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_9_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_9_1"
msgid "Is the club in trouble?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_9_2"
msgid "We're losing customers,{PA:10} aren't we?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_10_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_10_1"
msgid "Are we screwed?{PA:20}||We're sitting around twiddling our thumbs!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:0_10_2"
msgid "You've got to do something!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_0_0"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_1_0"
msgid "Oh!{PA:20} For me!?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_1_1"
msgid "Wow!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_2_0"
msgid "Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_3_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20}||Thanks,{PA:10} I guess.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_4_0"
msgid "What's this?{PA:20}||{MS:1}{MS:0}What am I supposed to do with this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_5_0"
msgid "You've got to be joking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:1_5_1"
msgid "I don't want that!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_0_0"
msgid "(Maybe I should give her a talking-to.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_1_0"
msgid "Have you been slacking off a little?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_1_1"
msgid "You've got to keep it together.{PA:20}||Once your ratings drop,{PA:10} it's over.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_1_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Maybe I have been slipping when||it comes to my customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_1_3"
msgid "I'm glad you pointed it out,{PA:10} or else I||probably wouldn't have noticed.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_1_4"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_1_5"
msgid "(That seemed to work well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_2_0"
msgid "Have you been slacking lately?{PA:20}||Don't you want to work here?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_2_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Of course I want to be here!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_2_2"
msgid "But if I'm doing poorly,{PA:10} then||I guess I'll try harder.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_2_3"
msgid "(That could've gone better.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_3_0"
msgid "You know,{PA:10} we don't need people who don't||want to work here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_3_1"
msgid "Is that you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_3_2"
msgid ".{PA:20}.{PA:20}.{PA:20}I want to work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_3_3"
msgid "But you're scaring me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:2_3_4"
msgid "(I should have complimented her.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_0_0"
msgid "(Maybe I should use positive reinforcement.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_1_0"
msgid "You've become a model employee||for the other girls.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_1_1"
msgid "Really?{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_1_2"
msgid "That's so nice of you||to say.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_1_3"
msgid "(That went well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_2_0"
msgid "You've been working hard lately.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_2_1"
msgid "Do you really think so?{PA:20}||I guess.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_2_2"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_3_0"
msgid "You've been getting great marks.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_3_1"
msgid "They haven't gotten any better than before.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_3_2"
msgid "Are you just flattering me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_3_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:3_3_4"
msgid "(That didn't go well at all.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_0_0"
msgid "(I could give her a 100,{PA:10}000 yen bonus.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_0_1"
msgid "You've been working hard recently.{PA:20}||Here's a bonus.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_0_2"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_1_0"
msgid "What!?{PA:20} Really?{PA:20}||{MS:1}{MS:0}How wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_2_0"
msgid "What!{PA:20} Really?{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_3_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20}.{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:4_3_1"
msgid "(Why isn't she happy?)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:5_0_0"
msgid "Can I go back now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:5_0_1"
msgid "Excuse me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:5_0_2"
msgid "What is it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_0_0"
msgid "Chinatsu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_1_0"
msgid "Miho N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_2_0"
msgid "Rika N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_3_0"
msgid "Excuse me.{PA:20}.{PA:20}.{PA:20} You know||that girl,{PA:10} Ran?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_3_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_3_2"
msgid "I get so mad just looking at her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_3_3"
msgid "She's not working hard at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_3_4"
msgid "I don't understand why||a girl like that is working here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_4_0"
msgid "Akira N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_5_0"
msgid "Mayu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_6_0"
msgid "Excuse me.{PA:20}.{PA:20}.{PA:20} You know||that girl,{PA:10} Hanako?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_6_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_6_2"
msgid "That girl really drives||me nuts.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_6_3"
msgid "She doesn't have any manners.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_6_4"
msgid "It's really bad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_7_0"
msgid "Sakura N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_8_0"
msgid "Excuse me.{PA:20}.{PA:20}.{PA:20} You know||that girl,{PA:10} Ai?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_8_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_8_2"
msgid "What's her deal?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_8_3"
msgid "She thinks she's better than everyone else.{PA:20}||I can't stand it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:6_9_0"
msgid "Yuri N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:7_0_0"
msgid "Give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:7_1_0"
msgid "Don't give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:8_0_0"
msgid "Yes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA04_US.BIN::line:8_1_0"
msgid "Not yet.{PA:20}"
msgstr ""

