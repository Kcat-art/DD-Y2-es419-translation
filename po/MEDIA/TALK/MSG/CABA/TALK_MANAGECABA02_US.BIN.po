msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::name:0"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::name:1"
msgid "Rika"
msgstr "Rika"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_0_0"
msgid "How've you been doing here lately?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_1_0"
msgid "It's great!{PA:20}❤||I'm having so much fun here!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_1_1"
msgid "Things are going really wonderfully.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_2_0"
msgid "Pretty good,{PA:10} I think.{PA:20}||I'm earning a lot of money.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_2_1"
msgid "I'm getting along with the customers,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_3_0"
msgid "Hm.{PA:20}.{PA:20}.{PA:20} Average,{PA:10} I guess.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_3_1"
msgid "Things have been kind of sluggish.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_4_0"
msgid "I don't feel like things are moving along.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_4_1"
msgid "I try to get into it,{PA:10} but I'm||not doing so well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_5_0"
msgid "To be honest,{PA:10} it's been terrible.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_5_1"
msgid "Conversations with the customers aren't||going well.{PA:20} They always get mad at me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_5_2"
msgid "I don't really feel like I can keep going.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_6_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_6_1"
msgid "I think you're amazing!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_6_2"
msgid "You've turned Marietta into the place||it is today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_6_3"
msgid "I really think it's incredible.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_7_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_7_1"
msgid "Nothing really.{PA:20}"
msgstr "Nada, realmente.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_7_2"
msgid "The customers are plentiful,{PA:10} and||it's all thanks to you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_8_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_8_1"
msgid "I think the club is still not set up well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_8_2"
msgid "Sometimes the customers complain.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_9_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_9_1"
msgid "There aren't very many customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_9_2"
msgid "At this rate,{PA:10} the girls don't have a lot of||incentive to work very hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_10_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_10_1"
msgid "What are we going to do?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_10_2"
msgid "I mean,{PA:10} there aren't any customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:0_10_3"
msgid "Please,{PA:10} do something.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_0_0"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_1_0"
msgid "Is this for me?!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_1_1"
msgid "How wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_2_0"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_3_0"
msgid "T-Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_3_1"
msgid "I'll take it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_4_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr "¿A{PA:20}{PA:20}h{PA:20}, sí{PA:20}{PA:20}?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_4_1"
msgid "Honestly,{PA:10} I don't want it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_5_0"
msgid "Uh.{PA:20}.{PA:20}.{PA:20}"
msgstr "..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:1_5_1"
msgid "What am I supposed to do with that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_0_0"
msgid "(Maybe I should give her a talking-to.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_0"
msgid "Are you satisfied with how things are?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_1"
msgid "You'll never make top hostess||if you're not trying harder.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_2"
msgid "Huh?{PA:20} Oh!{PA:20} You think I have a chance"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_3"
msgid "at being the top hostess?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_4"
msgid "Yeah.{PA:20}||But maybe I misjudged you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_5"
msgid ".{PA:20}.{PA:20}.{PA:20}I see.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_6"
msgid "I'll do my best to be number one!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_1_7"
msgid "(Seems like that got through to her.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_2_0"
msgid "Can you pay more attention to your looks?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_2_1"
msgid "Here,{PA:10} a woman's appearance is vital.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_2_2"
msgid ".{PA:20}.{PA:20}.{PA:20}Okay.{PA:20}"
msgstr "Si{PA:20} t{PA:20}ú {PA:20}lo dices...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_2_3"
msgid "But.{PA:20}.{PA:20}.{PA:20}||What exactly is lacking?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_2_4"
msgid "I work so hard on my makeup!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_2_5"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_3_0"
msgid "It looks like your work's slipping a little.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_3_1"
msgid "If this keeps up,{PA:10} your customers will||stop choosing you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_3_2"
msgid "What?{PA:20} Really?{PA:20}"
msgstr "¿Qué? {PA:20}¿En serio?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_3_3"
msgid "I don't really know what to do.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:2_3_4"
msgid "(I should have complimented her.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_0_0"
msgid "(Maybe I should use positive reinforcement.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_1_0"
msgid "You've been earning a lot of requests.{PA:20}||Keep up the good work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_1_1"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_1_2"
msgid "I'll work hard to||help the club succeed.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_1_3"
msgid "(That went well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_2_0"
msgid "You look fantastic lately.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_2_1"
msgid "Did you change your hair or something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_2_2"
msgid "Oh,{PA:10} uh.{PA:20}.{PA:20}.{PA:20}||Thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_2_3"
msgid "I haven't done anything different,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_2_4"
msgid "(Whoops.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_3_0"
msgid "You're doing well with the customers.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_3_1"
msgid "But it won't matter if there aren't||any customers,{PA:10} you know.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_3_2"
msgid "Is the club doing okay?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:3_3_3"
msgid "(That didn't work at all.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_0_0"
msgid "(I could give her a 100,{PA:10}000 yen bonus.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_0_1"
msgid "You've been working hard lately.{PA:20}||Here's a bonus.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_0_2"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_1_0"
msgid "What!?{PA:20} Really?{PA:20}||{MS:1}{MS:0}Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_1_1"
msgid "I'll work even harder!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_2_0"
msgid "What!{PA:20} Really?{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_3_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20}.{PA:20}||Thank you.{PA:20}"
msgstr "Ah{PA:20},{PA:20} {PA:20}{PA:20}gracias.||{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:4_3_1"
msgid "(Why isn't she happy?)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:5_0_0"
msgid "Can I go back now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:5_0_1"
msgid "Excuse me.{PA:20}"
msgstr "¡Mesero!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:5_0_2"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_0_0"
msgid "Chinatsu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_1_0"
msgid "Miho N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_2_0"
msgid "Rika N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_3_0"
msgid "Ran N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_4_0"
msgid "Excuse me,{PA:10} but.{PA:20}.{PA:20}.{PA:20}||You know Akira?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_4_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_4_2"
msgid "She keeps trying to give me||little jobs to do.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_4_3"
msgid "She really makes me mad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_4_4"
msgid "Can you do something about this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_4_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_5_0"
msgid "Mayu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_6_0"
msgid "Hanako N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_7_0"
msgid "Excuse me,{PA:10} but.{PA:20}.{PA:20}.{PA:20}||You know Sakura?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_7_1"
msgid "Yeah,{PA:10} what about her?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_7_2"
msgid "I don't think she really knows how to||interact with customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_7_3"
msgid "She's always spilling drinks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_7_4"
msgid "She irritates me just by||being around.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_7_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_8_0"
msgid "Ai N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:6_9_0"
msgid "Yuri N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:7_0_0"
msgid "Give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:7_1_0"
msgid "Don't give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:8_0_0"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA02_US.BIN::line:8_1_0"
msgid "Not yet.{PA:20}"
msgstr "Aún no.{PA:20}"

