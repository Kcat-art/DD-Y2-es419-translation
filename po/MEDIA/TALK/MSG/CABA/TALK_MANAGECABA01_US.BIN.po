msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::name:0"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::name:1"
msgid "Miho"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_0_0"
msgid "How've you been doing here lately?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_1_0"
msgid "I'm doing just great!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_1_1"
msgid "I can't believe how much fun I'm having!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_2_0"
msgid "I'm doing great.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_2_1"
msgid "I get chosen by customers a lot,{PA:10}||and I have no real complaints.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_3_0"
msgid "I'm doing okay.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_3_1"
msgid "Actually,{PA:10} I wish I were chosen more||often,{PA:10} but that's how it goes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_4_0"
msgid "Not so good.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_4_1"
msgid "I've been pretty tired lately.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_5_0"
msgid "Not good at all.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_5_1"
msgid "I don't think I'm cut out for this work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_6_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_6_1"
msgid "Nothing at all!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_6_2"
msgid "Everyone's been working really hard.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_7_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_7_1"
msgid "Nothing really.{PA:20}"
msgstr "Nada, realmente.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_7_2"
msgid "But it'd be nice if we had a||few more customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_8_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_8_1"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}||You want feedback?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_8_2"
msgid "Well,{PA:10} maybe if you did a little more||work for the club.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_9_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_9_1"
msgid "I've got nothing but free time these days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_9_2"
msgid "If we don't get some customers,{PA:10} we'll||go out of business.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_10_0"
msgid "Do you have any comments about the club?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_10_1"
msgid "This club is in trouble,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:0_10_2"
msgid "There aren't any customers!{PA:20}||Are we going to go out of business?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_0_0"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_1_0"
msgid "Oh!{PA:20} Is this for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_1_1"
msgid "Thank you!{PA:20}"
msgstr "¡Gracias!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_2_0"
msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_3_0"
msgid "T-Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_3_1"
msgid "I'll take it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_4_0"
msgid "Huh?{PA:20} What is this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_4_1"
msgid "I can't accept that.{PA:20}||I'm sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_5_0"
msgid "I don't want anything||like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:1_5_1"
msgid "Please,{PA:10} you keep it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_0_0"
msgid "(Maybe I should give her a talking-to.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_0"
msgid "Are you satisfied with how you're doing now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_1"
msgid "Huh?{PA:20}||Well,{PA:10} no,{PA:10} not really.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_2"
msgid "I'd think someone like you would be able"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_3"
msgid "to get more requests.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_4"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm sorry.{PA:20}"
msgstr "L{PA:20}o{PA:20} {PA:20}lamento...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_5"
msgid "I'll try harder to meet||your expectations!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_1_6"
msgid "(Seems like she gets it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_2_0"
msgid "Can you pay more attention to your looks?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_2_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Huh?{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} ¿Ah?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_2_2"
msgid "Your appearance is the product we sell.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}Excuse me.{PA:20}||I'll be more careful.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_2_4"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_0"
msgid "Can you try to work a little harder?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_1"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_2"
msgid "If you've got free time on your hands,{PA:10}||how about emailing some customers?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_3"
msgid "I know!{PA:20}"
msgstr "¡Lo sé!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_4"
msgid "Maybe you don't get just how hard I've||been working!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:2_3_6"
msgid "(That didn't work at all.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_0_0"
msgid "(Maybe I should use positive reinforcement.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_1_0"
msgid "Looks like you're getting a lot of requests.{PA:20}||Keep up the good work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_1_1"
msgid "Thank you!{PA:20}"
msgstr "¡Gracias!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_1_2"
msgid "That's so nice of you to say!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_1_3"
msgid "(That went well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_2_0"
msgid "You're really good at keeping everyone at||the club in a good mood.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_2_1"
msgid "You're doing a bang-up job.{PA:20}||Keep it up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_2_2"
msgid "Oh,{PA:10} sure.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_2_3"
msgid "I don't really know what I'm doing,{PA:10}||but I guess I'll just keep doing it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_2_4"
msgid "(That didn't work very well.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_3_0"
msgid "You look great these days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_3_1"
msgid "Did you do something different?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_3_2"
msgid "Huh?{PA:20} How so?{PA:20}||I haven't changed anything.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_3_3"
msgid "Maybe you just haven't noticed before.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_3_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:3_3_5"
msgid "(That didn't work at all.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_0_0"
msgid "(I could give her a 100,{PA:10}000 yen bonus.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_0_1"
msgid "You've been working hard recently.{PA:20}||Here's a bonus.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_0_2"
msgid "(Forget it.)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_1_0"
msgid "What?{PA:20} Really?{PA:20}||Thank you!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_1_1"
msgid "How wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_1_2"
msgid "I'll keep working hard so I can earn more!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_2_0"
msgid "What?{PA:20} Really?{PA:20}||Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_3_0"
msgid "Oh.{PA:20}||Thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:4_3_1"
msgid "(Isn't she happy?)"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:5_0_0"
msgid "Can I go back now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:5_0_1"
msgid "Excuse me.{PA:20}.{PA:20}.{PA:20}"
msgstr "¿Disculpe?.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:5_0_2"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_0_0"
msgid "Chinatsu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_1_0"
msgid "Miho N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_2_0"
msgid "Rika N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_0"
msgid "Can I talk to you about something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_1"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_2"
msgid "You know the new girl.{PA:20}.{PA:20}.{PA:20}||Ran?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_3"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_4"
msgid "I know she's new,{PA:10} but she needs to learn||to tone it down a little.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_5"
msgid "She can really kill a mood||when she gets going sometimes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_3_6"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_4_0"
msgid "Akira N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_5_0"
msgid "Mayu N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_6_0"
msgid "Hanako N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_7_0"
msgid "Sakura N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_8_0"
msgid "Ai N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:6_9_0"
msgid "Yuri N/A"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:7_0_0"
msgid "Give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:7_1_0"
msgid "Don't give it to her.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:8_0_0"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_MANAGECABA01_US.BIN::line:8_1_0"
msgid "Not yet.{PA:20}"
msgstr "Aún no.{PA:20}"

