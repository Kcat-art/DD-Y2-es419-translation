msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::name:2"
msgid "Staff"
msgstr "Empleado"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:0_0_0"
msgid "I{MS:1}{MS:0}t's nice to meet you.{MS:2}{PA:20} I'm Kaede.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:0_1_0"
msgid "H{MS:0}i,{PA:10} thanks for coming!{PA:30}{PA:20}||{MS:1}It's so nice to see you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_0_0"
msgid "M{MS:0}y name is Kaede.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_0_1"
msgid "T{MS:0}hank you for choosing me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_1_0"
msgid "Good evening,{PA:10} {MS:0}Kazuma.{PA:20}||It's great to see you again.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_2_0"
msgid "I'm sorry about before.{PA:20}||Something suddenly came up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_2_1"
msgid "It's no problem.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_3_0"
msgid "Let's have some fun!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_3_1"
msgid "Okay.{PA:20}"
msgstr "Okey.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_4_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}||I was hoping we could go out before work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_4_1"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm sorry.{PA:20}"
msgstr "L{PA:20}o{PA:20} {PA:20}lamento...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_4_2"
msgid "It's okay.{PA:20}||Let's drink up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_5_0"
msgid "Thanks for going out with me the||other night.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_5_1"
msgid "Of course.{PA:20}"
msgstr "Por supuesto.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_5_2"
msgid "Let's do it again sometime.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_6_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}||I wanted to go out after work.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_6_1"
msgid ".{PA:20}.{PA:20}.{PA:20}I'm sorry.{PA:20}"
msgstr "L{PA:20}o{PA:20} {PA:20}lamento...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:1_6_2"
msgid "It's okay.{PA:20}||Let's drink up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:2_0_0"
msgid "Y{MS:1}{MS:0}ou look very handsome today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:2_1_0"
msgid "Y{MS:1}{MS:0}ou always look so handsome.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:2_2_0"
msgid "S{MS:1}{MS:0}omething seems a little off today.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_0_0"
msgid "Oh,{PA:10} {MS:0}wow!{PA:20}❤||I love getting presents!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_0_1"
msgid "Of course.{PA:20}"
msgstr "Por supuesto.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_0_2"
msgid "T{MS:0}hank you,{PA:10} Kazuma.{PA:20}||I'll take good care of it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_1_0"
msgid "I{MS:0}s this for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_1_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_1_2"
msgid "T{MS:0}hank you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_2_0"
msgid "Is that for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_2_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_2_2"
msgid "Um.{PA:20}.{PA:20}.{PA:20} {MS:0}Thanks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:3_2_3"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_0_0"
msgid "W{MS:0}hat would you like to drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_1_0"
msgid "Your glass is empty.{PA:20}||W{MS:0}hat would you like to drink?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_2_0"
msgid "Y{MS:0}ou want.{PA:20}.{PA:20}.{PA:20} the gold?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_2_1"
msgid "W{MS:0}ow,{PA:10} what a big spender!{PA:20}||Lucky me!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_2_2"
msgid "I see.{PA:20}||I'll get you another menu.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_3_0"
msgid "Y{MS:0}ou can tell a lot about a person||by what they drink.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_3_1"
msgid "Is that so?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_3_2"
msgid "You know.{PA:20}.{PA:20}.{PA:20}"
msgstr "sabes l{PA:20}{PA:20}o{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_3_3"
msgid "Any other liquor {MS:0}just wouldn't suit||a first-class guy like you,{PA:10} Kazuma.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_4_0"
msgid "Y{MS:0}our drink will be ready right away.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_5_0"
msgid "Y{MS:0}ou drink that kind of liquor?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:4_5_1"
msgid "I don't really think it suits you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_0_0"
msgid "W{MS:0}ill you have something to eat,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_0_2"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_0_3"
msgid "No,{PA:10} I'm fine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_1_0"
msgid "This is delicious.{PA:20}||{MS:0}I love it,{PA:10} too.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_2_0"
msgid "C{MS:0}oming right up!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_3_0"
msgid "Y{MS:0}ou really want to eat that?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:5_3_1"
msgid "I honestly don't think it suits you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_0_0"
msgid "G{MS:0}reat,{PA:10} we can talk some more!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_0_1"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_1_0"
msgid "That felt like it went by quickly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_1_1"
msgid "Oh,{PA:10} here's my email address.{PA:20}||Can I have yours?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_1_2"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_1_3"
msgid "Okay,{PA:10} I'll{MS:0} send you an email later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_2_0"
msgid "The time passed so quickly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_2_1"
msgid "P{MS:0}lease come back again soon!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_3_0"
msgid "P{MS:0}lease come again.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_0"
msgid "M{MS:0}ay I ask you a favor,{PA:10} Kazuma?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_1"
msgid "What's that?{PA:20}"
msgstr "¿El qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_2"
msgid "Will you take me out on a date?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_3"
msgid "When we spend time together,{PA:10} I always feel||so at ease.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_4"
msgid "What do you think?{PA:20}"
msgstr "¿Qué opinas tú?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_5"
msgid "Sure,{PA:10} no problem.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_6"
msgid "Thank you.{PA:20}||I'll be waiting at Café Alps.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_4_7"
msgid "Please come.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_5_0"
msgid "Kazuma,{MS:0}{PA:10} do you have plans after this?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_5_1"
msgid "Why?{PA:20}"
msgstr "¿Por qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_5_2"
msgid "Well,{PA:10} I'd like it if we could talk for a||little longer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_5_3"
msgid "Is that all right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_5_4"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_5_5"
msgid "Great,{PA:10} I'll contact you later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_6_0"
msgid "Kazuma,{PA:10} {MS:0}can we go out before work next time?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_6_1"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_6_2"
msgid "Oh,{PA:10} good!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_6_3"
msgid "I'll contact you later,{PA:10} then.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_7_0"
msgid "Kazuma,{PA:10} {MS:0}can I ask you something?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_7_1"
msgid "What is it?{PA:20}"
msgstr "¿De qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_7_2"
msgid "Could we maybe go out again?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_7_3"
msgid "Yeah,{PA:10} sure.{PA:20}"
msgstr "Sí, c{PA:10}laro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_7_4"
msgid "Thank you.{PA:20}||I'll be waiting at Café Alps.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:6_7_5"
msgid "This time,{PA:10} please come alone.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:7_0_0"
msgid "T{MS:0}hank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_0"
msgid "Champagne call!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_1"
msgid "Hurraaay!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_2"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_3"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_4"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_5"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_6"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_7"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_8"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:8_0_9"
msgid "Hurray!{PA:20} Hurray!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_0"
msgid "S{MS:0}igh.{PA:20}.{PA:20}.{PA:20}||I've always had bad luck with men.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_1"
msgid "Maybe it's because I do this kind of work,{PA:10}||{MS:0}but I haven't really met anyone lately.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_2"
msgid "I'd like to think I could have any||man that I wanted,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_3"
msgid "but I don't know if that's really true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_4"
msgid "I{MS:0} wonder if I'll be alone on Valentine's.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_5"
msgid "Ha ha!{PA:20}❤||Are you serious?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_6"
msgid "Sure.{PA:20}"
msgstr "Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_7"
msgid "You know,{PA:10} my customers always say things||like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_8"
msgid "But they're just making conversation.{PA:20}||People say a lot of things they don't mean.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_9"
msgid "No,{PA:10} I really mean it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_10"
msgid "A{MS:0}ww!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_11"
msgid "Y{MS:0}ou're very sweet.{PA:20}||I'll keep that in mind.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_12"
msgid "Sure,{PA:10} b{MS:0}ut don't you think holidays||are a little different?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_13"
msgid "It gets lonely,{PA:10} you know.{PA:20}||My customers come and go,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_0_14"
