msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||That's going a little too far.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_5_18"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_5_19"
msgid "S{MS:0}ome hostesses really like their customers||or want to talk all about their day.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_5_20"
msgid "They can be pretty tough to read.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_0"
msgid "People{MS:0} always talk about who's the number||one hostess.{PA:20} Do you know what that means?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_1"
msgid "The hostess who gets requested the most?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_2"
msgid "That's right!{PA:20}||But there's another kind of number one.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_3"
msgid "What do you think the other||number one is all about?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_4"
msgid "W{MS:0}ell,{PA:10} most hostesses||are attractive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_5"
msgid "I{MS:0}t's not an effective way to judge us.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_6"
msgid "If it were up to me,{PA:10} you would be number||one in beauty.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_7"
msgid "Hee{MS:0} hee!{MS:1}{PA:20}||You're such a smooth talker,{PA:10} Kazuma!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_8"
msgid "T{MS:0}hat's right!{PA:20}||You know a lot,{PA:10} don't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_9"
msgid "I know a little.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_10"
msgid "What drinks a customer orders is very||important to the business.{PA:20} But it's tricky.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_11"
msgid "I've been number one in requests before,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_12"
msgid "but never number one in||drink sales.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_13"
msgid "So I guess I just need to work a little||bit harder.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_14"
msgid "I think you'll be number one in no time,{PA:10}||if you give it a go.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_15"
msgid "T{MS:0}hank you,{PA:10} Kazuma!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_16"
msgid "D{MS:0}ates are counted as customer requests,{PA:10}||for the most part.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_17"
msgid "So there isn't really a number one||in that arena.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_18"
msgid "Oh.{PA:20}"
msgstr "Vaya...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_19"
msgid "I{MS:0} think you've got some things||to learn about how a cabaret works.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_6_20"
msgid "Yeah,{PA:10} maybe.{PA:20}"
msgstr "Un {PA:10}poco.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_0"
msgid "My{MS:0} cooking?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_1"
msgid "I don't mean to be immodest,{PA:10}||but I'm actually a pretty good cook.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_2"
msgid "But mostly I invent my own||recipes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_3"
msgid "Hee hee hee!{PA:20}||Sure,{PA:10} but it might be a little bland.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_4"
msgid "When I make my mother's recipe,{PA:10}||people say it's too bland.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_5"
msgid "A beautiful woman who can cook is quite||a catch.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_6"
msgid "O{MS:0}h?{PA:20}||Really?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_7"
msgid "T{MS:0}hat's a really sweet thing||to say,{PA:10} Kazuma.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_8"
msgid "O{MS:0}h?{PA:20}||So you cook,{PA:10} too?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_9"
msgid "A bit.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_10"
msgid "A man who can cook is almost a given||these days.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_11"
msgid "And I thought I was special.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_12"
msgid "I{MS:0} eat alone!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_13"
msgid "I've got nobody to share my delicious||cooking with,{PA:10} as tragic as that may be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_14"
msgid "Why don't I eat it with you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_15"
msgid "T{MS:0}hat's what they all say.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_7_16"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_0"
msgid "B{MS:0}efore I come to work,{PA:10} I usually stop||at the store to pick up something to eat.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_1"
msgid "I always end up with lots of 1 yen||coins in my purse.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_2"
msgid "On the days that I put them into those"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_3"
msgid "fund-raiser boxes,{PA:10} {MS:1}{MS:0}I{MS:2} seem to||get a lot of good customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_4"
msgid "Of course,{PA:10} it's all just coincidence.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_5"
msgid "B{MS:0}ut I guess I am a little||bit superstitious.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_6"
msgid "D{MS:0}o you have any,{PA:10} Kazuma?{PA:20}||Superstitions,{PA:10} I mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_7"
msgid "A{MS:0}rmed?{PA:20} As in guns?!{PA:20}||What does that mean?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_8"
msgid "Er,{PA:10} nothing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_9"
msgid "You sound like a dangerous||man,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_11"
msgid "Um.{PA:20}.{PA:20}.{PA:20}"
msgstr "..{PA:20}{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_12"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_13"
msgid "T{MS:0}hat's terrible,{PA:10} Kazuma.{PA:20}||Why would you say such a thing?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_15"
msgid "Y{MS:0}es,{PA:10} I've heard of that before.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_16"
msgid "It's a great sensation,{PA:10} feeling lucky,{PA:10}||and it makes you feel invincible.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_17"
msgid "I{MS:0}'m a slow walker,{PA:10}||so I always get stuck waiting at red lights.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_18"
msgid "It's pretty rare that I get a lot||of green lights,{PA:10} but when I do,{PA:10} it's great!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_19"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_20"
msgid "S{MS:0}uperstitions don't really rely||on logic,{PA:10} but don't you think it's nice"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_21"
msgid "to transcend logic every once in a while?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_22"
msgid "Of course,{PA:10} not if it's a bad superstition,{PA:10}||but if it's one that can make the world a"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_23"
msgid "better place,{PA:10} {MS:1}{MS:0}what's the harm in it?{PA:20}||Don't you agree?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_8_24"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_0"
msgid "A {MS:0}hostess's job is to sell drinks,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_1"
msgid "We drink every day,{PA:10} so we develop a pretty||strong tolerance to alcohol.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_2"
msgid "Y{MS:0}ou seem pretty strong yourself,{PA:10} Kazuma.{PA:20}||Can you drink a lot?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_3"
msgid "A {MS:0}glass.{PA:20}.{PA:20}.{PA:20}||{MS:2}{MS:1}That's not very much.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_4"
msgid "Of course,{PA:10} it probably means you have a{MS:0}||pretty healthy liver then,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_5"
msgid "I guess so.{PA:20}"
msgstr "Supongo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_6"
msgid "A{MS:0}bout a bottle?{MS:1}{PA:20}||That's about the same as me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_7"
msgid "T{MS:0}here are some hostesses who||drink a stupid amount.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_8"
msgid "Some women get dead drunk and have to be||escorted home.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_9"
msgid "That can't be good.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_10"
msgid "No,{PA:10} it can't.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_12"
msgid "I {MS:0}can tell.{PA:20}❤||I like people who can drink!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_13"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_14"
msgid "But some men don't like women who can drink||like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_15"
msgid "No matter how much they drink,{PA:10}||they{MS:0} won't get even a little drunk.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_9_16"
msgid "They're functional alcoholics.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_0"
msgid "I{MS:0}n the club,{PA:10} there are guys||dressed in black acting as waiters,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_1"
msgid "I've seen them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_2"
msgid "Those guys sometimes act as||counselors to us women.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_3"
msgid "I{MS:0}t's against the rules to get||romantically involved with a coworker!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_4"
msgid "If you get caught,{PA:10} there's even a fine.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_5"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_6"
msgid "And it's quite a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_7"
msgid "B{MS:0}ecause if you're dating someone you work||with,{PA:10} you can't do your job properly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_8"
msgid "I can see that.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_9"
msgid "J{MS:0}ust stuff like etiquette,{PA:10}||rotation timing,{PA:10} things like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_10"
msgid "So you complain about your customers?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_11"
msgid "T{MS:0}hat's not it at all!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_12"
msgid "We all want to work hard and do better jobs,{PA:10}||so we talk about how we can do that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_13"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_14"
msgid "Maybe you don't believe me,{PA:10}||but it's true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_15"
msgid "W{MS:0}hat?{PA:20}||Why do you ask?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_16"
msgid "It's just,{PA:10} if there's something bothering||you,{PA:10} maybe there's something I can do.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_17"
msgid "H{MS:0}ee hee!{PA:20}❤||T{MS:1}hank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_10_18"
msgid "P{MS:0}eople who strive to be helpful are||good at heart.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_0"
msgid "D{MS:0}o you know anything about||credit?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_1"
msgid "You mean like bar tabs?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_2"
msgid "Yes,{PA:10} {MS:0}that's right.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_3"
msgid "In places that accept credit,{PA:10} you don't||have to worry about handling money,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_4"
msgid "so customers come back often.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_5"
msgid "W{MS:0}hat?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_6"
msgid "I don't think we can make you a||tab out of the blue like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_7"
msgid "Plus,{PA:10} our club doesn't allow tabs.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_8"
msgid "That's too bad.{PA:20}"
msgstr "Es una lástima.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_9"
msgid "Y{MS:0}ou're kind of||an opportunist,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_10"
msgid "W{MS:0}ell.{PA:20}.{PA:20}.{PA:20}||{MS:1}That can be an issue for some women.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_11"
msgid "They can't handle being confrontational,{PA:10}||and end up giving up on the money.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_12"
msgid "That's sad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_13"
msgid "It just means they shouldn't be in this||line of work,{PA:10} really.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_15"
msgid "T{MS:0}hat's right.{PA:20}||In the end,{PA:10} it's about trusting the customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_16"
msgid "Of course,{PA:10} some people just shouldn't||be trusted.{PA:20} Like me,{PA:10} for example.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_17"
msgid "H{MS:0}ee hee!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_11_18"
msgid "I think I could probably trust you,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_0"
msgid "T{MS:0}his kind of place is||pretty ritzy,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_1"
msgid "To be honest,{PA:10} it does cost a lot to come||here,{PA:10} but we think that's reasonable.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_2"
msgid "The women dress up,{PA:10} take care of themselves||and entertain their customers.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_3"
msgid "It can be hard work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_4"
msgid "We never want to see our customers going"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_5"
msgid "home unsatisfied.{PA:20} That's our main||priority,{PA:10} to keep our customers happy.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_6"
msgid "That's why it's so expensive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_7"
msgid "W{MS:0}e do the best that we can.{PA:20}||Everyone wants something different though,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_8"
msgid "so sometimes it's tough to gauge how to||act around each customer.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_9"
msgid "It can get a little tricky.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_10"
msgid "I just do my best.{MS:1}{MS:0}{PA:20} If there's something||{MS:2}l{MS:3}acking,{PA:10} please tell me,{PA:10} okay?{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_11"
msgid "Don't worry,{PA:10} I'm satisfied.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_12"
msgid "W{MS:0}ell,{PA:10} yes and no.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_13"
msgid "We hostesses earn more than a lot of people||who work for big companies.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_14"
msgid "But we use it all to polish ourselves up,{PA:10}||so it's common to end up with nothing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_15"
msgid "And at night we often travel by taxi.{PA:20}||It can be very expensive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_16"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_17"
msgid "K{MS:0}azuma,{PA:10} please!{PA:20}||Are you saying what I think you're saying?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_18"
msgid "This is a place where we drink and talk.{PA:20}||Nothing more,{PA:10} nothing less.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_12_19"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_0"
msgid "I{MS:0}n doing this job,{PA:10} I came to realize that"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_1"
msgid "most men are typically attracted to the||same type of women.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_2"
msgid "They want someone gorgeous and sweet,{PA:10}||who is kind,{PA:10} talented,{PA:10} hardworking.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_3"
msgid "Someone who is patient,{PA:10} but can be firm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_4"
msgid "W{MS:0}hat do you think,{PA:10} Kazuma?{PA:20}||Is that what you're looking for,{PA:10} too?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_5"
msgid "I{MS:0} see.{PA:20}||It's kind of an ideal,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_6"
msgid "Maybe even a pipe dream.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_7"
msgid "To think of you as an idealist.{PA:20}.{PA:20}.{PA:20}||{MS:2}{MS:1}{MS:0}T{MS:3}hat's kind of cute,{PA:10} Kazuma!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_8"
msgid "W{MS:0}omen have a lot to deal with,{PA:10} though,{PA:10}||so it's not always easy to fit that mold.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_9"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_10"
msgid "H{MS:0}uh!{PA:20}||Sounds like you're looking for a sugar mama.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_11"
msgid "Yet you come to cabarets and spend money||to talk to women!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_12"
msgid "Y{MS:0}ou're barking up the wrong tree,{PA:10}||Kazuma.{PA:20} That's just my opinion.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_13"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_14"
msgid "W{MS:0}hat!?{PA:20}||But we've been.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_15"
msgid "I'm joking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_16"
msgid "You {MS:0}had me for a moment there!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_17"
msgid "That's not a very politically correct||joke,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_13_18"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_0"
msgid "W{MS:0}hen you do nothing but||entertain people all day,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_1"
msgid "sometimes you want to relax and be||entertained yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_2"
msgid "So I used to go to host clubs a lot||with my friends.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_3"
msgid "I'm used to being so giving with my||attention all the time,{PA:10} so"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_4"
msgid "i{MS:0}t feels strange to be||on the other end of it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_5"
msgid "I{MS:0}t's not that I'm into it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_6"
msgid "It's the same kind of business,{PA:10}||so I understand it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_7"
msgid "That gets pretty expensive,{PA:10} doesn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_8"
msgid "A{MS:0} lot of women get hooked on it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_9"
msgid "The men at host clubs are usually very kind,{PA:10}||handsome and attentive.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_10"
msgid "It's nice to be on the||receiving end of that for a change.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_12"
msgid "Y{MS:0}eah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_13"
msgid "I don't think there's a woman here who||isn't stressed out to some degree.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_14"
msgid "When it's your first time with someone,{PA:10}||you don't know what to talk about.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_15"
msgid "And some customers drink so much,{PA:10}||they get belligerent.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_16"
msgid "I feel honored to drink with a woman||like you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_17"
msgid "H{MS:0}ee hee!{PA:20}||I wish I only had to drink with customers"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_18"
msgid "who are as gentlemanly as you are,{PA:10} Kazuma!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_19"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_20"
msgid "T{MS:0}hat's a little extreme.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_21"
msgid "There are a lot of great things about||working here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_22"
msgid "But it's hard,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_23"
msgid "I feel like entertaining people is||my calling.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_24"
msgid "I've never thought of quitting this||job,{PA:10} not even for a minute!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_14_25"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_0"
msgid "P{MS:0}eople say that with makeup,{PA:10}||even an average woman can become beautiful.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_1"
msgid "B{MS:0}ut makeup is a lot of work.{PA:20}||Not just time,{PA:10} but it also takes skill.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_2"
msgid "Plus,{PA:10} if your skin is bad enough,{PA:10}||then no amount of makeup will help you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_3"
msgid "I'm always on the lookout for products||that claim to be"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_4"
msgid "e{MS:0}ffective in beautifying skin.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_5"
msgid "I {MS:0}wonder.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_6"
msgid "I've only shown my true face||to my little brother.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_7"
msgid "I don't wear makeup around him.{PA:20}||{MS:1}{MS:0}H{MS:2}e thinks I'm pretty,{PA:10} but I just don't know.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_8"
msgid "Hm.{PA:20}.{PA:20}.{PA:20}"
msgstr "Mm.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_9"
msgid "Y{MS:0}es,{PA:10} people sometimes put too much emphasis||on beauty products.{PA:20} And I'm no exception.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_10"
msgid "I{MS:0}'ve tried using lemon packs||and going to spas.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_11"
msgid "But the thing that has the most effect||is a good night's sleep.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_12"
msgid "It's funny it's so simple,{PA:10} isn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_13"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_14"
msgid "T{MS:0}hank you for noticing!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_15"
msgid "But my natural face isn't anything to scoff||at either.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_16"
msgid "At least,{PA:10} that's what my brother tells me.{PA:20}||But I still won't show it to anyone but him.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_17"
msgid "I {MS:0}feel naked and exposed||when I don't wear any makeup.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_15_18"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_0"
msgid "I{MS:0} recently bought an apartment in the city.{PA:20}||{MS:1}It's a bit large for just one person.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_1"
msgid "Keeping it clean is a chore,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_2"
msgid "W{MS:0}hat?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_3"
msgid ".{PA:20}.{PA:20}.{PA:20}O{MS:0}f course I bought||it myself!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_4"
msgid "Really?{PA:20}"
msgstr "¿De verdad?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_5"
msgid "W{MS:0}hat,{PA:10} do you think a customer||bought it for me?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_6"
msgid "That happens sometimes,{PA:10} doesn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_7"
msgid "Y{MS:0}ou're terrible!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_8"
msgid "I {MS:0}don't ask for things||like that from my customers!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_9"
msgid "Oh.{PA:20}"
msgstr "Vaya...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_10"
msgid "H{MS:0}ey!{PA:20} Don't say things||like that so lightly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_11"
msgid "It wasn't a frivolous purchase.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_12"
msgid "Sorry.{PA:20}"
msgstr "Perdón.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_13"
msgid "You know,{PA:10} the number of young people||who buy apartments has been increasing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_14"
msgid "B{MS:0}ut I kind of regret it now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_16"
msgid "H{MS:0}a ha ha!{PA:20}||That's funny!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_17"
msgid "Then it wouldn't feel like it was too big.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_18"
msgid "B{MS:0}ut then I'd be broke!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_19"
msgid "It's sort of a catch-22 if||you think about it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_16_20"
msgid "Yeah,{PA:10} I guess so.{PA:20}"
msgstr "Sup{PA:10}ongo...{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_0"
msgid "A{MS:0} lot of women are obsessed with their hair.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_1"
msgid "Usually,{PA:10} I visit my stylist to get my hair||done before work,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_2"
msgid "but when I oversleep and don't have time,{PA:10}||I just come without worrying about it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_3"
msgid "My hairstyle isn't very elaborate,{PA:10}||so it's pretty easy to manage.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_4"
msgid "A lot of women don't make it in time||and spend the moments before we open"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_5"
msgid "fixing up their hair.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_6"
msgid "T{MS:0}hank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_7"
msgid "I'm so happy||you think so!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_8"
msgid "Hair is very important in this business.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_9"
msgid "I use a lot of treatment||and things like that.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_10"
msgid "S{MS:0}o I pretty much have no split ends.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_11"
msgid "Fascinating.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_12"
msgid "S{MS:0}ometimes I think about it,{PA:10}||but I'm not really tempted.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_13"
msgid "Showy hair might draw more attention||from customers,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_14"
msgid "but {MS:0}it'd be easy to damage my hair.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_15"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_16"
msgid "A{MS:0}bout thirty minutes or so.{PA:20}||I'm one of the faster ones.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_17"
msgid "Women with showier hair take||anywhere from an hour and up.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_17_18"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_0"
msgid "I{MS:0} love getting my nails done.{PA:20}||I go to a salon once a week.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_1"
msgid "I get sculpts put on.{PA:20} It's||more fun to have them put on in the shop.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_2"
msgid "S{MS:0}culpts are like press-on nails.{PA:20}||{MS:1}Maybe I should just call them press-ons.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_3"
msgid "Oh,{PA:10} I see.{PA:20}"
msgstr "Oh.{PA:10} Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_4"
msgid "Sorry.{PA:20}.{PA:20}.{PA:20}||I guess you'd never heard that term.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_5"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_6"
msgid "H{MS:0}a ha ha!{PA:20}||Good one,{PA:10} Kazuma!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_7"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} that's not it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_8"
msgid "N{MS:0}o!{PA:20}||It's not like I'm bald!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_9"
msgid "Y{MS:0}ou're such a card!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_10"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_11"
msgid "W{MS:0}hat!?{PA:20}||You get your nails done too?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_12"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_13"
msgid "K{MS:0}azuma,{PA:10} you shouldn't lie.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_14"
msgid "Sorry.{PA:20}"
msgstr "Perdón.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_18_15"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_0"
msgid "T{MS:0}here's a customer who comes here a lot||and brags all the time.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_1"
msgid "I think he's mostly lying.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_2"
msgid "You're not like him at all.{PA:20}||You don't talk much about yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_3"
msgid "In fact,{MS:0}{PA:10} you're kind of mysterious.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_4"
msgid "O{MS:0}h,{PA:10} really?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_5"
msgid "I thought maybe you were a higher-up||in the yakuza world or something.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_6"
msgid "I{MS:0} have a feeling about these things.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_7"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_8"
msgid "Y{MS:0}ou're humble.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_9"
msgid "But you have a powerful aura.{PA:20}||{MS:0}I{MS:2}{MS:1} think everyone notices.{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_10"
msgid "But there's a reason why you don't||talk about yourself,{PA:10} isn't there?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_11"
msgid "I {MS:0}won't ask you anything private||until you're ready to tell me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_12"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_13"
msgid "O{MS:0}h,{PA:10} Kazuma!{PA:20} You're so silly!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_14"
msgid "But you can get more creative than that,{PA:10}||can't you?{PA:20} Such as.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_15"
msgid "Y{MS:0}ou could say you were from the future!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_19_16"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_0"
msgid "A{MS:0} lot of customers use this place||to entertain business clients.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_1"
msgid "In those cases,{PA:10} we have to be careful to keep||professional,{PA:10} and not to say things that"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_2"
msgid "would affect business talks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_3"
msgid "Come to think of it,{PA:10} you||always come here alone,{PA:10} don't you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_4"
msgid "I{MS:0}'d think someone like you||would be surrounded by women.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_5"
msgid "E{MS:0}ven though that's just flattery,{PA:10}||I'm still delighted to hear it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_6"
msgid "I {MS:0}think any woman would be||happy to hear that from you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_7"
msgid "But at the same time,{PA:10} I'm a little||worried that you say that to"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_8"
msgid "all the girls.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_9"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_10"
msgid "O{MS:0}h,{PA:10} really?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_11"
msgid "What {MS:0}man doesn't dream of being surrounded||by beautiful women?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_12"
msgid "Or maybe what you mean is that||{MS:0}c{MS:1}rowds just don't suit you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_13"
msgid "Either way,{PA:10} I don't mind being the only||w{MS:0}oman sitting by your side.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_15"
msgid "Oh,{MS:0}{PA:10} good!{PA:20}||I'm so glad to hear that!{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_16"
msgid "I{MS:0} like this atmosphere too.{PA:20}||It's like a party that never ends.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_17"
msgid "Sometimes I pretend that this is my home,{PA:10}||and I'm throwing a party full of very"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_18"
msgid "important people.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_19"
msgid "A{MS:0}nd it's not a far stretch,{PA:10}||you know!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:9_20_20"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_0"
msgid "It's{MS:0} been six months since I began working||in this town,{PA:10} but I'm still not used to it.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_1"
msgid "Maybe I don't belong in Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_2"
msgid "O{MS:0}h,{PA:10} really?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_3"
msgid "You like this town,{PA:10} don't you?{PA:20}❤"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_4"
msgid "I'm still not sold on it.{PA:20}||There are a lot of sketchy people here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_5"
msgid "But I trust your judgment,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_6"
msgid "Maybe I'll try harder from now on.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_7"
msgid "I{MS:0} hope someday I'll be able to say||that I love it here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_8"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_9"
msgid "I{MS:0} see.{PA:20}.{PA:20}.{PA:20}"
msgstr "E{MS:0}ntiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_10"
msgid "T{MS:0}hat's the feeling that||I've been getting.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_11"
msgid "But I do like this club.{PA:20}||Maybe I'll try a little harder.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_12"
msgid "S{MS:0}o cheer me on,{PA:10} okay?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_13"
msgid "Will do.{PA:20}"
msgstr "Lo consideraré. Nos vemos.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_14"
msgid "A wall.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_15"
msgid "Hm.{PA:20} Now that I think about it,{PA:10} I've always||compared this place to where I used to work.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_16"
msgid "Not all the time,{PA:10} but sometimes I think||long and hard about why it is I'm"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_17"
msgid "working here.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_18"
msgid "B{MS:0}ut that's not fair to the customers||who come here to see me,{PA:10} is it?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_0_19"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_0"
msgid "T{MS:0}here are some customers who constantly"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_1"
msgid "try to grope me.{PA:20}||But I guess it's like that wherever you go.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_2"
msgid "They've even started calling my cell phone{MS:1}{MS:0}||a{MS:2}nd harassing me!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_3"
msgid "This isn't that kind of place for that,{PA:10}||and I explain it to them clearly.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_4"
msgid "I say if you want to do that kind of thing,{PA:10}||then please go to that kind of club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_5"
msgid "B{MS:0}ut it doesn't have any effect.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_6"
msgid "T{MS:0}hat's probably true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_7"
msgid "But when it's a customer,{PA:10} it's||hard to ignore them.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_8"
msgid "Their happiness is supposed to be my job!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_9"
msgid "O{MS:0}f course,{PA:10} there are some customers||I'd rather be tending to than others.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_10"
msgid "Such as yourself,{PA:10} of course.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_11"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_01_US.BIN::line:10_1_12"
