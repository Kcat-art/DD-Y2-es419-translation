msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_13_4"
msgid "I{MS:0} guess.{PA:20}||Yeah,{PA:10} maybe that's true.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_13_5"
msgid "But sometimes when I think about it,{PA:10}||I get a little sad.{PA:20}"
