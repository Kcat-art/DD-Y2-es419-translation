msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_4_14"
msgid "Y{MS:0}ou don't take me seriously,{PA:10}||do you,{PA:10} Kazuma?{PA:20}"
