msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:5_3_0"
msgid "I don't really want any.{MS:1}{MS:0}{PA:20}||You eat it,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_0_0"
msgid "You're going to stay longer?{PA:20}||{MS:0}That's wonderful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_1_0"
msgid "You're so great,{PA:10} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_1_1"
msgid "Most of my customers aren't very||good-looking.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_1_2"
msgid "But you're quite handsome.{PA:20}||Lucky me!{PA:20}"
