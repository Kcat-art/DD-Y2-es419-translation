msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_5_1"
msgid "Why?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_5_2"
msgid "I was just wondering if maybe||we could go get something to eat together.{PA:20}"
