msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_4_10"
msgid "Plus,{PA:10} when I noticed him,{PA:10} he ran.{PA:20}||{MS:0}I{MS:1}t's so awful!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_4_11"
msgid "I wish people like that would just get a||life and leave me alone!{PA:20}"
