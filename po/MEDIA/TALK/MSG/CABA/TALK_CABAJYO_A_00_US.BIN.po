msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:6_2_0"
msgid "Looks like our time is up.{PA:20}||{MS:0}And{MS:1} I wanted to talk more!{PA:20}"
