msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_5_0"
msgid "W{MS:0}hen the club is closed,{PA:10} sometimes||I moonlight as a model.{PA:20}"
