msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_0_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_1_0"
msgid "Looks like your glass is empty.{PA:20}||I'll bring you the menu.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_1_1"
msgid "I'll have this.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_2_0"
msgid "Oh,{PA:10} wow!{PA:20} Really?!{MS:0}{PA:20}||But gold is so expensive!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_2_1"
msgid "You must be rich,{PA:10} Kazuma!{PA:20}"
