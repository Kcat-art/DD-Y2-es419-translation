msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_5_11"
msgid "You'd protect me!{PA:20}||That's so nice!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_5_12"
