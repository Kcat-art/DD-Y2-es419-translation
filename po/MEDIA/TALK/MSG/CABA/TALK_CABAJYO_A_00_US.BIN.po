msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_2_4"
msgid "If something doesn't go your way,{PA:10} you've got||to get over it and move on!{PA:20} Don't you agree?{PA:20}"
