msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_4_13"
msgid "I {MS:0}don't think that's it!{PA:20}||I was so scared.{PA:20}"
