msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_13_14"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:9_14_0"
msgid "Wow,{MS:0}{PA:10} so you'll pretty much eat anything?{PA:20}||That's very admirable,{PA:10} Kazuma.{PA:20}"
