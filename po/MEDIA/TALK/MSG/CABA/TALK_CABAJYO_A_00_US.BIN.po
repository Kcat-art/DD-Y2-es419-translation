msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_2_2"
msgid "Let's toast.{PA:20}.{PA:20}.{PA:20} to us!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:4_2_3"
msgid "Oh,{PA:10} you were just kidding.{PA:20}.{PA:20}.{PA:20}||{MS:1}{MS:0}That's too bad.{PA:20}"
