msgctxt "MEDIA/TALK/MSG/CABA/TALK_CABAJYO_A_00_US.BIN::line:1_0_0"
msgid "T{MS:0}hank you for coming to see me!{PA:30}{PA:20}||I{MS:1}s this your first time here?{PA:20}"
