msgstr ".{PA:20}.{PA:20}. {PA:20}Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_3_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}||Are you free later?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_3_1"
msgid "If you'd like,{PA:10} how about||accompanying me on a date after work?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_3_2"
msgid "I'd love to.{PA:20}"
msgstr "Me encantaría.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_3_3"
msgid "Excellent.{PA:20}||I shall wait in front of the club.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_3_4"
msgid "All right.{PA:20}"
msgstr "Está bien.{PA:20}"

