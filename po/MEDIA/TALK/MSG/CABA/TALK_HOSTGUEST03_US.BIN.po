msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_8"
msgid "Of course they||are chilled.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_9"
msgid "You can't drink warm champagne,{PA:10}||can you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_10"
msgid ".{PA:20}.{PA:20}.{PA:20}Right.{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} Claro.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_11"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||What to have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_12"
msgid "W{MS:0}ow.{PA:20}.{PA:20}.{PA:20}||Order a few.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_13"
msgid ".{PA:20}.{PA:20}.{PA:20}Because today you're||the star.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_14"
msgid "Oh!{PA:20} Am I really?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_15"
msgid "O{MS:0}kay.{PA:20}.{PA:20}.{PA:20}||What to have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_0"
msgid "Tamao,{PA:10} how about we||order another bottle?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_1"
msgid "Well,{PA:10} well.{PA:20}.{PA:20}.{PA:20}||Are you being a salesman now?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_2"
msgid "You do,{PA:10} do you?{PA:20}||You're pretty confident.{PA:20}"
