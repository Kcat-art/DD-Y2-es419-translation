msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_11"
msgid "It's fine.{PA:20}"
msgstr "No es nada.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_12"
msgid "Time is something you make.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_13"
msgid "W{MS:0}hat kind of host are you?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_0"
msgid "T{MS:0}amao,{PA:10} aren't you thirsty?{PA:20}"
