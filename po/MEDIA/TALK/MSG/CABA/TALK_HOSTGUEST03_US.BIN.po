msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_0_2"
msgid "Leaving so soon?{PA:20}"
msgstr "¿Ya se va?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_0_3"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20} What to do?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:3_1_0"
