msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_3"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||What shall we have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_4"
msgid "Yes.{PA:20}.{PA:20}.{PA:20}||That's the most expensive,{PA:10} isn't it?{PA:20}"
