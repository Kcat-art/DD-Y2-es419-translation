msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_1"
msgid "No.{PA:20}.{PA:20}.{PA:20} I never.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_2"
msgid "I{MS:0}t's okay.{PA:20}.{PA:20}.{PA:20} I know.{PA:20}||I.{PA:20}.{PA:20}.{PA:20} *sniff*"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_3"
msgid "See.{PA:20}.{PA:20}.{PA:20}||In the end,{PA:10} all hosts are the same.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_5"
msgid "I just thought||maybe you'd be different.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_6"
msgid "It's really too bad.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_7"
msgid ".{PA:20}.{PA:20}.{PA:20}What?{PA:20}"
msgstr ".{PA:20}.{PA:20}.{PA:20} ¿Qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_8"
msgid "T{MS:0}ears don't suit you.{PA:20}||You've got to be stronger.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_9"
msgid "He{MS:0}h.{PA:20}.{PA:20}.{PA:20}||It looks like I picked the right host.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_10"
msgid "I'll show you how strong I can be.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_11"
msgid "A bottle of San Pietta!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_12"
msgid "T{MS:0}hank you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_13"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}What?{PA:20}"
msgstr ".{PA:20}.{PA:20}.{MS:0}{PA:20} ¿Qué?{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_14"
msgid "C{MS:0}ome on now.{PA:20}||You're trying to manipulate me with tears.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_15"
msgid "H{MS:0}ow cruel.{PA:20}.{PA:20}.{PA:20}||I'm being serious.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_16"
msgid ".{PA:20}.{PA:20}.{PA:20}Oh.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Oh.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_19_17"
msgid "I{MS:0}'m sorry then.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_0"
msgid "K{MS:0}azuma,{PA:10} I got us some||tickets to a play.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_1"
msgid "It will be just the two of us||in the VIP room.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_2"
msgid "You'll go of course,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_3"
msgid "Y{MS:0}es,{PA:10} it will.{PA:20}||We can relax and just be ourselves.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_4"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_5"
msgid "Hrmph!{PA:20}||Isn't that enough?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_6"
msgid "R{MS:0}egular people can't enter,{PA:10} so||no one will intrude on our date.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_7"
msgid "B{MS:0}ut I want to||show you off.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_8"
msgid "Oh {MS:0}Kazuma,{PA:10} you're good.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_9"
msgid "I see.{PA:20}"
msgstr "Ya veo.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:5_20_10"
msgid ".{PA:20}.{PA:20}.{MS:0}{PA:20}My apologies.{PA:20}"
