msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_3"
msgid ".{PA:20}.{PA:20}.{PA:20}What do you say?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_4"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||What to have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_5"
msgid "Hey!{PA:20}"
msgstr "¡Oye!{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_6"
msgid "What are you yammering about?{PA:20}||I'm the one doing the ordering!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_7"
msgid ".{PA:20}.{PA:20}.{PA:20}Sorry.{PA:20}"
msgstr "..{PA:20}.{PA:20} L{PA:20}o lamento.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_8"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||What to have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_9"
msgid "Ah,{PA:10} yes.{PA:20}||A toast would be nice.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_10"
msgid "It's nice when a||man can really drink.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_1_11"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||What to have?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:7_0_0"
msgid "I enjoyed myself today.{PA:20}||I'll see you again.{PA:20}"
msgstr ""

