msgid "Thank you.{PA:20}"
msgstr "Gracias.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:7_1_0"
msgid "I'll be leaving now!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:7_1_1"
msgid ".{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:8_0_0"
msgid "I'm happy we could meet too.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:8_1_0"
msgid "You make your own destiny.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:8_2_0"
msgid "Forget that,{PA:10} your perfume is really strong.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:9_0_0"
msgid "I'll earn my own money.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:9_1_0"
msgid "Yes,{PA:10} please.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:9_2_0"
msgid "Please just keep choosing me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:10_0_0"
msgid "But isn't it lonely?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:10_1_0"
msgid "Obviously,{PA:10} you're a target.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:10_2_0"
msgid "You've got a discerning eye for men.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:11_0_0"
msgid "For you?{PA:20} Nothing,{PA:10} of course.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:11_1_0"
msgid "One million yen.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:11_2_0"
msgid "It depends on what services you require.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:12_0_0"
msgid "My warm embrace.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:12_1_0"
msgid "A slow dance.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:12_2_0"
msgid "I'm not your pet.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:13_0_0"
msgid "What do you mean,{PA:10} sign a contract?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:13_1_0"
msgid "We don't need a contract.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:13_2_0"
msgid "Really,{PA:10} anything I want?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:14_0_0"
msgid "I'll gently wrap myself around you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:14_1_0"
msgid "Please keep those thoughts to yourself.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:14_2_0"
msgid "You must still be a virgin.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:15_0_0"
msgid "Whether she has money or not.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:15_1_0"
msgid "By our compatibility level.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:15_2_0"
msgid "By her intelligence.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:16_0_0"
msgid "Threats and persuasion.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:16_1_0"
msgid "Charming everyone with your good looks.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:16_2_0"
msgid "Your castration techniques.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:17_0_0"
msgid "I'll propose to you on New Year's Eve.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:17_1_0"
msgid "I'll pass by you without noticing.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:17_2_0"
msgid "Kiss you in the falling snow.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:18_0_0"
msgid "Well,{PA:10} how about I take his place then?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:18_1_0"
msgid "I hear that a lot.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:18_2_0"
msgid "Do I really look like him?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:19_0_0"
msgid "You can't seduce me that easily.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:19_1_0"
msgid "I get 'em with my eyes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:19_2_0"
msgid "A man's story is written on his back.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:20_0_0"
msgid "Your impeccable makeup.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:20_1_0"
msgid "Your smooth skin.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:20_2_0"
msgid "Your seductive eyes.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:21_0_0"
msgid "Golf.{PA:20}"
msgstr "Golf{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:21_1_0"
msgid "Baseball.{PA:20}"
msgstr "Bola de béisbol{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:21_2_0"
msgid "Fighting.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:22_0_0"
msgid "What about as your boyfriend?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:22_1_0"
msgid "What about as your friend?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:22_2_0"
msgid "What about as your son?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:23_0_0"
msgid "To your room.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:23_1_0"
msgid "On a night cruise.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:23_2_0"
msgid "To a hotel suite.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:24_0_0"
msgid "Did you get your money back?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:24_1_0"
msgid "The important thing is that you're safe.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:24_2_0"
msgid "It's because you boast about your wealth.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:25_0_0"
msgid "You can't buy me with money.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:25_1_0"
msgid "I'll make sure you're satisfied later.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:25_2_0"
msgid "Now you'll see my true value.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:26_0_0"
msgid "Maybe you can't count very high.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:26_1_0"
msgid "Of course you're still popular now.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:26_2_0"
msgid "Can I propose too?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:27_0_0"
msgid "I'm sorry.{PA:20}"
msgstr "le pido disculpas.{PA:20}"

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:27_1_0"
msgid "Stop with the crying.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:27_2_0"
msgid "You understand the male heart.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:28_0_0"
msgid "It will be nice to be alone together.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:28_1_0"
msgid "A VIP room sounds great.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:28_2_0"
msgid "I'm busy that night.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:29_0_0"
msgid "I think the gold would suit you well.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:29_1_0"
msgid "The champagnes are chilled.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:29_2_0"
msgid "Why not order a few?{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:30_0_0"
msgid "I want to know what you really think of me.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:30_1_0"
msgid "Let's hurry up and order.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:30_2_0"
msgid "Let's have a toast.{PA:20}"
msgstr ""

