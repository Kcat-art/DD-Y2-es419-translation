msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_6"
msgid "Ohohoho!{PA:20}||That sounds fun!{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/CABA/TALK_HOSTGUEST03_US.BIN::line:6_0_7"
msgid "H{MS:0}m.{PA:20}.{PA:20}.{PA:20}||Now what to have?{PA:20}"
