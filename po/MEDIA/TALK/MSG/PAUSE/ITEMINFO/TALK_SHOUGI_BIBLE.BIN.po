msgid "advances a piece into the opponent's camp,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_3"
msgid "that piece is promoted.{PA:20} The piece is"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_4"
