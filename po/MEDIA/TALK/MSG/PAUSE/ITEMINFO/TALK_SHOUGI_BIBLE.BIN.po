msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_5"
msgid "gold general.{PA:20} Promotion of a piece is up"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_6"
msgid "to the player.{PA:20} Kings and gold generals"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_7"
msgid "cannot be promoted.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_5_0"
msgid "Captured pieces lose any promotions.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_5_1"
msgid "In official shogi games,{PA:10} the players are"
msgstr ""

