msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_7_4"
msgid "best for you.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_8_0"
