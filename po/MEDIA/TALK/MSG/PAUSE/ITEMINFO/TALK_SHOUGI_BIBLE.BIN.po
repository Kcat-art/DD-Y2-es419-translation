msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_0"
msgid "Shogi is a game played on a 9x9 board.{PA:20} Two"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_1"
msgid "players take turns moving their pieces"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_2"
msgid "and capturing their opponent's.{PA:20} The"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_3"
msgid "placement of pieces is fixed,{PA:10} and each of"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_4"
msgid "the 8 varieties of pieces has their own"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_5"
msgid "rules for movement.{PA:20} When your piece lands"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_6"
msgid "on that of your opponent's,{PA:10} theirs is"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_0_7"
msgid "captured and becomes yours.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_0"
msgid "You can freely drop it anywhere on the board.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_1"
msgid "There are several restrictions on"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_2"
msgid "dropping pieces.{PA:20} A pawn cannot be dropped"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_3"
msgid "within the same vertical line as another"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_4"
msgid "pawn unless that pawn has been promoted.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_5"
msgid "A piece also may not be placed on a square"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_1_6"
msgid "where it cannot move in subsequent turns.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_2_0"
msgid "As for the direction and distance each"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_2_1"
msgid "piece can move,{PA:10} most computer shogi"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_2_2"
msgid "programs will show this information,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_2_3"
msgid "so it's enough to follow the on-screen"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_2_4"
msgid "displays.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_0"
msgid "The game ends when one player's king is"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_1"
msgid "captured.{PA:20} However,{PA:10} advanced players are"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_2"
msgid "often able to read many moves ahead and"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_3"
msgid "predict their own defeat.{PA:20} In these cases,{PA:10}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_4"
msgid "the player often resigns and the winner"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_5"
