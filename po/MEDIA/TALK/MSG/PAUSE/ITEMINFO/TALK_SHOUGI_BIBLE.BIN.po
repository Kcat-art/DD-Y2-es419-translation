msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_3_6"
msgid "captured.{PA:20}"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_0"
msgid "The upper and lower thirds of the board"
msgstr ""

msgctxt "MEDIA/TALK/MSG/PAUSE/ITEMINFO/TALK_SHOUGI_BIBLE.BIN::line:0_4_1"
msgid "are called the \"camps\".{PA:20} When a player"
msgstr ""

