msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "Daigo.{PA:20}.{PA:20}.{PA:20} Who'd you pick a fight with"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:0_0_1"
msgid "five years ago?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "The Second Chairman of the Omi Alliance's"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:1_0_1"
msgid "Go-Ryu Clan,{PA:10} Ryuji Goda.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "You know the Chairman we're headed to meet?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:2_0_1"
msgid "It's his son.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "The Chairman's son.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "I was an idiot.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "I jumped right into his little trap.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "A trap?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "Yeah.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "Five years ago,{PA:10} the Go-Ryu Clan was making"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:8_0_1"
msgid "regular visits up to Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "Were they after the old Dojima family?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "It didn't matter.{PA:20} Any Tojo officer would do.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "Their plan was to poke at the Tojo until"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:11_0_1"
msgid "they came down to Kansai.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "I was a little crazy back then,{PA:10} and I jumped"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:12_0_1"
msgid "at the bait.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "You made a move on Kansai?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "And all by myself at that.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "I flew down there to duke it out with Ryuji,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:15_0_1"
msgid "one-on-one.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:16_0_0"
msgid "When I got there,{PA:10} the police were waiting.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:17_0_0"
msgid "I got busted for packing heat and wound up"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:17_0_1"
msgid "eating shitty jail food for five years.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:18_0_0"
msgid "I guess I can't complain too much.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:18_0_1"
msgid "You ate it for twice that.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:19_0_0"
msgid "So I still owe Ryuji Goda one.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:20_0_0"
msgid "Until I settle this,{PA:10} I can't carry the Tojo.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:21_0_0"
msgid "I see.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:22_0_0"
msgid "I'll tell you this now,{PA:10} the Omi Alliance"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:22_0_1"
msgid "doesn't fuck around.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:23_0_0"
msgid "Who knows what they'll have waiting for you?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:24_0_0"
msgid "I'd advise you to watch your back.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0010.DAT/1___FILE.BIN::line:25_0_0"
msgid "Thanks.{PA:20}"
msgstr ""

