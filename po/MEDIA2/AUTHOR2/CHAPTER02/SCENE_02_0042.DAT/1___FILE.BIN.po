msgid "The details have yet to be confirmed,{PA:10} but"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0042.DAT/1___FILE.BIN::line:1_0_1"
msgid "reports suggest the explosion hit a floor"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0042.DAT/1___FILE.BIN::line:2_0_0"
msgid "occupied by the offices of a criminal group,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0042.DAT/1___FILE.BIN::line:2_0_1"
msgid "and that this may not have been an accident.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0042.DAT/1___FILE.BIN::line:3_0_0"
msgid "That's.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

