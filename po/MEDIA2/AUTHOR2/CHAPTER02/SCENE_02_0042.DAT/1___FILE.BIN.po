msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0042.DAT/1___FILE.BIN::line:0_0_0"
msgid "Moments ago at midnight,{PA:10} a violent explosion"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER02/SCENE_02_0042.DAT/1___FILE.BIN::line:0_0_1"
msgid "shook Kamurocho's Millennium Tower.{PA:20}"
