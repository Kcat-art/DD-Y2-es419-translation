msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:0_0_0"
msgid "Dining and dashing isn't very nice.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:1_0_0"
msgid "Huh?{PA:20} You're the guy from before.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:1_0_1"
msgid "What the hell do you want?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:2_0_0"
msgid "Oh,{PA:10} I get it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:2_0_1"
msgid "You're a heavy from that bar,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:3_0_0"
msgid "Bitch,{PA:10} please.{PA:20}.{PA:20}.{PA:20} Do you know who I am?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:4_0_0"
msgid "My man here is the Dragon of Dojima!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:4_0_1"
msgid "THE Kazuma Kiryu,{PA:10} you hear me?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:5_0_0"
msgid "What?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:6_0_0"
msgid "Scared now?{PA:20} Of course you are.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:6_0_1"
msgid "I'd be scared if I'd just pissed him off,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:7_0_0"
msgid "So what's it gonna be?{PA:20} Huh,{PA:10} Mr.{PA:20} Bodyguard?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:8_0_0"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20} Let's settle this peaceably.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:9_0_0"
msgid "What,{PA:10} are you kidding?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:10_0_0"
msgid "I'm in no mood to be jerked around"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:10_0_1"
msgid "right now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:11_0_0"
msgid "Damn punk!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:11_0_1"
msgid "Who do you think you're messing with?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:12_0_0"
msgid "There's no doing this the easy way.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:13_0_0"
msgid "Bitch.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:13_0_1"
msgid "You've really gone and pissed me off!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS10/SCENE_S10_0020.DAT/1___FILE.BIN::line:14_0_0"
msgid "Too late to beg for mercy now!{PA:20}"
msgstr ""

