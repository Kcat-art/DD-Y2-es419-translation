msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "Any way you look at it,{PA:10} Date shot him.{PA:20}"
msgstr "La evidencia es clara: Date fue {PA:10}el autor del disparo.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "This is some kind of mistake!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "We found this on the scene.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:2_0_1"
msgid "Forensics confirms it came from his pistol.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "I already explained to you that he was"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:3_0_1"
msgid "helping us on a top-secret investigation.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "Ex-cop or no,{PA:10} civilians can't be permitted"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:4_0_1"
msgid "to just walk around with firearms.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "Yes,{PA:10} but please consider the circumstances.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "We needed his help to confirm the group"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:6_0_1"
msgid "behind the Millennium Tower bombing.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:6_1_0"
msgid "1"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "So who is this group you're pursuing?{PA:20}"
msgstr "¿Podría explicarme de quiénes se trata?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "The Jingweon mafia.{PA:20}"
msgstr "Es la facción Jingwon.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "Jingweon mafia?{PA:20}"
msgstr "Facción Jingwon{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:9_0_1"
msgid "What are you talking about?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "They were annihilated years ago.{PA:20}"
msgstr "Ellos dejaron de existir hace años.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "No.{PA:20}.{PA:20}.{PA:20} Public Security has been watching"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:11_0_1"
msgid "them for the last six months.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "It seems some Jingweon survivors are still"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:12_0_1"
msgid "at large in Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "Is that reliable information?{PA:20}"
msgstr "¿Esa información es fiable?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "Yes.{PA:20} The man we'd marked was the owner of"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:14_0_1"
msgid "the Stardust club.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "Evidence suggested he was one of them.{PA:20}"
msgstr "Las evidencias sugerían que tenía conexiones con ellos.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:16_0_0"
msgid "So why didn't Public Security perform a"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:16_0_1"
msgid "standard investigation?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:17_0_0"
msgid "Kazuki is a cautious man,{PA:10} and smart.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:18_0_0"
msgid "Chief Kurahashi suggested we ask Mr.{PA:20} Date"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:18_0_1"
msgid "to help,{PA:10} due to his familiarity with Kazuki.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:19_0_0"
msgid "I see where you were coming from.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:19_0_1"
msgid "Still,{PA:10} this is the result.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:20_0_0"
msgid "I've got no choice but to order Date's arrest.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:21_0_0"
msgid "Arrest?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:22_0_0"
msgid "Just think of this going public.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:23_0_0"
msgid "The media would be tripping over itself to"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:23_0_1"
msgid "report an ex-cop scandal.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:24_0_0"
msgid "I'll have Date brought in immediately.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:25_0_0"
msgid "Please,{PA:10} sir,{PA:10} wait!{PA:20}"
msgstr "¡Es{PA:10}pe{PA:10}re!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:26_0_0"
msgid "Effective immediately,{PA:10} Division 1 is taking"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:26_0_1"
msgid "control of this investigation.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:27_0_0"
msgid "Likewise the Jingweon investigation.{PA:20} Public"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:27_0_1"
msgid "Security and Division 4 are off the case.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:28_0_0"
msgid "Am I understood?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:29_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Yes,{PA:10} sir.{PA:20}"
msgstr ".{PA:20}.{PA:20}. {PA:20}Sí, {PA:10}señor.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:30_0_0"
msgid "Understood.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entendid{PA:20}o{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:31_0_0"
msgid "Then we're through here.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:32_0_0"
msgid "Chief Kurahashi.{PA:20}.{PA:20}.{PA:20}"
msgstr "Superintendente.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:33_0_0"
msgid "I know.{PA:20}"
msgstr "Lo sé.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:34_0_0"
msgid "I'm responsible for what happened to Date.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0010.DAT/1___FILE.BIN::line:34_0_1"
msgid "I'll try to think of something.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

