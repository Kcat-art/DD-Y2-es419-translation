msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:0_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}And this makes eight.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:1_0_0"
msgid "Right.{PA:20} This is the last of them.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:2_0_0"
msgid "You're.{PA:20}.{PA:20}.{PA:20}!{PA:20}"
msgstr "¿Estás.{PA:20}.{PA:20}.{PA:20}?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:3_0_0"
msgid "Mr.{PA:20} Kiryu.{PA:20} Hand the girl over!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:4_0_0"
msgid "Great man like yerself.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:4_0_1"
msgid "It'd be a shame to have to waste ya.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:5_0_0"
msgid "Boys.{PA:20}.{PA:20}.{PA:20} Get 'im!{PA:20} Tear him apart!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:6_0_0"
msgid "You know him?{PA:20}"
msgstr "¿Lo conoce?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:7_0_0"
msgid "His name's Hayashi.{PA:20} He's Omi.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:8_0_0"
msgid "Omi?!{PA:20}"
msgstr "¡¿Omi?!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:9_0_0"
msgid "Why are you doing this?{PA:20}"
msgstr "¿Qué se supone que haces aquí?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:10_0_0"
msgid "I work for Mr.{PA:20} Ryuji now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:11_0_0"
msgid "I've got nuthin' to do with Omi proper"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:11_0_1"
msgid "anymore.{PA:20}"
msgstr "resistir!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:12_0_0"
msgid "What?{PA:20} So he sent you here to slow us down?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:13_0_0"
msgid "Ain't my place to know his reasons.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:14_0_0"
msgid "All I know is the man ordered me to rough up"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:14_0_1"
msgid "this here room.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:15_0_0"
msgid "Now I remember.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:16_0_0"
msgid "A year ago,{PA:10} the name \"Hayashi\" was struck"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:16_0_1"
msgid "from our list of Omi officers.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:17_0_0"
msgid "And of all the places he could have gone,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:17_0_1"
msgid "he goes to the Go-Ryu Clan.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:18_0_0"
msgid "Might you be the lady cop they call"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:18_0_1"
msgid "\"The Yakuza-Eater\",{PA:10} miss?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:19_0_0"
msgid "That's Detective Sayama,{PA:10} Osaka Division 4.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:20_0_0"
msgid "Well,{PA:10} well.{PA:20} A good cop like yerself,{PA:10} all"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:20_0_1"
msgid "paired up with a yakuza clan leader.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:21_0_0"
msgid "Hell of a world,{PA:10} ain't it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:22_0_0"
msgid "You're in no position to be so smug!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:23_0_0"
msgid "Unlawful entry,{PA:10} destruction of property.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:24_0_0"
msgid "Add resisting arrest if you so much as look"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:24_0_1"
msgid "at us funny.{PA:20} You're in it deep.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:25_0_0"
msgid "That a threat,{PA:10} miss?{PA:20} Don't see how that'll"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:25_0_1"
msgid "work on a man who already gave up his life.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:26_0_0"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:27_0_0"
msgid "Hayashi of the Omi Alliance is"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:27_0_1"
msgid "dead and gone.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:28_0_0"
msgid "My only goal is to see Mr.{PA:20} Ryuji rise"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:28_0_1"
msgid "to the top.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0110.DAT/5___FILE.BIN::line:29_0_0"
msgid "I'll do anything to make sure that happens!{PA:20}"
msgstr ""

