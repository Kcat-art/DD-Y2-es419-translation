msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:0_0_0"
msgid "Boss!{PA:20} The system's coming back online!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:1_0_0"
msgid "Good.{PA:20} Give her some juice!{PA:20}"
msgstr "Muy b{PA:20}ien. ¡Denle cuerda!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:2_0_0"
msgid "Show me Daigo Dojima's location!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:3_0_0"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr "¡Sí, {PA:10}señor!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:4_0_0"
msgid "Boss!{PA:20}"
msgstr "... ¡Jefe!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:5_0_0"
msgid "A malfunction?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:6_0_0"
msgid "No,{PA:10} this is.{PA:20}.{PA:20}.{PA:20} We're being hacked!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:7_0_0"
msgid "What?!{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:8_0_0"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:9_0_0"
msgid "Somebody's broken into the system and"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:9_0_1"
msgid "started blocking our access.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:10_0_0"
msgid "Another surprise from the Go-Ryu Clan?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:11_0_0"
msgid "Judging from the situation,{PA:10} I'd say so.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:12_0_0"
msgid "Damn.{PA:20}.{PA:20}.{PA:20} They're fast!{PA:20}"
msgstr "Carajo{PA:20}.{PA:20}.{PA:20}. ¡Es muy rápido!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:13_0_0"
msgid "I can't keep up!{PA:20}"
msgstr "¡No puedo seguirle el ritmo!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:14_0_0"
msgid "Let me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:15_0_0"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:16_0_0"
msgid "Move!{PA:20}"
msgstr "Moverse{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:17_0_0"
msgid "Ahh,{PA:10} okay.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:18_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Wow.{PA:20}"
msgstr "E{PA:20}l{PA:20}l{PA:20}a...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:19_0_0"
msgid "Unreal!{PA:20}"
msgstr "¡Es increíble!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:20_0_0"
msgid "I guess it figures.{PA:20}"
msgstr "No me sorprende.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:21_0_0"
msgid "Figures how?{PA:20}"
msgstr "¿No te sorprende?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:22_0_0"
msgid "What,{PA:10} you didn't know?{PA:20}"
msgstr "¿N{PA:10}o sabías?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:23_0_0"
msgid "That's your lady friend's main line of work.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:24_0_0"
msgid "Her what?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:25_0_0"
msgid "My file on her says she drilled programming"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:25_0_1"
msgid "at technical college.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:26_0_0"
msgid "That's what got her hired by the police.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:27_0_0"
msgid "She came in as an engineer with Public"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:27_0_1"
msgid "Security's new High-Tech Crime Unit.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:28_0_0"
msgid "High-Tech Crime?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:29_0_0"
msgid "It's a bunch of brainiac desk jockeys"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:29_0_1"
msgid "tracking Internet-related crime and so on.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:30_0_0"
msgid "Sayama came in on the Tier II Public"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:30_0_1"
msgid "Service Exam,{PA:10} semi-career track.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:31_0_0"
msgid "But she was hired as a specialist.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:31_0_1"
msgid "You're looking at her specialty right there.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:32_0_0"
msgid "So how did she wind up in Organized Crime?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:33_0_0"
msgid "She applied personally right after her"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:33_0_1"
msgid "initial placement.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:34_0_0"
msgid "Seems like she planned on going to"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:34_0_1"
msgid "Division 4 from the get-go.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:35_0_0"
msgid "Why Division 4?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:36_0_0"
msgid "Hey,{PA:10} all I know is her history.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:37_0_0"
msgid "My cameras can't see inside her head.{PA:20}"
msgstr "No puedo ver lo que hay en su mente.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:38_0_0"
msgid "Whoever he is,{PA:10} he's good.{PA:20}"
msgstr "Él también es m{PA:10}uy bueno...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:39_0_0"
msgid "Ooh,{PA:10} gotcha!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:40_0_0"
msgid "I'm impressed.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:41_0_0"
msgid "I've got a fix on Daigo Dojima,{PA:10} boss!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:42_0_0"
msgid "Where is he?{PA:20}"
msgstr "¿Y adónde fue?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:43_0_0"
msgid "Taihei Boulevard,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:43_0_1"
msgid "A room at the Shangri-La.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:44_0_0"
msgid "He's at the Shangri-La?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:45_0_0"
msgid "You know the place?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:46_0_0"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} I went there once last year.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:47_0_0"
msgid "I owe you one,{PA:10} Kage.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:48_0_0"
msgid "Considering what just happened,{PA:10} it's likely"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:48_0_1"
msgid "they know you've located him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:49_0_0"
msgid "The only reason they'd bring him to"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:49_0_1"
msgid "Kamurocho at all is to bait me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:50_0_0"
msgid "That's probably a safe assumption.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:51_0_0"
msgid "You be careful out there.{PA:20}"
msgstr "Ve con cuidado.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:52_0_0"
msgid "I will.{PA:20}"
msgstr "Lo haré.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:53_0_0"
msgid "An ex-yakuza and a Division 4 cop.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER08/SCENE_08_0130.DAT/1___FILE.BIN::line:53_0_1"
msgid "Talk about your odd couples.{PA:20}"
msgstr ""

