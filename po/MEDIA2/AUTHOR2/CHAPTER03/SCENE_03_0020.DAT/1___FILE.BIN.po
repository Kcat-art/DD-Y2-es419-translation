msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:0_0_0"
msgid "Omi Alliance and the Tojo Clan,{PA:10} signin'"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:0_0_1"
msgid "a peace treaty?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:1_0_0"
msgid "Yes,{PA:10} according to our information.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:2_0_0"
msgid "So whaddya want us to do exactly?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:3_0_0"
msgid "I'd like you to take Kazuma Kiryu into"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:3_0_1"
msgid "protective custody.{PA:20}"
msgstr "¿Custodia?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:4_0_0"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:5_0_0"
msgid "If the peace talks fail and Kiryu is killed,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:5_0_1"
msgid "there'll be no avoiding an extended conflict.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:6_0_0"
msgid "So you're telling us to babysit a yakuza?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:7_0_0"
msgid "Yes.{PA:20} There isn't much time.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:7_0_1"
msgid "We're counting on you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:8_0_0"
msgid "Anything else I can fuckin' do for ya today?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:9_0_0"
msgid "Chief.{PA:20}.{PA:20}.{PA:20} Who was that?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:10_0_0"
msgid "Mm?{PA:20} Oh,{PA:10} Tokyo's Division 4 Chief.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:11_0_0"
msgid "What did you mean,{PA:10} \"babysit a yakuza\"?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:12_0_0"
msgid "Seems Kazuma Kiryu's down in Kansai.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:13_0_0"
msgid "Kiryu.{PA:20}.{PA:20}.{PA:20} THAT Kazuma Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:14_0_0"
msgid "The one and only.{PA:20} Tojo's Fourth Chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:15_0_0"
msgid "If that guy bites it down here,{PA:10} it'll be"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:15_0_1"
msgid "a total shit storm between east and west.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:16_0_0"
msgid "So they told us to keep him safe.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:17_0_0"
msgid "The whole thing's fucked.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:18_0_0"
msgid "Chief.{PA:20}.{PA:20}.{PA:20} Let me do it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:19_0_0"
msgid "No way.{PA:20}"
msgstr "¡Cómo no!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:20_0_0"
msgid "You're not exactly the babysitting type.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:21_0_0"
msgid "Don't you see this is our big chance?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:22_0_0"
msgid "Big chance how?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:23_0_0"
msgid "We take responsibility for Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:24_0_0"
msgid "If I'm just following him,{PA:10} I can go to Kanto"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:24_0_1"
msgid "and investigate up there,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:25_0_0"
msgid "What,{PA:10} are ya gonna hit Kanto and show 'em"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:25_0_1"
msgid "what an Osakan cop can do?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:26_0_0"
msgid "Wipe the smug grins off those Tokyo pricks?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:27_0_0"
msgid "Depending on where it all goes,{PA:10} we could"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:27_0_1"
msgid "deploy the entire force.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:28_0_0"
msgid "Yeah,{PA:10} that'd be a hoot.{PA:20}.{PA:20}.{PA:20}"
msgstr "Eso sí{PA:10} que sería interesante.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:29_0_0"
msgid "\"Osakan police invade Kanto!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:29_0_1"
msgid "Film at 11.{PA:20}\""
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:30_0_0"
msgid "So,{PA:10} do I get the job?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:31_0_0"
msgid "Hey,{PA:10} hold up a minute.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:32_0_0"
msgid "You're not just hung up on the Tojo.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:32_0_1"
msgid "Are ya?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:33_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}No,{PA:10} sir!{PA:20}"
msgstr ".{PA:20}..{PA:20} {PA:20}¡No,{PA:10} señor!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:34_0_0"
msgid "I'm saying this as lead detective for the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:34_0_1"
msgid "Osaka Prefectural Police.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:35_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Swear to me?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:36_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}It's the truth.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:37_0_0"
msgid "Okay,{PA:10} then.{PA:20}.{PA:20}.{PA:20} Go take care of it!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0020.DAT/1___FILE.BIN::line:38_0_0"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr "¡Sí, {PA:10}señor!{PA:20}"

