msgid "That was some explosion last night.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:1_0_0"
msgid "Blew the Fuma family office to shit.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:1_0_1"
msgid "Kashiwagi's all right,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:2_0_0"
msgid "That's good.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:3_0_0"
msgid "Don't suppose it was the Omi,{PA:10} do you?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:4_0_0"
msgid "Most likely Ryuji Goda.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:5_0_0"
msgid "What?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0028.DAT/1___FILE.BIN::line:6_0_0"
