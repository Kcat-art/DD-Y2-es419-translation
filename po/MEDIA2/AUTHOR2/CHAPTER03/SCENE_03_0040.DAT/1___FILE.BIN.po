msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:0_0_0"
msgid "You've come quite a ways.{PA:20} Welcome.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:1_0_0"
msgid "My name is Jin Goda,{PA:10} Fifth Chairman of the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:1_0_1"
msgid "Omi Alliance.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:2_0_0"
msgid "I've heard many a rumor about you,{PA:10} Tojo"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:2_0_1"
msgid "Fourth Chairman Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:3_0_0"
msgid "I'm grateful for your hospitality.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:4_0_0"
msgid "I,{PA:10} Kazuma Kiryu,{PA:10} thank you as Fourth"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:4_0_1"
msgid "Chairman of the Tojo Clan.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:5_0_0"
msgid "Let's dispose of the formalities with that.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:5_0_1"
msgid "I'll introduce my officers.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:6_0_0"
msgid "Next to me is Chief Director of Omi"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:6_0_1"
msgid "Headquarters,{PA:10} Takashima.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:7_0_0"
msgid "He took over Terada's position.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:8_0_0"
msgid "Pleased to meet you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:9_0_0"
msgid "So you and Terada.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:10_0_0"
msgid "Yes,{PA:10} Terada was.{PA:20}.{PA:20}.{PA:20} The Tojo Clan's Fifth"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:10_0_1"
msgid "Chairman was a brother and a friend.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:11_0_0"
msgid "What happened was.{PA:20}.{PA:20}.{PA:20} extremely unfortunate.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:12_0_0"
msgid "Next to him.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:13_0_0"
msgid "Wait just a minute!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:14_0_0"
msgid "You.{PA:20}.{PA:20}.{PA:20} What the hell did you just say?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:15_0_0"
msgid "Unfortunate?{PA:20} Is that a joke?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:16_0_0"
msgid "You assholes are the ones that killed him!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:17_0_0"
msgid "Yes,{PA:10} Terada was killed by Omi men.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:18_0_0"
msgid "But that was not the will of the Alliance.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:19_0_0"
msgid "Bullshit!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:19_0_1"
msgid "You think we're going to buy that shit?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:20_0_0"
msgid "Quit your yappin',{PA:10} Junior.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:21_0_0"
msgid "Excuse me?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:22_0_0"
msgid "Look,{PA:10} there's a thing called status,{PA:10} kid.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:22_0_1"
msgid "These meetings are for important folk.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:23_0_0"
msgid "A kid like you is just gonna be in the way.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:24_0_0"
msgid "Am I right?{PA:20} .{PA:20}.{PA:20}.{PA:20}Well,{PA:10} Mr.{PA:20} Fourth Chairman?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:25_0_0"
msgid "Stop it,{PA:10} Sengoku.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:25_0_1"
msgid "I won't tolerate rudeness to our guests.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:26_0_0"
msgid "No.{PA:20}.{PA:20}.{PA:20} The first offense was ours.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:27_0_0"
msgid "I'm so sorry about what happened to Terada.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:28_0_0"
msgid "I hope you'll accept my deepest apologies.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:29_0_0"
msgid "Whoa,{PA:10} hold the phone!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:29_0_1"
msgid "Ain't no need for you to apologize!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:30_0_0"
msgid "Terada was ours to begin with.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:31_0_0"
msgid "Shouldn't matter none to you what our"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:31_0_1"
msgid "organization does to its traitors.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:32_0_0"
msgid "Sengoku!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:33_0_0"
msgid "Can the hollow act.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:34_0_0"
msgid "Heh?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:35_0_0"
msgid "None of you are sorry for this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:35_0_1"
msgid "Can you deny it,{PA:10} Mr.{PA:20} Goda?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:36_0_0"
msgid "No,{PA:10} not after last year.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:37_0_0"
msgid "Not after teaming with Jingu behind Terada's"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:37_0_1"
msgid "back to try to take over the Tojo.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:38_0_0"
msgid "Don't even try to deny it!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:39_0_0"
msgid "It's true.{PA:20}.{PA:20}.{PA:20} But that was neither my nor"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:39_0_1"
msgid "my officers' doing.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:40_0_0"
msgid "What?{PA:20} Quit pawning off the blame!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:41_0_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} Mr.{PA:20} Dojima.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:42_0_0"
msgid "This is a difficult subject for the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:42_0_1"
msgid "Chairman.{PA:20} Allow me to explain.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:43_0_0"
msgid "The Jingu incident was an independent act"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:43_0_1"
msgid "of the Go-Ryu Clan Chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:44_0_0"
msgid "What?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:45_0_0"
msgid "Ryuji.{PA:20}.{PA:20}.{PA:20}?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:46_0_0"
msgid "So you know him.{PA:20}.{PA:20}.{PA:20} He's the Chairman's son.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:47_0_0"
msgid "He failed to learn his father's temperance.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:47_0_1"
msgid "He uses the Omi name as he pleases.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:48_0_0"
msgid "I suspect that the ones who attacked Terada"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:48_0_1"
msgid "were from the Go-Ryu Clan.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:49_0_0"
msgid "So.{PA:20}.{PA:20}.{PA:20} The order to kill Terada was Ryuji's?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:50_0_0"
msgid "Most likely,{PA:10} yes.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:51_0_0"
msgid "This is stupid.{PA:20} I can't take any more.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:52_0_0"
msgid "Sengoku!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:53_0_0"
msgid "Eh,{PA:10} handle it however ya want.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:54_0_0"
msgid "Lemme know if ya need incense money"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:54_0_1"
msgid "for Terada's funeral.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:55_0_0"
msgid "I'd be happy to spot ya a billion or two.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:56_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Later.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:57_0_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} this is the current state of the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:57_0_1"
msgid "Omi Alliance.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:58_0_0"
msgid "120 groups,{PA:10} over 35,{PA:10}000 men.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:59_0_0"
msgid "The Alliance has grown too large.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:59_0_1"
msgid "It's nearly impossible to control.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:60_0_0"
msgid "Chairman.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:61_0_0"
msgid "Takashima here's young and sharp.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:61_0_1"
msgid "Terada was the same way.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:62_0_0"
msgid "But the other young folk like Sengoku and"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:62_0_1"
msgid "Ryuji just don't listen to me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:63_0_0"
msgid "Mr.{PA:20} Goda.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:64_0_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} losing Terada was a heavy blow"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:64_0_1"
msgid "for both Tojo and Omi alike.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:65_0_0"
msgid "I feel that now's the time to balance the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:65_0_1"
msgid "power of east and west,{PA:10} to avoid this war.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:66_0_0"
msgid "Balance east and west,{PA:10} sir?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:67_0_0"
msgid "Yes.{PA:20} Mr.{PA:20} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:67_0_1"
msgid "I believe you can do that.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:68_0_0"
msgid "I want to see you rebuild the Tojo Clan.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:69_0_0"
msgid "If the Omi can be of help along the way,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:69_0_1"
msgid "it'd be my pleasure to assist you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:70_0_0"
msgid "What's this?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:71_0_0"
msgid "A letter from Terada.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:72_0_0"
msgid "He wanted a truce with you,{PA:10} Chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:73_0_0"
msgid "Terada.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:74_0_0"
msgid "The Tojo Clan echoes that request.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:74_0_1"
msgid "We'd like to propose a 50-50 truce.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:75_0_0"
msgid "Will you accept it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:76_0_0"
msgid "I will.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:77_0_0"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:78_0_0"
msgid "I'll send for the Tojo Clan Interim Chairman"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:78_0_1"
msgid "Yayoi Dojima to come here at once.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:79_0_0"
msgid "Absolutely not.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:80_0_0"
msgid "It's our turn to make the trip.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:80_0_1"
msgid "I'll head up to Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0040.DAT/1___FILE.BIN::line:81_0_0"
msgid "You have our gratitude,{PA:10} sir.{PA:20}"
msgstr ""

