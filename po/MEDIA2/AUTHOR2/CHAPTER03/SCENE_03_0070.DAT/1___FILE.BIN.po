msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:0_0_0"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:1_0_0"
msgid "I'm ashamed for my son.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:2_0_0"
msgid "Making ya help me in this mess.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:2_0_1"
msgid "I can't begin to apologize enough.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:3_0_0"
msgid "Tojo,{PA:10} Omi.{PA:20}.{PA:20}.{PA:20} It doesn't matter.{PA:20}"
msgstr "Nuestra{PA:10} facció{PA:20}n{PA:20} n{PA:20}o es lo que ahora importa.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:4_0_0"
msgid "Don't trouble yourself about it,{PA:10} sir.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:5_0_0"
msgid "Are you all right?!{PA:20}"
msgstr "¿Se encuentra bien?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:6_0_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20} That guy's a real tank.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:7_0_0"
msgid "We're not through yet,{PA:10} kid!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:8_0_0"
msgid "Daigo.{PA:20}.{PA:20}.{PA:20}"
msgstr "Daigo.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:9_0_0"
msgid "Take Chairman Goda.{PA:20} Get back to the Tojo.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:10_0_0"
msgid "I still haven't settled things with.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:11_0_0"
msgid "Getting Chairman Goda to sign that truce"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:11_0_1"
msgid "with the Tojo comes first!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:12_0_0"
msgid "Plus.{PA:20}.{PA:20}.{PA:20} We can't afford to lose you here.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:13_0_0"
msgid "But if I leave it like this.{PA:20}.{PA:20}.{PA:20}"
msgstr "Pero si no..{PA:20}.{PA:20}{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:14_0_0"
msgid "Just listen to me,{PA:10} damn it!{PA:20}"
msgstr "¡Solo hazme caso!, ¡{PA:10}¿quieres?!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:15_0_0"
msgid "Fine.{PA:20}"
msgstr "Bien.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:16_0_0"
msgid "Looks like it's finally just us,{PA:10} friend.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:17_0_0"
msgid "Chairman Goda's with the Tojo Clan now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:18_0_0"
msgid "I'm not letting anything stop this treaty.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:19_0_0"
msgid "Fine,{PA:10} fine.{PA:20}.{PA:20}.{PA:20}"
msgstr "Ve al{PA:10} gran{PA:20}o{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:19_0_1"
msgid "Just one more thing to do after killin' ya.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:20_0_0"
msgid "Care to try?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:21_0_0"
msgid "Oh,{PA:10} I sure do.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:22_0_0"
msgid "How's about we see here and now.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0070.DAT/1___FILE.BIN::line:23_0_0"
msgid "Which one of us is the real dragon!{PA:20}"
msgstr ""

