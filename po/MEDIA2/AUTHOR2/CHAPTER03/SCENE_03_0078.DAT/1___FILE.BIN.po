msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:0_0_0"
msgid "This fight ain't over.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:1_0_0"
msgid "I hate an unfair fight.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:2_0_0"
msgid "What the fuck?{PA:20}"
msgstr "¿Qué carajo?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:3_0_0"
msgid "You just had it out with Daigo.{PA:20}"
msgstr "Saliste de luchar contra Daigo...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:4_0_0"
msgid "He's a strong man.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:5_0_0"
msgid "You can't be in any condition to fight me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:6_0_0"
msgid "This isn't over 'til one of us is dead!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:7_0_0"
msgid "Shit!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:8_0_0"
msgid "Remember this!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:9_0_0"
msgid "I'm not through with you!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:10_0_0"
msgid "Arrest everyone in the building!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:11_0_0"
msgid "Yes,{PA:10} ma'am!{PA:20}"
msgstr "¡Sí,{PA:10} señora!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:12_0_0"
msgid "Kazuma Kiryu?{PA:20}"
msgstr "¿Kazuma Kiryu?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:13_0_0"
msgid "That's me.{PA:20}"
msgstr "Así es.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:14_0_0"
msgid "Kaoru Sayama,{PA:10} Osaka Prefectural Police.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0078.DAT/1___FILE.BIN::line:15_0_0"
msgid "You're under arrest for assault.{PA:20}"
msgstr "Está bajo arresto por agresión física.{PA:20}"

