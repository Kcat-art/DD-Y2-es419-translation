msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:0_0_0"
msgid "Ya live up to the hype,{PA:10} chum.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:1_0_0"
msgid "And here I thought ya were tough"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:1_0_1"
msgid "last night!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:2_0_0"
msgid "Good.{PA:20} Any less than this and it'd be no fun"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:2_0_1"
msgid "taking you down.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:3_0_0"
msgid "What the fuck are ya doing?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:4_0_0"
msgid "You've got no right to go picking"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:4_0_1"
msgid "new fights.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:5_0_0"
msgid "I told you I'm not through with you yet!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:6_0_0"
msgid "Sorry,{PA:10} Kazuma,{PA:10} but I'm taking this guy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:6_0_1"
msgid "You go help Chairman Goda.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:7_0_0"
msgid "All right.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:8_0_0"
msgid "You've got more pep than I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:9_0_0"
msgid "I'm game.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:10_0_0"
msgid "You wanna die that bad?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER03/SCENE_03_0060.DAT/1___FILE.BIN::line:11_0_0"
msgid "I'll send yer ass to hell first,{PA:10} then!{PA:20}"
msgstr ""

