msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0050.DAT/1___FILE.BIN::line:21_0_0"
msgid "And it's worked marvelously.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0050.DAT/1___FILE.BIN::line:22_0_0"
msgid "Which means that you.{PA:20}.{PA:20}.{PA:20}"
