msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0050.DAT/1___FILE.BIN::line:47_0_1"
msgid "Your part is over.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0050.DAT/1___FILE.BIN::line:48_0_0"
msgid "This won't go.{PA:20}.{PA:20}.{PA:20} as you've planned.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0050.DAT/1___FILE.BIN::line:49_0_0"
