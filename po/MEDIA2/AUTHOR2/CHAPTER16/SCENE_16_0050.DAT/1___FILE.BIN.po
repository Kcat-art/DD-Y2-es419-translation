msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0050.DAT/1___FILE.BIN::line:76_0_0"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} You're right.{PA:20}"
