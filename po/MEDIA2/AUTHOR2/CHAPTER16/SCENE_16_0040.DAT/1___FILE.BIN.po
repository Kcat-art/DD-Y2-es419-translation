msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:0_0_0"
msgid "I see.{PA:20}.{PA:20}.{PA:20}"
msgstr "Entiendo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:1_0_0"
msgid "So that was you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:2_0_0"
msgid "It's true.{PA:20} Yeongmin and I lived through the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:2_0_1"
msgid "night 'cause of him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:3_0_0"
msgid "Terada.{PA:20}.{PA:20}.{PA:20}"
msgstr "Terada..{PA:20}.{PA:20},{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:4_0_0"
msgid "I kept gunnin' for Fuma after that,{PA:10} to"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:4_0_1"
msgid "avenge my brothers.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:5_0_0"
msgid "Day after day I tried.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:6_0_0"
msgid "But still he looked after me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:6_0_1"
msgid "He was the one who led me to the Omi.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:7_0_0"
msgid "So.{PA:20}.{PA:20}.{PA:20} That's what happened.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:8_0_0"
msgid "After you joined the Omi.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:9_0_0"
msgid "A Dojima man named Fuma came to me to ask"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:9_0_1"
msgid "that I look out for you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:10_0_0"
msgid "He was down on his hands and knees,{PA:10} begging.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:11_0_0"
msgid "Terada.{PA:20}.{PA:20}.{PA:20}"
msgstr "Terada..{PA:20}.{PA:20},{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:12_0_0"
msgid "Fuma did all that for you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:13_0_0"
msgid "Have you no sense of gratitude?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:14_0_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} I fear ya still don't understand.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:15_0_0"
msgid "I'm a member of the Jingweon mafia.{PA:20}"
msgstr "Soy un hombre de la facción Jingwon...,{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:16_0_0"
msgid "The creed takes precedence over all else.{PA:20}"
msgstr "el credo está por encima de todo...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:17_0_0"
msgid "Even if it means killing our own parents.{PA:20}"
msgstr "Incluso si eso significa matar a nuestros\\r||propios padres.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:18_0_0"
msgid "Such is our fate.{PA:20}"
msgstr "Es el destino que elegimos.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:19_0_0"
msgid "Those aren't the words of a human being.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:20_0_0"
msgid "Precisely.{PA:20}"
msgstr "En efecto.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:21_0_0"
msgid "Our organization has forsaken humanity.{PA:20}"
msgstr "Nuestra organización ha renunciado a su humanidad.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:22_0_0"
msgid "How else could we possibly live for 26 years"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:22_0_1"
msgid "for the sole purpose of revenge?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:23_0_0"
msgid "In any case,{PA:10} you're in our way.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER16/SCENE_16_0040.DAT/1___FILE.BIN::line:24_0_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} I'm afraid you'll have to die!{PA:20}"
msgstr ""

