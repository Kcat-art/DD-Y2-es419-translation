msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:0_0_0"
msgid "I'm headed to Kamurocho now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:1_0_0"
msgid "Looks like we were right.{PA:20}.{PA:20}.{PA:20}"
msgstr "Parece que estábamos en lo cierto{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:2_0_0"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} It's the worst-case scenario.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:3_0_0"
msgid "Osaka Police'll hold the Omi long as we can.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:4_0_0"
msgid "Good,{PA:10} thanks.{PA:20} Leave Kurahashi to me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:5_0_0"
msgid "They've got nothin' left to lose this time.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:6_0_0"
msgid "You be careful up there.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:7_0_0"
msgid "Will do.{PA:20}"
msgstr "Lo consideraré. Nos vemos.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:8_0_0"
msgid "If she finds out she's got their blood"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:8_0_1"
msgid "runnin' in her,{PA:10} Kaoru might.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:9_0_0"
msgid "I'm not letting that happen.{PA:20}"
msgstr "No permitiré que suceda.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:10_0_0"
msgid "That's why I've been hunting them"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0028.DAT/1___FILE.BIN::line:10_0_1"
msgid "down for the last 26 years.{PA:20}"
msgstr ""

