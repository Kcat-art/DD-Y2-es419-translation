msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "There,{PA:10} all better.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "To Kaoru"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:2_1_0"
msgid "Locate(BottomCenter)"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "What.{PA:20}.{PA:20}.{PA:20}?{PA:20} What does this mean?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "What's wrong?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "This note Mama left me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "What does it say?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "\"Your dad is still alive,{PA:10} honey.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:7_0_1"
msgid "Don't blame Mr.{PA:20} Kiryu.{PA:20}\""
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "Still alive?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "So if he's alive,{PA:10} who is he?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:9_0_1"
msgid "Where is he now?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "And where did Mama run off to anyway?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "You haven't seen Tamiyo around?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "I'll go look around the neighborhood.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "Who is she looking for?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "The lady who raised her.{PA:20}"
msgstr ""

