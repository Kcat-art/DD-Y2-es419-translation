msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:0_0_0"
msgid "I checked in on her about six months later.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:1_0_0"
msgid "It was like that horrible night had just cut"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:1_0_1"
msgid "a hole right through her heart.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:2_0_0"
msgid "Poor woman was falling apart at the seams.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:3_0_0"
msgid "What happened to her child?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:4_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}It tore her apart,{PA:10} but she gave him up.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:5_0_0"
msgid "Gave him up?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:6_0_0"
msgid "I figured Suyeon wouldn't last long in the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:6_0_1"
msgid "shape she was in.{PA:20} I found her a job.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER13/SCENE_13_0130.DAT/1___FILE.BIN::line:7_0_0"
msgid "Tried to help her build a new life.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

