msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:0_0_0"
msgid "Ten years ago,{PA:10} when I first laid eyes on"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:0_0_1"
msgid "Ryuji Goda,{PA:10} I was dumbstruck.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:1_0_0"
msgid "Knew then that he'd be my finest canvas.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:2_0_0"
msgid "I decided to use the family dragon.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:3_0_0"
msgid "When I started in on the outlines,{PA:10} though.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:4_0_0"
msgid "My hands just stopped.{PA:20} Wouldn't budge.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:5_0_0"
msgid "It's true.{PA:20}"
msgstr "le atinaste.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:6_0_0"
msgid "That's why I did it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS08/SCENE_S08_0050.DAT/1___FILE.BIN::line:6_0_1"
msgid "I took over for the Master and tattooed him.{PA:20}"
msgstr ""

