msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0105.DAT/1___FILE.BIN::line:0_0_0"
msgid "I hear Sengoku sent men into Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0105.DAT/1___FILE.BIN::line:0_0_1"
msgid "Still,{PA:10} today is the Chairman's funeral.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0105.DAT/1___FILE.BIN::line:1_0_0"
msgid "Tell the men to ignore them.{PA:20} Hear me?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0105.DAT/1___FILE.BIN::line:1_0_1"
msgid "That's an order.{PA:20}"
msgstr "Es una orden.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0105.DAT/1___FILE.BIN::line:2_0_0"
msgid "Yes,{PA:10} sir.{PA:20}"
msgstr "Sí, {PA:10}señor.{PA:20}"

