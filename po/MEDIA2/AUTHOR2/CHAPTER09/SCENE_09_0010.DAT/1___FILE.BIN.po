msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "The way they moved and handled their guns.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:0_0_1"
msgid "They're not just some gang.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "It's like they were military.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "That highly trained?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "Daigo!{PA:20} Are you all right?{PA:20}"
msgstr "¡Daig{PA:20}o! ¡¿Estás bien?!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "Mr.{PA:20} Kashiwagi!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "You're not hurt,{PA:10} are you?{PA:20}"
msgstr "¿No te hir{PA:10}ieron?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "Sorry,{PA:10} I.{PA:20}.{PA:20}.{PA:20} couldn't protect the Chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "I heard.{PA:20}"
msgstr "Lo sé.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "Look,{PA:10} don't worry about it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:8_0_1"
msgid "You're alive,{PA:10} that's all that matters now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "So,{PA:10} any clue as to who it was that nabbed"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:9_0_1"
msgid "you and Chairman Goda?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "I don't know specifics.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "But they called themselves the \"Jingweon\".{PA:20}"
msgstr "Pero... logré oír el nombre de \"facción Jingwon\".{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "The Jingweon mafia?{PA:20} .{PA:20}.{PA:20}.{PA:20}Are you sure?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "You've heard of them?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "But the Jingweon were wiped out.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:16_0_0"
msgid "I called headquarters and asked them to"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:16_0_1"
msgid "search the records there.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:17_0_0"
msgid "They said there was no mention of any"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:17_0_1"
msgid "Jingweon mafia existing.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:18_0_0"
msgid "No public knowledge of the Jingweon exists.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:19_0_0"
msgid "Still,{PA:10} any organization that big should"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:19_0_1"
msgid "turn up in police records somewhere.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:20_0_0"
msgid "The police are the ones who erased them.{PA:20}"
msgstr "No. La policía eliminó todo indicio de su existencia.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:21_0_0"
msgid "But why?{PA:20}"
msgstr "Pero ¿por qué debe ser específicamente eso?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER09/SCENE_09_0010.DAT/1___FILE.BIN::line:22_0_0"
msgid "It happened over 20 years ago.{PA:20}.{PA:20}.{PA:20}"
msgstr "Eso ocurrió... hace más de 20 año{PA:20}s{PA:20}.{PA:20}"

