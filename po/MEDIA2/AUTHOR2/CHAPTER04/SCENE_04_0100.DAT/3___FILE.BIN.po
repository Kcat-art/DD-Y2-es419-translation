msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:0_0_0"
msgid "Who put the bounty on my head?{PA:20} Talk!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:1_0_0"
msgid "How should I know?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:2_0_0"
msgid "Whoa,{PA:10} stop!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:3_0_0"
msgid "The S-Sengoku family!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:4_0_0"
msgid "Omi's Sengoku?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:5_0_0"
msgid "Th-That's him,{PA:10} yeah!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:6_0_0"
msgid "Eh,{PA:10} handle it however ya want.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:7_0_0"
msgid "Lemme know if ya need incense money"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:7_0_1"
msgid "for Terada's funeral.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:8_0_0"
msgid "Goda,{PA:10} Takashima and Sengoku are on yer ass.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:9_0_0"
msgid "Ya got nowhere to run,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:10_0_0"
msgid "Why put a hit on me?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:11_0_0"
msgid "You're the finish line at the end of their"
msgstr "Eres la meta... en su carrera por la sucesión..."

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:11_0_1"
msgid "race to take over the Alliance.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0100.DAT/3___FILE.BIN::line:12_0_0"
msgid "Me?{PA:20}"
msgstr "¿Yo?{PA:20}"

