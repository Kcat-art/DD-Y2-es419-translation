msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:0_0_0"
msgid "Huh.{PA:20}.{PA:20}.{PA:20}?{PA:20} Ya serious?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:1_0_0"
msgid "Gotcha.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:2_0_0"
msgid "Thanks for your help.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:3_0_0"
msgid "Whoa there!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:4_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Mr.{PA:20} Kazuma Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:5_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}How do you know my name?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:6_0_0"
msgid "Buddy.{PA:20}.{PA:20}.{PA:20} ya just turned into 100 million yen!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:7_0_0"
msgid "What?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:8_0_0"
msgid "It's a bounty,{PA:10} man.{PA:20} Nuthin' personal.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:9_0_0"
msgid "Put 100 million on any guy's head and"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:9_0_1"
msgid "folks'll jump for it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:10_0_0"
msgid "100 million.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:11_0_0"
msgid "Talk about heavy discounting.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:12_0_0"
msgid "May be cheap for the head of a former"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:12_0_1"
msgid "Tojo Chairman,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:13_0_0"
msgid "It's a shit-load o' money for folks like us!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0090.DAT/1___FILE.BIN::line:14_0_0"
msgid "'Fraid you've gotta die now!{PA:20}"
msgstr ""

