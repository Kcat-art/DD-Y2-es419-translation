msgid "The confrontational yakuza vs.{PA:20} police"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER04/SCENE_04_0070.DAT/1___FILE.BIN::line:49_0_1"
msgid "relationship is a thing of the past.{PA:20}"
msgstr ""

