msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "All right.{PA:20} Ready to go?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "What's wrong?{PA:20}"
msgstr "¿Qué pasa?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "Thinking through everything last night,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:2_0_1"
msgid "I hit a frightening possibility.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "What's that?{PA:20}"
msgstr "¿El qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "What if.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "What if I'm one of the Jingweon survivors?{PA:20}"
msgstr "¿Y si soy también una sobreviviente Jingwon?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "How do you figure that?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "From what Mama said before.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "If my parents were killed 20-some years ago"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:8_0_1"
msgid "by the Tojo Clan.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "They could have been part of the Jingweon"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:9_0_1"
msgid "Mafia the Tojo wiped out.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "Isn't that a reasonable conclusion?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "You?{PA:20} Another Jingweon survivor?{PA:20}"
msgstr "¿Dices {PA:20}que podrías ser otra sobreviviente\\r||de los Jingwon?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "It would all add up.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "Want to call off the meeting with Murai?{PA:20}"
msgstr "¿Quieres cancelar la reunión con Murai?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "I don't want to run away from my past.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER11/SCENE_11_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "Let's head out.{PA:20}"
msgstr ""

