msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "You.{PA:20}.{PA:20}.{PA:20} and Bessho from the"
msgstr ""

