msgid "Osaka Police?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "Right.{PA:20} It was our case.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "Is this why you joined the current"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:14_0_1"
msgid "investigation?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "That's right.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:16_0_0"
msgid "I heard through the grapevine Kurahashi was"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:16_0_1"
msgid "tracking the Jingweon and volunteered.{PA:20}"
