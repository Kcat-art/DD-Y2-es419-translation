msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0010.DAT/1___FILE.BIN::line:4_0_1"
msgid "You nearly gave me a heart attack.{PA:20}"
msgstr ""

