msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:1_0_0"
msgid "Think you're a tough guy,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:1_1_0"
msgid "Locate(BottomCenter)"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:2_0_0"
msgid "What the hell are you punks doing?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:3_0_0"
msgid "Hey,{PA:10} baby!{PA:20} Somethin' you wanna say?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:4_0_0"
msgid "Guess what'll happen if you try anything.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:5_0_0"
msgid "Get out of here.{PA:20}"
msgstr "¡Vete de aquí!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:6_0_0"
msgid "Th-thanks!{PA:20}"
msgstr "Gracias...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:6_1_0"
msgid "Locate(BottomCenter)"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:7_0_0"
msgid "Hold up,{PA:10} honey!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:8_0_0"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:9_0_0"
msgid "Damn,{PA:10} woman.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:9_0_1"
msgid "My heart's fired up like a fuckin' candle!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:10_0_0"
msgid "How nice for you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:11_0_0"
msgid "You're so hot,{PA:10} woman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:12_0_0"
msgid "How 'bout givin' me 'n' the boys some o' that?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:13_0_0"
msgid "Ugh,{PA:10} you gotta be kidding me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:14_0_0"
msgid "Naw,{PA:10} baby!{PA:20} This ain't no joke!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:15_0_0"
msgid "You bein' a cop just makes me harder.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:16_0_0"
msgid "One more word and I'll bust the lot of you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:17_0_0"
msgid "Ooh.{PA:20}.{PA:20}.{PA:20} It's even better when you're angry!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:18_0_0"
msgid "I love me a strong woman!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:19_0_0"
msgid "Who the fuck are you?{PA:20}"
msgstr "¿Y tú quién mierda eres?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:20_0_0"
msgid "Her bodyguard.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER10/SCENE_10_0060.DAT/1___FILE.BIN::line:21_0_0"
msgid "Looks like fun time's on hold,{PA:10} boys!{PA:20}"
msgstr ""

