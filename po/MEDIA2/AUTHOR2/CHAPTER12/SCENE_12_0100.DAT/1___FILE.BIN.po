msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:0_0_0"
msgid "I heard our Go-Ryu put on a little show"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:0_0_1"
msgid "at Tsutenkaku Tower.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:1_0_0"
msgid "The Koreans pulled that on their own.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:2_0_0"
msgid "No kidding?{PA:20} Ya kept using 'em left"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:2_0_1"
msgid "and right; I couldn't tell.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:3_0_0"
msgid "Not that it got ya anywhere.{PA:20}.{PA:20}.{PA:20}"
msgstr "Pero bueno, no es que te hayan servido de mucho{PA:20}.{PA:20}..{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:4_0_0"
msgid "You pickin' a fight,{PA:10} chum?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:5_0_0"
msgid "Don't let him get to you.{PA:20}"
msgstr "No dejes que te afecte.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:6_0_0"
msgid "Aww,{PA:10} look who's such a grown-up now!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:7_0_0"
msgid "Still,{PA:10} the game's over.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:7_0_1"
msgid "I'm gonna be the next chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:8_0_0"
msgid "I'll use her to whack Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:8_0_1"
msgid "Then it'll all be settled.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:9_0_0"
msgid "That plan suits you,{PA:10} Sengoku.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:10_0_0"
msgid "Hey,{PA:10} word is this guy doesn't go down easy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:11_0_0"
msgid "Do whatever ya want.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:12_0_0"
msgid "I've got my own plans for Kiryu"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:12_0_1"
msgid "and the Tojo.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:13_0_0"
msgid "How about we get started,{PA:10} then?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0100.DAT/1___FILE.BIN::line:13_0_1"
msgid "The race for the Omi throne starts now!{PA:20}"
msgstr ""

