msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:0_0_0"
msgid "You.{PA:20}.{PA:20}.{PA:20}?{PA:20} You'd let us live?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:1_0_0"
msgid "On the condition that you leave Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:2_0_0"
msgid "This isn't some trap,{PA:10} is it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:3_0_0"
msgid "I couldn't hear what they were saying.{PA:20}"
msgstr "No pude entender lo que decían.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:4_0_0"
msgid "I.{PA:20}.{PA:20}.{PA:20} I thought Fuma was in danger.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:4_0_1"
msgid "I wanted to protect him,{PA:10} at any cost.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:5_0_0"
msgid "Call your men and head out the back.{PA:20}"
msgstr "Llama a tus hombres, y huyan de aquí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:6_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Or it'll be a matter of time before"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:6_0_1"
msgid "they're all dead.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:7_0_0"
msgid "Trust me on this!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:8_0_0"
msgid "Kazuma?!{PA:20}"
msgstr "¡Kazuma!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:9_0_0"
msgid "I knew this was a trap!{PA:20}"
msgstr "¡Sabía que esto era una trampa!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:10_0_0"
msgid "Wait!{PA:20} The boy's not with the Tojo!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:11_0_0"
msgid "I.{PA:20}.{PA:20}.{PA:20}"
msgstr "Yo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:12_0_0"
msgid "I thought you were.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER12/SCENE_12_0040.DAT/1___FILE.BIN::line:13_0_0"
msgid "That he was going to.{PA:20}.{PA:20}.{PA:20} I didn't.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

