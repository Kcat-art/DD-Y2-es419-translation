msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:0_0_0"
msgid "Sorry to keep coming to you,{PA:10} Daddy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:1_0_0"
msgid "That man of yours.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:1_0_1"
msgid "I hear he quit another job.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:2_0_0"
msgid "That wasn't Takashi's fault!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:3_0_0"
msgid "It was too soon for you two.{PA:20}"
msgstr "Ustedes dos no están listos.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:4_0_0"
msgid "Look.{PA:20}.{PA:20}.{PA:20} Why don't you call it off?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:5_0_0"
msgid "You can come home anytime you like.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:6_0_0"
msgid "Thanks,{PA:10} Daddy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:7_0_0"
msgid "But I.{PA:20}.{PA:20}.{PA:20}"
msgstr "Pero yo.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:8_0_0"
msgid "I believe in Takashi.{PA:20}"
msgstr "Yo creo en Takashi.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:9_0_0"
msgid "He's not quite sure of himself yet,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:9_0_1"
msgid "I know he'll support me in the end.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:10_0_0"
msgid "That's why I want to support him now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:11_0_0"
msgid "Stubborn as always.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:11_0_1"
msgid "I have no idea where you get it from.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:12_0_0"
msgid "Once Takashi gets settled into a new job,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:12_0_1"
msgid "we'll pay you back if it takes us a decade!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:13_0_0"
msgid "I don't expect anything out of that kid.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:14_0_0"
msgid "It just kills me to see you live like this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0060.DAT/1___FILE.BIN::line:14_0_1"
msgid "You deserve better.{PA:20}"
msgstr ""

