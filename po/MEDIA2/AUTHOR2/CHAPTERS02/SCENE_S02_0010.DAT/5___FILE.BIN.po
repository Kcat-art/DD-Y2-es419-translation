msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:0_0_0"
msgid "Mr.{PA:20} Kiryu?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:1_0_0"
msgid "Wait,{PA:10} please!{PA:20} You're Mr.{PA:20} Kiryu,{PA:10} aren't you?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:2_0_0"
msgid "Wait,{PA:10} you're.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:3_0_0"
msgid "Takashi?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:4_0_0"
msgid "Yes!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:5_0_0"
msgid "Thank you so much.{PA:20}.{PA:20}.{PA:20} for everything.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:6_0_0"
msgid "A year ago,{PA:10} almost exactly.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:7_0_0"
msgid "I helped out Kage's kid,{PA:10} Takashi,{PA:10} when he"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:7_0_1"
msgid "was in a bind.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:8_0_0"
msgid "He was seriously involved with Kyoka,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:8_0_1"
msgid "daughter of the Atobe family boss.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:9_0_0"
msgid "Come ON,{PA:10} Takashi!{PA:20} Let's gooo!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:10_0_0"
msgid "You said you'd treat tonight 'cause you"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:10_0_1"
msgid "won big at the tracks!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:11_0_0"
msgid "Who is she?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:12_0_0"
msgid "Where's Kyoka?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:13_0_0"
msgid "Um,{PA:10} this is.{PA:20}.{PA:20}.{PA:20} She.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:14_0_0"
msgid "What happened to you doing whatever it takes"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:14_0_1"
msgid "to make Kyoka happy?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:15_0_0"
msgid "I-I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:16_0_0"
msgid "In the end,{PA:10} you were just another punk.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:17_0_0"
msgid "That's not true,{PA:10} Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS02/SCENE_S02_0010.DAT/5___FILE.BIN::line:17_0_1"
msgid "Please,{PA:10} hear me out.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

