msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "You smell good.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "Same as.{PA:20}.{PA:20}.{PA:20} Mom did.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Remember her at all?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "Uh-uh.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "Damn.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "Sorry to hear it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "Lost her before ya were.{PA:20}.{PA:20}.{PA:20} old enough to"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:7_0_1"
msgid "even remember.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "What was.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "What was she like?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "She looked a.{PA:20}.{PA:20}.{PA:20} lot like you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "When I first saw ya,{PA:10} I.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "I thought o' her.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "Damn,{PA:10} wish I'd known.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "I had such a.{PA:20}.{PA:20}.{PA:20} cute sister.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "Maybe I wouldn't a'.{PA:20}.{PA:20}.{PA:20} wound up like this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:16_0_0"
msgid "Naw.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:17_0_0"
msgid "Got too much Jingweon blood in me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:18_0_0"
msgid "Death woulda found me one way or another.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:19_0_0"
msgid "Heh.{PA:20}.{PA:20}.{PA:20} Made it further 'n I thought.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:20_0_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20} Gimme a smile.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:21_0_0"
msgid "Always used ta.{PA:20}.{PA:20}.{PA:20} love Mom's smile.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:22_0_0"
msgid "Brother.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:23_0_0"
msgid "Such a.{PA:20}.{PA:20}.{PA:20} pretty smile.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:24_0_0"
msgid "There's no time!{PA:20} That bomb is ticking!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:25_0_0"
msgid "Kazuma,{PA:10} can you hear me?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:26_0_0"
msgid "It's gonna blow!{PA:20} Get the hell out of there!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:27_0_0"
msgid "Uncle Kaz!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:28_0_0"
msgid "Kazuma!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:29_0_0"
msgid "We've got to get out of here,{PA:10} now!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:30_0_0"
msgid "You go.{PA:20}.{PA:20}.{PA:20} Run.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:31_0_0"
msgid "What are you,{PA:10} crazy?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:32_0_0"
msgid "I can't.{PA:20}.{PA:20}.{PA:20} move an inch.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:33_0_0"
msgid "You can't just give up!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:33_0_1"
msgid "I'll carry you if I have to!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:34_0_0"
msgid "You need to save yourself!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:35_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Fine.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:36_0_0"
msgid "Then I'm staying here with you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:37_0_0"
msgid "What?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:38_0_0"
msgid "I can't just leave you!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:39_0_0"
msgid "Just go.{PA:20}.{PA:20}.{PA:20} Forget about me!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:40_0_0"
msgid "I can't do that!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:41_0_0"
msgid "Hurry.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:42_0_0"
msgid "Hurry!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:43_0_0"
msgid "You've got to go!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:44_0_0"
msgid "Shut up!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:45_0_0"
msgid "I'm staying with you!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:46_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Kaoru.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:47_0_0"
msgid "Kazuma!{PA:20} Can you hear me?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:48_0_0"
msgid "Get out of there,{PA:10} NOW!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:49_0_0"
msgid "Date!{PA:20} It's too dangerous to get any closer!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:49_0_1"
msgid "There's no time!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:50_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}We've got to pull out!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:51_0_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:52_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Uncle Kaz!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:53_0_0"
msgid "Less than a minute left.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:54_0_0"
msgid "Poor Haruka.{PA:20}.{PA:20}.{PA:20} We let her down.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:55_0_0"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:56_0_0"
msgid "But I know she'll understand.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:57_0_0"
msgid "You're right.{PA:20}.{PA:20}.{PA:20} She's a smart girl.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:58_0_0"
msgid "Are you scared?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:59_0_0"
msgid "Course.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:60_0_0"
msgid "But this's the first time I've felt so warm.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER17/SCENE_17_0010.DAT/1___FILE.BIN::line:61_0_0"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

