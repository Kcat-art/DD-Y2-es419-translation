msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:0_0_0"
msgid "Forgive me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:1_0_0"
msgid "Kazuma.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kazuma.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:2_0_0"
msgid "It was me.{PA:20}.{PA:20}.{PA:20}"
msgstr "... Fui y{PA:20}o{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:3_0_0"
msgid "I killed your parents.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:4_0_0"
msgid "It was me.{PA:20}"
msgstr "... Fui yo.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:5_0_0"
msgid "Just one night.{PA:20}.{PA:20}.{PA:20} Just one look.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:6_0_0"
msgid "I just wanted to see you one more time.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:7_0_0"
msgid "And my wish came true.{PA:20}.{PA:20}.{PA:20} Kazuma.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:8_0_0"
msgid "I'm not letting scum like him get the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:8_0_1"
msgid "last laugh.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:9_0_0"
msgid "This is the end of the line.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:10_0_0"
msgid "Let me end this right!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:11_0_0"
msgid "Stop it!{PA:20}"
msgstr "¡Ya basta!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:12_0_0"
msgid "Stop it,{PA:10} Nishiki!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:13_0_0"
msgid "NISHIKI!{PA:20}"
msgstr "¡¡Nishiki!!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:14_0_0"
msgid "A dream.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:15_0_0"
msgid "What's wrong,{PA:10} Uncle Kaz?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:16_0_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} Hey,{PA:10} Haruka.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:17_0_0"
msgid "Where have you been?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:18_0_0"
msgid "What's with the flowers?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:19_0_0"
msgid "You said we'd go visit them today.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:20_0_0"
msgid "Oh,{PA:10} that's right.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:21_0_0"
msgid "Are you hungry?{PA:20}"
msgstr "¿Te ha entrado hambre?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:22_0_0"
msgid "I'll go get some breakfast ready.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:23_0_0"
msgid "Thanks.{PA:20}.{PA:20}.{PA:20} I'll help.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:24_0_0"
msgid "Don't worry,{PA:10} I can do it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:25_0_0"
msgid "I've gotten a lot better this last year.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0030.DAT/1___FILE.BIN::line:26_0_0"
msgid "You sure have.{PA:20}"
msgstr "Sí, es cierto.{PA:20}"

