msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:0_0_0"
msgid "I'm surprised to see people like you still"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:0_0_1"
msgid "hanging around this town.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:1_0_0"
msgid "And what kind of people is that?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:2_0_0"
msgid "Self-important scumbags.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:3_0_0"
msgid "Okay,{PA:10} smart guy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:4_0_0"
msgid "Time to get that jaw wired shut!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER01/SCENE_01_0090.DAT/1___FILE.BIN::line:5_0_0"
msgid "Get him!{PA:20}"
msgstr ""

