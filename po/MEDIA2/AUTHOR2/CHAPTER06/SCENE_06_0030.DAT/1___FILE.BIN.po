msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:0_0_0"
msgid "Date!{PA:20}"
msgstr "Fecha{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:1_0_0"
msgid "Kazuma?!{PA:20}"
msgstr "¡Kazuma!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:2_0_0"
msgid "Kazuma Kiryu?{PA:20}"
msgstr "¿Kazuma Kiryu?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:3_0_0"
msgid "Kazuki!{PA:20}"
msgstr "¡Kazuki!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:4_0_0"
msgid "Mr.{PA:20} Kiryu!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:5_0_0"
msgid "What the hell is going on?{PA:20}"
msgstr "(¿Qué demonios está pasando?).{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:6_0_0"
msgid "Don't ask me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:6_0_1"
msgid "We tailed Kazuki here and found two of him!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:7_0_0"
msgid "I'm the real Kazuki!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:8_0_0"
msgid "They had me under lock and key!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:8_0_1"
msgid "I was up here when I came to!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:9_0_0"
msgid "That's a lie!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:9_0_1"
msgid "You dragged me up here at gunpoint!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:10_0_0"
msgid "Why are you here?{PA:20}"
msgstr "¿Qué haces aquí?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:11_0_0"
msgid "I was told to be here at one o'clock.{PA:20}"
msgstr "Me pidieron que viniera aquí a la una de la mañana.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:12_0_0"
msgid "What?!{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:13_0_0"
msgid "Big surprise.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:14_0_0"
msgid "It was a trap.{PA:20}"
msgstr "Era una trampa.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:15_0_0"
msgid "Sure looks like it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:16_0_0"
msgid "Wh-What are you doing?{PA:20}"
msgstr "¿Qu-qué está haciendo?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:17_0_0"
msgid "Kawara!{PA:20}"
msgstr "¡Kawara!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:18_0_0"
msgid "This fake's the one who led us up here.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:19_0_0"
msgid "He put on a good show down at the Stardust,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:19_0_1"
msgid "and we took the bait.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:20_0_0"
msgid "You've got the wrong guy!{PA:20}"
msgstr "Se equivocaron de persona.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:21_0_0"
msgid "Shut up!{PA:20}"
msgstr "¡Cállate!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:22_0_0"
msgid "Never underestimate a cop.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:23_0_0"
msgid "You can change your face as much as you"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:23_0_1"
msgid "like,{PA:10} but you can't change your voice.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:24_0_0"
msgid "I remember your voice from our talk at the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:24_0_1"
msgid "bar,{PA:10} loud and clear.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:25_0_0"
msgid "Now spill it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:25_0_1"
msgid "Why did you lead us up here?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:26_0_0"
msgid "I don't know what you're talking about!{PA:20}"
msgstr "¡No sé de qué está hablando!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:27_0_0"
msgid "Drop the act!{PA:20}"
msgstr "¡No te hagas el tonto!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:28_0_0"
msgid "Who wrote this little scenario?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:29_0_0"
msgid "Stop it!{PA:20}"
msgstr "¡Ya basta!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:30_0_0"
msgid "Are you planning to kill right in front of"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:30_0_1"
msgid "me again?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:31_0_0"
msgid "Get it straight,{PA:10} Makoto.{PA:20}"
msgstr "Usa la cabeza, {PA:10}Makoto.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:32_0_0"
msgid "This guy's not the Kazuki you know.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:32_0_1"
msgid "He's a mafia goon.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:33_0_0"
msgid "How can you say that without any proof?{PA:20}"
msgstr "¡¿Cómo puedes estar tan seguro sin tener pruebas?!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:34_0_0"
msgid "I know it in my gut.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:35_0_0"
msgid "What?{PA:20} You'd kill a man based on your gut?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:36_0_0"
msgid "A cop's gut instinct is more than just"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:36_0_1"
msgid "some guess.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:37_0_0"
msgid "I've been through more kill-or-be-killed"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:37_0_1"
msgid "situations than I can count.{PA:20} I know.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:38_0_0"
msgid "This guy reeks of blood.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:38_0_1"
msgid "It's all over him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:39_0_0"
msgid "You're out of your damn mind.{PA:20}"
msgstr "Estás demente...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:40_0_0"
msgid "Stay back!{PA:20}"
msgstr "¡No te acerques!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:41_0_0"
msgid "Kawara!{PA:20}"
msgstr "¡Kawara!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:42_0_0"
msgid "Kazuki!{PA:20}"
msgstr "¡Kazuki!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:43_0_0"
msgid "Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kiryu..{PA:20}.{PA:20},{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:44_0_0"
msgid "I'm the one who called you here yesterday.{PA:20}"
msgstr "Fui yo quien te pidió que vinieras aquí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:45_0_0"
msgid "You?{PA:20}"
msgstr "Tú.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:46_0_0"
msgid "Where's Daigo?{PA:20}"
msgstr "¡¿Dónde está Daigo?!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:47_0_0"
msgid "No point in telling that to the dead.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:48_0_0"
msgid "So you brought us all up here to kill us?{PA:20}"
msgstr "¿Acaso nos trajiste aquí para matarnos?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:49_0_0"
msgid "Now you get it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:50_0_0"
msgid "The four of you came up here,{PA:10} fought,{PA:10} and"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:50_0_1"
msgid "shot each other dead.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:51_0_0"
msgid "That's the end to this scene.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:52_0_0"
msgid "The four of us?{PA:20}"
msgstr "¿Los cuatro?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:53_0_0"
msgid "Why the hell would we kill each other?{PA:20}"
msgstr "¿Por qué diablos nos mataríamos unos a otros?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:54_0_0"
msgid "Given an ending,{PA:10} a story will write itself.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:55_0_0"
msgid "That's the way it works.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:56_0_0"
msgid "Now.{PA:20}.{PA:20}.{PA:20} Shoot him.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:57_0_0"
msgid "Just do it.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:58_0_0"
msgid "Shoot!{PA:20}"
msgstr "¡Hazlo!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:59_0_0"
msgid "[In Korean] You.{PA:20}.{PA:20}.{PA:20} bastard.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:59_1_0"
msgid "Locate(BottomCenter)"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:60_0_0"
msgid "Die!{PA:20}"
msgstr "¡Muere!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:60_1_0"
msgid "Locate(BottomCenter)"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:61_0_0"
msgid "I heard gunshots.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:62_0_0"
msgid "Let's get out of here.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:63_0_0"
msgid "Why are we running?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:63_0_1"
msgid "That was self defense!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:64_0_0"
msgid "There's something fishy about all this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:64_0_1"
msgid "It's better to lay low for now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:65_0_0"
msgid "Let's head out.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER06/SCENE_06_0030.DAT/1___FILE.BIN::line:66_0_0"
msgid "Right!{PA:20}"
msgstr "¡Sí!{PA:20}"

