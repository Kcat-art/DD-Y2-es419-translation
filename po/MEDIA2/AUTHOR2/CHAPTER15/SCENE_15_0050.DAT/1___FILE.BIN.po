msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:0_0_0"
msgid "I don't know why I worried,{PA:10} Majima.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:1_0_0"
msgid "Damn,{PA:10} was I hot today!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:1_0_1"
msgid "My instincts were battin' 1,{PA:10}000,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:2_0_0"
msgid "Y-Yes,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:3_0_0"
msgid "Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:4_0_0"
msgid "Aww,{PA:10} stop!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:5_0_0"
msgid "I ain't done anythin' that hard.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:5_0_1"
msgid "Plus I was half just doin' it fer fun.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:6_0_0"
msgid "Awright,{PA:10} time to get some grub!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:6_0_1"
msgid "Hard day's work always makes me hungry.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:7_0_0"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:8_0_0"
msgid "Well,{PA:10} Kazzy,{PA:10} rest's up to you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:9_0_0"
msgid "See ya.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:10_0_0"
msgid "Oh,{PA:10} and Kaz.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:11_0_0"
msgid "Lose to that Ryuji punk an' I'll ruin ya.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:12_0_0"
msgid "Ya still haven't settled things with me yet.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:13_0_0"
msgid "I got it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:14_0_0"
msgid "I can't stop you from going,{PA:10} can I?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:15_0_0"
msgid "Sayama will be back tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:16_0_0"
msgid "After that,{PA:10} I'm going after him alone.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:17_0_0"
msgid "Until then,{PA:10} though.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER15/SCENE_15_0050.DAT/1___FILE.BIN::line:18_0_0"
msgid "I want to take in the city with Haruka.{PA:20}"
msgstr ""

