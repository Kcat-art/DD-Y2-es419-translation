msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "Hey,{PA:10} Uncle Kaz,{PA:10} look!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "Over there,{PA:10} it's Sakura!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "Hmm?{PA:20} Is that a friend of yours?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "What?{PA:20} No,{PA:10} it's Sakura Fukunaga.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:3_0_1"
msgid "She's like a super-famous actress.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "All right,{PA:10} Mr.{PA:20} Producer.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:4_0_1"
msgid "Next season's TV deal is in your hands.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "You got it,{PA:10} honey!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS03/SCENE_S03_0010.DAT/1___FILE.BIN::line:5_0_1"
msgid "Just leave it to me!{PA:20} Go on!{PA:20}"
msgstr ""

