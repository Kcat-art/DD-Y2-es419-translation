msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:0_0_0"
msgid "After all that,{PA:10} I wind up back here!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:1_0_0"
msgid "Yeah.{PA:20} Maybe it's fate.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:2_0_0"
msgid "Me and my boys are better suited to lurking"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:2_0_1"
msgid "underground than lording down from the sky.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:3_0_0"
msgid "Kawara was a good cop to the last.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "I'm happy I knew my dad.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:4_0_1"
msgid "Even if it was just for a few minutes.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:5_0_0"
msgid "We'll put him to rest next to Suyeon.{PA:20}"
msgstr "Deberíamos ponerlo a descansar junto a Suyeon.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:6_0_0"
msgid "Yeah.{PA:20} I think he'd want it that way.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:7_0_0"
msgid "Leave it to me,{PA:10} honey.{PA:20}"
msgstr "Déjamelo a mí,{PA:10} cielo.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:8_0_0"
msgid "Sorry I've put ya through all this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:9_0_0"
msgid "Oh,{PA:10} hush,{PA:10} baby.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:10_0_0"
msgid "It's all a part of bein' yer mama.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:11_0_0"
msgid "Thanks.{PA:20}.{PA:20}.{PA:20}"
msgstr "Gracias.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:12_0_0"
msgid "I'm still wondering about the kid Sayama's"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:12_0_1"
msgid "mother gave up 26 years ago.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:13_0_0"
msgid "Right.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:14_0_0"
msgid "If the Jingweon got to him,{PA:10} he could be"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:14_0_1"
msgid "involved in all this somehow.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:15_0_0"
msgid "That,{PA:10} and the rat in my office got away.{PA:20}"
msgstr "No nos{PA:10} olvidemos del topo que escapó de mi oficina.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:16_0_0"
msgid "Then I doubt we've seen the last of him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:17_0_0"
msgid "If we can analyze this,{PA:10} it may give us"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:17_0_1"
msgid "something to go on.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:18_0_0"
msgid "I found it on Kurahashi's body.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:19_0_0"
msgid "Nicked it before the cops got their"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:19_0_1"
msgid "hands on it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:20_0_0"
msgid "Yup.{PA:20}"
msgstr "Ajá.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0010.DAT/1___FILE.BIN::line:21_0_0"
msgid "She may be able to crack it open.{PA:20}"
msgstr ""

