msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:0_0_0"
msgid "Listen up,{PA:10} people!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:1_0_0"
msgid "Look.{PA:20}.{PA:20}.{PA:20} This isn't just a Tojo problem.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:2_0_0"
msgid "This is a fight for every clan in Kanto.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:3_0_0"
msgid "Yes,{PA:10} sir!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:4_0_0"
msgid "We grew up in this town.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:5_0_0"
msgid "Some folks might say I have no right saying"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:5_0_1"
msgid "it,{PA:10} but I love this place.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:6_0_0"
msgid "That's why I want to do something in return.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:7_0_0"
msgid "As proud members of the Tojo Clan.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:8_0_0"
msgid "Let's show those Go-Ryu assholes they're"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:8_0_1"
msgid "not taking our home!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:9_0_0"
msgid "Yeah!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:10_0_0"
msgid "I don't think anyone will object to Daigo"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:10_0_1"
msgid "taking over the Tojo after this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:11_0_0"
msgid "It's me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:12_0_0"
msgid "Got it.{PA:20} I'll head to Purgatory now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:13_0_0"
msgid "What is it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:14_0_0"
msgid "That was Date.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0090.DAT/1___FILE.BIN::line:15_0_0"
msgid "He says we've got trouble.{PA:20}"
msgstr ""

