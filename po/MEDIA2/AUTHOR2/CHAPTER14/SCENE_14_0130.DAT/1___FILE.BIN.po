msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:0_0_0"
msgid "M-Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:1_0_0"
msgid "What are you playing at?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:2_0_0"
msgid "Whackin' ya now don't make me a dragon.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:3_0_0"
msgid "Plus you've got somethin' else to do now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:4_0_0"
msgid "What?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:5_0_0"
msgid "The bombs,{PA:10} buddy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:6_0_0"
msgid "Are you saying you didn't put them up to it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:7_0_0"
msgid "The Jingweon are on their own on this one.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:7_0_1"
msgid "Wasn't my idea.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:8_0_0"
msgid "Doesn't do me any good to have this city"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:8_0_1"
msgid "burn down.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:9_0_0"
msgid "What are you talking about?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:10_0_0"
msgid "Kamurocho's gonna be mine soon.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:11_0_0"
msgid "I want it lookin' nice when that happens.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:11_0_1"
msgid "Who needs ashes?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:12_0_0"
msgid "Ryuji.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:13_0_0"
msgid "When you're done,{PA:10} ya come to me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:14_0_0"
msgid "I ain't runnin' or hidin' nowhere.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:15_0_0"
msgid "I'll be waitin' at the tip top of this town.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:16_0_0"
msgid "All right.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:17_0_0"
msgid "No interruptions this time.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:18_0_0"
msgid "Just you and me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0130.DAT/1___FILE.BIN::line:19_0_0"
msgid "Fine.{PA:20}"
msgstr ""

