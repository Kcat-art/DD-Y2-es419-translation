msgid "Yes,{PA:10} but we've got a handle on it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:2_0_0"
msgid "Date is talking with the police about"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:2_0_1"
msgid "defusing the explosives.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:3_0_0"
msgid "Our job will be to protect the city from the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:3_0_1"
msgid "Go-Ryu Clan invasion.{PA:20}"
msgstr "Invasión del clan Go-Ryu{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:4_0_0"
msgid "That's fine and dandy,{PA:10} but most of our"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:4_0_1"
msgid "officers just got served.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

