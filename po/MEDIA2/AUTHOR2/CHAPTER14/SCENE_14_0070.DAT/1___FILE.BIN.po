msgid "The men are all caught in limbo with"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:5_0_1"
msgid "nobody to direct them.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:6_0_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20} How many men could you pull together?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:7_0_0"
msgid "Well.{PA:20}.{PA:20}.{PA:20}"
msgstr "Es que{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:8_0_0"
msgid "If I called around the Kamurocho area.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

