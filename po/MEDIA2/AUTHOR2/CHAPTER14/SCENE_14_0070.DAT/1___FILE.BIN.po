msgid "Maybe 300?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:9_0_0"
msgid "Kashiwagi.{PA:20}.{PA:20}.{PA:20}"
msgstr "kashiwag{PA:20}{PA:20}i{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:10_0_0"
msgid "Will you trust me with those 300 men?{PA:20}"
msgstr "¿me confiaría esos 300 hombres?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:11_0_0"
msgid "I'll put out a call right now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:12_0_0"
msgid "You'll take a stand for the Tojo Clan?{PA:20}"
msgstr "¿Piensas alzarte en defensa del Clan Tojo?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:13_0_0"
msgid "Dad and Fuma risked their necks to keep"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:13_0_1"
msgid "this town safe.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0070.DAT/1___FILE.BIN::line:14_0_0"
msgid "I don't want to hand it over to Ryuji Goda.{PA:20}"
msgstr ""

