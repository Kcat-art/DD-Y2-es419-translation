msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:0_0_0"
msgid "Okay.{PA:20} We just left Osaka too.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:0_0_1"
msgid "We should be there by tonight.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:1_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Later.{PA:20}"
msgstr "N{PA:20}o{PA:20}s{PA:20} vemos.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:2_0_0"
msgid "Five trucks chock full of weapons just"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:2_0_1"
msgid "pulled into Kamurocho,{PA:10} boss.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:3_0_0"
msgid "Good.{PA:20}"
msgstr "Bien.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:4_0_0"
msgid "Won't be long now,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:5_0_0"
msgid "Nope.{PA:20}"
msgstr "No.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:6_0_0"
msgid "Invadin' Kamurocho's been on Omi's to-do"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:6_0_1"
msgid "list for ages.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:7_0_0"
msgid "Even Pop never quite made it happen.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:8_0_0"
msgid "Now the Go-Ryu Clan will finally do it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:9_0_0"
msgid "Damn straight.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:10_0_0"
msgid "I'm fixin' to use that as a jumping-off"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:10_0_1"
msgid "point to take over every gang in Japan.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:11_0_0"
msgid "I'll be the one and only dragon.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:12_0_0"
msgid "Watch me close,{PA:10} Pop.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0020.DAT/1___FILE.BIN::line:13_0_0"
msgid "I'm about to do what ya couldn't.{PA:20}"
msgstr ""

