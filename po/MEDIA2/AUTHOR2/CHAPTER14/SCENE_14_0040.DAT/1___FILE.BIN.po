msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:0_0_0"
msgid "No dice.{PA:20}"
msgstr "No hay manera.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:1_0_0"
msgid "No dice?{PA:20}"
msgstr "¿No?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:2_0_0"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:3_0_0"
msgid "I can't crack it on this terminal.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:4_0_0"
msgid "I need a special application to brute"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:4_0_1"
msgid "force the password.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:5_0_0"
msgid "Oh.{PA:20}"
msgstr "Vaya...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:6_0_0"
msgid "Sorry about that.{PA:20}"
msgstr "Perdón por eso...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:7_0_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20}"
msgstr "Oye.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:8_0_0"
msgid "Does that mean.{PA:20}.{PA:20}.{PA:20}?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:9_0_0"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:10_0_0"
msgid "Could you read it using the system downtown?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:11_0_0"
msgid "At police headquarters?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:12_0_0"
msgid "Yeah.{PA:20} We've got a high-tech crime"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:12_0_1"
msgid "unit up here,{PA:10} too.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:13_0_0"
msgid "Maybe they have that tool you need.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:14_0_0"
msgid "But the Tokyo Police aren't exactly on our"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:14_0_1"
msgid "side on this one.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:15_0_0"
msgid "That's the tricky part.{PA:20}"
msgstr "Esa es la parte complicada.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:16_0_0"
msgid "Me calling in a favor won't get us too far.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:17_0_0"
msgid "I guess that's out,{PA:10} then.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:18_0_0"
msgid "Oh,{PA:10} hey!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:19_0_0"
msgid "Then why not use Osaka's system?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:20_0_0"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:21_0_0"
msgid "Hey,{PA:10} that's right!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:22_0_0"
msgid "Sayama,{PA:10} where are you headed next?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:23_0_0"
msgid "I.{PA:20}.{PA:20}.{PA:20}"
msgstr "Yo{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:24_0_0"
msgid "I'm headed back home with Mama for now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:25_0_0"
msgid "That's perfect,{PA:10} then.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:26_0_0"
msgid "Take this in to the office down there and"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:26_0_1"
msgid "have a crack at it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:27_0_0"
msgid "You should be able to open it there,{PA:10} right?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:28_0_0"
msgid "Umm.{PA:20}.{PA:20}.{PA:20} Probably.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0040.DAT/1___FILE.BIN::line:29_0_0"
msgid "Great!{PA:20} Thanks a ton.{PA:20}"
msgstr ""

