msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:0_0_0"
msgid "Oh.{PA:20}.{PA:20}.{PA:20} It's you.{PA:20}"
msgstr "Ah.{PA:20}.{PA:20}.{PA:20} Eres tú.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:1_0_0"
msgid "Sorry,{PA:10} I just let myself in.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:2_0_0"
msgid "No problem.{PA:20}"
msgstr "Está bien.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:3_0_0"
msgid "What's up?{PA:20}"
msgstr "¿Qué ocurre, Date-san?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:4_0_0"
msgid "Ya look like ya wanna ask me something.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:5_0_0"
msgid "No.{PA:20}"
msgstr "No{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:6_0_0"
msgid "Oh.{PA:20}"
msgstr "Vaya...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:7_0_0"
msgid "You're headed back to Kansai?{PA:20}"
msgstr "¿Piensas volver a Kansai?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:8_0_0"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:9_0_0"
msgid "After all that happened,{PA:10} I don't"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:9_0_1"
msgid "wanna leave Mama on her own.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:10_0_0"
msgid "I wanna see her home safely.{PA:20}"
msgstr "Quiero acompañarla hasta Osaka.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:11_0_0"
msgid "Yeah.{PA:20} That makes sense.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:12_0_0"
msgid "I kinda feel like I'm running away"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:12_0_1"
msgid "at the most important part here.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:13_0_0"
msgid "Don't worry about us.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:14_0_0"
msgid "You're right.{PA:20}"
msgstr "Tienes razón.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:15_0_0"
msgid "You don't need my protective custody now.{PA:20}"
msgstr "Supongo que ya no hace falta que te acompañe.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:16_0_0"
msgid "God,{PA:10} I'm sorry.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:17_0_0"
msgid "Kaoru.{PA:20}.{PA:20}.{PA:20}"
msgstr "Kaoru..{PA:20}.{PA:20},{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:18_0_0"
msgid "I'm scared.{PA:20}"
msgstr "Tengo miedo...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:19_0_0"
msgid "Hmm?{PA:20}"
msgstr "¿Mmm?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:20_0_0"
msgid "Of finding out anything else about all this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:21_0_0"
msgid "For the first time,{PA:10} I'm really scared.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:22_0_0"
msgid "I was so eager to figure it all out.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:23_0_0"
msgid "I thought I could handle whatever turned up.{PA:20}"
msgstr "Pensé que podría aceptarlo, fuera lo que fuera.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:24_0_0"
msgid "But no.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:25_0_0"
msgid "You were right.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:26_0_0"
msgid "What I found out only hurt.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:27_0_0"
msgid "Guess it's too late for that now,{PA:10} huh?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:28_0_0"
msgid "It's going to be okay.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:29_0_0"
msgid "Huh?{PA:20}"
msgstr "¿Eh?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:30_0_0"
msgid "Whatever you find out is fine.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:30_0_1"
msgid "Nothing will make me think less of you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:31_0_0"
msgid "Promise me.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:32_0_0"
msgid "Whatever happens,{PA:10} you'll come back.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:33_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Back to Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:34_0_0"
msgid "Okay.{PA:20}"
msgstr "Okey.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0050.DAT/1___FILE.BIN::line:35_0_0"
msgid "I promise.{PA:20}"
msgstr "Lo prometo.{PA:20}"

