msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:0_0_0"
msgid "Hey,{PA:10} there you are.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:1_0_0"
msgid "Kazuki!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:2_0_0"
msgid "Mr.{PA:20} Kiryu.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:3_0_0"
msgid "I'm sorry to make you come here.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:4_0_0"
msgid "Don't worry about it.{PA:20} How are you feeling?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:5_0_0"
msgid "I'll be fine.{PA:20} Thank you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:6_0_0"
msgid "Kazuki.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:6_0_1"
msgid "I'm sorry I got you into this mess.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:7_0_0"
msgid "Not at all.{PA:20} You saved me,{PA:10} Mr.{PA:20} Date.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:8_0_0"
msgid "Isn't that a bit much?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:9_0_0"
msgid "No,{PA:10} it's the truth.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:10_0_0"
msgid "You freed me from those mafia goons.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:11_0_0"
msgid "What do you mean?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:12_0_0"
msgid "They had me under lock and key for the last"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:12_0_1"
msgid "six months.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:13_0_0"
msgid "Six months?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:14_0_0"
msgid "What?!{PA:20} B-but then.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:14_0_1"
msgid "Who was that at the club?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:15_0_0"
msgid "That wasn't me.{PA:20} It was that other guy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:16_0_0"
msgid "I couldn't believe it at first,{PA:10} either.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:17_0_0"
msgid "I had no clue I had a lookalike out there.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:18_0_0"
msgid "He was a Korean.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:19_0_0"
msgid "One of the Jingweon mafia's men?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:20_0_0"
msgid "Yes.{PA:20} I got jumped outside the bar one night,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:20_0_1"
msgid "and the next thing I know,{PA:10} I'm a prisoner.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:21_0_0"
msgid "So they used you to try to get at us.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:22_0_0"
msgid "Most likely.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:23_0_0"
msgid "Mr.{PA:20} Kiryu,{PA:10} Mr.{PA:20} Date.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:24_0_0"
msgid "They were talking about.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:24_0_1"
msgid "something horrible.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:25_0_0"
msgid "What was it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:26_0_0"
msgid "This is only what I overheard,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:27_0_0"
msgid "They're planning to destroy the city.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:28_0_0"
msgid "Wh-What?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:29_0_0"
msgid "There was more than one bomb.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:30_0_0"
msgid "They've already got the whole town rigged.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:31_0_0"
msgid "What?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:32_0_0"
msgid "They've been working on this for years.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:33_0_0"
msgid "Where are the other bombs?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:34_0_0"
msgid "All I know is how many there are.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:35_0_0"
msgid "How many?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:36_0_0"
msgid "One of them said.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:37_0_0"
msgid "\"I've got as many bombs as the brothers'"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:37_0_1"
msgid "lives we lost that day.{PA:20}\""
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:38_0_0"
msgid "Kazuma,{PA:10} the number of guys who died was.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:39_0_0"
msgid "Thirty-three in total.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:40_0_0"
msgid "So there are 33 bombs.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:41_0_0"
msgid "One went off in the Millennium Tower.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:42_0_0"
msgid "One we took care of along with Kurahashi.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:43_0_0"
msgid "That leaves 31.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:44_0_0"
msgid "Kazuma,{PA:10} I'll call the station and ask them"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:44_0_1"
msgid "to have the squad ready.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:45_0_0"
msgid "The squad?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:46_0_0"
msgid "Yeah,{PA:10} the bomb squad.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:47_0_0"
msgid "Even if we find them,{PA:10} it'll take a"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:47_0_1"
msgid "professional to safely defuse them.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER14/SCENE_14_0060.DAT/1___FILE.BIN::line:48_0_0"
msgid "All right.{PA:20}"
msgstr ""

