msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:19_0_0"
msgid "The fuck is your problem?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:20_0_0"
msgid "I'm afraid I can't let you take this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:21_0_0"
msgid "Find another deed.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:22_0_0"
