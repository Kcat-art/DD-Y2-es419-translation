msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:0_0_0"
msgid "I brought it,{PA:10} just like you said.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:1_0_0"
msgid "You.{PA:20}.{PA:20}.{PA:20} What are you doin' here?!{PA:20}"
msgstr ""

