msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0030.DAT/1___FILE.BIN::line:22_0_1"
msgid "Piss me off,{PA:10} and you'll piss blood.{PA:20} Get it?!{PA:20}"
