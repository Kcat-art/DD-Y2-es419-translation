msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:0_0_0"
msgid "This is Ota from Osaka Police.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:1_0_0"
msgid "Yes,{PA:10} I've confirmed the fund transfer.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:2_0_0"
msgid "I'm afraid your husband's been arrested for"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:2_0_1"
msgid "groping a young lady on the train.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:3_0_0"
msgid "If this doesn't settle out before court,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:3_0_1"
msgid "this could be extremely serious.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:4_0_0"
msgid "Hey,{PA:10} it's me.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:4_0_1"
msgid "I'm in some seriously deep shit.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:5_0_0"
msgid "The victim's husband is absolutely furious.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:6_0_0"
msgid "Listen up,{PA:10} boys!{PA:20} We're gettin' 50 million"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:6_0_1"
msgid "more by month's end,{PA:10} no matter what!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:7_0_0"
msgid "We cross 50 mil,{PA:10} we get to keep 10 percent!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:7_0_1"
msgid "Now get on those phones!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:8_0_0"
msgid "We ARE on the fuckin' phones!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:8_0_1"
msgid "Been on 'em all night!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:9_0_0"
msgid "I don't see it happenin',{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:9_0_1"
msgid "We got all we're gonna get.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:10_0_0"
msgid "Nobody else's gonna fall for this shit.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:11_0_0"
msgid "'Zactly.{PA:20} I'm with him,{PA:10} man.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:12_0_0"
msgid "Fuck that noise!{PA:20} You ladies're just chicken!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:13_0_0"
msgid "Other day I got the CEO of Lucky Realtors or"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:13_0_1"
msgid "some shit to transfer 6.{PA:20}8 million over.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:14_0_0"
msgid "These stupid geezers are out there!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:15_0_0"
msgid "So don't give up,{PA:10} c'mon!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:16_0_0"
msgid "Shit,{PA:10} I'm late.{PA:20}.{PA:20}.{PA:20} Gotta hand over that deed.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTERS07/SCENE_S07_0020.DAT/1___FILE.BIN::line:17_0_0"
msgid "Hey,{PA:10} where you goin'?!{PA:20}"
msgstr ""

