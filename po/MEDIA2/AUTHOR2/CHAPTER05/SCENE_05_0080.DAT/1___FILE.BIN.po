msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:0_0_0"
msgid "It's me,{PA:10} Kiryu.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:1_0_0"
msgid "Anybody here?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:2_0_0"
msgid "I know you're here.{PA:20} Come on out.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:3_0_0"
msgid "I been waitin' for ya,{PA:10} Kazuma baby!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:4_0_0"
msgid "You've got no idea how lonely I've been"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:4_0_1"
msgid "since ya got outta the game last year.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:5_0_0"
msgid "Oh,{PA:10} but I knew!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:5_0_1"
msgid "I knew my Kaz would be back someday!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:6_0_0"
msgid "Who or what is this?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:7_0_0"
msgid "Former second-in-command of the Tojo"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:7_0_1"
msgid "Shimano family.{PA:20} I learned a lot from him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:8_0_0"
msgid "He had a hand in last year's incident,{PA:10} too.{PA:20}"
msgstr "También tuvo que ver con lo que pasó el año p{PA:10}asado.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:9_0_0"
msgid "It's been a while,{PA:10} Majima.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:10_0_0"
msgid "What,{PA:10} already got yerself a woman,{PA:10} Kaz?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:10_0_1"
msgid "You dog!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:11_0_0"
msgid "We're not a couple.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:12_0_0"
msgid "Aww,{PA:10} no need to get bashful.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:12_0_1"
msgid "Right,{PA:10} babe?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:13_0_0"
msgid "Kaoru Sayama,{PA:10} Osaka Police Division 4.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:13_0_1"
msgid ".{PA:20}.{PA:20}.{PA:20}Charmed.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:14_0_0"
msgid "Osaka Police?{PA:20} Division 4?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:14_0_1"
msgid ".{PA:20}.{PA:20}.{PA:20}You're a cop,{PA:10} babe?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:15_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Kaz,{PA:10} what the fuck is going on?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:16_0_0"
msgid "Forget that.{PA:20}.{PA:20}.{PA:20} Why are you here?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:17_0_0"
msgid "The last guy up and left.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:18_0_0"
msgid "Kage's gone?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:19_0_0"
msgid "Kage?{PA:20}"
msgstr "Kage{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:20_0_0"
msgid "Yeah,{PA:10} he's a legendary information dealer"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:20_0_1"
msgid "who worked down here a year ago.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:21_0_0"
msgid "Yeah.{PA:20}.{PA:20}.{PA:20} \"Kage the Florist\",{PA:10} they call him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:21_0_1"
msgid "The guy's an ex-cop.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:22_0_0"
msgid "Used to deliver info on bouquet cards,{PA:10} so"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:22_0_1"
msgid "they started callin' him that.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:23_0_0"
msgid "What's Kage doing now?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:24_0_0"
msgid "Went back to the sunny side.{PA:20}"
msgstr "Pues ahora vive como alguien normal.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:25_0_0"
msgid "The sunny side?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:26_0_0"
msgid "Cops have subcontracted him.{PA:20} He passes info"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:26_0_1"
msgid "from his monitors on to them now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:27_0_0"
msgid "Guess for him,{PA:10} it's just back to old tricks.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:28_0_0"
msgid "So he's back on police payroll?{PA:20}"
msgstr "¿Así que volvió a trabajar para la ley?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:29_0_0"
msgid "Yup.{PA:20} This place went dead when he left.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:30_0_0"
msgid "So I started up Majima Construction and"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:30_0_1"
msgid "started work on the Kamurocho Hills!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:31_0_0"
msgid "Kamurocho Hills?{PA:20}"
msgstr "¿Kamurocho Hills?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:32_0_0"
msgid "Ya didn't see it up there?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:32_0_1"
msgid "A huge fuckin' steel skeleton?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:33_0_0"
msgid "Well,{PA:10} that's Kamurocho Hills!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:34_0_0"
msgid "Course,{PA:10} I'm only doing this so I can"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:34_0_1"
msgid "take over this underground city.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:35_0_0"
msgid "You're a smart man.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:36_0_0"
msgid "I know!{PA:20} Right?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:37_0_0"
msgid "So what brings ya here today?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:38_0_0"
msgid "Please.{PA:20}.{PA:20}.{PA:20} Come back to the Tojo Clan.{PA:20}"
msgstr "Vuelve{PA:20} {PA:20}a{PA:20}l Clan Tojo, por favor.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:39_0_0"
msgid "Lookit you all whipped!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:39_0_1"
msgid "What have ya been smoking,{PA:10} Kaz?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:40_0_0"
msgid "You were never very good at the jokes,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:40_0_1"
msgid "my man!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:41_0_0"
msgid "I'm serious.{PA:20}"
msgstr "Lo digo en serio.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:42_0_0"
msgid "The Tojo Clan needs you right now.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:42_0_1"
msgid "Please.{PA:20}.{PA:20}.{PA:20}"
msgstr "Por favor{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:43_0_0"
msgid "No fucking way.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:44_0_0"
msgid "Please.{PA:20}.{PA:20}.{PA:20}"
msgstr "Por favor{PA:20}..{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:45_0_0"
msgid "You're killin' me,{PA:10} Kaz!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:46_0_0"
msgid "I don't wanna see you like this.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:47_0_0"
msgid "Please,{PA:10} Majima.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:48_0_0"
msgid "The Tojo are dead without the Majima family.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:49_0_0"
msgid "I beg of you!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:50_0_0"
msgid "Ugh,{PA:10} fine.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:51_0_0"
msgid "I got one condition,{PA:10} though.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:52_0_0"
msgid "What's that?{PA:20}"
msgstr "¿El qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:53_0_0"
msgid "A little job only you can do,{PA:10} Kazzy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:54_0_0"
msgid "Don't tell me.{PA:20}.{PA:20}.{PA:20}"
msgstr "No me digas que persona er{PA:20}a.{PA:20}..{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:55_0_0"
msgid "Oh,{PA:10} yeah.{PA:20} A tournament.{PA:20}"
msgstr "Exa{PA:10}cto..{PA:20}. Un torneo.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:56_0_0"
msgid "Well?{PA:20} You in?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:57_0_0"
msgid "Tournament?{PA:20} What's he talking about?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:58_0_0"
msgid "This won't take long.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0080.DAT/1___FILE.BIN::line:58_0_1"
msgid "Wait for me back at Serena.{PA:20}"
msgstr ""

