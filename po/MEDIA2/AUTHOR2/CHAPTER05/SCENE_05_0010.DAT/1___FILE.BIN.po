msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0010.DAT/1___FILE.BIN::line:4_0_0"
msgid "Stop,{PA:10} put me down!{PA:20} This is embarrassing!{PA:20}"
msgstr ""

