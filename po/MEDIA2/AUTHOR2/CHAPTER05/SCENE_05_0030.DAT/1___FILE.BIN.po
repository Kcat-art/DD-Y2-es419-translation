msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:0_0_0"
msgid "The Go-Ryu staged a coup?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:1_0_0"
msgid "Ryuji Goda.{PA:20}.{PA:20}.{PA:20} He wants an all-out war"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:1_0_1"
msgid "between east and west,{PA:10} at any cost.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:2_0_0"
msgid "Have you figured out who the foreigners"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:2_0_1"
msgid "behind the kidnapping are?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:3_0_0"
msgid "No.{PA:20}"
msgstr "No{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:4_0_0"
msgid "And the man who took Daigo told you to come"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:4_0_1"
msgid "to the Amano Building alone at one tonight?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:5_0_0"
msgid "Yes.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:6_0_0"
msgid "It's a trap.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:7_0_0"
msgid "I know.{PA:20}"
msgstr "Lo sé.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:8_0_0"
msgid "But if I don't go,{PA:10} we'll never know who"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:8_0_1"
msgid "it is we're dealing with.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:9_0_0"
msgid "Maybe so,{PA:10} but still.{PA:20}.{PA:20}.{PA:20}"
msgstr "Concuer{PA:10}do, pero.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:10_0_0"
msgid "You think the foreigners are tied to the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:10_0_1"
msgid "Go-Ryu Clan behind the scenes?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:11_0_0"
msgid "I'm sure of it.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:12_0_0"
msgid "I can't think of anyone else who would take"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:12_0_1"
msgid "Daigo and the Chairman.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:13_0_0"
msgid "So that foreign group is probably also"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:13_0_1"
msgid "responsible for bombing my office.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:14_0_0"
msgid "If so,{PA:10} they know their way around Kamurocho.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:15_0_0"
msgid "Then going in alone is even more dangerous.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:16_0_0"
msgid "Shindo.{PA:20}"
msgstr "shindo{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:17_0_0"
msgid "The Amano Building is your territory,{PA:10} right?{PA:20}"
msgstr "El edificio Amano está en tu territorio, {PA:10}¿verdad?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:18_0_0"
msgid "Back Kazuma up from a distance.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:18_0_1"
msgid "Stay out of sight,{PA:10} but be ready.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:19_0_0"
msgid "I don't think so.{PA:20}"
msgstr "No es eso...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:20_0_0"
msgid "What did you say?!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:21_0_0"
msgid "My boys are still sore from having Mr.{PA:20} Kiryu"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:21_0_1"
msgid "kill off half the family.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:22_0_0"
msgid "You can't ask us to guard him.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:23_0_0"
msgid "You little shit!{PA:20}"
msgstr "¡Imbécil!{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:24_0_0"
msgid "That was because Nishiki turned traitor!{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:25_0_0"
msgid "I'm aware of that.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:26_0_0"
msgid "But we chose this life out of respect"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:26_0_1"
msgid "for the boss.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:27_0_0"
msgid "Our respect for Nishiki hasn't changed.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:28_0_0"
msgid "So you won't follow clan orders?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:29_0_0"
msgid "Even if it means expulsion from the Tojo,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:29_0_1"
msgid "that's the one thing we can't do.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:30_0_0"
msgid "Fine.{PA:20}"
msgstr "Bien.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:31_0_0"
msgid "I know better than anyone what sort of man"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:31_0_1"
msgid "Nishiki was.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:32_0_0"
msgid "I understand how you feel.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:33_0_0"
msgid "Just let me ask you one thing.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:34_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}And what's that?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:35_0_0"
msgid "Other than your grudge against me.{PA:20}.{PA:20}.{PA:20}"
msgstr "Aparte de su rencor hacia mí..{PA:20}.{PA:20},{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:36_0_0"
msgid "You're not hiding any motives,{PA:10} are you?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:37_0_0"
msgid ".{PA:20}.{PA:20}.{PA:20}Of course not.{PA:20}"
msgstr "E{PA:20}{PA:20}n{PA:20} absoluto.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:38_0_0"
msgid "All right.{PA:20}.{PA:20}.{PA:20} Then that's fine.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0030.DAT/1___FILE.BIN::line:39_0_0"
msgid "Excuse me.{PA:20}"
msgstr "¡Mesero!{PA:20}"

