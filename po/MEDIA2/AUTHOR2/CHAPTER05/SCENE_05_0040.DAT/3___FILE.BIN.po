msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:0_0_0"
msgid "I'm back.{PA:20}"
msgstr "Ya volví.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:1_0_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20} Where are you?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:2_0_0"
msgid "Where'd she go?{PA:20}"
msgstr "¿Acaso se fue?...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:3_0_0"
msgid "God,{PA:10} that felt good.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:4_0_0"
msgid "I was all sweaty and gross,{PA:10} so I thought"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:4_0_1"
msgid "maybe I'd hit a sauna or something.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:5_0_0"
msgid "But the place next door had a shower,{PA:10}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:5_0_1"
msgid "so I just helped myself.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:6_0_0"
msgid "Oh.{PA:20}"
msgstr "Vaya...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:7_0_0"
msgid "It used to be a brothel,{PA:10} didn't it?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:8_0_0"
msgid "I've never seen so many showers crammed"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:8_0_1"
msgid "into such a tiny place.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:9_0_0"
msgid "If this were Kansai,{PA:10} they would've been"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:9_0_1"
msgid "busted in a heartbeat.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:10_0_0"
msgid "Are you feeling better?{PA:20}"
msgstr "¿Ya te sientes mejor?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:11_0_0"
msgid "Yeah,{PA:10} my fever's finally down.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:12_0_0"
msgid "My shoulder doesn't hurt as much,{PA:10} either.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:13_0_0"
msgid "I'm back and ready for action.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:14_0_0"
msgid "You should still be taking it easy.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:15_0_0"
msgid "Thanks for picking that stuff up.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:16_0_0"
msgid "Hey.{PA:20}.{PA:20}.{PA:20}"
msgstr "Oye.{PA:20}.{PA:20}.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:17_0_0"
msgid "Hmm?{PA:20}"
msgstr "¿Mmm?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:18_0_0"
msgid "You said you were following me to learn"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:18_0_1"
msgid "about the Tojo's past activities.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:19_0_0"
msgid "As long as he's in my custody,{PA:10} I can get"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:19_0_1"
msgid "close to the Tojo.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:20_0_0"
msgid "Close enough to dig up what happened.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:20_0_1"
msgid "Whatever it is.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:21_0_0"
msgid "I didn't mean to listen in.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:22_0_0"
msgid "If you knew that much.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:22_0_1"
msgid "why did you let me come along?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:23_0_0"
msgid "Because you mentioned the Tojo.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:24_0_0"
msgid "That make you curious?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:25_0_0"
msgid "A little.{PA:20}"
msgstr "Quizá...{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:26_0_0"
msgid "Tell me what happened.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:27_0_0"
msgid "Just like Mama told you before.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:28_0_0"
msgid "I grew up without ever knowing my parents.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:29_0_0"
msgid "She told me they died from illness when I"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:29_0_1"
msgid "was just a baby,{PA:10} but.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:30_0_0"
msgid "I sort of sensed she was hiding something.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:31_0_0"
msgid "One day,{PA:10} I heard Mama shouting on the phone.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:32_0_0"
msgid "What was she saying?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:33_0_0"
msgid "\"It's the Tojo that made Kaoru's life"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:33_0_1"
msgid "this hell.{PA:20}\""
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:34_0_0"
msgid "The Tojo?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:35_0_0"
msgid "I'm sure she was talking to someone who"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:35_0_1"
msgid "knows about my past.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:36_0_0"
msgid "That was over 10 years ago.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:37_0_0"
msgid "I asked her about it countless times,{PA:10} but"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:37_0_1"
msgid "she wouldn't tell me a thing.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:38_0_0"
msgid "She'd just say,{PA:10} \"Knowing won't make you"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:38_0_1"
msgid "any happier.{PA:20}\""
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:39_0_0"
msgid "You're sure it's not a misunderstanding?{PA:20}"
msgstr "¿No habrá sido algún tipo de malentendido?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:40_0_0"
msgid "Judging from her reaction?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:40_0_1"
msgid "Yeah,{PA:10} I'm sure she's hiding something.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:41_0_0"
msgid "But it was killing me to keep hounding her.{PA:20}"
msgstr "Pero me di cuenta de que la perseguía demasiado.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:42_0_0"
msgid "So I joined the police so I could find out"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:42_0_1"
msgid "for myself.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:43_0_0"
msgid "You think the Tojo Clan killed your parents?{PA:20}"
msgstr "¿Crees que el Clan Tojo mató a tus padres?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:44_0_0"
msgid "After that much secrecy,{PA:10} isn't that the"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:44_0_1"
msgid "natural conclusion?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:45_0_0"
msgid "So you want to see if you're right or not.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:46_0_0"
msgid "That's why you've taken me into custody?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:47_0_0"
msgid "Some undercover detective I make.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:48_0_0"
msgid "I can sympathize with you.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:49_0_0"
msgid "What?{PA:20}"
msgstr "¿Qué?{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:50_0_0"
msgid "I had one,{PA:10} too.{PA:20}.{PA:20}.{PA:20} A secret in my past.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:51_0_0"
msgid "A secret in your past?{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:52_0_0"
msgid "Yeah.{PA:20}"
msgstr "Sí.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:53_0_0"
msgid "But when I learned the truth,{PA:10} it only"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:53_0_1"
msgid "brought me pain.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:54_0_0"
msgid "I wished I'd never found out.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:55_0_0"
msgid "It's possible that.{PA:20}.{PA:20}.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:55_0_1"
msgid "some old secrets are best left that way.{PA:20}"
msgstr ""

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:56_0_0"
msgid "Spoken like a man who knows his past.{PA:20}"
msgstr "Por cómo lo dices, supongo que||sabes de lo que hablas.{PA:20}"

msgctxt "MEDIA2/AUTHOR2/CHAPTER05/SCENE_05_0040.DAT/3___FILE.BIN::line:57_0_0"
msgid "You may be right.{PA:20}"
msgstr ""

